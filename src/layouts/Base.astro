---
// Fonts are self-hosted (Latin only): no render-blocking trip to Google Fonts.
import "@fontsource/inter-tight/latin-400.css";
import "@fontsource/inter-tight/latin-500.css";
import "@fontsource/inter-tight/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/pt-sans-narrow/latin-400.css";
import "@fontsource/pt-sans-narrow/latin-700.css";
import "../styles/global.css";
// the hero headline's font: fetched in parallel with the HTML, not after the CSS
import heroFont from "@fontsource/inter-tight/files/inter-tight-latin-700-normal.woff2?url";

interface Props { title: string; description: string; theme?: string }
const { title, description, theme } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <!-- Set before paint: reveal styles only apply when JS can undo them.
         Failsafe: if the module scripts never run (blocked, failed), drop .js
         so hidden start states can't leave content invisible. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(() => { if (!window.__motion) document.documentElement.classList.remove("js"); }, 4000);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- absolute URL from astro.config `site`: WhatsApp/LinkedIn ignore relative og:image -->
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="More customers shouldn't mean more hours. Websites and automations for small businesses, by Zaid Hossain." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json" />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />

    <script>
      // Reveal-on-scroll. One observer for the whole page; unobserve after the
      // first trigger so sections don't re-animate when scrolling back up.
      import { HEADINGS } from "../scripts/text-reveal";
      (window as any).__motion = true; // tells the head failsafe that JS is alive
      // Split headings are animated by GSAP (text-reveal.ts): mark them shown
      // now and keep them out of this observer, so the CSS fade can't fight it.
      const els: HTMLElement[] = [];
      document.querySelectorAll<HTMLElement>(".reveal").forEach((el) =>
        el.matches(HEADINGS) ? el.classList.add("in-view") : els.push(el)
      );
      // scripts arrived after the failsafe fired: show everything, then restore .js
      if (!document.documentElement.classList.contains("js")) {
        els.forEach((el) => el.classList.add("in-view"));
        document.documentElement.classList.add("js");
      }
      const revealEl = (el: Element) => {
        const delay = Number(el.getAttribute("data-delay") ?? 0);
        setTimeout(() => el.classList.add("in-view"), delay);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            revealEl(e.target);
            io.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.1 }
      );
      // Anything already on screen at load reveals immediately (the -12% dead
      // zone must not hide above-the-fold content); the rest waits for scroll.
      els.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) revealEl(el);
        else io.observe(el);
      });
    </script>

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis();
        (window as any).lenis = lenis; // Process uses it to settle on the nearest phase

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            const href = anchor.getAttribute("href");
            if (href && href !== "#") {
              try {
                const target = document.querySelector(href);
                if (target) {
                  e.preventDefault();
                  lenis.scrollTo(target as HTMLElement, { duration: 0.8 });
                }
              } catch {
                // Ignore invalid selector
              }
            }
          });
        });
      }
    </script>
  </body>
</html>

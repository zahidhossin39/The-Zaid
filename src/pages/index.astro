---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import WhatIBuild from "../components/WhatIBuild.astro";
import Proof from "../components/Proof.astro";
import Process from "../components/Process.astro";
import About from "../components/About.astro";
import FAQ from "../components/FAQ.astro";
import BookACall from "../components/BookACall.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Zaid Hossain | Websites and automations for small businesses"
  description="I build websites that bring customers in and automations that handle the work they create, so more customers don't mean more hours. Fixed price, agreed upfront."
>
  <a href="#main" class="skip-link">Skip to content</a>
  <Navbar />
  <main id="main" tabindex="-1">
    <Hero />
    <Problem />
    <WhatIBuild />
    <Proof />
    <Process />
    <About />
    <FAQ />
    <BookACall />
  </main>
  <Footer />
</Base>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100; /* above the navbar (50) */
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
  main:focus { outline: none; } /* focus target only, not a control */
</style>

<script>
  // Base's Lenis handler preventDefaults #anchors, which skips the browser's
  // fragment focus move. Do it ourselves so keyboard users land in main.
  document.querySelector(".skip-link")?.addEventListener("click", () => {
    document.getElementById("main")?.focus({ preventScroll: true });
  });
</script>

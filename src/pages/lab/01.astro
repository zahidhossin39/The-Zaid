---
// Lab prototype 01 — Deep Water. Standalone by design; see LAB-SPEC.md.
// Teal-tinted neutrals so the accent reads as the page's own concentrate.
// Accent roles: the rule before the eyebrow, the numbers, the button. Nothing else.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>01 · Deep Water</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400;500;600&display=swap"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #0A1111; color: #EFF7F6; font-family: Inter, system-ui, sans-serif; }
      a { text-decoration: none; }
      .lbl { position: fixed; top: 1rem; left: 1rem; font: 600 11px ui-monospace, monospace;
             letter-spacing: .1em; padding: .35rem .6rem; border-radius: 4px; z-index: 9;
             background: #2DD4BF; color: #0A1111; }

      .hero { max-width: 66rem; margin: 0 auto; padding: 7rem 3rem 0; min-height: 100vh;
              display: flex; flex-direction: column; justify-content: center; }
      .mark { display: flex; align-items: center; gap: .85rem; }
      .mark i { width: 2.25rem; height: 2px; background: #2DD4BF; display: block; }
      .eyb { font: 400 .8125rem ui-monospace, Menlo, monospace; letter-spacing: .14em;
             text-transform: uppercase; color: #8FA8A5; margin: 0; }
      h1 { font-family: "Instrument Serif", Georgia, serif; font-weight: 400;
           font-size: clamp(3rem, 7.5vw, 5.25rem); line-height: 1.0; letter-spacing: -.02em;
           margin: 2.5rem 0 0; max-width: 17ch; text-wrap: pretty; }
      .sub { color: #8FA8A5; font-size: 1.1875rem; line-height: 1.65; margin: 2rem 0 0; max-width: 44ch; }
      .row { margin-top: 3rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
      .btn { background: #2DD4BF; color: #0A1111; border-radius: 999px;
             padding: .9rem 1.85rem; font-weight: 500; }
      .ghost { color: #8FA8A5; }
      .rule { margin-top: 6rem; height: 1px; background: #1F3030; }

      .svc { max-width: 66rem; margin: 0 auto; padding: 3.5rem 3rem 7rem;
             display: grid; grid-template-columns: repeat(3, 1fr); gap: 3.5rem; }
      .svc h3 { font-size: 1.0625rem; margin: 1rem 0 .5rem; font-weight: 600; }
      .svc p { color: #8FA8A5; font-size: .9375rem; line-height: 1.65; margin: 0; }
      .n { font: 400 .75rem ui-monospace, monospace; color: #2DD4BF; letter-spacing: .1em; }
    </style>
  </head>
  <body>
    <div class="lbl">01 · Deep Water</div>

    <section class="hero" data-shot="hero">
      <div class="mark"><i></i><p class="eyb">Zaid Hossain — builder for hire</p></div>
      <h1>You've had the idea long enough.</h1>
      <p class="sub">
        I build the app, site, or automation you've been circling for months.
        Scoped tight, built in the open, handed over working.
      </p>
      <div class="row">
        <a class="btn" href="#">Book a 20-minute call</a>
        <a class="ghost" href="#">See the work ↓</a>
      </div>
      <div class="rule"></div>
    </section>

    <section class="svc" data-shot="two">
      <div><span class="n">01</span><h3>Apps</h3><p>The internal tool you have been faking with a spreadsheet.</p></div>
      <div><span class="n">02</span><h3>Automations</h3><p>The copy-paste between two systems. It runs without you now.</p></div>
      <div><span class="n">03</span><h3>Websites</h3><p>Not a brochure. A site with one job and the plumbing to do it.</p></div>
    </section>
  </body>
</html>

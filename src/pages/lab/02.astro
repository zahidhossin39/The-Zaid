---
// Lab prototype 02 — Blueprint. Standalone by design; see LAB-SPEC.md.
// Blue-black steel neutrals, split grid, technical register. All-sans, no serif.
// Accent roles: the status dot and the button. Nothing else.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>02 · Blueprint</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #0B0E14; color: #F2F4F8; font-family: Inter, system-ui, sans-serif; }
      a { text-decoration: none; }
      .lbl { position: fixed; top: 1rem; left: 1rem; font: 600 11px ui-monospace, monospace;
             letter-spacing: .1em; padding: .35rem .6rem; border-radius: 4px; z-index: 9;
             background: #6E8BFF; color: #0B0E14; }

      .hero { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
      .left { padding: 7rem 4rem; display: flex; flex-direction: column; justify-content: center;
              border-right: 1px solid #232937; }
      .eyb { font: 500 .75rem Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase;
             color: #98A1B3; margin: 0 0 2.25rem; }
      h1 { font-size: clamp(2.5rem, 4.6vw, 3.75rem); font-weight: 600; letter-spacing: -.035em;
           line-height: 1.05; margin: 0; max-width: 14ch; }
      .sub { color: #98A1B3; font-size: 1.0625rem; line-height: 1.7; margin: 1.75rem 0 0; max-width: 40ch; }
      .row { margin-top: 2.75rem; display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
      .btn { background: #6E8BFF; color: #0B0E14; border-radius: 8px;
             padding: .85rem 1.6rem; font-weight: 600; font-size: .9375rem; }
      .ghost { color: #98A1B3; font-size: .9375rem; }

      .right { position: relative; display: flex; flex-direction: column; justify-content: center;
               padding: 7rem 4rem; }
      .grid-bg { position: absolute; inset: 0; opacity: .6;
        background-image:
          linear-gradient(#232937 1px, transparent 1px),
          linear-gradient(90deg, #232937 1px, transparent 1px);
        background-size: 56px 56px;
        -webkit-mask-image: radial-gradient(ellipse at center, #000 25%, transparent 72%);
        mask-image: radial-gradient(ellipse at center, #000 25%, transparent 72%); }
      dl { position: relative; margin: 0; }
      .spec { display: flex; justify-content: space-between; gap: 2rem;
              padding: 1.2rem 0; border-bottom: 1px solid #232937; font-size: .9375rem; }
      .spec:first-child { border-top: 1px solid #232937; }
      .spec dt { color: #98A1B3; }
      .spec dd { margin: 0; font-weight: 500; }
      .dot { width: .45rem; height: .45rem; border-radius: 999px; background: #6E8BFF;
             display: inline-block; margin-right: .55rem; }
    </style>
  </head>
  <body>
    <div class="lbl">02 · Blueprint</div>

    <section class="hero" data-shot="hero">
      <div class="left">
        <p class="eyb">Zaid Hossain — builder for hire</p>
        <h1>You've had the idea long enough.</h1>
        <p class="sub">
          I build the app, site, or automation you've been circling for months.
          Scoped tight, built in the open, handed over working.
        </p>
        <div class="row">
          <a class="btn" href="#">Book a 20-minute call</a>
          <a class="ghost" href="#">See the work ↓</a>
        </div>
      </div>

      <div class="right">
        <div class="grid-bg"></div>
        <dl>
          <div class="spec"><dt><span class="dot"></span>Availability</dt><dd>2 slots</dd></div>
          <div class="spec"><dt>Typical build</dt><dd>2–5 weeks</dd></div>
          <div class="spec"><dt>You see progress</dt><dd>every few days</dd></div>
          <div class="spec"><dt>You keep</dt><dd>the code + accounts</dd></div>
          <div class="spec"><dt>Retainer</dt><dd>not required</dd></div>
        </dl>
      </div>
    </section>
  </body>
</html>

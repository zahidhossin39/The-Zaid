---
// PROTOTYPE — faithful clone of scrollservices.framer.website. Throwaway.
// Curved arc timeline (numbers ride a fixed arc, active = filled black disc,
// connector black-below / grey-above), text-left + 3D-icon-right, crossfade
// per phase. Content = placeholder builder process, swap freely.
const phases = [
  {
    n: "01",
    kick: "Phase 01",
    title: ["Discovery", "& Scope"],
    body: "We start with your goals, users, and the outcome you need — turning a fuzzy idea into a tight, shared scope.",
    tags: ["Audit", "Goals", "Scope"],
    icon: "https://framerusercontent.com/images/rqTHzxUO3vC7g6gXZqLxByu48M.png?width=256&height=256",
  },
  {
    n: "02",
    kick: "Phase 02",
    title: ["Plan &", "Design"],
    body: "I map the build and design the flows — priorities, structure, and how the thing should feel to use.",
    tags: ["Roadmap", "UX", "UI"],
    icon: "https://framerusercontent.com/images/6UNvtZcsajPqOY2iFqXfLWLAis.png?width=256&height=256",
  },
  {
    n: "03",
    kick: "Phase 03",
    title: ["Build"],
    body: "I build it in the open — clean, modern code you own, shipped in small working pieces you can watch grow.",
    tags: ["Frontend", "Backend", "Automation"],
    icon: "https://framerusercontent.com/images/Uigc835AQJZdGJdrV6pTnx9kEDg.png?width=256&height=256",
  },
  {
    n: "04",
    kick: "Phase 04",
    title: ["Test &", "Ship"],
    body: "Tested, hardened, and deployed to production — handed over working, not almost-working.",
    tags: ["QA", "Deploy", "Docs"],
    icon: "https://framerusercontent.com/images/71NyN9JJ45ohmLF3K57VaKslow.png?width=256&height=256",
  },
  {
    n: "05",
    kick: "Phase 05",
    title: ["Handover", "& Support"],
    body: "You keep the code and the accounts. I stay reachable while you find your feet with it.",
    tags: ["Handover", "Training", "Support"],
    icon: "https://framerusercontent.com/images/4dkW40P1hqiAVkLaXX3by8xbOQY.png?width=256&height=256",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Process — Scroll Clone</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --cream: #f2f0ec;
        --ink: #171512;
        --muted: #6a655d;
        --eye: #8a857c;
        --line-off: #d9d5cd;
        --serif: "Instrument Serif", Georgia, serif;
        --sans: "Inter", system-ui, sans-serif;
      }
      body { margin: 0; background: var(--cream); color: var(--ink); font-family: var(--sans); }

      /* ---------- intro / outro (dark) ---------- */
      .pad { min-height: 100svh; display: grid; place-items: center; text-align: center;
             background: var(--ink); color: var(--cream); padding: 4rem 1.5rem; }
      .pad .eye { font: 500 0.8rem var(--sans); letter-spacing: 0.2em; text-transform: uppercase;
                  color: var(--eye); margin: 0 0 1.4rem; }
      .pad h1 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em;
                font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1.04; margin: 0; max-width: 15ch; }
      .pad .arrow { margin-top: 2.6rem; font-size: 1.4rem; color: var(--muted);
                    animation: bob 1.8s ease-in-out infinite; }
      .pad .subtext { font: 400 1rem var(--sans); color: var(--muted); margin: 1.4rem 0 0; max-width: 44ch; }
      @keyframes bob { 50% { transform: translateY(8px); } }

      /* ---------- pinned process stage ---------- */
      .process { position: relative; height: 520vh; background: var(--cream); }
      .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

      /* timeline rail (left) */
      .rail { position: absolute; inset: 0; pointer-events: none; }
      .rail svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .dot { position: absolute; display: grid; place-items: center; border-radius: 999px;
             background: var(--cream); border: 1px solid var(--line-off);
             font-family: var(--serif); color: var(--ink); transform: translate(-50%, -50%);
             transition: background .35s ease, color .35s ease, border-color .35s ease, width .35s ease, height .35s ease;
             will-change: left, top, width, height; }
      .dot.on { background: var(--ink); color: var(--cream); border-color: var(--ink); }

      /* content: text left, icon right */
      .content { position: absolute; inset: 0; }
      .phase { position: absolute; inset: 0; opacity: 0; pointer-events: none;
               display: grid; align-items: center;
               grid-template-columns: minmax(0,1fr) minmax(0,0.9fr);
               gap: 3rem; padding: 4rem clamp(3rem,6vw,6rem) 4rem clamp(20rem,26vw,26rem);
               transition: opacity .6s ease; }
      .phase.show { opacity: 1; pointer-events: auto; }
      .phase .copy { max-width: 40ch; transform: translateY(14px); transition: transform .7s ease; }
      .phase.show .copy { transform: translateY(0); }
      .phase .kick { font: 600 0.85rem var(--sans); letter-spacing: 0.16em; text-transform: uppercase;
                     color: var(--eye); margin: 0 0 1.4rem; }
      .phase h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em;
                  font-size: clamp(2.6rem, 4.6vw, 3.8rem); line-height: 1.0; margin: 0; color: var(--ink); }
      .phase p { font: 400 1.0625rem var(--sans); line-height: 1.6; color: var(--muted);
                 margin: 1.5rem 0 0; max-width: 42ch; }
      .phase .tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
      .phase .tags span { font: 500 0.85rem var(--sans); color: var(--ink);
                          padding: 0.5rem 1rem; border: 1px solid var(--line-off); border-radius: 999px; }
      .phase .art { justify-self: center; }
      .phase .art img { width: clamp(220px, 26vw, 380px); height: auto; display: block; }

      @media (max-width: 900px) {
        .rail { display: none; }
        .phase { grid-template-columns: 1fr; padding: 5rem 1.5rem; text-align: left; gap: 1.5rem; }
        .phase .art { order: -1; justify-self: start; }
        .phase .art img { width: clamp(160px, 40vw, 240px); }
      }
    </style>
  </head>
  <body>
    <!-- intro -->
    <section class="pad">
      <div>
        <p class="eye">Our Process</p>
        <h1>How we bring ideas to life</h1>
        <div class="arrow">↓</div>
      </div>
    </section>

    <!-- pinned process -->
    <section class="process" id="process">
      <div class="stage">
        <div class="rail">
          <svg id="railSvg" preserveAspectRatio="none">
            <path id="lineGrey" fill="none" stroke="#d9d5cd" stroke-width="1.5" />
            <path id="lineInk" fill="none" stroke="#171512" stroke-width="2.5" stroke-linecap="round" />
          </svg>
          {phases.map((p) => (
            <div class="dot" data-n={p.n}>{p.n}</div>
          ))}
        </div>

        <div class="content">
          {phases.map((p) => (
            <article class="phase">
              <div class="copy">
                <p class="kick">{p.kick}</p>
                <h2>{p.title[0]}{p.title[1] ? <br /> : null}{p.title[1] ?? ""}</h2>
                <p>{p.body}</p>
                <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
              </div>
              <div class="art"><img src={p.icon} alt="" loading="eager" /></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- outro -->
    <section class="pad">
      <div>
        <p class="eye">Ready when you are</p>
        <h1>Let's build the next one together</h1>
        <p class="subtext">You describe the problem, I build the thing — scoped tight and handed over working.</p>
      </div>
    </section>

    <script>
      const N = 5;
      const R = 456;          // arc radius (measured from the reference)
      const STEP = 0.335;     // angular gap between numbers (~19.2°)
      const CX = -169;        // arc centre x, viewport-relative (287 - R)

      const process = document.getElementById("process") as HTMLElement;
      const dots = [...document.querySelectorAll<HTMLElement>(".dot")];
      const phasesEls = [...document.querySelectorAll<HTMLElement>(".phase")];
      const svg = document.getElementById("railSvg") as unknown as SVGSVGElement;
      const grey = document.getElementById("lineGrey") as unknown as SVGPathElement;
      const ink = document.getElementById("lineInk") as unknown as SVGPathElement;

      // arc position for a number that is `d` steps away from the active centre
      // d > 0 = below (passed), d < 0 = above (upcoming)
      const pos = (d: number, cy: number) => {
        const a = d * STEP;
        return { x: CX + R * Math.cos(a), y: cy + R * Math.sin(a) };
      };

      let progress = 0;
      const tick = () => {
        const r = process.getBoundingClientRect();
        const total = process.offsetHeight - innerHeight;
        const p = Math.min(1, Math.max(0, -r.top / total));
        progress = p * (N - 1);               // 0 .. 4
        const cy = innerHeight / 2;
        const active = Math.round(progress);

        // place dots on the arc
        const pts: { x: number; y: number }[] = [];
        dots.forEach((dot, i) => {
          const { x, y } = pos(progress - i, cy);  // passed (i<prog) -> below
          pts[i] = { x, y };
          const near = Math.abs(progress - i);
          const size = Math.max(58, 78 - Math.min(1, near) * 20);
          dot.style.left = x + "px";
          dot.style.top = y + "px";
          dot.style.width = size + "px";
          dot.style.height = size + "px";
          dot.style.fontSize = (size * 0.34).toFixed(1) + "px";
          dot.classList.toggle("on", i === active);
          dot.style.opacity = (x < -40 || y < -60 || y > innerHeight + 60) ? "0" : "1";
        });

        // connector: grey through all points, ink from bottom (01) up to active
        const dPath = (a: { x: number; y: number }[]) =>
          a.length ? "M" + a.map((q) => `${q.x.toFixed(1)} ${q.y.toFixed(1)}`).join(" L ") : "";
        grey.setAttribute("d", dPath(pts));
        // ink runs from 01 (i=0, bottom of arc) up to the active dot
        ink.setAttribute("d", dPath(pts.slice(0, active + 1)));

        // crossfade content
        phasesEls.forEach((el, i) => el.classList.toggle("show", i === active));

        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      phasesEls[0].classList.add("show");
    </script>
  </body>
</html>

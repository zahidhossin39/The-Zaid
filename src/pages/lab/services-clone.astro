---
// PROTOTYPE — faithful clone of scrollservices.framer.website. Throwaway.
// Smooth curved arc timeline (numbers ride a real circle arc; connector is one
// continuous curve, black below the active disc, grey above, running off both
// edges), text-left + 3D-icon-right, eased scroll, revolver-style click + haptic
// on each step change. Content = placeholder builder process, swap freely.
const phases = [
  {
    n: "01", kick: "Phase 01", title: ["Discovery", "& Scope"],
    body: "We start with your goals, users, and the outcome you need — turning a fuzzy idea into a tight, shared scope.",
    tags: ["Audit", "Goals", "Scope"],
    icon: "https://framerusercontent.com/images/rqTHzxUO3vC7g6gXZqLxByu48M.png?width=256&height=256",
  },
  {
    n: "02", kick: "Phase 02", title: ["Plan &", "Design"],
    body: "I map the build and design the flows — priorities, structure, and how the thing should feel to use.",
    tags: ["Roadmap", "UX", "UI"],
    icon: "https://framerusercontent.com/images/6UNvtZcsajPqOY2iFqXfLWLAis.png?width=256&height=256",
  },
  {
    n: "03", kick: "Phase 03", title: ["Build"],
    body: "I build it in the open — clean, modern code you own, shipped in small working pieces you can watch grow.",
    tags: ["Frontend", "Backend", "Automation"],
    icon: "https://framerusercontent.com/images/Uigc835AQJZdGJdrV6pTnx9kEDg.png?width=256&height=256",
  },
  {
    n: "04", kick: "Phase 04", title: ["Test &", "Ship"],
    body: "Tested, hardened, and deployed to production — handed over working, not almost-working.",
    tags: ["QA", "Deploy", "Docs"],
    icon: "https://framerusercontent.com/images/71NyN9JJ45ohmLF3K57VaKslow.png?width=256&height=256",
  },
  {
    n: "05", kick: "Phase 05", title: ["Handover", "& Support"],
    body: "You keep the code and the accounts. I stay reachable while you find your feet with it.",
    tags: ["Handover", "Training", "Support"],
    icon: "https://framerusercontent.com/images/4dkW40P1hqiAVkLaXX3by8xbOQY.png?width=256&height=256",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Process — Scroll Clone</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --cream: #f2f0ec;
        --ink: #171512;
        --muted: #6a655d;
        --eye: #8a857c;
        --line-off: #d9d5cd;
        --serif: "Instrument Serif", Georgia, serif;
        --sans: "Inter", system-ui, sans-serif;
      }
      body { margin: 0; background: var(--cream); color: var(--ink); font-family: var(--sans); }

      /* ---------- intro / outro (dark) ---------- */
      .pad { min-height: 100svh; display: grid; place-items: center; text-align: center;
             background: var(--ink); color: var(--cream); padding: 4rem 1.5rem; }
      .pad .eye { font: 500 0.8rem var(--sans); letter-spacing: 0.2em; text-transform: uppercase;
                  color: var(--eye); margin: 0 0 1.4rem; }
      .pad h1 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em;
                font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1.04; margin: 0; max-width: 15ch; }
      .pad .arrow { margin-top: 2.6rem; font-size: 1.4rem; color: var(--muted);
                    animation: bob 1.8s ease-in-out infinite; }
      .pad .subtext { font: 400 1rem var(--sans); color: var(--muted); margin: 1.4rem 0 0; max-width: 44ch; }
      @keyframes bob { 50% { transform: translateY(8px); } }

      /* ---------- pinned process stage ---------- */
      .process { position: relative; height: 340vh; background: var(--cream); }
      .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

      /* timeline rail (left, fixed-width column so content never overlaps it) */
      .rail { position: absolute; top: 0; left: 0; width: 460px; height: 100%; pointer-events: none; }
      .rail svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
      .dot { position: absolute; display: grid; place-items: center; border-radius: 999px;
             background: var(--cream); border: 1px solid var(--line-off);
             font-family: var(--serif); color: var(--ink); transform: translate(-50%, -50%);
             transition: background .3s ease, color .3s ease, border-color .3s ease;
             will-change: left, top, width, height; z-index: 2; }
      .dot.on { background: var(--ink); color: var(--cream); border-color: var(--ink); }
      .dot.ping { animation: ping .32s ease-out; }
      @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(23,21,18,.35); } 100% { box-shadow: 0 0 0 18px rgba(23,21,18,0); } }

      /* content: text left, 3D icon right — offset past the rail column */
      .content { position: absolute; top: 0; left: 460px; right: 0; bottom: 0; }
      .phase { position: absolute; inset: 0; opacity: 0; pointer-events: none;
               display: grid; align-items: center;
               grid-template-columns: minmax(0,1fr) minmax(0,0.85fr);
               gap: 3rem; padding: 4rem clamp(3rem,5vw,6rem) 4rem 0.5rem;
               transition: opacity .5s ease; }
      .phase.show { opacity: 1; pointer-events: auto; }
      .phase .copy { max-width: 40ch; transform: translateY(14px); transition: transform .6s ease; }
      .phase.show .copy { transform: translateY(0); }
      .phase .kick { font: 600 0.85rem var(--sans); letter-spacing: 0.16em; text-transform: uppercase;
                     color: var(--eye); margin: 0 0 1.4rem; }
      .phase h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em;
                  font-size: clamp(2.6rem, 4.6vw, 3.8rem); line-height: 1.0; margin: 0; color: var(--ink); }
      .phase p { font: 400 1.0625rem var(--sans); line-height: 1.6; color: var(--muted);
                 margin: 1.5rem 0 0; max-width: 42ch; }
      .phase .tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
      .phase .tags span { font: 500 0.85rem var(--sans); color: var(--ink);
                          padding: 0.5rem 1rem; border: 1px solid var(--line-off); border-radius: 999px; }
      .phase .art { justify-self: center; }
      .phase .art img { width: clamp(220px, 26vw, 380px); height: auto; display: block; }

      @media (max-width: 1024px) {
        .rail { display: none; }
        .content { left: 0; }
        .phase { grid-template-columns: 1fr; padding: 5rem 1.5rem; text-align: left; gap: 1.5rem; }
        .phase .art { order: -1; justify-self: start; }
        .phase .art img { width: clamp(160px, 40vw, 240px); }
      }
    </style>
  </head>
  <body>
    <!-- intro -->
    <section class="pad">
      <div>
        <p class="eye">Our Process</p>
        <h1>How we bring ideas to life</h1>
        <div class="arrow">↓</div>
      </div>
    </section>

    <!-- pinned process -->
    <section class="process" id="process">
      <div class="stage">
        <div class="rail">
          <svg id="railSvg" preserveAspectRatio="none">
            <path id="lineGrey" fill="none" stroke="#d9d5cd" stroke-width="1.5" />
            <path id="lineInk" fill="none" stroke="#171512" stroke-width="2.5" stroke-linecap="round" />
          </svg>
          {phases.map((p) => (
            <div class="dot" data-n={p.n}>{p.n}</div>
          ))}
        </div>

        <div class="content">
          {phases.map((p) => (
            <article class="phase">
              <div class="copy">
                <p class="kick">{p.kick}</p>
                <h2>{p.title[0]}{p.title[1] ? <br /> : null}{p.title[1] ?? ""}</h2>
                <p>{p.body}</p>
                <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
              </div>
              <div class="art"><img src={p.icon} alt="" loading="eager" /></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- outro -->
    <section class="pad">
      <div>
        <p class="eye">Ready when you are</p>
        <h1>Let's build the next one together</h1>
        <p class="subtext">You describe the problem, I build the thing — scoped tight and handed over working.</p>
      </div>
    </section>

    <script>
      const N = 5;
      const R = 456;          // arc radius (measured off the reference)
      const STEP = 0.335;     // angular gap between numbers (~19.2°)
      const CX = -169;        // arc centre x within the 460px rail (287 - R)

      const process = document.getElementById("process") as HTMLElement;
      const dots = [...document.querySelectorAll<HTMLElement>(".dot")];
      const phasesEls = [...document.querySelectorAll<HTMLElement>(".phase")];
      const grey = document.getElementById("lineGrey") as unknown as SVGPathElement;
      const ink = document.getElementById("lineInk") as unknown as SVGPathElement;

      // ---- revolver-style click: soft synth tick + haptic on each step change ----
      let ac: AudioContext | null = null;
      const armAudio = () => {
        if (!ac) { const AC = (window.AudioContext || (window as any).webkitAudioContext); if (AC) ac = new AC(); }
        if (ac && ac.state === "suspended") ac.resume();
      };
      ["wheel", "keydown", "pointerdown", "touchstart"].forEach((e) =>
        addEventListener(e, armAudio, { once: false, passive: true }));
      const clickSound = () => {
        if (!ac) return;
        const t = ac.currentTime;
        // low body — a rounded wooden "tock"
        const o = ac.createOscillator(), g = ac.createGain();
        o.type = "triangle";
        o.frequency.setValueAtTime(230, t);
        o.frequency.exponentialRampToValueAtTime(120, t + 0.06);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.16, t + 0.005);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.13);
        o.connect(g).connect(ac.destination); o.start(t); o.stop(t + 0.14);
        // tiny high transient — the mechanical "tick"
        const o2 = ac.createOscillator(), g2 = ac.createGain();
        o2.type = "square"; o2.frequency.value = 1300;
        g2.gain.setValueAtTime(0.05, t); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.03);
        o2.connect(g2).connect(ac.destination); o2.start(t); o2.stop(t + 0.04);
      };
      const detent = (dot: HTMLElement) => {
        clickSound();
        if (navigator.vibrate) navigator.vibrate(12);
        dot.classList.remove("ping"); void dot.offsetWidth; dot.classList.add("ping");
      };

      // sample the real circle arc between two angles -> smooth path
      const arc = (aFrom: number, aTo: number, cy: number) => {
        const n = 48; let d = "";
        for (let k = 0; k <= n; k++) {
          const a = aFrom + (aTo - aFrom) * (k / n);
          const x = CX + R * Math.cos(a), y = cy + R * Math.sin(a);
          d += (k ? " L " : "M ") + x.toFixed(1) + " " + y.toFixed(1);
        }
        return d;
      };

      let sp = 0;             // smoothed progress (eased)
      let lastActive = 0;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const frame = () => {
        const r = process.getBoundingClientRect();
        const total = process.offsetHeight - innerHeight;
        const target = Math.min(1, Math.max(0, -r.top / total)) * (N - 1); // 0..4
        sp += (target - sp) * (reduce ? 1 : 0.18);                          // ease
        if (Math.abs(target - sp) < 0.001) sp = target;

        const cy = innerHeight / 2;
        const active = Math.round(sp);

        // dots on the arc
        dots.forEach((dot, i) => {
          const a = (sp - i) * STEP;                 // i<sp (passed) -> a>0 -> below
          const x = CX + R * Math.cos(a);
          const y = cy + R * Math.sin(a);
          const near = Math.min(1, Math.abs(sp - i));
          const size = 78 - near * 20;               // active biggest
          dot.style.left = x + "px";
          dot.style.top = y + "px";
          dot.style.width = size + "px";
          dot.style.height = size + "px";
          dot.style.fontSize = (size * 0.34).toFixed(1) + "px";
          dot.classList.toggle("on", i === active);
        });

        // connector — one continuous arc, running off both edges
        const aTop = Math.asin(Math.max(-1, Math.min(1, (-80 - cy) / R)));            // above 05
        const aBot = Math.asin(Math.max(-1, Math.min(1, (innerHeight + 80 - cy) / R))); // below 01
        const aActive = (sp - active) * STEP;
        grey.setAttribute("d", arc(aTop, aBot, cy));   // full faint arc
        ink.setAttribute("d", arc(aActive, aBot, cy));  // black from active down past 01

        // crossfade content + detent click on step change
        if (active !== lastActive) {
          lastActive = active;
          phasesEls.forEach((el, i) => el.classList.toggle("show", i === active));
          detent(dots[active]);
        }

        requestAnimationFrame(frame);
      };
      phasesEls[0].classList.add("show");
      requestAnimationFrame(frame);
    </script>
  </body>
</html>

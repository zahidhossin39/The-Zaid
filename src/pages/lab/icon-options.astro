---
// Icon options contact sheet — pick one per service. Throwaway.
// Each icon is literal + labelled so intent is obvious at a glance.
const S = (id: string, accent: string) => `<defs>
  <linearGradient id="g${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="${accent}22"/></linearGradient>
  <filter id="s${id}" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="${accent}" flood-opacity="0.28"/></filter>
</defs>`;
const INK = "#171512";

const icons = {
  // ---------- APPS (blue) ----------
  "A1 · App window": `<svg viewBox="0 0 120 120" fill="none">${S("a1", "#2f74ff")}
    <g filter="url(#sa1)">
      <rect x="18" y="24" width="84" height="72" rx="12" fill="url(#ga1)" stroke="${INK}" stroke-width="5"/>
      <path d="M18 42h84" stroke="${INK}" stroke-width="5"/>
      <circle cx="30" cy="33" r="3" fill="#2f74ff"/><circle cx="42" cy="33" r="3" fill="#2f74ff"/>
      <rect x="32" y="54" width="56" height="8" rx="4" fill="#2f74ff"/>
      <rect x="32" y="70" width="40" height="8" rx="4" fill="#9dc2ff"/>
    </g></svg>`,
  "A2 · Mobile app": `<svg viewBox="0 0 120 120" fill="none">${S("a2", "#2f74ff")}
    <g filter="url(#sa2)">
      <rect x="36" y="16" width="48" height="88" rx="12" fill="url(#ga2)" stroke="${INK}" stroke-width="5"/>
      <rect x="46" y="30" width="12" height="12" rx="3" fill="#2f74ff"/><rect x="62" y="30" width="12" height="12" rx="3" fill="#9dc2ff"/>
      <rect x="46" y="48" width="12" height="12" rx="3" fill="#9dc2ff"/><rect x="62" y="48" width="12" height="12" rx="3" fill="#2f74ff"/>
      <rect x="50" y="90" width="20" height="5" rx="2.5" fill="#9dc2ff"/>
    </g></svg>`,
  "A3 · Dashboard": `<svg viewBox="0 0 120 120" fill="none">${S("a3", "#2f74ff")}
    <g filter="url(#sa3)">
      <rect x="16" y="26" width="88" height="68" rx="12" fill="url(#ga3)" stroke="${INK}" stroke-width="5"/>
      <rect x="28" y="66" width="10" height="18" rx="2" fill="#9dc2ff"/><rect x="44" y="54" width="10" height="30" rx="2" fill="#2f74ff"/>
      <rect x="60" y="60" width="10" height="24" rx="2" fill="#9dc2ff"/><rect x="76" y="46" width="10" height="38" rx="2" fill="#2f74ff"/>
      <rect x="28" y="38" width="34" height="7" rx="3.5" fill="#2f74ff"/>
    </g></svg>`,

  // ---------- AUTOMATIONS (green) ----------
  "B1 · Gears": `<svg viewBox="0 0 120 120" fill="none">${S("b1", "#12a56f")}
    <g filter="url(#sb1)">
      <path d="M48 30l4-9h8l4 9 9 4 9-4 5 7-5 8 4 9-4 9 5 8-5 7-9-4-9 4-4 9h-8l-4-9" fill="none"/>
      <circle cx="46" cy="52" r="20" fill="url(#gb1)" stroke="${INK}" stroke-width="5"/>
      <g stroke="${INK}" stroke-width="5" stroke-linecap="round"><path d="M46 26v-8M46 86v-8M20 52h-8M80 52h-8M28 34l-6-6M70 76l-6-6M64 34l6-6M28 70l-6 6"/></g>
      <circle cx="46" cy="52" r="7" fill="#12a56f"/>
      <circle cx="82" cy="82" r="13" fill="url(#gb1)" stroke="${INK}" stroke-width="5"/>
      <circle cx="82" cy="82" r="4.5" fill="#12a56f"/>
    </g></svg>`,
  "B2 · Auto loop": `<svg viewBox="0 0 120 120" fill="none">${S("b2", "#12a56f")}
    <g filter="url(#sb2)">
      <path d="M88 44a34 34 0 1 0 6 30" fill="none" stroke="url(#gb2)" stroke-width="0"/>
      <path d="M90 40a36 36 0 1 0 8 34" fill="none" stroke="${INK}" stroke-width="7" stroke-linecap="round"/>
      <path d="M74 30l18 6-6 18z" fill="${INK}"/>
      <path d="M55 44l14 16h-9l0 16-14-16h9z" fill="#12a56f" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>
    </g></svg>`,
  "B3 · Workflow": `<svg viewBox="0 0 120 120" fill="none">${S("b3", "#12a56f")}
    <g filter="url(#sb3)">
      <circle cx="30" cy="34" r="14" fill="url(#gb3)" stroke="${INK}" stroke-width="5"/>
      <rect x="70" y="20" width="30" height="28" rx="7" fill="url(#gb3)" stroke="${INK}" stroke-width="5"/>
      <circle cx="60" cy="90" r="14" fill="#12a56f" stroke="${INK}" stroke-width="5"/>
      <path d="M44 34h20M85 50v14a10 10 0 0 1-10 10H72M30 48v16a10 10 0 0 0 10 10h6" stroke="${INK}" stroke-width="4.5" stroke-linecap="round" fill="none"/>
      <path d="M46 30l-4 4 4 4M69 70l4 4-4 4" stroke="${INK}" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </g></svg>`,

  // ---------- WEBSITES (purple) ----------
  "C1 · Browser": `<svg viewBox="0 0 120 120" fill="none">${S("c1", "#6d3cff")}
    <g filter="url(#sc1)">
      <rect x="14" y="24" width="92" height="72" rx="12" fill="url(#gc1)" stroke="${INK}" stroke-width="5"/>
      <path d="M14 42h92" stroke="${INK}" stroke-width="5"/>
      <circle cx="26" cy="33" r="3" fill="#6d3cff"/><circle cx="37" cy="33" r="3" fill="#6d3cff"/>
      <rect x="48" y="30" width="46" height="6" rx="3" fill="#c9b8ff"/>
      <rect x="24" y="52" width="72" height="16" rx="4" fill="#6d3cff"/>
      <rect x="24" y="74" width="30" height="12" rx="3" fill="#c9b8ff"/><rect x="60" y="74" width="36" height="12" rx="3" fill="#c9b8ff"/>
    </g></svg>`,
  "C2 · Globe": `<svg viewBox="0 0 120 120" fill="none">${S("c2", "#6d3cff")}
    <g filter="url(#sc2)">
      <circle cx="58" cy="56" r="34" fill="url(#gc2)" stroke="${INK}" stroke-width="5"/>
      <path d="M24 56h68M58 22v68M35 34c14 12 32 12 46 0M35 78c14-12 32-12 46 0" stroke="${INK}" stroke-width="3.5" fill="none"/>
      <ellipse cx="58" cy="56" rx="14" ry="34" stroke="${INK}" stroke-width="3.5" fill="none"/>
      <path d="M84 78c0 9-13 22-13 22s-13-13-13-22a13 13 0 0 1 26 0z" fill="#6d3cff" stroke="${INK}" stroke-width="5" stroke-linejoin="round"/>
      <circle cx="71" cy="78" r="5" fill="#fff"/>
    </g></svg>`,
  "C3 · Responsive": `<svg viewBox="0 0 120 120" fill="none">${S("c3", "#6d3cff")}
    <g filter="url(#sc3)">
      <rect x="14" y="28" width="72" height="54" rx="9" fill="url(#gc3)" stroke="${INK}" stroke-width="5"/>
      <path d="M40 82v8H60" stroke="${INK}" stroke-width="5" fill="none"/>
      <rect x="24" y="38" width="52" height="8" rx="4" fill="#6d3cff"/><rect x="24" y="52" width="34" height="7" rx="3.5" fill="#c9b8ff"/>
      <rect x="74" y="60" width="34" height="46" rx="8" fill="url(#gc3)" stroke="${INK}" stroke-width="5"/>
      <rect x="82" y="70" width="18" height="6" rx="3" fill="#6d3cff"/><rect x="82" y="82" width="18" height="6" rx="3" fill="#c9b8ff"/>
    </g></svg>`,
};
const groups = [
  ["Apps", ["A1 · App window", "A2 · Mobile app", "A3 · Dashboard"]],
  ["Automations", ["B1 · Gears", "B2 · Auto loop", "B3 · Workflow"]],
  ["Websites", ["C1 · Browser", "C2 · Globe", "C3 · Responsive"]],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Icon options</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <style>
      *{box-sizing:border-box} body{margin:0;background:#faf8f4;color:#171512;font-family:Inter,sans-serif;padding:3rem}
      h1{font-size:1.3rem;margin:0 0 2rem}
      h2{font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:#8a857c;margin:2.5rem 0 1rem}
      .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
      .cell{background:linear-gradient(150deg,#ffffff,#f0ece3);border:1px solid rgba(0,0,0,.05);border-radius:16px;
            padding:1.5rem;display:flex;flex-direction:column;align-items:center;gap:1rem;box-shadow:0 12px 30px rgba(30,25,15,.06)}
      .cell :global(svg){width:140px;height:140px}
      .lbl{font-size:.85rem;font-weight:600;color:#57534c}
    </style>
  </head>
  <body>
    <h1>Icon options — pick one per service (e.g. "A1, B2, C1")</h1>
    {groups.map(([name, keys]) => (
      <section>
        <h2>{name}</h2>
        <div class="grid">
          {keys.map((k) => (
            <div class="cell">
              <div set:html={icons[k]}></div>
              <span class="lbl">{k}</span>
            </div>
          ))}
        </div>
      </section>
    ))}
  </body>
</html>

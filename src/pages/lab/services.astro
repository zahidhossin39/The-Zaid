---
// PROTOTYPE — Services section, 3 variants. Throwaway. Switch with ?v=A|B|C.
// Inspired by scrollservices.framer.website (sticky-stacked phase cards),
// reworked three structurally different ways. Content = real services.
const services = [
  {
    n: "01",
    kicker: "AI Automation",
    title: ["Automate the", "busywork"],
    body: "The repetitive two hours a week that never needed a human. I wire up the tools you already use so the work just happens.",
    tags: ["Workflows", "Integrations", "Agents"],
    glyph: "M4 7h16M4 12h10M4 17h7",
  },
  {
    n: "02",
    kicker: "Web Development",
    title: ["Ship the", "site"],
    body: "Fast, modern, hand-built sites and web apps. No page-builder bloat — real code you own, handed over working.",
    tags: ["Astro", "React", "Design"],
    glyph: "M3 5h18v14H3zM3 9h18",
  },
  {
    n: "03",
    kicker: "App Building",
    title: ["Build the", "thing"],
    body: "The app you keep describing out loud. Scoped tight, built in the open, in your hands in weeks not quarters.",
    tags: ["Product", "Frontend", "Backend"],
    glyph: "M7 3h10v18H7zM10 18h4",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Variant chosen client-side; a static route can't read ?v= at build.
      document.documentElement.dataset.v = (new URLSearchParams(location.search).get("v") || "A").toUpperCase();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Services prototypes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter+Tight:wght@400;500;600&display=swap"
    />
    <style define:vars={{}}>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --bg: #0d0d0f;
        --panel: #f4f1ea;
        --ink: #16150f;
        --muted: #6c675c;
        --line: rgba(20,19,15,.14);
        --accent: #c8502a;
        --serif: "Fraunces", Georgia, serif;
        --sans: "Inter Tight", system-ui, sans-serif;
      }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--panel); font-family: var(--sans); }
      a { color: inherit; }

      /* ---- shared intro + outro ---- */
      .intro, .outro {
        min-height: 100svh; display: grid; place-items: center; text-align: center;
        padding: 4rem 1.5rem;
      }
      .intro .kick, .outro .kick {
        font-size: .8rem; letter-spacing: .22em; text-transform: uppercase;
        color: #8d8578; margin: 0 0 1.2rem;
      }
      .intro h1, .outro h1 {
        font-family: var(--serif); font-weight: 300; letter-spacing: -.02em;
        font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1.02; margin: 0; max-width: 16ch;
      }
      .arrow { margin-top: 2.5rem; opacity: .5; animation: bob 1.8s ease-in-out infinite; }
      @keyframes bob { 50% { transform: translateY(8px); } }
      .outro .btn {
        margin-top: 2rem; display: inline-block; font-family: var(--sans); font-weight: 500;
        background: var(--panel); color: var(--ink); padding: .95rem 1.9rem; border-radius: 999px;
        text-decoration: none;
      }

      /* variant visibility — one shown at a time via :root[data-v] */
      .A-stack, .A-rail, .B-pin, .C-wrap { display: none; }
      :root[data-v="A"] .A-stack { display: block; }
      :root[data-v="A"] .A-rail { display: flex; }
      :root[data-v="B"] .B-pin { display: block; }
      :root[data-v="C"] .C-wrap { display: grid; }

      /* ============ VARIANT A — sticky stack ============ */
      .A-stack { position: relative; }
      .A-card {
        position: sticky; top: 0; min-height: 100svh; background: var(--panel); color: var(--ink);
        border-top: 1px solid var(--line); overflow: hidden;
        display: grid; grid-template-columns: 1fr 1fr; align-items: center;
        gap: 2rem; padding: clamp(2rem,6vw,6rem);
      }
      .A-card .idx {
        position: absolute; top: 1.4rem; left: clamp(1.5rem,5vw,4rem);
        font-family: var(--serif); font-size: 1rem; color: var(--muted);
      }
      .A-copy { max-width: 34ch; }
      .A-copy .kick {
        margin: 0 0 1rem; font-size: .78rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent);
      }
      .A-copy h2 {
        font-family: var(--serif); font-weight: 300; letter-spacing: -.02em;
        font-size: clamp(2.6rem, 6vw, 5rem); line-height: .96; margin: 0 0 1.4rem;
      }
      .A-copy p { color: var(--muted); font-size: 1.075rem; line-height: 1.65; margin: 0 0 1.8rem; }
      .A-tags { display: flex; flex-wrap: wrap; gap: .55rem; }
      .A-tags span {
        font-size: .82rem; padding: .4rem .85rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink);
      }
      .A-art { display: grid; place-items: center; }
      .A-blob {
        width: min(30vw, 22rem); aspect-ratio: 1; border-radius: 42% 58% 55% 45% / 48% 42% 58% 52%;
        background: radial-gradient(120% 120% at 32% 26%, #fff, #d9d2c4 62%, #c3bbaa);
        box-shadow: inset -18px -22px 48px rgba(120,110,92,.35), 26px 30px 60px rgba(80,70,55,.18);
        display: grid; place-items: center;
        transform: translateY(var(--art-shift, 0));
      }
      .A-blob svg { width: 42%; height: 42%; stroke: #8b8271; stroke-width: 1.4; fill: none; stroke-linecap: round; opacity: .8; }
      /* fixed progress rail */
      .A-rail { position: fixed; top: 50%; right: 1.1rem; transform: translateY(-50%); display: none;
                flex-direction: column; gap: .7rem; z-index: 20; mix-blend-mode: difference; }
      .A-rail b { width: 8px; height: 8px; border-radius: 999px; background: #fff; opacity: .35; transition: opacity .3s, transform .3s; }
      .A-rail b.on { opacity: 1; transform: scale(1.5); }
      @media (max-width: 760px) {
        .A-card { grid-template-columns: 1fr; text-align: left; }
        .A-art { order: -1; }
      }

      /* ============ VARIANT B — horizontal pin ============ */
      .B-pin { position: relative; height: 320vh; }
      .B-sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--panel); color: var(--ink); }
      .B-head { position: absolute; top: clamp(1.5rem,5vw,3rem); left: clamp(1.5rem,5vw,4rem); z-index: 3; }
      .B-head .kick { font-size: .78rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin: 0; }
      .B-head h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(1.8rem,4vw,2.8rem); margin: .4rem 0 0; }
      .B-bar { position: absolute; left: clamp(1.5rem,5vw,4rem); right: clamp(1.5rem,5vw,4rem); bottom: 2.4rem; height: 3px; background: var(--line); z-index: 3; }
      .B-bar i { display: block; height: 100%; width: 0; background: var(--accent); }
      .B-track { display: flex; height: 100%; align-items: center; gap: clamp(1.5rem,4vw,3rem); padding-inline: clamp(1.5rem,5vw,4rem); will-change: transform; }
      .B-slide { flex: 0 0 auto; width: min(74vw, 34rem); height: 62vh; border-radius: 20px; background: #fff;
                 border: 1px solid var(--line); box-shadow: 0 30px 60px rgba(80,70,55,.12);
                 padding: clamp(1.6rem,3vw,2.6rem); display: flex; flex-direction: column; justify-content: space-between;
                 transition: transform .4s; }
      .B-slide .num { font-family: var(--serif); font-size: 3.4rem; font-weight: 300; color: var(--accent); line-height: 1; }
      .B-slide h3 { font-family: var(--serif); font-weight: 300; font-size: clamp(2rem,4vw,3rem); margin: .6rem 0 0; line-height: .98; }
      .B-slide p { color: var(--muted); font-size: 1.02rem; line-height: 1.6; margin: 1rem 0 0; max-width: 32ch; }
      .B-slide .B-tags { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: auto; }
      .B-slide .B-tags span { font-size: .8rem; padding: .38rem .8rem; border: 1px solid var(--line); border-radius: 999px; }

      /* ============ VARIANT C — split scrolly ============ */
      .C-wrap { grid-template-columns: 1fr 1fr; background: var(--panel); color: var(--ink); }
      .C-left { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; border-right: 1px solid var(--line); overflow: hidden; }
      .C-stage { position: relative; width: 100%; height: 40vh; }
      .C-num { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--serif);
               font-weight: 300; font-size: clamp(7rem, 20vw, 16rem); color: var(--accent); line-height: 1;
               opacity: 0; transform: translateY(28px);
               transition: opacity .45s ease, transform .55s cubic-bezier(.22,.61,.36,1); }
      .C-num.on { opacity: 1; transform: translateY(0); }
      .C-right { padding: 0 clamp(1.5rem,5vw,5rem); }
      .C-step { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; max-width: 40ch; }
      .C-step .kick { font-size: .78rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin: 0 0 1rem; }
      .C-step h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(2.4rem,5vw,4rem); line-height: .98; margin: 0 0 1.3rem; letter-spacing: -.02em; }
      .C-step p { color: var(--muted); font-size: 1.08rem; line-height: 1.65; margin: 0 0 1.6rem; }
      .C-step .C-tags { display: flex; gap: .55rem; flex-wrap: wrap; }
      .C-step .C-tags span { font-size: .82rem; padding: .4rem .85rem; border: 1px solid var(--line); border-radius: 999px; }
      @media (max-width: 760px) {
        .C-wrap { grid-template-columns: 1fr; }
        .C-left { display: none; }
      }

      /* ---- floating variant switcher (prototype only) ---- */
      .switch {
        position: fixed; bottom: 1.1rem; left: 50%; transform: translateX(-50%); z-index: 50;
        display: flex; align-items: center; gap: .3rem; background: #111; color: #fff;
        border: 1px solid #2a2a2a; border-radius: 999px; padding: .35rem .5rem; font: 500 .85rem var(--sans);
        box-shadow: 0 8px 30px rgba(0,0,0,.4);
      }
      .switch button { background: none; border: 0; color: #fff; cursor: pointer; font-size: 1rem; padding: .3rem .55rem; border-radius: 999px; }
      .switch button:hover { background: #2a2a2a; }
      .switch .lab { padding: 0 .5rem; white-space: nowrap; }
      .switch .lab b { color: var(--accent); }
    </style>
  </head>

  <body>
    <!-- intro -->
    <section class="intro">
      <div>
        <p class="kick">What I do</p>
        <h1>Three ways I turn a stuck idea into a shipped thing</h1>
        <div class="arrow">↓</div>
      </div>
    </section>

    <!-- VARIANT A -->
    <div class="A-stack">
        {services.map((s) => (
          <section class="A-card" data-idx={s.n}>
            <span class="idx">{s.n} — {s.kicker}</span>
            <div class="A-copy">
              <p class="kick">{s.kicker}</p>
              <h2>{s.title[0]}<br />{s.title[1]}</h2>
              <p>{s.body}</p>
              <div class="A-tags">{s.tags.map((t) => <span>{t}</span>)}</div>
            </div>
            <div class="A-art">
              <div class="A-blob"><svg viewBox="0 0 24 24"><path d={s.glyph} /></svg></div>
            </div>
          </section>
        ))}
      </div>
    <div class="A-rail">{services.map(() => <b></b>)}</div>

    <!-- VARIANT B -->
    <div class="B-pin">
        <div class="B-sticky">
          <div class="B-head"><p class="kick">Services</p><h2>Scroll to move →</h2></div>
          <div class="B-track">
            {services.map((s) => (
              <article class="B-slide">
                <div class="num">{s.n}</div>
                <h3>{s.kicker}</h3>
                <p>{s.body}</p>
                <div class="B-tags">{s.tags.map((t) => <span>{t}</span>)}</div>
              </article>
            ))}
          </div>
          <div class="B-bar"><i></i></div>
        </div>
      </div>

    <!-- VARIANT C -->
    <div class="C-wrap">
        <div class="C-left">
          <div class="C-stage">
            {services.map((s, i) => <div class={"C-num" + (i === 0 ? " on" : "")} data-i={i}>{s.n}</div>)}
          </div>
        </div>
        <div class="C-right">
          {services.map((s, i) => (
            <section class="C-step" data-i={i}>
              <p class="kick">{s.n} · {s.kicker}</p>
              <h2>{s.title[0]} {s.title[1]}</h2>
              <p>{s.body}</p>
              <div class="C-tags">{s.tags.map((t) => <span>{t}</span>)}</div>
            </section>
          ))}
        </div>
      </div>

    <!-- outro -->
    <section class="outro">
      <div>
        <p class="kick">Ready when you are</p>
        <h1>Let's build the next one together</h1>
        <a class="btn" href="#">Book a 20-minute call</a>
      </div>
    </section>

    <!-- switcher -->
    <div class="switch">
      <button id="prev" aria-label="Previous variant">←</button>
      <span class="lab" id="lab"></span>
      <button id="next" aria-label="Next variant">→</button>
    </div>

    <script>
      const names: Record<string, string> = { A: "Sticky Stack", B: "Horizontal Pin", C: "Split Scrolly" };
      const keys = ["A", "B", "C"];
      const cur = (document.documentElement.dataset.v || "A").toUpperCase();
      document.getElementById("lab")!.innerHTML = `<b>${cur}</b> · ${names[cur]}`;
      const go = (dir: number) => {
        const i = (keys.indexOf(cur) + dir + keys.length) % keys.length;
        const u = new URL(location.href); u.searchParams.set("v", keys[i]); location.href = u.toString();
      };
      document.getElementById("prev")!.onclick = () => go(-1);
      document.getElementById("next")!.onclick = () => go(1);
      addEventListener("keydown", (e) => {
        const t = e.target as HTMLElement;
        if (["INPUT", "TEXTAREA"].includes(t.tagName) || t.isContentEditable) return;
        if (e.key === "ArrowLeft") go(-1);
        if (e.key === "ArrowRight") go(1);
      });

      // Variant A: progress rail active dot + icon parallax within each card
      if (cur === "A") {
        const cards = [...document.querySelectorAll<HTMLElement>(".A-card")];
        const dots = [...document.querySelectorAll<HTMLElement>(".A-rail b")];
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              const i = cards.indexOf(e.target as HTMLElement);
              dots.forEach((d, di) => d.classList.toggle("on", di === i));
            }
          });
        }, { threshold: 0.55 });
        cards.forEach((c) => io.observe(c));
        const onScroll = () => {
          for (const c of cards) {
            const r = c.getBoundingClientRect();
            const blob = c.querySelector<HTMLElement>(".A-blob");
            if (blob) {
              const p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight; // -0.5..0.5
              blob.style.setProperty("--art-shift", `${(-p * 60).toFixed(1)}px`);
            }
          }
          requestAnimationFrame(onScroll);
        };
        requestAnimationFrame(onScroll);
      }

      // Variant B: map vertical scroll of the tall .B-pin to horizontal track travel
      if (cur === "B") {
        const pin = document.querySelector<HTMLElement>(".B-pin")!;
        const track = document.querySelector<HTMLElement>(".B-track")!;
        const bar = document.querySelector<HTMLElement>(".B-bar i")!;
        const tick = () => {
          const r = pin.getBoundingClientRect();
          const total = pin.offsetHeight - innerHeight;
          const p = Math.min(1, Math.max(0, -r.top / total));
          const travel = track.scrollWidth - innerWidth;
          track.style.transform = `translateX(${-p * travel}px)`;
          bar.style.width = (p * 100).toFixed(1) + "%";
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // Variant C: swap the big sticky number to whichever step is nearest
      // the viewport centre. rAF, same reliable pattern as A/B.
      if (cur === "C") {
        const steps = [...document.querySelectorAll<HTMLElement>(".C-step")];
        const nums = [...document.querySelectorAll<HTMLElement>(".C-num")];
        let last = -1;
        const tick = () => {
          const mid = innerHeight / 2;
          let best = 0, bestD = Infinity;
          steps.forEach((s, i) => {
            const r = s.getBoundingClientRect();
            const d = Math.abs(r.top + r.height / 2 - mid);
            if (d < bestD) { bestD = d; best = i; }
          });
          if (best !== last) {
            const dir = best > last ? 1 : -1; // scrolling down = +1
            nums.forEach((n, ni) => {
              if (ni === best) {
                // incoming number enters from the direction of travel
                n.style.transform = `translateY(${dir * 34}px)`;
                n.classList.add("on");
                requestAnimationFrame(() => { n.style.transform = ""; });
              } else if (n.classList.contains("on")) {
                // outgoing number exits the opposite way
                n.classList.remove("on");
                n.style.transform = `translateY(${-dir * 34}px)`;
              }
            });
            last = best;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>

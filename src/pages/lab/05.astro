---
// Lab prototype 05 — Warm Stage, Cold Light. Standalone by design; see LAB-SPEC.md.
// Brown-black neutrals against a cold azure accent: warm room, cold instrument.
// Accent roles: the vertical rule and the button. Nothing else.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>05 · Warm Stage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&display=swap"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #151210; color: #F6F2ED; font-family: Inter, system-ui, sans-serif; }
      a { text-decoration: none; }
      .lbl { position: fixed; top: 1rem; left: 1rem; font: 600 11px ui-monospace, monospace;
             letter-spacing: .1em; padding: .35rem .6rem; border-radius: 4px; z-index: 9;
             background: #4CC2FF; color: #151210; }

      .hero { min-height: 100vh; display: flex; align-items: center;
              padding: 6rem 3.5rem; max-width: 70rem; margin: 0 auto; }
      .bar { width: 3px; align-self: stretch; margin: 4rem 3.5rem 4rem 0;
             background: linear-gradient(to bottom, #4CC2FF, #4CC2FF 22%, #2F2823 22%); }
      .body-col { flex: 1; }
      .eyb { font: 400 .8125rem ui-monospace, Menlo, monospace; letter-spacing: .14em;
             text-transform: uppercase; color: #A79C92; margin: 0; }
      h1 { font-family: "Instrument Serif", Georgia, serif; font-weight: 400;
           font-size: clamp(3rem, 7vw, 5rem); line-height: 1.02; letter-spacing: -.02em;
           margin: 2rem 0 0; max-width: 16ch; text-wrap: pretty; }
      h1 em { font-style: italic; }
      .sub { color: #A79C92; font-size: 1.125rem; line-height: 1.7; margin: 1.75rem 0 0; max-width: 44ch; }
      .row { margin-top: 3rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
      .btn { background: #4CC2FF; color: #151210; border-radius: 4px;
             padding: .9rem 1.85rem; font-weight: 500; }
      .ghost { color: #A79C92; }
      .meta { margin-top: 4.5rem; display: flex; gap: 3rem; font-size: .875rem; color: #A79C92;
              border-top: 1px solid #2F2823; padding-top: 1.5rem; }
      .meta b { color: #F6F2ED; font-weight: 500; display: block; margin-top: .35rem; }
    </style>
  </head>
  <body>
    <div class="lbl">05 · Warm Stage</div>

    <section class="hero" data-shot="hero">
      <div class="bar"></div>
      <div class="body-col">
        <p class="eyb">Zaid Hossain — builder for hire</p>
        <h1>You've had the idea <em>long enough.</em></h1>
        <p class="sub">
          I build the app, site, or automation you've been circling for months.
          Scoped tight, built in the open, handed over working.
        </p>
        <div class="row">
          <a class="btn" href="#">Book a 20-minute call</a>
          <a class="ghost" href="#">See the work ↓</a>
        </div>
        <div class="meta">
          <div>Typical build<b>2–5 weeks</b></div>
          <div>You keep<b>the code + accounts</b></div>
          <div>Retainer<b>not required</b></div>
        </div>
      </div>
    </section>
  </body>
</html>

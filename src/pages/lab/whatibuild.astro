---
// PROTOTYPE — "What I build" as an expand-on-hover list.
// Inspired by expand-on-hover-list.framer.website: grey collapsed rows, hover
// expands one row (text -> black, one-line description + an image card fades+
// scales in). Content = Zaid's three offerings. Images = warm clay renders.
const items = [
  { n: "01", title: "Apps", sub: "The internal tool or client portal you've been faking with a spreadsheet — built small, built to get used.", img: "/clay-apps.jpg" },
  { n: "02", title: "Automations", sub: "The copy-paste between two systems, the report you rebuild every Monday — it runs without you now.", img: "/clay-auto.webp" },
  { n: "03", title: "Websites", sub: "Not a brochure. A site with one clear job to do, and the plumbing behind it to make it happen.", img: "/clay-web.webp" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>What I build — expand on hover</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=PT+Sans+Narrow:wght@400;700&family=Inter:wght@400;500&display=swap" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      :root { --ink:#111111; --grey:#c3c0b9; --line:#e6e4e0; --card:#f2efe8;
              --narrow:"PT Sans Narrow", system-ui, sans-serif; --sans:"Inter", system-ui, sans-serif; }
      body { margin:0; background:#fff; color:var(--ink); font-family:var(--sans);
             min-height:100svh; display:grid; place-items:center; padding:5rem 1.5rem; }

      .wrap { width:100%; max-width:64rem; }
      .eyebrow { font:500 .82rem var(--sans); letter-spacing:.18em; text-transform:uppercase; color:#9a968d; margin:0 0 1rem; }
      .lead { font-family:var(--narrow); font-weight:700; font-size:clamp(2.2rem,4.4vw,3.4rem);
              letter-spacing:-.01em; line-height:1.02; margin:0 0 2.5rem; }

      .list { border-bottom:1px solid var(--line); }
      .row { position:relative; display:grid; grid-template-columns:5rem minmax(0,1fr) 3.4rem; align-items:start; column-gap:2rem;
             min-height:6.8rem; padding:2.2rem 0; border-top:1px solid var(--line);
             text-decoration:none; color:inherit; cursor:pointer;
             transition:min-height .55s cubic-bezier(.22,.61,.36,1); }
      .row:hover { min-height:16rem; }

      .num { font-family:var(--narrow); font-weight:700; font-size:2.5rem; line-height:1; color:var(--grey); transition:color .4s ease; }
      .title { font-family:var(--narrow); font-weight:700; font-size:clamp(1.6rem,2.6vw,2rem); line-height:1; letter-spacing:.01em;
               text-transform:uppercase; color:var(--grey); margin:0; transition:color .4s ease; }
      .sub { font:400 1rem/1.5 var(--sans); color:#6a675f; opacity:0; margin-top:0; max-width:34ch;
             max-height:0; overflow:hidden;
             transition:opacity .45s ease .05s, margin-top .5s ease, max-height .55s ease; }

      /* image card — reveals by rotating into place, settling at -5deg (matches reference) */
      .media { position:absolute; right:7rem; top:50%; opacity:0; pointer-events:none;
               transform:translateY(-50%) rotate(-20deg) scale(.8); transform-origin:center;
               transition:opacity .45s ease, transform .55s cubic-bezier(.22,1,.36,1); }
      .card { display:block; width:clamp(300px,27vw,380px); aspect-ratio:1.792; border-radius:16px; overflow:hidden;
              background:#f2efe8; border:3px solid #e6e6e6;
              box-shadow:0 0 4px rgba(0,0,0,.12); }
      .card img { width:100%; height:100%; object-fit:cover; display:block; }

      .arrow-wrap { display:flex; justify-content:flex-end; }
      .arrow { width:3rem; height:3rem; border-radius:999px; background:var(--ink); color:#fff; display:grid; place-items:center;
               transition:transform .4s ease; }
      .arrow svg { width:1.1rem; height:1.1rem; }

      /* hover expand */
      .row:hover .num, .row:hover .title { color:var(--ink); }
      .row:hover .sub { opacity:1; margin-top:.9rem; max-height:6rem; }
      .row:hover .media { opacity:1; transform:translateY(-50%) rotate(-5deg) scale(1); }
      .row:hover .arrow { transform:translateX(4px); }

      @media (max-width:720px) {
        .row { grid-template-columns:3rem 1fr 2.6rem; }
        .media { display:none; }
        .num { font-size:1.8rem; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="eyebrow">What I build</p>
      <h2 class="lead">It's usually one of three things.</h2>

      <div class="list">
        {items.map((it) => (
          <a class="row" href="#">
            <span class="num">{it.n}</span>
            <span class="main">
              <h3 class="title">{it.title}</h3>
              <p class="sub">{it.sub}</p>
            </span>
            <span class="media"><span class="card"><img src={it.img} alt={it.title} /></span></span>
            <span class="arrow-wrap">
              <span class="arrow">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>

---
// Lab 06 · Oxblood — editorial menace: bottom-anchored oversized Newsreader, hairline rule, meta row split sub-left / actions-right.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>06 · Oxblood</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Inter:wght@400;500;600&display=swap" />
    <style>
      :root { --bg:#141110; --surface:#1D1917; --border:#2E2824; --text:#F6F1EC; --muted:#ADA29A; --accent:#FF4D4D; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); font-family: Inter, system-ui, sans-serif; }
      .tag { position: fixed; top: 1rem; left: 1rem; font: 600 11px ui-monospace, monospace; letter-spacing: .1em; padding: .35rem .6rem; border-radius: 4px; z-index: 9; background: var(--accent); color: var(--bg); }
      .hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: flex-end; padding: 6rem 4rem 3.5rem; }
      .eyebrow { display: flex; align-items: center; gap: .75rem; margin: 0; font-size: .8125rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .eyebrow::before { content: ""; width: 2rem; height: 2px; background: var(--accent); }
      h1 { font-family: Newsreader, Georgia, serif; font-weight: 400; letter-spacing: -.02em; line-height: .98; font-size: clamp(3.5rem, 8.5vw, 7.75rem); margin: 2.25rem 0 0; max-width: 13ch; text-wrap: balance; }
      .meta { margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-end; gap: 4rem; }
      .sub { color: var(--muted); font-size: 1.1875rem; line-height: 1.6; margin: 0; max-width: 44ch; }
      .actions { display: flex; flex-direction: column; align-items: flex-end; gap: 1.25rem; flex-shrink: 0; }
      .btn { background: var(--accent); color: var(--bg); border-radius: 9999px; padding: .875rem 1.75rem; font-weight: 600; font-size: 1rem; text-decoration: none; }
      .link { color: var(--muted); text-decoration: none; font-size: .9375rem; }
      .link:hover { color: var(--text); }
    </style>
  </head>
  <body>
    <div class="tag">06 · OXBLOOD</div>
    <section class="hero" data-shot="hero">
      <p class="eyebrow">Zaid Hossain — builder for hire</p>
      <h1>You&apos;ve had the idea long enough.</h1>
      <div class="meta">
        <p class="sub">I build the app, site, or automation you&apos;ve been circling for months. Scoped tight, built in the open, handed over working.</p>
        <div class="actions">
          <a class="btn" href="#">Book a 20-minute call</a>
          <a class="link" href="#">See the work ↓</a>
        </div>
      </div>
    </section>
  </body>
</html>

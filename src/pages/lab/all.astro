---
// Dev-only contact sheet: all ten prototypes at once, via scaled iframes.
// Dev server only (iframes point at localhost). Delete after choosing.
const items = [
  ["01", "Deep Water", "8.8 / 8.6"],
  ["02", "Blueprint", "8.8 / 8.8"],
  ["03", "Midnight Ink", "9.2 / 8.8"],
  ["04", "Forest Noir", "9.0 / 9.1"],
  ["05", "Warm Stage", "9.0 / 8.8"],
  ["06", "Oxblood", "8.5 / 8.8"],
  ["07", "Aubergine Hour", "8.7 / 8.7"],
  ["08", "Acid", "8.7 / 8.6"],
  ["09", "One Note", "8.7 / 8.7"],
  ["10", "Fog", "8.7 / 8.6"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>All ten prototypes</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #08080A; color: #EDEDED;
             font: 400 14px Inter, system-ui, sans-serif; padding: 2rem; }
      h1 { font-size: 1.1rem; font-weight: 600; margin: 0 0 1.5rem; letter-spacing: -.01em; }
      .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem; }
      figure { margin: 0; }
      .frame { position: relative; width: 100%; aspect-ratio: 1440 / 820;
               overflow: hidden; border: 1px solid #2A2A2E; border-radius: 8px; }
      iframe { position: absolute; top: 0; left: 0; width: 1440px; height: 820px;
               border: 0; transform-origin: top left; }
      figcaption { display: flex; justify-content: space-between; align-items: baseline;
                   margin-top: .6rem; font-size: .8125rem; }
      .name { font-weight: 500; }
      .score { font-family: ui-monospace, monospace; color: #8A8A92; }
      .fail { color: #FF6B6B; }
    </style>
  </head>
  <body>
    <h1>Ten prototypes — colour / design, agreed by three-way scoring. All pass 8.5.</h1>
    <div class="grid">
      {items.map(([n, name, score]) => (
        <figure data-shot={n}>
          <div class="frame"><iframe src={`/lab/${n}`} loading="lazy" title={name}></iframe></div>
          <figcaption>
            <span class="name">{n} · {name}</span>
            <span class={"score" + (parseFloat(score) < 8.5 || parseFloat(score.split("/")[1]) < 8.5 ? " fail" : "")}>{score}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <script>
      // Scale each 1440px page down to whatever the tile is actually wide.
      const fit = () => {
        document.querySelectorAll<HTMLIFrameElement>("iframe").forEach((f) => {
          const w = f.parentElement!.clientWidth;
          f.style.transform = `scale(${w / 1440})`;
        });
      };
      fit();
      addEventListener("resize", fit);
    </script>
  </body>
</html>

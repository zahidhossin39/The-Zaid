---
// Lab prototype 03 — Midnight Ink. Standalone by design; see LAB-SPEC.md.
// The background IS the colour: deep navy, not black. Centred, atmospheric.
// Accent roles: the status dot and the button. Nothing else.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>03 · Midnight Ink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter:wght@400;500;600&display=swap"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #0A1020; color: #EDF1F7; font-family: Inter, system-ui, sans-serif; }
      a { text-decoration: none; }
      .lbl { position: fixed; top: 1rem; left: 1rem; font: 600 11px ui-monospace, monospace;
             letter-spacing: .1em; padding: .35rem .6rem; border-radius: 4px; z-index: 9;
             background: #38BDF8; color: #0A1020; }

      .glow { position: absolute; top: -22rem; left: 50%; transform: translateX(-50%);
              width: 58rem; height: 38rem; border-radius: 999px; background: #38BDF8;
              opacity: .11; filter: blur(150px); pointer-events: none; }
      .hero { position: relative; max-width: 52rem; margin: 0 auto; padding: 8rem 3rem;
              min-height: 100vh; display: flex; flex-direction: column;
              align-items: center; justify-content: center; text-align: center; }
      .pill { display: inline-flex; align-items: center; gap: .6rem; border: 1px solid #223050;
              background: #111A30; border-radius: 999px; padding: .45rem 1rem;
              font: 500 .75rem Inter, sans-serif; letter-spacing: .1em; text-transform: uppercase;
              color: #8FA0BD; }
      .pill i { width: .4rem; height: .4rem; border-radius: 999px; background: #38BDF8; display: block; }
      h1 { font-family: Fraunces, Georgia, serif; font-weight: 500;
           font-size: clamp(2.75rem, 6.5vw, 4.75rem); line-height: 1.05; letter-spacing: -.025em;
           margin: 2.5rem 0 0; max-width: 15ch; text-wrap: pretty; }
      .sub { color: #8FA0BD; font-size: 1.125rem; line-height: 1.7; margin: 1.75rem 0 0; max-width: 42ch; }
      .row { margin-top: 3rem; display: flex; align-items: center; gap: 1.75rem;
             justify-content: center; flex-wrap: wrap; }
      .btn { background: #38BDF8; color: #0A1020; border-radius: 999px;
             padding: .9rem 1.85rem; font-weight: 600; }
      .ghost { color: #8FA0BD; }
    </style>
  </head>
  <body>
    <div class="lbl">03 · Midnight Ink</div>

    <section class="hero" data-shot="hero">
      <div class="glow"></div>
      <span class="pill"><i></i>Zaid Hossain — builder for hire</span>
      <h1>You've had the idea long enough.</h1>
      <p class="sub">
        I build the app, site, or automation you've been circling for months.
        Scoped tight, built in the open, handed over working.
      </p>
      <div class="row">
        <a class="btn" href="#">Book a 20-minute call</a>
        <a class="ghost" href="#">See the work ↓</a>
      </div>
    </section>
  </body>
</html>

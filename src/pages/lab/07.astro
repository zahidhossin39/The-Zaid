---
// Lab 07 · Aubergine Hour — off-axis mood: vertical eyebrow rail on the left, right-aligned headline, surface panel pulled inboard.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>07 · Aubergine Hour</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" />
    <style>
      :root { --bg:#130B16; --surface:#1C1221; --border:#2E2136; --text:#F3EEF6; --muted:#A796B0; --accent:#D946EF; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); font-family: Inter, system-ui, sans-serif; }
      .tag { position: fixed; top: 1rem; left: 1rem; font: 600 11px ui-monospace, monospace; letter-spacing: .1em; padding: .35rem .6rem; border-radius: 4px; z-index: 9; background: var(--accent); color: var(--bg); }
      .hero { min-height: 100vh; display: grid; grid-template-columns: 5rem 1fr; }
      .rail { border-right: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; gap: 2rem; padding: 6.5rem 0 3rem; }
      .dot { width: .625rem; height: .625rem; border-radius: 50%; background: var(--accent); }
      .rail p { writing-mode: vertical-rl; transform: rotate(180deg); margin: 0; font-size: .8125rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
      .main { display: flex; flex-direction: column; justify-content: center; align-items: flex-end; padding: 6rem 5rem 6rem 4rem; }
      h1 { font-family: "Space Grotesk", Inter, sans-serif; font-weight: 500; letter-spacing: -.03em; line-height: 1.02; font-size: clamp(3rem, 6.5vw, 6rem); margin: 0; max-width: 15ch; text-align: right; text-wrap: balance; }
      .panel { margin-top: 3.5rem; margin-right: 10rem; max-width: 32rem; background: var(--surface); border: 1px solid var(--border); padding: 2.25rem 2.5rem; }
      .sub { color: var(--muted); font-size: 1.0625rem; line-height: 1.65; margin: 0; }
      .actions { margin-top: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
      .btn { background: var(--accent); color: var(--bg); padding: .875rem 1.5rem; font-weight: 600; font-size: .9375rem; text-decoration: none; }
      .link { color: var(--muted); text-decoration: none; font-size: .9375rem; }
      .link:hover { color: var(--text); }
    </style>
  </head>
  <body>
    <div class="tag">07 · AUBERGINE HOUR</div>
    <section class="hero" data-shot="hero">
      <div class="rail">
        <span class="dot"></span>
        <p>Zaid Hossain — builder for hire</p>
      </div>
      <div class="main">
        <h1>You&apos;ve had the idea long enough.</h1>
        <div class="panel">
          <p class="sub">I build the app, site, or automation you&apos;ve been circling for months. Scoped tight, built in the open, handed over working.</p>
          <div class="actions">
            <a class="btn" href="#">Book a 20-minute call</a>
            <a class="link" href="#">See the work ↓</a>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>

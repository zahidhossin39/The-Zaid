---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SvHero from "../components/sv/SvHero.astro";
import SvDemo from "../components/sv/SvDemo.astro";
import SvPrivate from "../components/sv/SvPrivate.astro";
import SvFeatures from "../components/sv/SvFeatures.astro";
import SvFinal from "../components/sv/SvFinal.astro";
import SvAndroid from "../components/sv/SvAndroid.astro";
import SvNotetaker from "../components/sv/SvNotetaker.astro";

const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Silent Voice",
  description:
    "Free, open-source voice-to-text. Hold a key, speak, and the text is typed at your cursor. Records and transcribes meetings on your computer.",
  applicationCategory: "ProductivityApplication",
  operatingSystem: "Windows, macOS, Linux, Android",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://opensource.org/licenses/MIT",
  url: "https://zaidhossain.com/silent-voice",
  downloadUrl: "https://github.com/zahidhossin39/Silent-Voice/releases",
  author: { "@type": "Person", name: "Zaid Hossain", url: "https://zaidhossain.com" },
};
---
<Base
  title="Silent Voice | Free voice-to-text and meeting notes that run on your computer"
  description="Hold a key, speak, let go: Silent Voice types your words wherever your cursor is, and its Notetaker writes down your calls. Free, open source and unlimited, for Windows, macOS, Linux and Android."
  ogImage="/og-silent-voice.png"
  ogImageAlt="Silent Voice: hold a key, speak, let go. Free voice-to-text that runs on your computer."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="sv-progress" aria-hidden="true"><i></i></div>
  <Navbar variant="app" />
  <main id="main" tabindex="-1" class="sv">
    <SvHero />
    <SvDemo />
    <SvNotetaker />
    <SvFeatures />
    <SvPrivate />
    <SvAndroid />
    <SvFinal />
  </main>
  <Footer variant="app" />
</Base>

<style is:global>
  /* page-wide tokens for the Silent Voice page (the app's own orange) */
  :root {
    --sv-orange: #f97316;
    --sv-orange-deep-ish: #ea580c;
    --sv-line: rgba(244, 242, 237, 0.09);
    /* one container for every section: content width and side gutter */
    --sv-max: 76rem;
    --sv-gutter: clamp(1.25rem, 4vw, 2.5rem);
    /* vertical padding of every section after the hero */
    --sv-space: clamp(4.5rem, 8vw, 7rem);
  }
  .sv { overflow-x: clip; }
  /* Android visitors: the phone app comes straight after the hero */
  html[data-sv-os="android"] main.sv { display: flex; flex-direction: column; }
  html[data-sv-os="android"] main.sv > * { order: 2; }
  html[data-sv-os="android"] main.sv > .svh { order: 0; }
  html[data-sv-os="android"] main.sv > .and { order: 1; }

  /* One section rhythm and one container for the whole page. Every section
     after the hero gets the same vertical padding and the same side gutter
     here; its inner wrapper takes max-width: var(--sv-max) and margin: 0 auto,
     so section headings share one left edge. (This beats each section's own
     scoped padding on purpose: one place to tune the rhythm.) */
  main.sv > section:is(.svd, .svn, .svf, .svp, .and, .svx) {
    padding: var(--sv-space) var(--sv-gutter);
  }
  .sv ::selection { background: var(--sv-orange); color: #140a02; }
  .sv :focus-visible { outline-color: var(--sv-orange); }
  .sv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sv-orange);
  }
  .sv-eyebrow::before { content: ""; width: 1.4rem; height: 1px; background: currentColor; }
</style>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
  main:focus { outline: none; }

  .sv-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; pointer-events: none; }
  .sv-progress i { display: block; height: 100%; background: linear-gradient(90deg, #c2410c, var(--sv-orange), #fdba74); transform-origin: left; transform: scaleX(var(--p, 0)); box-shadow: 0 0 12px rgba(249, 115, 22, 0.8); }
</style>

<script>
  import { initRelease } from "../scripts/sv-release";
  import { gsap } from "gsap";

  initRelease();

  document.querySelector(".skip-link")?.addEventListener("click", () => {
    document.getElementById("main")?.focus({ preventScroll: true });
  });

  // reading progress along the top edge
  const bar = document.querySelector<HTMLElement>(".sv-progress i")!;
  let ticking = false;
  const progress = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.setProperty("--p", String(max > 0 ? Math.min(1, scrollY / max) : 0));
  };
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(progress); } }, { passive: true });
  progress();

  // Download buttons stay put (a moving target is harder to hit); the light
  // inside follows the pointer, and a click sends out one soft ring.
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
    el.addEventListener("pointermove", (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty("--mx", `${e.clientX - r.left}px`);
      el.style.setProperty("--my", `${e.clientY - r.top}px`);
    });
    el.addEventListener("click", (e) => {
      if (still) return;
      const r = el.getBoundingClientRect();
      const ring = document.createElement("span");
      Object.assign(ring.style, {
        position: "fixed", left: `${e.clientX || r.left + r.width / 2}px`, top: `${e.clientY || r.top + r.height / 2}px`,
        width: "20px", height: "20px", margin: "-10px 0 0 -10px", borderRadius: "50%",
        border: "1.5px solid #f97316", pointerEvents: "none", zIndex: "70",
      });
      document.body.appendChild(ring);
      gsap.to(ring, { scale: 7, opacity: 0, duration: 0.9, ease: "power2.out", onComplete: () => ring.remove() });
    });
  });
</script>

---
// Framer-style "Plus + Lines" grid, registered to the hero layout: the cell is
// the content width / 20 and the origin is the content-left edge + headline
// top, so lines land on the layout's edges. Marks near the cursor darken and
// fade back. Quiet (35%) behind each line of [data-quiet] text, faded at top and bottom.
---

<div class="grid-bg" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .grid-bg canvas { display: block; width: 100%; height: 100%; }
</style>

<script>
  const MARK = 8; // plus size (6 on phones)
  const LINE_A = 0.055;
  const MARK_A = 0.15;
  const GLOW = 0.4; // max extra opacity under the cursor
  const DARK = "17,17,17";
  const LIGHT = "244,242,237"; // on the dark panel (variant 3)

  const wrap = document.querySelector<HTMLElement>(".grid-bg")!;
  const hero = wrap.parentElement!;
  const inner = hero.querySelector<HTMLElement>(".hero-inner")!;
  const canvas = wrap.querySelector("canvas")!;
  const ctx = canvas.getContext("2d")!;
  const mask = document.createElement("canvas");
  const mctx = mask.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let w = 0, h = 0, dpr = 1, cell = 64, ox = 0, oy = 0, mark = MARK;
  let lines = true, split = Infinity; // x where the dark panel starts
  let xs: number[] = [], ys: number[] = [];
  let skips: { l: number; t: number; r: number; b: number }[] = []; // no marks under/around the card and button
  let glow = new Float32Array(0);
  let mx = -1e4, my = -1e4, running = false;

  const px = (v: number) => Math.round(v * dpr) / dpr; // snap to device pixel
  // layout box relative to the hero, ignoring transforms (the reveal animation moves the copy)
  const box = (el: HTMLElement) => {
    let x = 0, y = 0, n: HTMLElement | null = el;
    while (n && n !== hero) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
    return { l: x, t: y, r: x + el.offsetWidth, b: y + el.offsetHeight };
  };

  const layout = () => {
    const r = wrap.getBoundingClientRect();
    dpr = devicePixelRatio || 1;
    w = r.width; h = r.height;
    for (const c of [canvas, mask]) { c.width = w * dpr; c.height = h * dpr; }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    mctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const vw = innerWidth;
    const cs = getComputedStyle(inner);
    const ir = inner.getBoundingClientRect();
    const left = ir.left - r.left + parseFloat(cs.paddingLeft);
    const content = ir.width - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    cell = content / (vw >= 1024 ? 20 : vw >= 768 ? 12 : 6);
    mark = vw >= 768 ? MARK : 6;
    lines = vw >= 768;
    ox = left; oy = box(hero.querySelector<HTMLElement>(".headline")!).t;
    split = hero.dataset.v === "3" && vw >= 1024 ? px(ox + 9 * cell) : Infinity;
    hero.style.setProperty("--split", isFinite(split) ? `${split}px` : "50%");

    xs = []; ys = [];
    for (let x = ox - Math.ceil(ox / cell) * cell; x <= w; x += cell) xs.push(px(x));
    for (let y = oy - Math.ceil(oy / cell) * cell; y <= h; y += cell) ys.push(px(y));
    glow = new Float32Array(xs.length * ys.length);

    skips = [...hero.querySelectorAll<HTMLElement>(".reel, .btn")].map((el) => {
      const c = box(el);
      return { l: c.l - 8, t: c.t - 8, r: c.r + 8, b: c.b + 8 };
    });

    // mask: 35% behind each text line (tight soft edge), fade over top and bottom 96px
    mctx.clearRect(0, 0, w, h);
    mctx.globalCompositeOperation = "source-over";
    mctx.fillStyle = "#000";
    mctx.fillRect(0, 0, w, h);
    mctx.globalCompositeOperation = "destination-out";
    mctx.filter = "blur(10px)";
    mctx.fillStyle = "rgba(0,0,0,.65)";
    hero.querySelectorAll<HTMLElement>("[data-quiet]").forEach((el) => {
      const q = box(el);
      // one rect per rendered line, only as wide as its words (not the whole block);
      // measured relative to the element so the reveal animation's transform cancels out
      const er = el.getBoundingClientRect();
      const range = document.createRange();
      range.selectNodeContents(el);
      for (const lr of range.getClientRects()) {
        if (lr.width < 1) continue;
        mctx.fillRect(q.l + lr.left - er.left - 6, q.t + lr.top - er.top - 6, lr.width + 12, lr.height + 12);
      }
    });
    mctx.filter = "none";
    mctx.globalCompositeOperation = "destination-in";
    const g = mctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, "rgba(0,0,0,0)");
    g.addColorStop(Math.min(0.45, 96 / h), "#000");
    g.addColorStop(Math.max(0.55, 1 - 96 / h), "#000");
    g.addColorStop(1, "rgba(0,0,0,0)");
    mctx.fillStyle = g;
    mctx.fillRect(0, 0, w, h);

    draw();
  };

  const tone = (x: number, a: number) =>
    x >= split ? `rgba(${LIGHT},${a * 0.85})` : `rgba(${DARK},${a})`;

  const draw = () => {
    ctx.globalCompositeOperation = "source-over";
    ctx.clearRect(0, 0, w, h);
    if (lines) {
      ctx.lineWidth = 1;
      for (const x of xs) {
        ctx.strokeStyle = tone(x, LINE_A);
        ctx.beginPath(); ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, h); ctx.stroke();
      }
      for (const y of ys) {
        for (const [a, b] of [[0, Math.min(split, w)], [split, w]]) {
          if (b <= a) continue;
          ctx.strokeStyle = tone(a, LINE_A);
          ctx.beginPath(); ctx.moveTo(a, y + 0.5); ctx.lineTo(b, y + 0.5); ctx.stroke();
        }
      }
    }
    const reach = cell * 2;
    const half = mark / 2;
    let active = false;
    for (let j = 0; j < ys.length; j++) {
      const y = ys[j];
      for (let i = 0; i < xs.length; i++) {
        const x = xs[i];
        if (skips.some((s) => x > s.l && x < s.r && y > s.t && y < s.b)) continue;
        const k = j * xs.length + i;
        const d = Math.hypot(x - mx, y - my);
        const target = d < reach ? (1 - d / reach) * GLOW : 0;
        glow[k] += (target - glow[k]) * (target > glow[k] ? 0.35 : 0.08);
        if (glow[k] > 0.003) active = true;
        ctx.fillStyle = tone(x, MARK_A + glow[k]);
        ctx.fillRect(x - half, y, mark + 1, 1); // 1px arms on whole pixels
        ctx.fillRect(x, y - half, 1, half);
        ctx.fillRect(x, y + 1, 1, half);
      }
    }
    ctx.globalCompositeOperation = "destination-in";
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.drawImage(mask, 0, 0);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return active;
  };

  const loop = () => {
    if (draw()) requestAnimationFrame(loop);
    else running = false;
  };
  const kick = () => { if (!running && !still) { running = true; requestAnimationFrame(loop); } };

  // Start after the first paint: the grid is decoration, so it must not delay
  // the headline appearing (PageSpeed FCP/LCP on phones).
  const start = () => {
    const ro = new ResizeObserver(() => layout());
    ro.observe(wrap);
    ro.observe(inner);
    document.fonts.ready.then(layout); // web font changes the headline height
  };
  requestAnimationFrame(() => setTimeout(start, 0));
  hero.addEventListener("variantchange", () => requestAnimationFrame(layout));
  if (!still) {
    addEventListener("pointermove", (e) => {
      const r = wrap.getBoundingClientRect();
      mx = e.clientX - r.left; my = e.clientY - r.top;
      if (my > -cell * 2 && my < r.height + cell * 2) kick();
    }, { passive: true });
    document.addEventListener("pointerleave", () => { mx = my = -1e4; kick(); });
  }
</script>

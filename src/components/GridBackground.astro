---
// Replica of the Framer "grid-background" component: a 60px grid of plus
// marks (or dots), optional hairlines, and marks that light up near the cursor
// and fade back out. PROTOTYPE: a switcher pill lets you try all 4 modes.
---

<div class="grid-bg" aria-hidden="true">
  <canvas></canvas>
</div>
<div class="grid-switch" role="group" aria-label="Background style (prototype)">
  <button type="button" data-mode="plus" aria-pressed="true">Plus</button>
  <button type="button" data-mode="plus-lines">Plus + Lines</button>
  <button type="button" data-mode="dots">Dots</button>
  <button type="button" data-mode="dots-lines">Dots + Lines</button>
</div>

<style>
  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .grid-bg canvas { display: block; width: 100%; height: 100%; }

  .grid-switch {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 0.5rem;
  }
  .grid-switch button {
    font: 500 0.75rem/1 "Inter Tight", system-ui, sans-serif;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(17 17 17 / 0.2);
    background: rgb(255 255 255 / 0.85);
    color: #111;
    cursor: pointer;
    white-space: nowrap;
  }
  .grid-switch button[aria-pressed="true"] { background: #111; color: #fff; border-color: #111; }
  @media (max-width: 767px) { .grid-switch { bottom: 0.75rem; gap: 0.3rem; } .grid-switch button { padding: 0.45rem 0.6rem; } }
</style>

<script>
  const CELL = 60; // grid pitch (Framer: 60px)
  const MARK = 10; // plus size
  const ARM = 1.7; // plus arm thickness
  const DOT = 2.5; // dot radius
  const BASE = 0.15; // resting opacity
  const RADIUS = 150; // cursor reach
  const COLOR = "17,17,17";

  const wrap = document.querySelector<HTMLElement>(".grid-bg")!;
  const canvas = wrap.querySelector("canvas")!;
  const ctx = canvas.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let mode = "plus";
  let w = 0, h = 0, cols = 0, rows = 0;
  let glow = new Float32Array(0); // per-mark extra opacity, decays over time
  let mx = -1e4, my = -1e4;
  let running = false;

  const resize = () => {
    const r = wrap.getBoundingClientRect();
    const dpr = devicePixelRatio || 1;
    w = r.width; h = r.height;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = Math.ceil(w / CELL) + 1; rows = Math.ceil(h / CELL) + 1;
    glow = new Float32Array(cols * rows);
    draw();
  };

  const draw = () => {
    ctx.clearRect(0, 0, w, h);
    const lines = mode.endsWith("lines");
    if (lines) {
      ctx.strokeStyle = `rgba(${COLOR},0.07)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let c = 0; c < cols; c++) { const x = CELL / 2 + c * CELL + 0.5; ctx.moveTo(x, 0); ctx.lineTo(x, h); }
      for (let r = 0; r < rows; r++) { const y = CELL / 2 + r * CELL + 0.5; ctx.moveTo(0, y); ctx.lineTo(w, y); }
      ctx.stroke();
    }
    let active = false;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const i = r * cols + c;
        const x = CELL / 2 + c * CELL, y = CELL / 2 + r * CELL;
        const d = Math.hypot(x - mx, y - my);
        const target = d < RADIUS ? (1 - d / RADIUS) * 0.85 : 0;
        // rise fast, fall slow: leaves a short trail behind the cursor
        glow[i] += (target - glow[i]) * (target > glow[i] ? 0.35 : 0.06);
        if (glow[i] > 0.003) active = true;
        ctx.fillStyle = `rgba(${COLOR},${Math.min(1, BASE + glow[i])})`;
        if (mode.startsWith("plus")) {
          ctx.fillRect(x - MARK / 2, y - ARM / 2, MARK, ARM);
          ctx.fillRect(x - ARM / 2, y - MARK / 2, ARM, MARK);
        } else {
          ctx.beginPath(); ctx.arc(x, y, DOT, 0, Math.PI * 2); ctx.fill();
        }
      }
    }
    return active;
  };

  const loop = () => {
    if (draw()) requestAnimationFrame(loop);
    else running = false;
  };
  const kick = () => { if (!running && !still) { running = true; requestAnimationFrame(loop); } };

  new ResizeObserver(resize).observe(wrap);
  if (!still) {
    addEventListener("pointermove", (e) => {
      const r = wrap.getBoundingClientRect();
      mx = e.clientX - r.left; my = e.clientY - r.top;
      if (my > -RADIUS && my < r.height + RADIUS) kick();
    }, { passive: true });
    document.addEventListener("pointerleave", () => { mx = my = -1e4; kick(); });
  }

  document.querySelectorAll<HTMLButtonElement>(".grid-switch button").forEach((b, _, all) => {
    b.addEventListener("click", () => {
      mode = b.dataset.mode!;
      all.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      draw();
    });
  });
</script>

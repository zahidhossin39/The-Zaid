---
// Native <details> accordion: no JS, keyboard + screen-reader accessible.
const faqs = [
  { q: "How much does it cost?",
    a: "A fixed price, agreed upfront, before any work starts. No hourly billing. You pay part at the start and the final part only when it works." },
  { q: "How long does it take?",
    a: "It depends on the size of the job. You get a real date on the call, not a range that keeps growing." },
  { q: "What kind of work can be automated?",
    a: "Most repeat tasks: replying to new enquiries, sending reminders, following up, copying details from one place to another and simple reports. On the call, I'll tell you which of yours are worth automating and which aren't." },
  { q: "Will it keep up as I get more customers?",
    a: "Yes, that's the reason to build it. I plan it for the number of customers you're aiming for, not only the ones you have today." },
  { q: "Do I need to be technical?",
    a: "No. You tell me what takes your time in plain words. I handle the technical side and show you progress you can click, not jargon." },
  { q: "What if I don't like what you build?",
    a: "You see it working in small pieces as it's built, so there are no big reveals at the end. And the final payment only happens once it works as agreed." },
  { q: "Who owns the website or automation?",
    a: "You do. The code, the accounts, the domain and the data are all in your name. Nothing is tied to me." },
  { q: "What happens after it's handed over?",
    a: "You get a short walkthrough and notes on how it works. I stay reachable for questions and fixes, with no monthly fee." },
];
---
<section id="faq" class="mx-auto max-w-[64rem] px-6 py-20 md:px-8 md:py-32">
  <div class="grid gap-12 md:grid-cols-[5fr_7fr] md:gap-14">
    <div>
      <p class="eyebrow reveal">Questions</p>
      <h2 class="h2 reveal mt-5" data-delay="80">Before you book.</h2>
      <p class="lead mt-5">
        The things people usually ask first. Anything else, ask me on the call.
      </p>
    </div>

    <div class="reveal border-t border-border" data-delay="120">
      {faqs.map(({ q, a }) => (
        <details class="faq group border-b border-border">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.0625rem] font-medium text-text">
            <span class="q">{q}</span>
            <span class="icon relative h-4 w-4 shrink-0" aria-hidden="true"></span>
          </summary>
          <p class="answer pb-6 pr-10 text-muted">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  /* closed rows sit slightly muted so the open one stands out */
  summary { position: relative; color: rgb(244 242 237 / .78); transition: color .3s; }
  .faq[open] summary { color: var(--color-text); }
  /* row highlight: absolutely positioned, bleeds 12px into the gutters, never moves layout */
  summary::before { content: ""; position: absolute; inset: 0 -12px; border-radius: 6px;
    background: rgb(244 242 237 / .03); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .q, .icon { transition: transform .3s cubic-bezier(.215, .61, .355, 1); }
  /* plus that turns into a minus */
  .icon::before, .icon::after { content: ""; position: absolute; left: 50%; top: 50%;
    width: 14px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%);
    transition: transform .3s ease; }
  .icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq[open] .icon::after { transform: translate(-50%, -50%) rotate(0deg); }

  @media (hover: hover) {
    summary:hover { color: var(--color-text); }
    summary:hover::before { opacity: 1; }
    summary:hover .q { transform: translateX(6px); }
  }
  /* keyboard: same as hover, plus a ring drawn on the highlight so it wraps the full row */
  summary:focus-visible { outline: none; color: var(--color-text); }
  summary:focus-visible::before { opacity: 1; outline: 2px solid var(--color-accent); outline-offset: -2px; }
  summary:focus-visible .q { transform: translateX(6px); }

  .faq[open] .answer { animation: open .35s ease; }
  @keyframes open { from { opacity: 0; transform: translateY(-4px); } }

  /* smooth height on open where supported; elsewhere it stays instant */
  @supports (interpolate-size: allow-keywords) {
    :global(:root) { interpolate-size: allow-keywords; }
    .faq::details-content { block-size: 0; overflow: hidden;
      transition: block-size .4s cubic-bezier(.215, .61, .355, 1), content-visibility .4s allow-discrete; }
    .faq[open]::details-content { block-size: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq[open] .answer { animation: none; }
    .q, .icon, summary:hover .q, summary:focus-visible .q { transform: none; }
    .faq::details-content { transition: none; }
  }
</style>

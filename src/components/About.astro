---
import { siGithub, siX } from "simple-icons";

// Add a tool: drop its official color SVG in public/tools/ and append it here.
const tools = [
  ["figma", "Figma"], ["framer", "Framer"], ["astro", "Astro"], ["nextjs", "Next.js"],
  ["n8n", "n8n"], ["make", "Make"], ["zapier", "Zapier"], ["claude", "Claude"],
  ["openai", "ChatGPT"], ["google-gemini", "Gemini"], ["google-sheets", "Google Sheets"],
];

const LINKEDIN = "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z";
const socials = [
  { label: "GitHub", href: "https://github.com/zahidhossin39", path: siGithub.path },
  { label: "X", href: "https://x.com/ZaidHossain_", path: siX.path },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/zaid-hossain", path: LINKEDIN },
];
---
<section id="about" class="mx-auto max-w-[64rem] px-6 py-20 md:px-8 md:py-32">
  <div class="grid gap-12 md:grid-cols-[4fr_8fr] md:gap-16">
    <div>
      <div data-about-photo class="aspect-[4/5] w-full max-w-[18rem] overflow-hidden rounded-lg border border-border bg-surface">
        <img src="/zaid.webp" alt="Zaid Hossain" width="640" height="800" class="h-full w-full object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="reveal mt-5 flex max-w-[18rem] items-center justify-between" data-delay="120">
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Find me on</p>
        <ul class="flex gap-2">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
                 class="grid size-10 place-items-center rounded-full border border-border text-muted transition hover:border-text hover:text-text">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="max-w-[42rem]">
      <p class="eyebrow reveal">Who's building it</p>
      <h2 class="h2 reveal mt-5" data-delay="80">I'm Zaid.</h2>

      <div class="mt-7 space-y-5 text-muted">
        <p>
          I build websites and automations for owners whose business has
          outgrown their hours.
        </p>
        <p>
          Most of what I know came from building things I needed myself. I
          built apps to fix my own problems and automations because I was
          tired of doing the same tasks by hand. I know how many hours that
          kind of work takes. I still start with the real problem and build
          the smallest thing that solves it.
        </p>
        <p class="text-text">
          I'm early in taking on client work. That means you get my full
          attention, and I'd rather prove that than promise it.
        </p>
      </div>

      <div class="reveal mt-10 rounded-lg border border-border bg-surface p-6 md:p-7" data-delay="240">
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">What happens on the call</p>
        <ol class="mt-5 space-y-4">
          {[
            "You tell me where your hours go.",
            "I show you what I'd build and roughly what it costs.",
            "You decide. No pitch, no follow-up spam.",
          ].map((step, i) => (
            <li class="flex gap-4">
              <span class="grid size-6 shrink-0 place-items-center rounded-full border border-border font-mono text-[11px] text-muted">{i + 1}</span>
              <span class="text-text">{step}</span>
            </li>
          ))}
        </ol>
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="https://cal.com/zaid-hossain/20min" target="_blank" rel="noopener noreferrer" data-cal-intent
             class="inline-flex items-center rounded-full bg-text px-6 py-3 font-medium text-bg transition hover:-translate-y-0.5 hover:bg-white">
            Book a free 20-min call
          </a>
          <span class="text-[0.875rem] text-muted">I reply within 24 hours.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-20 md:mt-28">
    <p class="font-mono text-center text-[11px] uppercase tracking-[0.08em] text-muted">Tools I build with</p>
    <div class="tools mt-8" aria-label="Tools I build with">
      <ul class="track">
        {[0, 1].map((copy) => tools.map(([file, name]) => (
          <li class="tool" aria-hidden={copy ? "true" : undefined}>
            <span class="tile"><img src={`/tools/${file}.svg`} alt="" width="40" height="40" loading="lazy" /></span>
            <span class="name">{name}</span>
          </li>
        )))}
      </ul>
    </div>
  </div>
</section>

<style>
  .tools {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .track { display: flex; width: max-content; animation: slide 40s linear infinite; }
  .tools:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .tool { display: flex; flex-direction: column; align-items: center; gap: 14px; width: 9.5rem; }
  /* real full-color logos on a white app-icon tile: true brand colors pop on the dark section */
  .tile {
    display: grid; place-items: center; width: 76px; height: 76px; border-radius: 20px;
    background: linear-gradient(180deg, #ffffff, #eeece7);
    box-shadow: inset 0 1px 0 #fff, 0 10px 30px -10px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(255 255 255 / 0.06);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tile img { width: 40px; height: 40px; object-fit: contain; }
  .tool:hover .tile { transform: translateY(-4px) scale(1.04); }
  .name {
    border-radius: 999px; background: var(--color-surface); border: 1px solid var(--color-border);
    padding: 4px 12px; font-size: 0.875rem; color: var(--color-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .tools { mask-image: none; }
    .track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; row-gap: 2rem; }
    .tool[aria-hidden] { display: none; }
  }
</style>

<script>
  import { whenNear, loadGsap } from "../scripts/near";

  const photo = document.querySelector<HTMLElement>("[data-about-photo]");
  const img = photo?.querySelector("img");
  if (photo && img) whenNear(photo, async () => {
    const gsap = await loadGsap();
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      // Start state is JS-only, so the photo is visible without JS.
      gsap.set(photo, { clipPath: "inset(100% 0 0 0)" });
      let io: IntersectionObserver | undefined;
      img.decode().then(
        () => {
          io = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) return;
            io!.disconnect();
            gsap.to(photo, { clipPath: "inset(0% 0 0 0)", duration: 0.9, ease: "power3.out" });
          }, { threshold: 0.4, rootMargin: "0px 0px -25% 0px" });
          io.observe(photo.parentElement!); // not the clipped box: IO counts its own clip-path as hidden
        },
        () => gsap.set(photo, { clipPath: "inset(0% 0 0 0)" }),
      );
      return () => { io?.disconnect(); gsap.set(photo, { clearProps: "clipPath" }); };
    });
  });
</script>

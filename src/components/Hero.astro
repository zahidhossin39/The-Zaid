---
import fs from "node:fs";
import DotGrid from "./DotGrid.astro";

// Showreel column only renders once public/hero.mp4 exists (checked at build).
const hasReel = fs.existsSync("public/hero.mp4");

const HEAD = "More customers shouldn't mean more hours.";
const SUB =
  "I build websites to bring customers in, and automations that reply, follow up and keep their details in one place, so you don't have to.";
const CTA = "Book a free 20-min call";
---

<section class="hero">
  <DotGrid />
  <div class="hero-inner">
    <div class="hero-copy">
      <h1 class="headline reveal" data-delay="120">{HEAD}</h1>
      <p class="sub reveal" data-delay="220">{SUB}</p>
      <div class="cta reveal" data-delay="320">
        <a href="#book" class="btn" data-cal-intent
          ><span class="btn-label"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>{CTA}</span
          ><span class="btn-fill" aria-hidden="true"></span></a
        >
        <a href="#proof" class="link">See examples ↓</a>
      </div>
      <p class="trust reveal" data-delay="380">Fixed price, agreed upfront · Final payment when it works as agreed · You own everything</p>
    </div>

    {hasReel && (
      <div class="hero-media reveal" data-delay="260">
        <video
          src="/hero.mp4"
          width="316"
          height="176"
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
        ></video>
        <p class="caption">Showreel</p>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: #ffffff;
    color: #111111;
    font-family: "Inter Tight", system-ui, sans-serif;
  }

  .hero :global(.dotgrid-wrapper) {
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    align-items: start;
    gap: 5rem;
  }

  .headline {
    margin: 0;
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    max-width: 16ch;
    text-wrap: balance;
  }

  .sub {
    margin: 1.75rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .cta {
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    background: #111111;
    color: #ffffff;
    font-weight: 500;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-label {
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .btn-label svg {
    flex-shrink: 0;
  }

  /* cursor-origin fill circle (grows from where the mouse enters) */
  .btn-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 550px;
    height: 550px;
    border-radius: 9999px;
    background: #3a3a3a; /* lifts the black pill on hover, text stays white */
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0);
    transform-origin: center center;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-fill { display: none; }
  }

  .trust {
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
    color: #6b6963;
  }

  .link {
    color: #111111;
    text-decoration: none;
    border-bottom: 1px solid #111111;
    padding-bottom: 1px;
  }

  .hero-media {
    justify-self: end;
  }

  .hero-media video {
    display: block;
    cursor: pointer;
    width: 316px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 316 / 176;
    background: #f0f0f0;
    object-fit: cover;
  }

  .caption {
    margin: 0.625rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-inner {
      gap: 3rem;
    }
  }

  @media (max-width: 767px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 4rem;
      min-height: auto;
      padding: 5rem 1.5rem;
    }

    .headline {
      font-size: clamp(1.875rem, 9.5vw, 2.5rem);
    }

    .hero-media {
      justify-self: start;
    }
  }
</style>

<script>
  // Cursor-origin fill: circle grows from the point the mouse enters and
  // shrinks toward the point it leaves. Ported from the Zaid-Portfolio button.
  const btn = document.querySelector<HTMLElement>(".hero .btn");
  const fill = btn?.querySelector<HTMLElement>(".btn-fill");
  if (btn && fill) {
    const drive = (e: MouseEvent, entering: boolean) => {
      const rect = btn.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const size = Math.hypot(Math.max(x, rect.width - x), Math.max(y, rect.height - y)) * 2;
      fill.style.width = `${size}px`;
      fill.style.height = `${size}px`;
      // snap to cursor at the current scale, no transition
      fill.style.transition = "none";
      fill.style.left = `${x}px`;
      fill.style.top = `${y}px`;
      fill.style.transform = `translate(-50%, -50%) scale(${entering ? 0 : 1})`;
      void fill.offsetHeight; // force reflow so the snap applies before animating
      fill.style.transition = "transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)";
      fill.style.transform = `translate(-50%, -50%) scale(${entering ? 1 : 0})`;
    };
    btn.addEventListener("mouseenter", (e) => drive(e, true));
    btn.addEventListener("mouseleave", (e) => drive(e, false));
  }

  // Showreel (only in the DOM when public/hero.mp4 exists): plays once, then
  // holds its last frame (no loop). Click replays. Reduced motion: no autoplay.
  const media = document.querySelector<HTMLElement>(".hero-media");
  const video = media?.querySelector("video");
  if (media && video) {
    const play = () => video.play().catch(() => {});
    video.addEventListener("error", () => media.remove());
    video.addEventListener("click", () => {
      video.currentTime = 0;
      play();
    });
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (matchMedia("(max-width: 767px)").matches) {
        // phones: the reel sits below the copy, so wait until it's half in view
        const io = new IntersectionObserver(
          ([e]) => {
            if (!e.isIntersecting) return;
            io.disconnect();
            play();
          },
          { threshold: 0.5 },
        );
        io.observe(video);
      } else {
        const start = () => setTimeout(play, 1000); // ~1s after the reveal
        if (document.readyState === "complete") start();
        else addEventListener("load", start, { once: true });
      }
    }
  }
</script>

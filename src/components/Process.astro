---
// Process section — curved arc timeline (inspired by scrollservices.framer.website).
// Numbers ride a real circle arc; connector is one smooth curve, black below the
// active disc and grey above, running off both edges. Eased scroll, revolver-style
// visual ping on each step. Icons are placeholder 3D assets — swap for your own.
// Custom duotone icons — hand-drawn SVG, no external assets. Each carries a
// light->shade gradient fill and a soft drop shadow for a puffy 3D feel.
const defs = (id: string) => `<defs>
  <linearGradient id="g${id}" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#f0ebe1"/><stop offset="1" stop-color="#d2cbbc"/>
  </linearGradient>
  <filter id="s${id}" x="-45%" y="-45%" width="190%" height="190%">
    <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#3a3428" flood-opacity="0.22"/>
  </filter>
</defs>`;
const ICON = {
  magnifier: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">${defs("m")}
    <g filter="url(#sm)">
      <path d="M71 71 96 96" stroke="#171512" stroke-width="9" stroke-linecap="round"/>
      <circle cx="50" cy="50" r="30" fill="url(#gm)" stroke="#171512" stroke-width="5"/>
      <circle cx="42" cy="42" r="9" fill="#ffffff" fill-opacity=".6"/>
    </g></svg>`,
  pen: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">${defs("p")}
    <g filter="url(#sp)" transform="rotate(-40 60 64)">
      <rect x="43" y="19" width="34" height="15" rx="6" fill="#b9b2a4" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <path d="M43 32h34v52H43z" fill="url(#gp)" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <rect x="43" y="40" width="34" height="8" fill="#b9b2a4" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <path d="M43 84h34l-17 27z" fill="#ece6db" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <path d="M52 97h16l-8 14z" fill="#171512"/>
    </g></svg>`,
  code: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">${defs("c")}
    <g filter="url(#sc)">
      <rect x="16" y="26" width="88" height="72" rx="13" fill="url(#gc)" stroke="#171512" stroke-width="5"/>
      <path d="M46 52 33 62 46 72" stroke="#171512" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M74 52 87 62 74 72" stroke="#171512" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M65 48 55 76" stroke="#171512" stroke-width="6" stroke-linecap="round"/>
    </g></svg>`,
  rocket: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">${defs("r")}
    <g filter="url(#sr)">
      <path d="M39 67 26 84 44 78" fill="#b9b2a4" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <path d="M81 67 94 84 76 78" fill="#b9b2a4" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <path d="M60 16c15 13 21 32 21 51H39c0-19 6-38 21-51Z" fill="url(#gr)" stroke="#171512" stroke-width="5" stroke-linejoin="round"/>
      <circle cx="60" cy="46" r="9" fill="#b9b2a4" stroke="#171512" stroke-width="5"/>
      <path d="M52 80c2 12 14 12 16 0" stroke="#171512" stroke-width="5" stroke-linecap="round"/>
    </g></svg>`,
  key: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">${defs("k")}
    <g filter="url(#sk)">
      <path d="M60 60 96 96" stroke="#171512" stroke-width="7" stroke-linecap="round"/>
      <path d="M85 85 95 75M74 74 82 82" stroke="#171512" stroke-width="7" stroke-linecap="round"/>
      <circle cx="44" cy="44" r="23" fill="url(#gk)" stroke="#171512" stroke-width="5"/>
      <circle cx="44" cy="44" r="8" fill="#f2f0ec" stroke="#171512" stroke-width="5"/>
    </g></svg>`,
};

const phases = [
  {
    n: "01", kick: "Phase 01", title: ["Discovery", "& Scope"],
    body: "It starts with a call. You tell me where your time goes and where customers slip away. I turn that into a clear, honest plan.",
    tags: ["Call", "Review", "Plan"], svg: ICON.magnifier,
  },
  {
    n: "02", kick: "Phase 02", title: ["Plan &", "Design"],
    body: "Before I build anything, I map out what brings customers in and which tasks can run on their own. You see the plan first.",
    tags: ["Steps", "Screens", "Design"], svg: ICON.pen,
  },
  {
    n: "03", kick: "Phase 03", title: ["Build"],
    body: "I build it in small working pieces, so you can watch it come together. The code is yours from day one.",
    tags: ["Websites", "Automations", "AI"], svg: ICON.code,
  },
  {
    n: "04", kick: "Phase 04", title: ["Test &", "Ship"],
    body: "I test everything, fix what breaks and put it live. You get it working, not almost working.",
    tags: ["Testing", "Launch", "Notes"], svg: ICON.rocket,
  },
  {
    n: "05", kick: "Phase 05", title: ["Handover", "& Support"],
    body: "You keep the code and every account. I stay reachable while you get used to it, with no monthly fee.",
    tags: ["Handover", "Training", "Support"], svg: ICON.key,
  },
];
---
<section class="proc" id="process">
  <div class="proc-head">
    <p class="eye">How I work</p>
    <h2>From your first call to a system that runs on its own</h2>
  </div>

  <div class="proc-scroll" data-proc-scroll>
    <div class="stage">
      <div class="rail">
        <svg class="railSvg" preserveAspectRatio="none">
          <path class="lineGrey" fill="none" stroke="#d9d5cd" stroke-width="1.5"></path>
          <path class="lineInk" fill="none" stroke="#171512" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
        {phases.map((p) => (
          <div class="dot" data-n={p.n}>{p.n}</div>
        ))}
      </div>

      <div class="content">
        {phases.map((p) => (
          <article class="phase">
            <div class="copy">
              <p class="kick anim">{p.kick}</p>
              <h3 class="anim">{p.title[0]}{p.title[1] ? <br /> : null}{p.title[1] ?? ""}</h3>
              <p class="anim">{p.body}</p>
              <div class="tags anim">{p.tags.map((t) => <span>{t}</span>)}</div>
            </div>
            <div class="art anim" set:html={p.svg}></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .proc {
    --cream: #f2f0ec;
    --ink: #171512;
    --muted: #6a655d;
    --eye: #8a857c;
    --line-off: #d9d5cd;
    --serif: "Instrument Serif", Georgia, serif;
    --sans: "Inter", system-ui, sans-serif;
    background: var(--cream); color: var(--ink);
  }

  .proc-head { text-align: center; padding: clamp(5rem, 12vh, 9rem) 1.5rem clamp(2rem, 5vh, 3rem); }
  .proc-head .eye { font: 500 0.8rem var(--sans); letter-spacing: 0.2em; text-transform: uppercase;
                    color: var(--eye); margin: 0 0 1.2rem; }
  .proc-head h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em;
                  font-size: clamp(2.4rem, 5.4vw, 4rem); line-height: 1.04; margin: 0 auto; max-width: 18ch; }

  .proc-scroll { position: relative; height: 340vh; }
  .proc .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

  .proc .rail { position: absolute; top: 0; left: 0; width: 460px; height: 100%; pointer-events: none; }
  .proc .rail svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .proc .dot { position: absolute; display: grid; place-items: center; border-radius: 999px;
               background: var(--cream); border: 1px solid var(--line-off);
               font-family: var(--serif); color: var(--ink); transform: translate(-50%, -50%);
               transition: background .3s ease, color .3s ease, border-color .3s ease; z-index: 2; }
  .proc .dot.on { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .proc .dot.ping { animation: procping .32s ease-out; }
  @keyframes procping { 0% { box-shadow: 0 0 0 0 rgba(23,21,18,.35); } 100% { box-shadow: 0 0 0 18px rgba(23,21,18,0); } }

  .proc .content { position: absolute; top: 0; left: 460px; right: 0; bottom: 0; }
  .proc .phase { position: absolute; inset: 0; pointer-events: none; visibility: hidden;
                 display: grid; align-items: center;
                 grid-template-columns: minmax(0,1fr) minmax(0,0.85fr);
                 gap: 3rem; padding: 4rem clamp(3rem,5vw,6rem) 4rem 0.5rem; }
  .proc .phase.show, .proc .phase.leave { visibility: visible; }
  .proc .phase.show { pointer-events: auto; }
  .proc .phase .copy { max-width: 40ch; }

  /* Phase change, in two beats that never overlap:
     1. the old phase slides out along the scroll direction, fading and blurring (ease-in, 0.26s);
     2. the new phase's parts rise in one after another from the opposite side (expo ease-out).
     --d is 1 scrolling down, -1 scrolling up (set by the script). */
  .proc .anim { opacity: 0; transform: translate3d(0, calc(var(--d, 1) * 28px), 0); filter: blur(8px);
                will-change: opacity, transform, filter; }
  .proc .phase.show .anim {
    opacity: 1; transform: none; filter: blur(0);
    transition: opacity .6s cubic-bezier(.16,1,.3,1) var(--t),
                transform .9s cubic-bezier(.16,1,.3,1) var(--t),
                filter .6s cubic-bezier(.16,1,.3,1) var(--t);
  }
  .proc .phase.leave .anim {
    opacity: 0; transform: translate3d(0, calc(var(--d, 1) * -22px), 0); filter: blur(6px);
    transition: opacity .26s cubic-bezier(.4,0,1,1), transform .3s cubic-bezier(.4,0,1,1),
                filter .26s cubic-bezier(.4,0,1,1);
  }
  .proc .kick.anim { --t: .24s; }
  .proc h3.anim { --t: .30s; }
  .proc .copy > p.anim { --t: .36s; }
  .proc .tags.anim { --t: .42s; }
  .proc .art.anim { --t: .34s; }
  @media (prefers-reduced-motion: reduce) {
    .proc .anim, .proc .phase.leave .anim { transform: none; filter: none; }
  }
  .proc .phase .kick { font: 600 0.85rem var(--sans); letter-spacing: 0.16em; text-transform: uppercase;
                       color: var(--eye); margin: 0 0 1.4rem; }
  .proc .phase h3 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em;
                    font-size: clamp(2.6rem, 4.6vw, 3.8rem); line-height: 1.0; margin: 0; color: var(--ink); }
  .proc .phase p { font: 400 1.0625rem var(--sans); line-height: 1.6; color: var(--muted);
                   margin: 1.5rem 0 0; max-width: 42ch; }
  .proc .phase .tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
  .proc .phase .tags span { font: 500 0.85rem var(--sans); color: var(--ink);
                            padding: 0.5rem 1rem; border: 1px solid var(--line-off); border-radius: 999px; }
  .proc .phase .art { justify-self: center; }
  .proc .phase .art :global(svg) { width: clamp(200px, 24vw, 340px); height: auto; display: block; }

  /* no JS (or the failsafe removed .js): the scroll engine never runs, so show
     the phases as a plain stacked list instead of an empty sticky stage */
  :global(html:not(.js)) .proc-scroll { height: auto; }
  :global(html:not(.js)) .proc .stage { position: static; height: auto; overflow: visible; }
  :global(html:not(.js)) .proc .rail { display: none; }
  :global(html:not(.js)) .proc .content { position: static; max-width: 64rem; margin: 0 auto; padding: 0 1.5rem 4rem; }
  :global(html:not(.js)) .proc .phase { position: relative; opacity: 1; pointer-events: auto; visibility: visible;
                                        padding-top: 2rem; padding-bottom: 2rem; }
  :global(html:not(.js)) .proc .anim { opacity: 1; transform: none; filter: none; }

  /* phones + tablets: the vertical arc turns into a horizontal dial along the
     bottom of the screen (same dots, same ink/grey line, driven by the script) */
  @media (max-width: 1024px) {
    .proc .rail { width: 100%; }
    .proc .content { left: 0; bottom: 8.5rem; }
    .proc .phase { padding: 5rem 2rem 1rem; gap: 2rem; align-content: center; }
    .proc .phase .art :global(svg) { width: clamp(150px, 26vw, 240px); }
  }
  @media (max-width: 767px) {
    .proc .content { bottom: 7.5rem; }
    .proc .phase { grid-template-columns: 1fr; padding: 4.5rem 1.5rem 0; gap: 1.25rem; }
    .proc .phase .art { order: -1; justify-self: start; }
    .proc .phase .art :global(svg) { width: min(140px, 26vw, 16svh); }
    .proc .phase .kick { margin-bottom: 0.9rem; }
    .proc .phase h3 { font-size: clamp(2.2rem, 9.5vw, 2.8rem); }
    .proc .phase p { font-size: 1rem; margin-top: 1rem; }
    .proc .phase .tags { margin-top: 1.25rem; }
  }
  /* phones held sideways: too short for the icon, so text only */
  @media (max-width: 1024px) and (max-height: 500px) {
    .proc .content { bottom: 4.5rem; }
    .proc .phase { grid-template-columns: 1fr; padding: 4rem 2rem 0; gap: 0; }
    .proc .phase .art { display: none; }
    .proc .phase .kick { margin-bottom: 0.5rem; }
    .proc .phase h3 { font-size: 2rem; }
    .proc .phase p { font-size: 0.95rem; margin-top: 0.6rem; max-width: 60ch; }
    .proc .phase .tags { margin-top: 0.8rem; }
  }
</style>

<script>
  const root = document.getElementById("process");
  if (root) {
    const N = 5, R = 456, STEP = 0.335, CX = -169;
    const scroll = root.querySelector<HTMLElement>("[data-proc-scroll]")!;
    const stage = root.querySelector<HTMLElement>(".stage")!;
    const dots = [...root.querySelectorAll<HTMLElement>(".dot")];
    const phasesEls = [...root.querySelectorAll<HTMLElement>(".phase")];
    const grey = root.querySelector(".lineGrey") as unknown as SVGPathElement;
    const ink = root.querySelector(".lineInk") as unknown as SVGPathElement;

    const detent = (dot: HTMLElement) => {
      dot.classList.remove("ping"); void dot.offsetWidth; dot.classList.add("ping");
    };

    const arc = (cx: number, cy: number, r: number, aFrom: number, aTo: number) => {
      const n = 48; let d = "";
      for (let k = 0; k <= n; k++) {
        const a = aFrom + (aTo - aFrom) * (k / n);
        d += (k ? " L " : "M ") + (cx + r * Math.cos(a)).toFixed(1) + " " + (cy + r * Math.sin(a)).toFixed(1);
      }
      return d;
    };
    const clamp1 = (v: number) => Math.max(-1, Math.min(1, v));

    let sp = 0, lastActive = 0, leaveTimer = 0;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const dial = matchMedia("(max-width: 1024px)");
    phasesEls[0].classList.add("show");

    const place = (dot: HTMLElement, x: number, y: number, size: number) => {
      dot.style.left = x + "px";
      dot.style.top = y + "px";
      dot.style.width = size + "px";
      dot.style.height = size + "px";
      dot.style.fontSize = (size * 0.34).toFixed(1) + "px";
    };

    const frame = () => {
      const r = scroll.getBoundingClientRect();
      const total = scroll.offsetHeight - innerHeight;
      const target = Math.min(1, Math.max(0, -r.top / total)) * (N - 1);
      sp += (target - sp) * (reduce ? 1 : 0.18);
      if (Math.abs(target - sp) < 0.001) sp = target;

      const active = Math.round(sp);

      if (dial.matches) {
        // Dial: circle centred below the screen, active dot at its top.
        // Past phases slide off to the left, upcoming ones wait on the right.
        // stage is 100svh; innerHeight grows when the phone URL bar hides, so measure the stage
        const W = root.clientWidth, H = stage.clientHeight, RD = 620;
        const stepD = Math.asin(Math.min(W * 0.36, 200) / RD);
        const short = H < 500, small = W < 768 || short;
        const cx = W / 2, cy = H - (short ? 36 : small ? 60 : 68) + RD;
        const top = -Math.PI / 2;
        dots.forEach((dot, i) => {
          const a = top - (sp - i) * stepD;
          const size = (short ? 44 : small ? 54 : 64) - Math.min(1, Math.abs(sp - i)) * (small ? 14 : 16);
          place(dot, cx + RD * Math.cos(a), cy + RD * Math.sin(a), size);
          dot.classList.toggle("on", i === active);
        });
        const aL = -Math.acos(clamp1((-80 - cx) / RD));
        const aR = -Math.acos(clamp1((W + 80 - cx) / RD));
        grey.setAttribute("d", arc(cx, cy, RD, aL, aR));
        ink.setAttribute("d", arc(cx, cy, RD, aL, top - (sp - active) * stepD));
      } else {
        const cy = innerHeight / 2;
        dots.forEach((dot, i) => {
          const a = (sp - i) * STEP;
          place(dot, CX + R * Math.cos(a), cy + R * Math.sin(a), 78 - Math.min(1, Math.abs(sp - i)) * 20);
          dot.classList.toggle("on", i === active);
        });
        const aTop = Math.asin(clamp1((-80 - cy) / R));
        const aBot = Math.asin(clamp1((innerHeight + 80 - cy) / R));
        grey.setAttribute("d", arc(CX, cy, R, aTop, aBot));
        ink.setAttribute("d", arc(CX, cy, R, (sp - active) * STEP, aBot));
      }

      if (active !== lastActive) {
        root.style.setProperty("--d", active > lastActive ? "1" : "-1");
        const prev = phasesEls[lastActive];
        lastActive = active;
        phasesEls.forEach((el) => el.classList.remove("show", "leave"));
        prev.classList.add("leave");
        clearTimeout(leaveTimer);
        leaveTimer = window.setTimeout(() => prev.classList.remove("leave"), 320);
        phasesEls[active].classList.add("show");
        detent(dots[active]);
      }
      if (running) raf = requestAnimationFrame(frame);
    };

    // Only run the loop while the section is near the viewport. On restart,
    // snap the eased value to the scroll target so a jump (e.g. #process)
    // doesn't sweep through every phase.
    let running = false, raf = 0;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) {
        running = true;
        const r = scroll.getBoundingClientRect();
        sp = Math.min(1, Math.max(0, -r.top / (scroll.offsetHeight - innerHeight))) * (N - 1);
        raf = requestAnimationFrame(frame);
      } else if (!e.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }, { rootMargin: "200px 0px" }).observe(root);
  }
</script>

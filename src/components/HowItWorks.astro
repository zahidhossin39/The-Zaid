---
const steps = [
  {
    n: "01",
    title: "Tell me what's stuck",
    body: "One call, twenty minutes. You describe the problem. I tell you honestly whether I'm the right person for it, and roughly what it takes.",
  },
  {
    n: "02",
    title: "I build it in the open",
    body: "You see progress every few days, not at the end. If it's heading the wrong way, we catch it in week one instead of week six.",
  },
  {
    n: "03",
    title: "You get the keys",
    body: "The code, the accounts, the documentation. It's yours. No retainer required to keep the thing running.",
  },
];
---
<section class="mx-auto max-w-[64rem] px-6 py-20 md:px-8 md:py-32">
  <p class="eyebrow reveal">How it works</p>
  <h2 class="h2 reveal mt-5 max-w-[20ch]" data-delay="80">A straight line, not a maze.</h2>

  <div class="relative mt-16">
    <!-- the spine: horizontal on desktop, hidden on mobile -->
    <div aria-hidden="true" class="absolute left-0 right-0 top-[0.6875rem] hidden h-px bg-border md:block"></div>

    <ol class="grid gap-12 md:grid-cols-3 md:gap-10">
      {steps.map((s, i) => (
        <li class="reveal relative" data-delay={i * 110}>
          <div class="flex items-center gap-3 md:block">
            <span class="relative z-10 grid h-[1.375rem] w-[1.375rem] place-items-center rounded-full border border-accent bg-bg">
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            </span>
            <span class="font-mono text-sm text-accent md:mt-5 md:block">{s.n}</span>
          </div>
          <h3 class="h3 mt-4 md:mt-2">{s.title}</h3>
          <p class="mt-2.5 max-w-[32ch] text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

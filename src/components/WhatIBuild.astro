---
// Expand-on-hover list (from lab/whatibuild prototype), folded into the real
// site. This section is a light black-on-white band (same palette as the
// prototype) inset into the otherwise-dark site. Hover reveals the description
// + a warm-clay image card that rotates into place (settles -5deg).
const items = [
  { n: "01", label: "Websites", sub: "A site with one clear job: getting customers to call, book or buy. Everything behind it is set up to make that happen.", img: "/clay-web.jpg" },
  { n: "02", label: "Automations", sub: "The replies, follow-ups and record-keeping each new customer creates. They run on their own, so you're not the one doing them.", img: "/clay-auto.jpg" },
];
---
<section class="band">
  <div class="mx-auto max-w-[64rem] px-6 py-20 md:px-8 md:py-32">
    <p class="eyebrow reveal">What I build</p>
    <h2 class="lead reveal mt-5 max-w-[22ch]" data-delay="80">
      One brings customers in. The other handles the work.
    </h2>

    <div class="list reveal mt-14" data-delay="140">
      {items.map((it) => (
        <a class="row" href="#book">
          <span class="num">{it.n}</span>
          <span class="main">
            <h3 class="rtitle">{it.label}</h3>
            <p class="sub">{it.sub}</p>
          </span>
          <span class="media"><span class="card"><img src={it.img} alt={it.label} /></span></span>
          <span class="arrow-wrap">
            <span class="arrow">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* black-on-white band, same palette as the prototype (light section on dark site) */
  .band { background: #ffffff; color: #111111; }
  .band .eyebrow { color: #9a968d; }
  .lead { font-family: "PT Sans Narrow", var(--font-sans); font-weight: 700;
          font-size: clamp(2.2rem, 4.4vw, 3.4rem); line-height: 1.02; letter-spacing: -.01em;
          color: #111111; }

  .list { border-bottom: 1px solid #e6e4e0; }
  .row { position: relative; display: grid; grid-template-columns: 5rem minmax(0, 1fr) 3.4rem;
         align-items: start; column-gap: 2rem; min-height: 6.8rem; padding: 2.2rem 0;
         border-top: 1px solid #e6e4e0; text-decoration: none; color: inherit;
         cursor: pointer; transition: min-height .55s cubic-bezier(.22,.61,.36,1); }
  .row:hover { min-height: 18rem; }

  .num { font-family: "PT Sans Narrow", var(--font-sans); font-weight: 700; font-size: 2.5rem;
         line-height: 1; color: #c3c0b9; transition: color .4s ease; }
  .rtitle { font-family: "PT Sans Narrow", var(--font-sans); font-weight: 700;
            font-size: clamp(1.7rem, 2.8vw, 2.2rem); line-height: 1; letter-spacing: .01em;
            text-transform: uppercase; color: #c3c0b9; margin: 0; transition: color .4s ease; }
  .sub { font-size: 1rem; line-height: 1.5; color: #6a675f; opacity: 0; margin-top: 0;
         max-width: 34ch; max-height: 0; overflow: hidden;
         transition: opacity .45s ease .05s, margin-top .5s ease, max-height .55s ease; }

  /* image card — rotates into place, settling at -5deg (matches reference) */
  .media { position: absolute; right: 6rem; top: 50%; opacity: 0; pointer-events: none;
           transform: translateY(-50%) rotate(-20deg) scale(.8); transform-origin: center;
           transition: opacity .45s ease, transform .55s cubic-bezier(.22,1,.36,1); }
  .card { display: block; width: clamp(320px, 31vw, 440px); aspect-ratio: 1.792; border-radius: 16px;
          overflow: hidden; background: #f2efe8; border: 3px solid #e6e6e6;
          box-shadow: 0 20px 42px rgba(30,25,15,.11); }
  .card img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .arrow-wrap { display: flex; justify-content: flex-end; }
  .arrow { width: 3rem; height: 3rem; border-radius: 999px; background: #111111;
           color: #ffffff; display: grid; place-items: center; transition: transform .4s ease; }
  .arrow svg { width: 1.1rem; height: 1.1rem; }

  /* hover expand */
  .row:hover .num, .row:hover .rtitle { color: #111111; }
  .row:hover .sub { opacity: 1; margin-top: .9rem; max-height: 6rem; }
  .row:hover .media { opacity: 1; transform: translateY(-50%) rotate(-5deg) scale(1); }
  .row:hover .arrow { transform: translateX(4px); }

  @media (max-width: 720px) {
    .row { grid-template-columns: 3rem 1fr 2.6rem; }
    .media { display: none; }
    .num { font-size: 1.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .row, .sub, .media, .arrow { transition: none; }
  }
</style>

---
// Expand-on-hover list (from lab/whatibuild prototype), folded into the real
// site. This section is a light black-on-white band (same palette as the
// prototype) inset into the otherwise-dark site. Hover reveals the description
// + a warm-clay image card that rotates into place (settles -5deg).
const items = [
  { n: "01", label: "Websites", sub: "A site with one clear job: getting customers to call, book or buy. Everything behind it is set up to make that happen.", img: "/clay-web.webp" },
  { n: "02", label: "Automations", sub: "The replies, follow-ups and record-keeping each new customer creates. They run on their own, so you're not the one doing them.", img: "/clay-auto.webp" },
];
---
<section class="band">
  <div class="mx-auto max-w-[64rem] px-6 py-20 md:px-8 md:py-32">
    <p class="eyebrow reveal">What I build</p>
    <h2 class="lead reveal mt-5 max-w-[22ch]" data-delay="80">
      One brings customers in. The other handles the work.
    </h2>

    <div class="list reveal mt-14" data-delay="140">
      {items.map((it) => (
        <a class="row" href="#book">
          <span class="num">{it.n}</span>
          <span class="main">
            <h3 class="rtitle">{it.label}</h3>
            <p class="sub">{it.sub}</p>
          </span>
          <span class="media"><span class="card"><img src={it.img} srcset={`${it.img.replace(".webp", "-640.webp")} 640w, ${it.img} 960w`} sizes="(max-width: 767px) 90vw, 440px" alt={it.label} width="960" height="528" loading="lazy" decoding="async" /></span></span>
          <span class="arrow-wrap">
            <span class="arrow">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* black-on-white band, same palette as the prototype (light section on dark site) */
  .band { background: #ffffff; color: #111111; }
  .band .eyebrow { color: #6f6c66; }
  .lead { font-family: "PT Sans Narrow", var(--font-sans); font-weight: 700;
          font-size: clamp(2.2rem, 4.4vw, 3.4rem); line-height: 1.02; letter-spacing: -.01em;
          color: #111111; }

  .list { border-bottom: 1px solid #e6e4e0; }
  .row { position: relative; display: grid; grid-template-columns: 5rem minmax(0, 1fr) 3.4rem;
         align-items: start; column-gap: 2rem; min-height: 6.8rem; padding: 2.2rem 0;
         border-top: 1px solid #e6e4e0; text-decoration: none; color: inherit;
         cursor: pointer; transition: min-height .55s cubic-bezier(.22,.61,.36,1); }
  .row:hover { min-height: 18rem; }
  /* black ring to match the band (global ring is the site accent) */
  .row:focus-visible { outline: 2px solid #111111; outline-offset: 6px; border-radius: 4px; }

  .num { font-family: "PT Sans Narrow", var(--font-sans); font-weight: 700; font-size: 2.5rem;
         line-height: 1; color: #6f6c66; transition: color .4s ease; }
  .rtitle { font-family: "PT Sans Narrow", var(--font-sans); font-weight: 700;
            font-size: clamp(1.7rem, 2.8vw, 2.2rem); line-height: 1; letter-spacing: .01em;
            text-transform: uppercase; color: #6f6c66; margin: 0; transition: color .4s ease; }
  .sub { font-size: 1rem; line-height: 1.5; color: #6a675f; opacity: 0; margin-top: 0;
         max-width: 34ch; max-height: 0; overflow: hidden;
         transition: opacity .45s ease .05s, margin-top .5s ease, max-height .55s ease; }

  /* image card — rotates into place, settling at -5deg (matches reference) */
  .media { position: absolute; right: 6rem; top: 50%; opacity: 0; pointer-events: none;
           transform: translateY(-50%) rotate(-20deg) scale(.8); transform-origin: center;
           transition: opacity .45s ease, transform .55s cubic-bezier(.22,1,.36,1); }
  .card { display: block; width: clamp(320px, 31vw, 440px); aspect-ratio: 1.792; border-radius: 16px;
          overflow: hidden; background: #f2efe8; border: 3px solid #e6e6e6;
          box-shadow: 0 20px 42px rgba(30,25,15,.11); }
  .card img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .arrow-wrap { display: flex; justify-content: flex-end; }
  .arrow { width: 3rem; height: 3rem; border-radius: 999px; background: #111111;
           color: #ffffff; display: grid; place-items: center; transition: transform .4s ease; }
  .arrow svg { width: 1.1rem; height: 1.1rem; }

  /* desktop: hover or keyboard focus expands the row */
  @media (hover: hover) and (min-width: 721px) {
    .row:is(:hover, :focus-visible, :focus-within) { min-height: 18rem; }
    .row:is(:hover, :focus-visible, :focus-within) :is(.num, .rtitle) { color: #111111; }
    .row:is(:hover, :focus-visible, :focus-within) .sub { opacity: 1; margin-top: .9rem; max-height: 6rem; }
    .row:is(:hover, :focus-visible, :focus-within) .media { opacity: 1; transform: translateY(-50%) rotate(-5deg) scale(1); }
    .row:is(:hover, :focus-visible, :focus-within) .arrow { transform: translateX(4px); }
  }

  /* touch + phones: no hover, so rows stay open (no layout shift) and the
     card rotates into place when the row scrolls into view (.is-on, set by JS) */
  @media (hover: none), (max-width: 720px) {
    .row { min-height: 18rem; }
    .sub { opacity: 1; margin-top: .9rem; max-height: none; }
    .row.is-on .num, .row.is-on .rtitle { color: #111111; }
    .row.is-on .media { opacity: 1; transform: translateY(-50%) rotate(-5deg) scale(1); }
  }

  /* tablets: smaller card so it clears the description column */
  @media (min-width: 721px) and (max-width: 1023px) {
    .media { right: 4.5rem; }
    .card { width: clamp(200px, 27vw, 440px); }
    .sub { max-width: 28ch; }
  }

  /* phones: the card moves under the text instead of floating on the right */
  @media (max-width: 720px) {
    .band { overflow-x: clip; }
    .row { grid-template-columns: 3rem minmax(0, 1fr) 2.6rem; column-gap: 1rem; min-height: 0; }
    .num { font-size: 1.8rem; }
    .arrow-wrap { grid-column: 3; grid-row: 1; }
    .arrow { width: 2.6rem; height: 2.6rem; }
    .media { display: block; position: static; grid-column: 1 / -1; grid-row: 2; margin-top: 1.75rem;
             transform: rotate(-14deg) scale(.88); }
    .row.is-on .media { transform: rotate(-4deg) scale(1); }
    .card { width: 100%; max-width: 30rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .row, .sub, .media, .arrow { transition: none; }
  }
</style>

<script>
  // Touch/phone mode: open each row's card once it's well into view.
  const mq = matchMedia("(hover: none), (max-width: 720px)");
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add("is-on"); io.unobserve(e.target); }
    }),
    { rootMargin: "0px 0px -25% 0px", threshold: 0.35 }
  );
  const watch = () => { if (mq.matches) document.querySelectorAll(".band .row:not(.is-on)").forEach((r) => io.observe(r)); };
  watch();
  mq.addEventListener("change", watch);
</script>

---

<header class="navbar">
  <div class="navbar-inner">
    <a href="#" class="logo">Zaid Hossain</a>
    <nav class="nav-links">
      <a href="#proof" class="nav-link">Work</a>
      <a href="#about" class="nav-link nav-about">About</a>
      <a href="#book" class="nav-link nav-cta" data-cal-intent>Book a call</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    color: #ffffff;
    height: 4rem;
    font-family: "Inter Tight", system-ui, sans-serif;
    mix-blend-mode: difference;
  }

  .navbar-inner {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 700;
    font-size: 1rem;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  /* "Book a call" keeps its pill padding at all times, so showing the outline
     never moves anything. The negative margin cancels the padding, so the
     text sits exactly where a plain link would and the outline hangs into the
     gutter. The outline is a pseudo-element faded by opacity. */
  .nav-cta {
    position: relative;
    padding: 0 0.875rem;
    margin: 0 -0.875rem;
  }

  .nav-cta::after {
    content: "";
    position: absolute;
    inset: 5px 0;
    border: 1px solid currentColor;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .navbar.is-pill .nav-cta::after {
    opacity: 1;
  }

  @media (max-width: 767px) {
    /* Headroom: fade out everything except the "Book a call" pill. Hidden
       items can't be clicked or focused (visibility flips after the fade). */
    .logo,
    .nav-link:not(.nav-cta) {
      transition: opacity 0.3s ease, visibility 0s;
    }

    .navbar.is-hidden .logo,
    .navbar.is-hidden .nav-link:not(.nav-cta) {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.3s ease, visibility 0s 0.3s;
    }

    .navbar-inner {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 399px) {
    .nav-about {
      display: none;
    }

    .nav-links {
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo,
    .nav-link,
    .nav-cta::after {
      transition: none !important;
    }
  }
</style>

<script>
  // Headroom (phones only): hide the fixed nav while scrolling down so it
  // doesn't sit on top of body text, bring it back on any scroll up.
  const nav = document.querySelector<HTMLElement>(".navbar");
  const phone = window.matchMedia("(max-width: 767px)");
  const TOP = 80; // always visible above this
  const JITTER = 6; // ignore scroll deltas smaller than this

  if (nav) {
    let lastY = Math.max(0, window.scrollY);
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      if (!phone.matches || y < TOP) {
        nav.classList.remove("is-hidden");
        lastY = y;
        return;
      }
      const delta = y - lastY;
      if (Math.abs(delta) < JITTER) return; // keep lastY so slow scrolls add up
      nav.classList.toggle("is-hidden", delta > 0);
      lastY = y;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    phone.addEventListener("change", update);
    // keyboard users tabbing into a hidden nav should see it
    nav.addEventListener("focusin", () => nav.classList.remove("is-hidden"));

    // Outline "Book a call" as a pill once the hero CTA has scrolled above the
    // viewport, so there's always one visible way to book.
    const heroCta = document.querySelector(".hero [data-cal-intent]");
    if (heroCta) {
      new IntersectionObserver(([e]) => {
        nav.classList.toggle("is-pill", !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(heroCta);
    }
  }
</script>

<header class="navbar">
  <div class="navbar-inner">
    <a href="#" class="logo">Zaid Hossain</a>
    <nav class="nav-links">
      <a href="#proof" class="nav-link">Work</a>
      <a href="#about" class="nav-link">About</a>
      <a href="#book" class="nav-link">Book a call</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    color: #ffffff;
    height: 4rem;
    font-family: "Inter Tight", system-ui, sans-serif;
    mix-blend-mode: difference;
  }

  .navbar-inner {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 700;
    font-size: 1rem;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
  }
</style>

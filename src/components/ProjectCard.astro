---
// Media is either a real walkthrough (youtubeId, click-to-load facade) or a
// hand-built mockup for demo projects (kind: "site" | "auto").
interface Props {
  title: string; stuck: string; now: string; tags: string[];
  kind?: "site" | "auto"; demo?: boolean; youtubeId?: string; liveUrl?: string;
}
const { title, stuck, now, tags, kind, demo, youtubeId, liveUrl } = Astro.props;
---
<article class="reveal group overflow-hidden rounded-xl border border-border bg-surface transition hover:border-muted/40">
  {youtubeId ? (
    <div class="relative aspect-video w-full bg-bg" data-yt={youtubeId}>
      <img src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`} alt="" loading="lazy" decoding="async"
           class="h-full w-full object-cover opacity-80 transition group-hover:opacity-100" />
      <button type="button" aria-label={`Play walkthrough: ${title}`}
              class="yt-play absolute inset-0 grid place-items-center bg-bg/30 transition hover:bg-bg/10">
        <span class="grid h-16 w-16 place-items-center rounded-full bg-accent shadow-lg transition group-hover:scale-110">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#0A0A0B" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
        </span>
      </button>
    </div>
  ) : kind === "site" ? (
    /* mock: a small-business booking site in a browser window.
       Below sm: no fixed ratio, columns stack like the site's own mobile view; bottom padding gives the toast empty space.
       Base CSS is the demo's final frame (10:30 picked, toast shown); the script plays it once in view. */
    <div class="mock relative sm:aspect-[4/3] md:aspect-video w-full overflow-hidden bg-[#1b1b1f] p-4 pb-10 md:p-5 md:pb-11" data-mock="site">
      <div class="h-full" aria-hidden="true">
        <div class="win flex h-full flex-col overflow-hidden rounded-lg bg-[#fbfaf7] text-[#111] shadow-2xl">
          <div class="flex items-center gap-2 border-b border-black/10 bg-[#f1efea] px-3 py-2">
            <i class="h-2 w-2 rounded-full bg-black/20"></i><i class="h-2 w-2 rounded-full bg-black/20"></i><i class="h-2 w-2 rounded-full bg-black/20"></i>
            <span class="ml-2 flex-1 truncate rounded-full bg-white px-3 py-0.5 font-mono text-[10px] text-black/50">harborpinedental.com</span>
          </div>
          <div class="flex items-center justify-between px-5 pt-3 text-[10px] text-black/55">
            <b class="font-semibold text-black">Harbor &amp; Pine</b>
            <span class="hidden gap-4 sm:flex"><span>Services</span><span>Team</span><span>Prices</span></span>
          </div>
          <div class="grid flex-1 grid-cols-1 items-center gap-4 px-5 pt-4 pb-16 sm:grid-cols-[1.2fr_1fr] sm:py-0">
            <div>
              <p class="font-display text-[clamp(1.1rem,2.6vw,1.6rem)] leading-[1.05]">Healthy smiles,<br/>booked in 30 seconds.</p>
              <p class="mt-2 text-[10px] leading-snug text-black/55">Family dentistry in Portside. Open evenings and Saturdays.</p>
              <span class="cta mt-3 inline-block rounded-full bg-[#111] px-3 py-1.5 text-[10px] font-medium text-white">Book an appointment →</span>
            </div>
            <div class="slot relative rounded-md border border-black/10 bg-white p-2.5 text-[9px] shadow-sm">
              <i class="ring pointer-events-none absolute -inset-px rounded-md border border-black"></i>
              <p class="font-semibold">Pick a time</p>
              <div class="mt-1.5 grid grid-cols-3 gap-1">
                {["9:00","10:30","11:15","14:00","15:30","17:45"].map((t, i) => (
                  <span class:list={["relative rounded bg-black/5 px-1 py-1 text-center", i === 1 && "pick"]}>{t}{i === 1 && <span class="fill absolute inset-0 grid place-items-center rounded bg-[#111] text-white">{t}</span>}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="toast absolute bottom-12 right-6 flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-[10px] text-[#111] shadow-xl md:bottom-14 md:right-8">
          <span class="grid h-4 w-4 place-items-center rounded-full bg-[#111] text-[8px] text-white">✓</span>
          New booking · Tue 10:30
        </div>
        <!-- fake cursor; its tip sits at (2, 1.5) in its own box -->
        <svg class="cursor pointer-events-none invisible absolute left-0 top-0 opacity-0" width="18" height="18" viewBox="0 0 18 18">
          <path d="M2 1.5v13.2l3.5-3.2 2.4 5.3 2.2-1-2.4-5.2h4.8z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="absolute inset-x-4 bottom-0 flex h-10 items-center justify-between md:inset-x-5 md:h-11">
        <span class="demo-tag">Demo</span>
        <button type="button" class="replay" aria-label={`Replay demo: ${title}`} hidden>Replay</button>
      </div>
    </div>
  ) : (
    /* mock: an automation flow with a run log. Base CSS is the final frame (all steps lit, newest row on top). */
    <div class="mock relative w-full overflow-hidden bg-[#1b1b1f] p-4 pb-10 md:p-5 md:pb-11" data-mock="auto">
      <div aria-hidden="true">
        <!-- light panel, matching the site demo's window -->
        <div class="rounded-lg bg-[#fbfaf7] p-4 font-mono text-[10px] text-[#111] shadow-2xl md:p-6">
          <!-- below sm: vertical flow, one full-width row per node -->
          <div class="grid grid-cols-1 items-stretch gap-2 sm:grid-cols-[1fr_auto_1fr_auto_1fr]">
            {[["New lead", "Website form"], ["AI drafts reply", "Personal, on-brand"], ["Sent + logged", "Email · customer list · chat"]].map(([a, b], i) => (
              <>
                {i > 0 && <span class="wire relative h-4 w-px justify-self-center self-center bg-black/15 sm:h-px sm:w-6 md:w-10"></span>}
                <div class="node relative flex flex-wrap items-baseline gap-x-3 rounded-lg border border-black/10 bg-white px-3 py-2 sm:block sm:px-2.5">
                  <i class="lit pointer-events-none absolute -inset-px rounded-lg border border-black"></i>
                  <p class="text-[8px] uppercase tracking-[0.14em] text-black/45">Step {i + 1}</p>
                  <p class="font-sans text-[12px] font-semibold text-black sm:mt-1 sm:text-[11px]">{a}</p>
                  <p class="text-[10px] text-black/55 sm:text-[9px]">{b}</p>
                </div>
              </>
            ))}
          </div>
          <div class="log mt-5">
            <p class="mb-1.5 flex justify-between text-[8px] uppercase tracking-[0.14em] text-black/45"><span>Run log</span><span>Demo run</span></p>
            {/* newest first: the first row is the one this run adds, the rest are dimmed history */}
            {[["10:03:09", "Mark T. · reply sent in 38s"], ["09:30:00", "Owner summary sent"], ["09:17:50", "Dental Co. · added to customer list"], ["09:02:14", "Sarah K. · reply sent in 41s"]].map(([t, m], i) => (
              <p class:list={["row flex gap-3 border-t border-black/5 py-1", i > 0 && "opacity-50"]}><span class="text-black/45">{t}</span><span>{m}</span><span class="ml-auto text-black/60">✓</span></p>
            ))}
          </div>
        </div>
      </div>
      <div class="absolute inset-x-4 bottom-0 flex h-10 items-center justify-between md:inset-x-5 md:h-11">
        <span class="demo-tag">Demo</span>
        <button type="button" class="replay" aria-label={`Replay demo: ${title}`} hidden>Replay</button>
      </div>
    </div>
  )}

  <div class="p-6 md:p-7">
    <div class="flex items-start justify-between gap-4">
      <h3 class="h3">{title}</h3>
      {demo && <span class="shrink-0 rounded-full border border-border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-muted">Demo</span>}
    </div>

    <dl class="mt-4 space-y-2 text-[0.95rem]">
      <div class="flex gap-3">
        <dt class="w-14 shrink-0 font-mono text-xs uppercase tracking-[0.1em] text-muted pt-1">Stuck</dt>
        <dd class="text-muted">{stuck}</dd>
      </div>
      <div class="flex gap-3">
        <dt class="w-14 shrink-0 font-mono text-xs uppercase tracking-[0.1em] text-accent pt-1">Now</dt>
        <dd class="text-text">{now}</dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-5">
      <ul class="flex flex-wrap gap-2">
        {tags.map((t) => (
          <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">{t}</li>
        ))}
      </ul>
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-accent transition hover:text-accent-hover">
          Visit it live ↗
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* Base state = each demo's final frame; no-JS and reduced-motion visitors see this. */
  .wire::after { content: ""; position: absolute; inset: 0; background: #111; transform: scaleX(var(--d, 1)); transform-origin: left; }
  @media (max-width: 639.98px) {
    .wire::after { transform: scaleY(var(--d, 1)); transform-origin: top; }
  }
  .demo-tag, .replay { font-family: var(--font-mono), ui-monospace, monospace; font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #fff; }
  .demo-tag { border: 1px solid rgb(255 255 255 / .4); border-radius: 999px; padding: 1px 8px; }
  /* padding gives a bigger tap target; negative margin keeps the text aligned to the edge */
  .replay { margin-right: -8px; padding: 8px; cursor: pointer; text-underline-offset: 3px; }
  .replay:hover { text-decoration: underline; }
  .replay:focus-visible { outline: 1px solid #fff; outline-offset: -2px; }
</style>

<script>
  // Demos: each mock plays once when it crosses the viewport centre, then holds its final frame.
  // It replays on re-entry only after it has fully left the viewport, or from its Replay button.
  import { gsap } from "gsap";

  const mocks = [...document.querySelectorAll<HTMLElement>(".mock")];

  // centre of `el` in the mock's coordinates, minus the cursor tip offset (2, 1.5)
  const pt = (mock: HTMLElement, el: Element, axis: "x" | "y") => () => {
    const r = el.getBoundingClientRect(), m = mock.getBoundingClientRect();
    return axis === "x" ? r.left - m.left + r.width / 2 - 2 : r.top - m.top + r.height / 2 - 1.5;
  };

  // Every tween is a fromTo, so invalidate()/restart() never reuse stale "from" values.
  // Later tweens on an already-animated property skip immediateRender so they don't clobber the first one's start.
  const later = { immediateRender: false };

  function siteTl(m: HTMLElement) {
    const q = (s: string) => m.querySelector(s)!;
    const cursor = q(".cursor"), cta = q(".cta"), pick = q(".pick");
    return gsap.timeline({ paused: true })
      .fromTo(cursor, { x: () => m.clientWidth * 0.82, y: () => m.clientHeight * 0.92 },
        { x: pt(m, cta, "x"), y: pt(m, cta, "y"), duration: 0.8, ease: "power2.inOut" }, 0)
      .fromTo(cursor, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.2 }, 0)
      .fromTo(cta, { scale: 1 }, { scale: 0.96, duration: 0.12, ease: "power2.out", ...later }, 0.95)
      .fromTo(cta, { scale: 0.96 }, { scale: 1, duration: 0.25, ease: "power2.out", ...later }, 1.07)
      .fromTo(q(".ring"), { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3 }, 1.35)
      .fromTo(cursor, { x: pt(m, cta, "x"), y: pt(m, cta, "y") },
        { x: pt(m, pick, "x"), y: pt(m, pick, "y"), duration: 0.6, ease: "power2.inOut", ...later }, 1.5)
      .fromTo(q(".fill"), { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.2 }, 2.2)
      .fromTo(q(".toast"), { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: "power3.out" }, 2.6)
      .fromTo(cursor, { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.3, ...later }, 3.1);
  }

  function autoTl(m: HTMLElement) {
    const nodes = m.querySelectorAll(".node"), lits = m.querySelectorAll(".lit"), wires = m.querySelectorAll(".wire");
    const rows = [...m.querySelectorAll<HTMLElement>(".row")];
    const tl = gsap.timeline({ paused: true });
    const light = (i: number, at: number) => tl
      .fromTo(nodes[i], { opacity: 0.4 }, { opacity: 1, duration: 0.25 }, at)
      .fromTo(lits[i], { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.25 }, at);
    const fill = (i: number, at: number) =>
      tl.fromTo(wires[i], { "--d": 0 }, { "--d": 1, duration: 0.5, ease: "power1.inOut" }, at);
    light(0, 0); fill(0, 0.25); light(1, 0.75); fill(1, 1); light(2, 1.5);
    // the new row fades in on top while the older rows slide down into place
    return tl
      .fromTo(rows[0], { autoAlpha: 0, y: -8 }, { autoAlpha: 1, y: 0, duration: 0.35, ease: "power3.out" }, 1.5)
      .fromTo(rows.slice(1), { y: () => -rows[0].offsetHeight }, { y: 0, duration: 0.35, ease: "power3.out" }, 1.5);
  }

  if (mocks.length) gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const tls = mocks.map((m) => (m.dataset.mock === "site" ? siteTl(m) : autoTl(m)));
    const armed = mocks.map(() => true);
    const ac = new AbortController();

    // one demo at a time: finish any other that is still running
    const play = (i: number) => {
      tls.forEach((t, j) => j !== i && t.isActive() && t.progress(1));
      // invalidate to re-measure (fonts/layout may have shifted). An invalidated tween only re-applies its
      // "from" state once it has rendered forward again, so render 0 -> end -> 0 before playing.
      tls[i].invalidate().progress(0, true).progress(1, true).progress(0, true).play();
    };
    // edge = "centre" (init: the mock's centre is above the viewport centre) or "bottom" (the whole mock is above it)
    const passed = (m: HTMLElement, edge: "centre" | "bottom") => {
      const r = m.getBoundingClientRect();
      return (edge === "centre" ? r.top + r.height / 2 : r.bottom) < innerHeight / 2;
    };
    // a demo already past the centre (refresh, deep link, fast jump) shows its final frame, never its start.
    // Only never-played (still paused) timelines qualify. After init we only settle mocks that are fully above
    // the centre line; one still on the line is the centre observer's to play.
    const settle = (i: number, edge: "centre" | "bottom") => {
      const tl = tls[i];
      if (tl.paused() && tl.progress() === 0 && passed(mocks[i], edge)) { tl.progress(1); armed[i] = false; }
    };

    const centre = new IntersectionObserver((es) => es.forEach((e) => {
      const i = mocks.indexOf(e.target as HTMLElement);
      if (e.isIntersecting && armed[i]) { armed[i] = false; play(i); }
    }), { rootMargin: "-50% 0px -49% 0px" });
    // plain observer: re-arm only once the mock has fully left the viewport
    const view = new IntersectionObserver((es) => es.forEach((e) => {
      const i = mocks.indexOf(e.target as HTMLElement);
      if (e.isIntersecting) settle(i, "bottom"); else { armed[i] = true; tls[i].pause(0); }
    }));

    mocks.forEach((m, i) => {
      settle(i, "centre");
      centre.observe(m);
      view.observe(m);
      const btn = m.querySelector<HTMLButtonElement>(".replay")!;
      btn.hidden = false;
      btn.addEventListener("click", () => { if (!tls[i].isActive()) play(i); }, { signal: ac.signal });
    });

    let timer = 0;
    addEventListener("resize", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => tls.forEach((tl) => {
        const done = tl.progress() === 1;
        tl.invalidate();
        if (done) tl.progress(1);
      }), 200);
    }, { signal: ac.signal });

    return () => {
      ac.abort();
      clearTimeout(timer);
      centre.disconnect();
      view.disconnect();
      mocks.forEach((m) => (m.querySelector<HTMLButtonElement>(".replay")!.hidden = true));
    };
  });
</script>

---
// The working day as a line: 8 hour slots, all full, 3 customers left over.
// "problem": the full bar with times and "+3 waiting".
// "book": a compact reprise where the 3 leftovers sit in a "handled for you" lane.
// Base CSS is the final frame; JS (motion allowed only) sets the start states.
interface Props { variant?: "problem" | "book" }
const { variant = "problem" } = Astro.props;
const ticks = Array.from({ length: 9 }, (_, i) => i * 12.5);
const slots = Array.from({ length: 8 }, (_, i) => i * 12.5 + 6.25);
const extras = [0, 1, 2];
---
<div class={`hb hb--${variant}`} data-bar={variant} aria-hidden="true">
  <div class="hb-track">
    {ticks.map((x) => <i class="hb-tick" style={`left:${x}%`}></i>)}
    {slots.map((x) => <b class="hb-dot" style={`left:${x}%`}></b>)}
  </div>
  {variant === "problem" ? (
    <>
      <div class="hb-over">{extras.map(() => <b class="hb-extra"></b>)}</div>
      <div class="hb-times">
        <span class="hb-start">9 am</span>
        <span class="hb-mid">1 pm</span>
        <span class="hb-end">5 pm</span>
      </div>
      <span class="hb-wait">+3 waiting</span>
    </>
  ) : (
    <>
      <div class="hb-lane"><span>handled for you</span><i></i></div>
      <div class="hb-over hb-done">{extras.map(() => <b class="hb-extra"></b>)}</div>
    </>
  )}
</div>

<style>
  .hb {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 12px;
    row-gap: 10px;
    align-items: center;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--color-muted);
  }
  .hb-track { position: relative; height: 12px; }
  /* the line itself: fixed length, it never grows */
  .hb-track::before {
    content: "";
    position: absolute;
    inset: calc(50% - 0.5px) 0 auto;
    height: 1px;
    background: rgb(244 242 237 / 0.28);
  }
  .hb-tick {
    position: absolute;
    top: 50%;
    width: 1px;
    height: 7px;
    margin: -3.5px 0 0 -0.5px;
    background: var(--color-muted);
  }
  .hb-dot, .hb-extra {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text);
  }
  .hb-dot { position: absolute; top: 50%; margin: -3px 0 0 -3px; }
  .hb-over { display: flex; align-items: center; gap: 8px; height: 12px; }
  .hb-extra { opacity: 0.35; }

  .hb-times { position: relative; height: 1em; }
  .hb-times span { position: absolute; top: 0; white-space: nowrap; }
  .hb-start { left: 0; }
  .hb-end { right: 0; }
  .hb-mid { left: 50%; transform: translateX(-50%); display: none; }
  @media (min-width: 480px) { .hb-mid { display: block; } }
  .hb-wait { white-space: nowrap; color: var(--color-text); }

  /* compact reprise: row 1 = the day, row 2 = the "handled for you" lane */
  .hb--book { row-gap: 12px; }
  .hb--book .hb-track { grid-area: 1 / 1; }
  .hb-lane {
    grid-area: 2 / 1;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 12px;
    white-space: nowrap;
  }
  .hb-lane i { flex: 1; border-top: 1px dashed rgb(244 242 237 / 0.28); }
  .hb-done { grid-area: 2 / 2; }
  .hb-done .hb-extra { opacity: 1; }
</style>

<script>
  import type { gsap as G } from "gsap";
  import { whenNear, loadGsap } from "../scripts/near";
  let gsap: typeof G; // loaded when the first bar gets near

  const inReadingZone = (el: Element, fn: () => void) => {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        fn();
      },
      { threshold: 0.4, rootMargin: "0px 0px -10% 0px" }
    );
    io.observe(el);
    return io;
  };
  const midY = (el: Element) => {
    const r = el.getBoundingClientRect();
    return r.top + r.height / 2;
  };

  // Visitor clicked "Book a call": they came for the calendar, so the reprise
  // shows its final frame instead of moving while they arrive.
  let calIntent = false;
  let skips: Array<() => void> = [];
  document.addEventListener(
    "click",
    (e) => {
      if (!(e.target as Element | null)?.closest?.("[data-cal-intent]")) return;
      calIntent = true;
      skips.forEach((f) => f());
    },
    true
  );

  // Cal mounting into #cal-embed = the calendar has replaced its placeholder.
  let calMounted = false;
  let onCalMounted = () => {};
  const embed = document.getElementById("cal-embed");
  if (embed) {
    const mo = new MutationObserver(() => {
      mo.disconnect();
      calMounted = true;
      onCalMounted();
    });
    mo.observe(embed, { childList: true });
  }

  whenNear(document.querySelector("[data-bar]"), async () => {
  gsap = await loadGsap();
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const ios: IntersectionObserver[] = [];
    let timer = 0;

    // each bar builds its timeline only when it gets near (the book bar measures layout)
    document.querySelectorAll<HTMLElement>('[data-bar="problem"]').forEach((bar) => whenNear(bar, () => {
      const drop = { y: -10, autoAlpha: 0 };
      const tl = gsap
        .timeline({ paused: true })
        .fromTo(bar.querySelectorAll(".hb-dot"), drop,
          { y: 0, autoAlpha: 1, duration: 0.3, ease: "power2.out", stagger: 0.14 })
        .fromTo(bar.querySelectorAll(".hb-extra"), drop,
          { y: 0, autoAlpha: 0.35, duration: 0.3, ease: "power2.out", stagger: 0.14 }, ">+0.15")
        // "+3 waiting" lands with the last overflow dot (2 x 0.14 in)
        .fromTo(bar.querySelector(".hb-wait"), { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3 }, "<+0.28");
      ios.push(inReadingZone(bar, () => tl.play()));
    }));

    document.querySelectorAll<HTMLElement>('[data-bar="book"]').forEach((bar) => whenNear(bar, () => {
      const track = bar.querySelector(".hb-track")!;
      const done = bar.querySelector(".hb-done")!;
      // start: dim, up in the overflow spot past the end of the day line
      const tl = gsap.timeline({ paused: true }).fromTo(
        bar.querySelectorAll(".hb-extra"),
        { y: () => midY(track) - midY(done), autoAlpha: 0.35 },
        { y: 0, autoAlpha: 1, duration: 0.6, ease: "power3.out", stagger: 0.06 }
      );
      let started = false;
      const start = (animate: boolean) => {
        if (started) return;
        started = true;
        clearTimeout(timer);
        animate ? tl.play() : tl.progress(1);
      };
      if (calIntent) start(false);
      skips.push(() => start(false));
      ios.push(
        inReadingZone(bar, () => {
          if (calIntent) return start(false);
          if (calMounted) return start(true);
          onCalMounted = () => start(true);
          timer = window.setTimeout(() => start(true), 1200);
        })
      );
    }));

    return () => {
      ios.forEach((io) => io.disconnect());
      clearTimeout(timer);
      skips = [];
      onCalMounted = () => {};
    };
  });
  });
</script>

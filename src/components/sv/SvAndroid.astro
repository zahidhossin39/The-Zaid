---
// "And it's on my phone too": the Android beta. A dark phone mock-up with a
// chat app, the keyboard up and the Silent Voice bubble floating above it.
// Tap the bubble (or the button under the phone): it listens with the
// desktop pill's bars and an orange ring that swells with the voice, tap
// again and the cleaned words are typed into the field and sent. The bubble
// can be dragged around the screen and always settles above the keyboard,
// like the real one. Base markup is the finished frame (listening + typed),
// so it reads with JS off and under reduced motion.
import { siAndroid } from "simple-icons";

const APK_URL = "https://github.com/zahidhossin39/Silent-Voice/releases";

type Tok = { w: string; cut?: boolean; to?: string };
type Script = { say: Tok[]; text: string; reply: string };

// What you say -> what is typed. The clean-up shown is what the phone does:
// ums dropped, stutters fixed, numbers as digits, "new line".
const scripts: Script[] = [
  {
    say: [
      { w: "um,", cut: true }, { w: "I'll", cut: true }, { w: "I'll" }, { w: "be" }, { w: "there" }, { w: "in" },
      { w: "uh", cut: true }, { w: "twenty five", to: "25" }, { w: "minutes" },
    ],
    text: "I'll be there in 25 minutes.",
    reply: "Perfect. Want me to order for you?",
  },
  {
    say: [
      { w: "uh,", cut: true }, { w: "yes" }, { w: "please" }, { w: "new line", to: "↵" }, { w: "a" }, { w: "flat" },
      { w: "white" }, { w: "with", cut: true }, { w: "with" }, { w: "oat" }, { w: "milk" },
    ],
    text: "Yes please.\nA flat white with oat milk.",
    reply: "Done. See you soon.",
  },
  {
    say: [{ w: "um,", cut: true }, { w: "thanks" }, { w: "you're" }, { w: "the", cut: true }, { w: "the" }, { w: "best" }],
    text: "Thanks, you're the best.",
    reply: "Anytime.",
  },
];
const first = scripts[0];

const ICON = {
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9.5 9.5v3M12 8v6M14.5 10v2"/>',
  clean: '<path d="M4 7h10M4 12h7M4 17h5"/><path d="m14 15 2.5 2.5L21 13"/>',
  words: '<path d="M4 19 9 5l5 14M5.8 14h6.4"/><path d="M18 8v8M14 12h8"/>',
  modes: '<path d="M12 3.5l1.8 4.7 4.7 1.8-4.7 1.8L12 16.5l-1.8-4.7L5.5 10l4.7-1.8z"/><path d="M18.5 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>',
  history: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  free: '<path d="m8.5 8-4 4 4 4M15.5 8l4 4-4 4M13.5 5.5l-3 13"/>',
};

const left = [
  {
    key: "device",
    ic: ICON.phone,
    t: "Runs on the phone",
    d: "Parakeet 110M, an on-device speech model, turns your voice into text right there. One download of about 110 MB, then it works offline.",
  },
  {
    key: "clean",
    ic: ICON.clean,
    t: "Cleaned before it's typed",
    d: "Drops the ums, fixes stutters and writes numbers as digits. Say “new line” to start a new line.",
  },
  {
    key: "words",
    ic: ICON.words,
    t: "Knows your words",
    d: "Add names and jargon so it spells them right. Shortcuts type longer text: say “my email” and your address appears.",
  },
];
const right = [
  {
    key: "modes",
    ic: ICON.modes,
    t: "Writing modes, if you want them",
    d: "Polish, Message, Email or Notes rewrite your words using your own AI key. Only text is sent, never audio, and the key is encrypted on the phone. Exact words, the default, stays on the phone.",
  },
  {
    key: "history",
    ic: ICON.history,
    t: "History stays with you",
    d: "Past dictations are kept on the phone only, so a sentence is never lost. Password fields are never touched.",
  },
  {
    key: "free",
    ic: ICON.free,
    t: "Free and open source",
    d: "No account, no ads, no tracking.",
  },
];

const rows: string[][] = [
  [..."qwertyuiop"],
  [..."asdfghjkl"],
  ["⇧", ..."zxcvbnm", "⌫"],
  ["?123", ",", " ", ".", "↵"],
];
const keyClass = (k: string) =>
  k === " " ? "k k--space" : ["⇧", "⌫", "?123"].includes(k) ? "k k--fn" : k === "↵" ? "k k--enter" : "k";

const alt = `Phone mock-up: a chat app with the keyboard open and the Silent Voice bubble floating above it. You say “${first.say
  .map((t) => t.w)
  .join(" ")}”, and “${first.text}” is typed into the message field.`;
---

<section class="and" id="android" aria-labelledby="and-title">
  <div class="and-inner">
    <header class="and-head">
      <p class="sv-eyebrow">Now on Android · beta</p>
      <h2 class="h2" id="and-title">Talk into any app on your <em>phone.</em></h2>
      <p class="and-lead">
        A mic bubble sits above your keyboard in every app. Tap it, talk, tap again, and the cleaned-up text is typed at
        your cursor. Your speech is turned into text on the phone itself.
      </p>
    </header>

    <div class="and-stage">
      <ul class="and-callouts and-callouts--l">
        {left.map((c) => (
          <li class="and-co" data-and-co={c.key}>
            <span class="and-co-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={c.ic} /></span>
            <span class="and-co-body">
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </span>
          </li>
        ))}
      </ul>

      <div class="and-demo" data-and-demo data-state="composite" data-scripts={JSON.stringify(scripts)}>
        <div class="and-aura" aria-hidden="true"></div>
        <div class="and-figure">
          <div class="and-say is-on is-clean" aria-hidden="true" data-and-say>
            <span class="and-say-label"><i></i><i></i><i></i>You say</span>
            <p class="and-say-text" data-and-say-text>
              {first.say.map((t) => (
                <span class:list={["w", "is-said", { cut: t.cut, sub: t.to }]}>{t.w}{t.to && <b>{t.to}</b>}</span>
              ))}
            </p>
          </div>

          <div class="and-phone" aria-hidden="true">
            <span class="and-key and-key--pwr"></span>
            <span class="and-key and-key--vol"></span>
            <div class="and-screen" data-and-screen>
              <div class="and-status">
                <span>10:24</span>
                <span class="and-cam"></span>
                <span class="and-sys">
                  <svg viewBox="0 0 16 12"><path d="M1 11h2V8H1zM5 11h2V6H5zM9 11h2V3.5H9zM13 11h2V1h-2z" /></svg>
                  <svg viewBox="0 0 16 12"><path d="M8 11.2 15.4 3.6A10.6 10.6 0 0 0 .6 3.6Z" /></svg>
                  <svg viewBox="0 0 22 12"><rect x="0.6" y="0.6" width="18" height="10.8" rx="3" fill="none" stroke="currentColor" stroke-width="1.2" /><rect x="2.4" y="2.4" width="11" height="7.2" rx="1.6" /><rect x="19.6" y="4" width="1.8" height="4" rx="0.9" /></svg>
                </span>
              </div>

              <div class="and-appbar">
                <svg class="and-ab-ic" viewBox="0 0 24 24"><path d="M15 5 8 12l7 7" /></svg>
                <span class="and-avatar">M</span>
                <span class="and-who"><b>Maya</b><small>online</small></span>
                <svg class="and-ab-ic and-ab-ic--r" viewBox="0 0 24 24"><path d="M6.6 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.1 6.1l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" /></svg>
                <svg class="and-ab-ic" viewBox="0 0 24 24"><circle cx="12" cy="5.5" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="12" cy="18.5" r="1.3" /></svg>
              </div>

              <div class="and-chat" data-and-chat>
                <p class="and-day">Today</p>
                <p class="and-msg and-msg--in">Are you close? The table's ready.<time>10:23</time></p>
              </div>

              <div class="and-compose">
                <svg class="and-cp-ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M8.5 14a4 4 0 0 0 7 0" /><circle cx="9.3" cy="10" r="0.6" /><circle cx="14.7" cy="10" r="0.6" /></svg>
                <p class="and-field has-text" data-and-field>
                  <span class="and-field-txt" data-and-text>{first.text}</span><i class="and-caret"></i><span class="and-ph">Message</span>
                </p>
                <span class="and-send" data-and-send>
                  <svg viewBox="0 0 24 24"><path d="M4.5 12 19.5 5l-3.5 14.5-4.4-5.3z" /><path d="m11.6 14.2 7.9-9.2" /></svg>
                </span>
              </div>

              <div class="and-kb">
                <div class="and-strip">
                  <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1.4" /><rect x="14" y="4" width="6" height="6" rx="1.4" /><rect x="4" y="14" width="6" height="6" rx="1.4" /><rect x="14" y="14" width="6" height="6" rx="1.4" /></svg>
                  <span>I'll</span><span>I</span><span>Thanks</span>
                </div>
                {rows.map((r) => (
                  <div class="and-row">
                    {r.map((k) => <span class={keyClass(k)}>{k === " " ? "" : k}</span>)}
                  </div>
                ))}
              </div>
              <div class="and-nav"><i></i></div>

              <div class="and-bubble" data-and-bubble>
                <span class="and-touch" data-and-touch></span>
                <svg viewBox="-19 -19 38 38">
                  <circle class="b-ripple" r="16.8" fill="none" stroke="#F97316" stroke-width="0.9" stroke-opacity="0" />
                  <circle class="b-ring" r="16.6" fill="none" stroke="#F97316" stroke-width="1.3" stroke-opacity="0.62" />
                  <circle class="b-disc" r="15" fill="#0E1116" />
                  <circle r="14.8" fill="none" stroke="#343B50" stroke-width="0.4" />
                  <g class="b-mic" opacity="0" transform="scale(0.95) translate(0 0.75)">
                    <rect x="-3.2" y="-9" width="6.4" height="11" rx="3.2" fill="#E6E9F0" />
                    <path d="M6 -2.6A6 6 0 0 1 -6 -2.6M0 3.4V6.6M-3 6.6H3" fill="none" stroke="#E6E9F0" stroke-width="1.8" stroke-linecap="round" />
                  </g>
                  <g class="b-bars">
                    <rect x="-9" y="-3" width="2" height="6" rx="1" fill="#F97316" />
                    <rect x="-5" y="-5" width="2" height="10" rx="1" fill="#F97316" />
                    <rect x="-1" y="-6.5" width="2" height="13" rx="1" fill="#F97316" />
                    <rect x="3" y="-4.5" width="2" height="9" rx="1" fill="#F97316" />
                    <rect x="7" y="-2.5" width="2" height="5" rx="1" fill="#F97316" />
                  </g>
                  <path class="b-check" d="M4.67 -3.5 -1.75 2.92 -4.67 0" fill="none" stroke="#22C55E" stroke-width="1.87" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
                </svg>
              </div>
              <div class="and-glare"></div>
            </div>
          </div>
        </div>

        <div class="and-ctrl">
          <button type="button" class="and-try" data-and-try>
            <span class="and-try-ic" aria-hidden="true">
              <svg class="and-try-mic" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg>
              <span class="and-try-bars"><i></i><i></i><i></i><i></i><i></i></span>
            </span>
            <span data-and-try-label>Try it: start talking</span>
          </button>
          <p class="and-hint">Or tap the bubble on the screen. Drag it, too: it settles above the keyboard.</p>
          <p class="and-sr">{alt}</p>
          <p class="and-sr" aria-live="polite" data-and-live></p>
        </div>
      </div>

      <ul class="and-callouts and-callouts--r">
        {right.map((c) => (
          <li class="and-co" data-and-co={c.key}>
            <span class="and-co-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={c.ic} /></span>
            <span class="and-co-body">
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="and-get">
      <div class="and-get-main">
        <h3 class="and-get-title">Get the beta</h3>
        <a class="and-apk" href={APK_URL} data-sv-apk data-magnetic>
          <span class="and-apk-glow" aria-hidden="true"></span>
          <span class="and-apk-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={siAndroid.path} /></svg></span>
          <span class="and-apk-text">
            <span class="and-apk-label">Download APK (beta)</span>
            <span class="and-apk-meta"><span data-sv-apk-version>Latest</span> · pre-release</span>
          </span>
          <span class="and-apk-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v14m0 0-6-6m6 6 6-6" /></svg></span>
        </a>
        <ul class="and-req" aria-label="Requirements">
          <li>Android 10 or newer</li>
          <li>64-bit phones</li>
          <li>English only for now</li>
        </ul>
        <p class="and-ios">iPhone is not available yet.</p>
      </div>
      <ol class="and-steps">
        <li>
          <b>Install it from GitHub.</b> It is not on the Play Store, so allow installs from your browser when Android asks.
        </li>
        <li><b>Get the voice model.</b> The app downloads it once, about 110 MB.</li>
        <li>
          <b>Switch on the bubble.</b> In Accessibility, turn on Silent Voice bubble. On Android 13 or newer, first open the
          app's App info, tap ⋮ and choose Allow restricted settings.
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .and {
    position: relative;
    padding: clamp(6rem, 12vw, 10rem) 1.25rem;
  }
  .and-inner { max-width: 78rem; margin: 0 auto; }

  .and-head { text-align: center; max-width: 48rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); }
  .and-head .h2 { margin-top: 0.9rem; font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1.02; }
  .and-head em { color: var(--sv-orange); }
  .and-lead { margin: 1.3rem auto 0; max-width: 40rem; color: var(--color-muted); font-size: clamp(1.02rem, 1.5vw, 1.15rem); text-wrap: pretty; }

  /* ---------- stage: callouts | phone | callouts ---------- */
  .and-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: "l demo r";
    align-items: center;
    gap: clamp(1.5rem, 2.6vw, 2.75rem);
  }
  .and-callouts--l { grid-area: l; }
  .and-callouts--r { grid-area: r; }
  .and-demo { grid-area: demo; }

  .and-callouts { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1.75rem, 3vw, 2.6rem); }
  .and-co { position: relative; display: flex; gap: 0.95rem; align-items: flex-start; }
  .and-callouts--l .and-co { flex-direction: row-reverse; text-align: right; }
  .and-co-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    border: 1px solid rgba(249, 115, 22, 0.28);
    background: rgba(249, 115, 22, 0.08);
    color: var(--sv-orange);
    transition: background 0.4s ease, color 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .and-co-ic svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .and-co h3 { margin: 0.15rem 0 0.35rem; font-family: "Inter Tight", var(--font-sans); font-size: 1.08rem; font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; }
  .and-co p { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--color-muted); text-wrap: pretty; }
  /* a short wire from each callout toward the phone */
  .and-co::after {
    content: "";
    position: absolute;
    top: 1.3rem;
    width: clamp(1rem, 2vw, 2rem);
    height: 1px;
    background: linear-gradient(90deg, rgba(249, 115, 22, 0.5), transparent);
    transition: opacity 0.4s ease;
    opacity: 0.6;
  }
  .and-callouts--l .and-co::after { left: 100%; margin-left: 0.6rem; }
  .and-callouts--r .and-co::after { right: 100%; margin-right: 0.6rem; transform: scaleX(-1); }
  /* lit while the demo shows that feature working */
  .and-co.is-lit .and-co-ic { background: var(--sv-orange); color: #140a02; border-color: var(--sv-orange); box-shadow: 0 0 28px -4px rgba(249, 115, 22, 0.75); }
  .and-co.is-lit::after { opacity: 1; background: linear-gradient(90deg, var(--sv-orange), transparent); }

  /* ---------- demo ---------- */
  .and-demo {
    --u: clamp(8.8px, 1.12vh, 10.5px); /* one phone unit; the whole mock scales with it */
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: calc(var(--u) * 3);
    --lvl: 0.55;
  }
  .and-aura {
    position: absolute;
    left: 50%;
    top: 42%;
    width: calc(var(--u) * 62);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(249, 115, 22, 0.32), rgba(249, 115, 22, 0.08) 55%, transparent 72%);
    opacity: calc(0.35 + var(--lvl) * 0.65);
    scale: calc(0.86 + var(--lvl) * 0.22);
    pointer-events: none;
    filter: blur(8px);
  }
  .and-figure { position: relative; padding-top: calc(var(--u) * 11); }

  /* phone shell */
  .and-phone {
    position: relative;
    width: calc(var(--u) * 30);
    height: calc(var(--u) * 64);
    padding: calc(var(--u) * 0.85);
    border-radius: calc(var(--u) * 4.7);
    background: linear-gradient(150deg, #2c2f37 0%, #121318 22%, #0b0c0f 60%, #24262d 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.09),
      inset 0 0 0 calc(var(--u) * 0.3) #050506,
      0 0 0 1px rgba(0, 0, 0, 0.9),
      0 50px 90px -30px rgba(0, 0, 0, 0.9),
      0 30px 140px -40px rgba(249, 115, 22, 0.35);
    user-select: none;
    -webkit-user-select: none;
  }
  .and-key { position: absolute; right: calc(var(--u) * -0.35); width: calc(var(--u) * 0.4); border-radius: 0 3px 3px 0; background: linear-gradient(90deg, #1a1b20, #34363e); }
  .and-key--pwr { top: calc(var(--u) * 19); height: calc(var(--u) * 6); }
  .and-key--vol { top: calc(var(--u) * 11); height: calc(var(--u) * 6.5); }

  .and-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: calc(var(--u) * 3.9);
    overflow: hidden;
    background: #0b0e14;
    color: #e6e9f0;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: calc(var(--u) * 1.4);
    line-height: 1.35;
    isolation: isolate;
  }
  .and-glare {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.015) 26%, transparent 40%);
    pointer-events: none;
  }

  .and-status {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--u) * 3.3);
    padding: 0 calc(var(--u) * 2.2);
    font-size: calc(var(--u) * 1.25);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .and-cam {
    position: absolute;
    left: 50%;
    top: calc(var(--u) * 1);
    width: calc(var(--u) * 1.35);
    height: calc(var(--u) * 1.35);
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3447 0 18%, #050608 45%);
    box-shadow: 0 0 0 calc(var(--u) * 0.25) #000;
  }
  .and-sys { display: flex; align-items: center; gap: calc(var(--u) * 0.45); }
  .and-sys svg { height: calc(var(--u) * 1.05); width: auto; fill: currentColor; }

  .and-appbar {
    flex: none;
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.9);
    height: calc(var(--u) * 5.4);
    padding: 0 calc(var(--u) * 1.1);
    background: #121621;
    border-bottom: 1px solid #1c2130;
  }
  .and-ab-ic { width: calc(var(--u) * 2.1); height: calc(var(--u) * 2.1); flex: none; fill: none; stroke: #c5cad6; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .and-ab-ic circle { fill: #c5cad6; stroke: none; }
  .and-ab-ic--r { margin-left: auto; }
  .and-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: calc(var(--u) * 3.3);
    height: calc(var(--u) * 3.3);
    border-radius: 50%;
    background: linear-gradient(135deg, #6d8dff, #9b6dff);
    color: #fff;
    font-weight: 700;
    font-size: calc(var(--u) * 1.4);
  }
  .and-who { display: flex; flex-direction: column; line-height: 1.15; }
  .and-who b { font-size: calc(var(--u) * 1.5); font-weight: 650; }
  .and-who small { font-size: calc(var(--u) * 1.1); color: #7fd1a0; }

  .and-chat {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: calc(var(--u) * 0.7);
    padding: calc(var(--u) * 1.6) calc(var(--u) * 1.2) calc(var(--u) * 6.2);
    overflow: hidden;

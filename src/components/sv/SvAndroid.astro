<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  type Tok = { w: string; cut?: boolean; to?: string };
  type Script = { say: Tok[]; text: string; reply: string };
  type State = "composite" | "idle" | "starting" | "rec" | "work" | "typed";
  type Phase = "idle" | "rec" | "work";

  const section = document.querySelector<HTMLElement>(".and");
  const demo = section?.querySelector<HTMLElement>("[data-and-demo]");
  if (section && demo) init(section, demo);

  function init(section: HTMLElement, demo: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string) => section.querySelector<T>(s)!;
    const SCRIPTS: Script[] = JSON.parse(demo.dataset.scripts || "[]");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const still = () => reduce.matches;

    const screen = $("[data-and-screen]");
    const chat = $("[data-and-chat]");
    const field = $("[data-and-field]");
    const fieldTxt = $("[data-and-text]");
    const send = $("[data-and-send]");
    const say = $("[data-and-say]");
    const sayText = $("[data-and-say-text]");
    const bubbleEl = $("[data-and-bubble]");
    const touchEl = $("[data-and-touch]");
    const tryBtn = $<HTMLButtonElement>("[data-and-try]");
    const tryLabel = $("[data-and-try-label]");
    const live = $("[data-and-live]");
    const kb = $(".and-kb");
    const status = $(".and-status");
    const initialChat = chat.innerHTML;
    // scoped-style attribute Astro gave this component, so injected nodes match it
    const cid = [...chat.attributes].find((a) => a.name.startsWith("data-astro-cid"))?.name;
    const el = (tag: string, cls: string, text = "") => {
      const n = document.createElement(tag);
      n.className = cls;
      if (text) n.textContent = text;
      if (cid) n.setAttribute(cid, "");
      return n;
    };

    // APK version from the release script: "android-v0.1.4" reads as "v0.1.4".
    document.querySelectorAll<HTMLElement>("[data-sv-apk-version]").forEach((v) => {
      const tidy = () => {
        const t = v.textContent || "";
        const n = t.replace(/^android-/i, "");
        if (n !== t) v.textContent = n;
      };
      tidy();
      new MutationObserver(tidy).observe(v, { childList: true, characterData: true, subtree: true });
    });

    /* ---------------- the bubble (a port of the app's Pill.kt) ---------------- */
    const svg = bubbleEl.querySelector("svg")!;
    const ring = svg.querySelector<SVGCircleElement>(".b-ring")!;
    const ripple = svg.querySelector<SVGCircleElement>(".b-ripple")!;
    const mic = svg.querySelector<SVGGElement>(".b-mic")!;
    const barsG = svg.querySelector<SVGGElement>(".b-bars")!;
    const bars = [...barsG.querySelectorAll<SVGRectElement>("rect")];
    const check = svg.querySelector<SVGPathElement>(".b-check")!;
    const BASE = [6, 10, 13, 9, 5];
    const mix = (t: number) => {
      // #8B93A7 (grey) -> #F97316 (orange)
      const a = [0x8b, 0x93, 0xa7], b = [0xf9, 0x73, 0x16];
      return `rgb(${a.map((x, i) => Math.round(x + (b[i] - x) * Math.min(1, Math.max(0, t)))).join(",")})`;
    };
    const B = {
      phase: "rec" as Phase,
      hist: [0, 0, 0, 0, 0],
      h: [...BASE],
      a: [1, 1, 1, 1, 1],
      warm: [1, 1, 1, 1, 1],
      check: 0,
      idleShown: 0,
      ringShown: 1,
      env: 0,
      talking: 0,
      wasRec: true,
      rippleStart: 0,
      doneUntil: 0,
      donePending: false,
      pulseKind: 0,
      pulseStart: 0,
      last: 0,
      animating: false,
    };
    const setPhase = (p: Phase) => {
      if (B.phase === p) return;
      B.phase = p;
      if (p !== "rec") B.hist.fill(0);
      B.animating = true;
    };
    const push = (lvl: number) => {
      if (B.phase !== "rec") return;
      B.hist.shift();
      B.hist.push(lvl);
      B.animating = true;
    };
    const pulse = (elapsed: number, i: number, period: number) => {
      const t = elapsed - i * 100;
      if (t < 0) return [1, 1];
      const p = (t % period) / period;
      const u = p < 0.5 ? p / 0.5 : (1 - p) / 0.5;
      const e = u * u * (3 - 2 * u);
      return [0.4 + 0.6 * e, 0.6 + 0.4 * e];
    };
    let lastLvl = -1;
    function drawBubble(now: number, instant = false) {
      const st = still() || instant;
      const dt = B.last ? Math.min(100, Math.max(0, now - B.last)) : 16;
      B.last = now;
      if (B.donePending) { B.donePending = false; B.doneUntil = now + 700; }
      const done = now < B.doneUntil;
      const rec = B.phase === "rec" && !done;
      const work = B.phase === "work" && !done;
      const idle = !rec && !work && !done;
      const speaking = rec && Math.max(...B.hist) > 0.14;
      if (rec && !B.wasRec) B.rippleStart = now;
      B.wasRec = rec;
      const kind = st ? 0 : rec && !speaking ? 1 : work ? 2 : 0;
      if (kind !== B.pulseKind) { B.pulseKind = kind; B.pulseStart = now; }
      const ease = (tau: number) => (st ? 1 : 1 - Math.exp(-dt / tau));
      const k = ease(speaking ? 20 : 75);
      let moving = st ? false : kind !== 0 || done || rec;
      for (let i = 0; i < 5; i++) {
        let th: number, ta: number, tc: number;
        if (done) { th = 2; ta = 0; tc = B.warm[i]; }
        else if (idle) { th = 2; ta = 0; tc = 0; }
        else if (rec) { th = speaking ? Math.max(2, Math.round(2 + B.hist[i] * 13)) : BASE[i]; ta = 1; tc = 1; }
        else { th = BASE[i]; ta = 1; tc = 0; }
        B.h[i] += (th - B.h[i]) * k;
        B.a[i] += (ta - B.a[i]) * k;
        B.warm[i] += (tc - B.warm[i]) * k;
        if (Math.abs(th - B.h[i]) > 0.02 || Math.abs(ta - B.a[i]) > 0.01 || Math.abs(tc - B.warm[i]) > 0.01) moving = true;
      }
      B.check += ((done ? 1 : 0) - B.check) * ease(40);
      const ti = idle && B.check < 0.15 ? 1 : 0;
      B.idleShown += (ti - B.idleShown) * ease(90);
      const tr = rec ? 1 : 0;
      B.ringShown += (tr - B.ringShown) * ease(90);
      B.talking += ((speaking ? 1 : 0) - B.talking) * ease(speaking ? 60 : 160);
      const te = rec ? B.hist[4] : 0;
      B.env += (te - B.env) * ease(te > B.env ? 30 : 160);
      if ((B.check > 0.01 && B.check < 0.99) || Math.abs(ti - B.idleShown) > 0.01 || Math.abs(tr - B.ringShown) > 0.01 ||
        (B.talking > 0.01 && B.talking < 0.99) || B.env > 0.005) moving = true;
      if (done) moving = true; // keep going until the check has had its 700 ms
      B.animating = moving;

      // ring: swells with the voice; still frames show it at a steady middle level
      const e = st && rec ? 0.5 : Math.min(1, B.env * 1.3);
      ring.setAttribute("r", (15.8 + 1.6 * e).toFixed(2));
      ring.setAttribute("stroke-width", (1 + 0.6 * e).toFixed(2));
      ring.setAttribute("stroke-opacity", (B.ringShown * (0.25 + 0.75 * e)).toFixed(3));
      let ra = 0;
      if (!st) {
        const p = ((now - B.rippleStart) % 1500) / 1500;
        ra = B.ringShown * (1 - B.talking) * (1 - p) * 0.7;
        ripple.setAttribute("r", (15.5 + p * 2.6).toFixed(2));
      }
      ripple.setAttribute("stroke-opacity", ra.toFixed(3));
      const ms = 0.95 * (0.82 + 0.18 * B.idleShown);
      mic.setAttribute("opacity", B.idleShown.toFixed(3));
      mic.setAttribute("transform", `scale(${ms.toFixed(3)}) translate(0 0.75)`);
      const shown = 1 - B.idleShown;
      barsG.setAttribute("transform", `scale(${(0.85 + 0.15 * shown).toFixed(3)})`);
      bars.forEach((r, i) => {
        let bh = B.h[i];
        let a = B.a[i];
        if (B.pulseKind) {
          const [s, o] = pulse(now - B.pulseStart, i, B.pulseKind === 1 ? 1000 : 1600);
          bh *= s;
          a *= o;
        }
        a *= shown;
        r.setAttribute("y", (-bh / 2).toFixed(2));
        r.setAttribute("height", bh.toFixed(2));
        r.setAttribute("rx", (Math.min(2, bh) / 2).toFixed(2));
        r.setAttribute("opacity", a.toFixed(3));
        r.setAttribute("fill", mix(B.warm[i]));
      });
      check.setAttribute("opacity", B.check.toFixed(3));

      // the glow behind the phone follows the same voice level
      const lvl = Math.round(B.ringShown * (0.35 + 0.65 * (st && rec ? 0.4 : Math.min(1, B.env * 1.3))) * 100) / 100;
      if (lvl !== lastLvl) { demo.style.setProperty("--lvl", String(lvl)); lastLvl = lvl; }
    }
    function bubbleTo(p: Phase, opts: { done?: boolean } = {}) {
      setPhase(p);
      if (opts.done) { B.donePending = true; B.animating = true; }
    }

    /* ---------------- timers that can be flushed (finish now) or cancelled ---------------- */
    let q: { id: number; fn: () => void }[] = [];
    const later = (fn: () => void, ms: number) => {
      const item = { id: 0, fn };
      item.id = window.setTimeout(() => { q = q.filter((x) => x !== item); fn(); kick(); }, ms);
      q.push(item);
    };
    const cancelAll = () => { q.forEach((x) => clearTimeout(x.id)); q = []; };
    const flush = () => {
      for (let guard = 0; q.length && guard < 20; guard++) {
        const items = q;
        q = [];
        items.forEach((x) => { clearTimeout(x.id); x.fn(); });
      }
    };

    /* ---------------- state ---------------- */
    let state: State = "composite";
    let si = 0; // which script is next
    let cur = SCRIPTS[0];
    let auto = false; // the one-time autoplay is running
    let touched = false; // the visitor has interacted
    let recStart = 0;
    let lastPush = 0;
    let plan: { segs: { t0: number; t1: number; peak: number; len: number }[]; end: number } = { segs: [], end: 0 };
    let typer: { text: string; start: number } | null = null;
    let words: HTMLElement[] = [];

    const LABEL: Record<State, string> = {
      composite: "Try it: start talking",
      idle: "Start talking",
      typed: "Say something else",
      starting: "Done talking",
      rec: "Done talking",
      work: "Writing it down…",
    };
    function setState(s: State) {
      state = s;
      demo.dataset.state = s;
      tryLabel.textContent = LABEL[s];
      tryBtn.setAttribute("aria-disabled", s === "work" ? "true" : "false");
    }

    function renderSay(tokens: Tok[], said: boolean) {
      sayText.textContent = "";
      words = tokens.map((t) => {
        const s = el("span", `w${t.cut ? " cut" : ""}${t.to ? " sub" : ""}${said ? " is-said" : ""}`, t.w);
        if (t.to) s.appendChild(el("b", "", t.to));
        sayText.appendChild(s);
        return s;
      });
    }
    function setField(text: string) {
      fieldTxt.textContent = text;
      field.classList.toggle("has-text", text.length > 0);
    }
    function light(key: string, ms = 1800) {
      const c = section.querySelector<HTMLElement>(`[data-and-co="${key}"]`);
      if (!c) return;
      c.classList.add("is-lit");
      setTimeout(() => c.classList.remove("is-lit"), ms);
    }
    function trimChat() {
      const msgs = chat.querySelectorAll(".and-msg");
      for (let i = 0; i < msgs.length - 7; i++) msgs[i].remove();
    }
    function addMsg(text: string, out: boolean) {
      const m = el("p", `and-msg ${out ? "and-msg--out" : "and-msg--in"}`, text);
      m.appendChild(el("time", "", "10:24"));
      chat.appendChild(m);
      trimChat();
      if (!still()) gsap.from(m, { y: 18, opacity: 0, scale: 0.9, transformOrigin: out ? "100% 100%" : "0% 100%", duration: 0.5, ease: "back.out(1.6)" });
      return m;
    }
    function tapFx() {
      if (still()) return;
      gsap.fromTo(touchEl, { scale: 0.5, opacity: 0.55 }, { scale: 1.25, opacity: 0, duration: 0.6, ease: "power2.out" });
      gsap.fromTo(svg, { scale: 0.9 }, { scale: 1, duration: 0.45, ease: "back.out(3)", clearProps: "scale" });
    }

    function makePlan(tokens: Tok[]) {
      let t = 380;
      const segs = tokens.map((tok) => {
        const filler = !!tok.cut && /^(um|uh)/.test(tok.w);
        const dur = filler ? 360 : 130 + tok.w.length * 36;
        const seg = { t0: t, t1: t + dur, peak: filler ? 0.3 : 0.6 + Math.random() * 0.32, len: tok.w.length };
        t += dur + (filler ? 140 : 50 + Math.random() * 60);
        return seg;
      });
      return { segs, end: t };
    }
    function levelAt(ms: number) {
      const s = plan.segs.find((x) => ms >= x.t0 && ms < x.t1);
      if (!s) return 0.02 + Math.random() * 0.04;
      const local = (ms - s.t0) / (s.t1 - s.t0);
      const syl = 0.5 + 0.5 * Math.abs(Math.sin(local * Math.PI * (1 + Math.floor(s.len / 3))));
      return Math.min(1, s.peak * syl * (0.85 + Math.random() * 0.3));
    }

    /* ---------------- the flow ---------------- */
    function resetChat() {
      chat.innerHTML = initialChat;
    }
    function start() {
      flush(); // finish any send that's still on its way
      if (si >= SCRIPTS.length) si = 0;
      if (si === 0) resetChat();
      cur = SCRIPTS[si];
      setField("");
      typer = null;
      renderSay(cur.say, still());
      say.classList.remove("is-clean");
      say.classList.add("is-on");
      demo.classList.add("is-live");
      setState("starting");
      // the bars show once the mic is live, about 200 ms after the tap
      later(() => {
        setState("rec");
        bubbleTo("rec");
        recStart = performance.now();
        lastPush = 0;
        plan = makePlan(cur.say);
      }, still() ? 0 : 200);
    }
    function finish() {
      cancelAll();
      words.forEach((w) => w.classList.add("is-said"));
      setState("work");
      bubbleTo("work");
      light("device", 1500);
      say.classList.add("is-clean");
      const st = still();
      later(() => {
        bubbleTo("idle", { done: true });
        typer = st ? null : { text: cur.text, start: performance.now() };
        if (st) setField(cur.text);
        light("clean");
        live.textContent = `Typed into the message field: ${cur.text.replace("\n", " ")}`;
        setState("typed");
        auto = false;
      }, st ? 200 : 750);
      later(() => say.classList.remove("is-on"), st ? 1600 : 2000);
      later(() => sendIt(), st ? 1800 : 2300);
    }
    function sendIt() {
      typer = null;
      const text = cur.text;
      send.classList.add("is-press");
      setTimeout(() => send.classList.remove("is-press"), 180);
      setField("");
      addMsg(text, true);
      const reply = cur.reply;
      si++;
      later(() => {
        const typing = el("p", "and-msg and-msg--in and-typing");
        typing.append(el("i", ""), el("i", ""), el("i", ""));
        chat.appendChild(typing);
        trimChat();
        later(() => { typing.remove(); addMsg(reply, false); }, 1300);
      }, 700);
    }
    function toggle(fromUser: boolean) {
      if (fromUser) touched = true;
      if (state === "work") return;
      if (state === "starting" || state === "rec") finish();
      else start();
      kick();
    }

    /* ---------------- frame loop (only while visible and something moves) ---------------- */
    let raf = 0;
    let visible = false;
    function frame(now: number) {
      raf = 0;
      if (state === "rec") {
        const elapsed = now - recStart;
        if (!still()) {
          if (now - lastPush > 50) { push(levelAt(elapsed)); lastPush = now; }
          plan.segs.forEach((s, i) => { if (elapsed >= s.t0 + 60) words[i]?.classList.add("is-said"); });
          // autoplay taps again once the sentence is out; a visitor gets a while longer
          if (auto && elapsed > plan.end + 650) { tapFx(); finish(); }
          else if (!auto && elapsed > plan.end + 7000) finish();
        }
      }
      if (typer) {
        const n = Math.min(typer.text.length, Math.floor((now - typer.start) / 16));
        setField(typer.text.slice(0, n));
        if (n >= typer.text.length) typer = null;
      }
      drawBubble(now);
      if (visible && (B.animating || typer || (state === "rec" && !still()))) raf = requestAnimationFrame(frame);
    }
    function kick() {
      if (!raf && visible) raf = requestAnimationFrame(frame);
    }
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (visible) kick();
      else if (raf) { cancelAnimationFrame(raf); raf = 0; }
    }).observe(demo);

    /* ---------------- show the finished frame (base markup state) ---------------- */
    function composite() {
      cancelAll();
      typer = null;
      resetChat();
      si = 0;
      cur = SCRIPTS[0];
      renderSay(cur.say, true);
      say.classList.add("is-on", "is-clean");
      setField(cur.text);
      demo.classList.remove("is-live");
      Object.assign(B, { phase: "rec", h: [...BASE], a: [1, 1, 1, 1, 1], warm: [1, 1, 1, 1, 1], idleShown: 0, ringShown: 1, check: 0, env: 0, talking: 0, hist: [0, 0, 0, 0, 0], doneUntil: 0, donePending: false, wasRec: true });
      drawBubble(performance.now(), true);
      setState("composite");
    }
    function idleFrame() {
      cancelAll();
      typer = null;
      resetChat();
      si = 0;
      setField("");
      say.classList.remove("is-on", "is-clean");
      demo.classList.add("is-live");
      Object.assign(B, { phase: "idle", h: [2, 2, 2, 2, 2], a: [0, 0, 0, 0, 0], warm: [0, 0, 0, 0, 0], idleShown: 1, ringShown: 0, check: 0, env: 0, talking: 0, hist: [0, 0, 0, 0, 0], doneUntil: 0, donePending: false, wasRec: false });
      drawBubble(performance.now(), true);
      setState("idle");
    }

    /* ---------------- controls ---------------- */
    tryBtn.addEventListener("click", () => toggle(true));

    // tap the bubble, or drag it: it follows the finger anywhere on the screen
    // and settles above the keyboard when let go, like the app's.
    let off = { x: 0, y: 0 };
    let drag: { id: number; sx: number; sy: number; ox: number; oy: number; moved: boolean } | null = null;
    let snapTween: gsap.core.Tween | null = null;
    const apply = () => { bubbleEl.style.translate = `${off.x}px ${off.y}px`; };
    function bounds(tight: boolean) {
      const s = screen.getBoundingClientRect();
      const b = bubbleEl.getBoundingClientRect();
      const bx = b.left - off.x, by = b.top - off.y; // where the bubble sits with no offset
      const pad = b.width * 0.12;
      const top = (tight ? status.getBoundingClientRect().bottom : s.top) + pad;
      const bottom = (tight ? kb.getBoundingClientRect().top - b.width * 0.14 : s.bottom) - pad;
      return {
        minX: s.left + pad - bx, maxX: s.right - pad - b.width - bx,
        minY: top - by, maxY: bottom - b.height - by,
      };
    }
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    function settle() {
      const r = bounds(true);
      const to = { x: clamp(off.x, r.minX, r.maxX), y: clamp(off.y, r.minY, r.maxY) };
      snapTween?.kill();
      if (still()) { off = to; apply(); return; }
      snapTween = gsap.to(off, { ...to, duration: 0.7, ease: "elastic.out(1, 0.6)", onUpdate: apply });
    }
    bubbleEl.addEventListener("pointerdown", (e) => {
      if (e.button > 0) return;
      snapTween?.kill();
      drag = { id: e.pointerId, sx: e.clientX, sy: e.clientY, ox: off.x, oy: off.y, moved: false };
      bubbleEl.setPointerCapture(e.pointerId);
    });
    bubbleEl.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.sx, dy = e.clientY - drag.sy;
      if (!drag.moved && Math.hypot(dx, dy) > 6) { drag.moved = true; bubbleEl.classList.add("is-drag"); touched = true; }
      if (!drag.moved) return;
      const r = bounds(false);
      off = { x: clamp(drag.ox + dx, r.minX, r.maxX), y: clamp(drag.oy + dy, r.minY, r.maxY) };
      apply();
    });
    const end = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      const wasDrag = drag.moved;
      drag = null;
      bubbleEl.classList.remove("is-drag");
      if (wasDrag || e.type === "pointercancel") settle();
      else toggle(true);
    };
    bubbleEl.addEventListener("pointerup", end);
    bubbleEl.addEventListener("pointercancel", end);
    addEventListener("resize", () => { if (off.x || off.y) settle(); }, { passive: true });

    /* ---------------- motion: entrance + one autoplay ---------------- */
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      idleFrame();
      const callouts = section.querySelectorAll(".and-co");
      const tl = gsap.timeline({ scrollTrigger: { trigger: section.querySelector(".and-stage"), start: "top 80%", once: true } });
      tl.from(section.querySelector(".and-phone"), { y: 90, rotate: -5, opacity: 0, duration: 1.3, ease: "expo.out" })
        .from(callouts, { y: 26, opacity: 0, duration: 0.9, ease: "expo.out", stagger: 0.07 }, 0.25)
        .from(section.querySelector(".and-ctrl"), { y: 16, opacity: 0, duration: 0.8, ease: "expo.out" }, 0.5);
      const getIn = gsap.from(section.querySelector(".and-get"), {
        y: 40, opacity: 0, duration: 1, ease: "expo.out",
        scrollTrigger: { trigger: section.querySelector(".and-get"), start: "top 88%", once: true },
      });

      // play it once by itself when the phone is well in view, unless the visitor got there first
      let autoTimer = 0;
      const io = new IntersectionObserver((es) => {
        if (!es[0].isIntersecting) return;
        io.disconnect();
        autoTimer = window.setTimeout(() => {
          if (touched || state !== "idle") return;
          auto = true;
          tapFx();
          toggle(false);
        }, 900);
      }, { threshold: 0.6 });
      io.observe(section.querySelector(".and-phone")!);

      return () => {
        io.disconnect();
        clearTimeout(autoTimer);
        tl.revert();
        getIn.revert();
        auto = false;
        composite();
      };
    });
  }
</script>

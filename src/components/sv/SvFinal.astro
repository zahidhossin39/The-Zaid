---
// The closing block: one headline, the download button and its one-line
// caveat, the Android beta for computer visitors (a QR code to scan, the APK
// file only as a quiet link), then the detail most people can skip: install
// notes per system (the visitor's own open, the rest folded, SHA-256 when
// GitHub gives one), a short "Recent updates" list and one quiet line about
// the source.
import SvDownload from "./SvDownload.astro";
import { siAndroid } from "simple-icons";
// @ts-ignore: no bundled types; used only at build time
import QRCode from "qrcode";
import { ANDROID_RELEASES_URL, ISSUES_URL, LICENSE_URL, PAGE_URL, SOURCE_URL } from "../../scripts/sv-release";

const chevron = "M6 9l6 6 6-6";

// The same QR code as the Android section: this page's Android section, on the phone.
const QR_URL = `${PAGE_URL}#android`;
const qr = QRCode.create(QR_URL, { errorCorrectionLevel: "M" });
const qrSize: number = qr.modules.size;
let qrPath = "";
for (let y = 0; y < qrSize; y++) {
  for (let x = 0; x < qrSize; x++) {
    if (!qr.modules.get(x, y)) continue;
    let run = 1;
    while (x + run < qrSize && qr.modules.get(x + run, y)) run++;
    qrPath += `M${x} ${y}h${run}v1h-${run}z`;
    x += run - 1;
  }
}
---

<section class="svx" id="download" aria-labelledby="svx-title">
  <div class="svx-glow" aria-hidden="true"></div>
  <div class="svx-inner">
    <p class="sv-eyebrow svx-eyebrow">Download</p>
    <h2 class="svx-title" id="svx-title">
      <span class="svx-line">Your voice.</span>{" "}
      <!-- on Android the button below is the APK, so the line says phone (a swap, no layout jump) -->
      <span class="svx-line svx-line--em"><span class="svx-pc">Your computer.</span><span class="svx-phone">Your phone.</span></span>
    </h2>
    <!-- the count: installer downloads from the releases call, shown only from 250 up -->
    <p class="svx-lead">
      Free to download, free to keep. <span class="svx-nowrap">No sign-up.</span>{" "}<span class="svx-count" data-sv-downloads hidden></span>
    </p>
    <div class="svx-cta"><SvDownload size="xl" apk={false} /></div>

    <!-- the Android beta, for someone on a computer: scan it onto the phone; the .apk file is only a quiet link
         (phones get their own links under the button) -->
    <div class="svx-alt">
      <div class="svx-alt-card">
        <svg class="svx-alt-qr" viewBox={`-4 -4 ${qrSize + 8} ${qrSize + 8}`} role="img" aria-label={`QR code for ${QR_URL}`} shape-rendering="crispEdges">
          <rect x="-4" y="-4" width={qrSize + 8} height={qrSize + 8} rx="3" fill="#f4f2ed" />
          <path d={qrPath} fill="#0a0a0b" />
        </svg>
        <span class="svx-alt-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={siAndroid.path} /></svg></span>
        <div class="svx-alt-text">
          <p class="svx-alt-title">Also on Android (beta)</p>
          <p class="svx-alt-scan">Scan with your Android phone to install it there.</p>
          <p class="svx-alt-file">
            <a class="svx-alt-link" href={ANDROID_RELEASES_URL} data-sv-apk><span class="svx-alt-or">or download</span><span class="svx-alt-dl">Download</span> the .apk</a>
            <span class="svx-alt-meta" data-sv-apk-meta>Beta · Android 10 and newer</span>
          </p>
        </div>
      </div>
    </div>

    <div class="svx-panel">
      <section class="svx-block svx-block--install" id="install" aria-labelledby="svx-install-t">
        <h3 class="svx-h" id="svx-install-t">Before you install</h3>
        <div class="svx-os">
          <details class="svx-os-row svx-os--windows" id="install-windows">
            <summary>
              <span class="svx-os-name">Windows</span>
              <span class="svx-os-hint">Windows 10 and 11</span>
              <svg class="svx-chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} /></svg>
            </summary>
            <ul>
              <li><strong>Not code-signed yet, so Windows may warn you.</strong> Choose More info, then Run anyway.</li>
              <li>After that, updates show up inside the app.</li>
              <li class="svx-sum" data-sv-sum="windows" hidden></li>
            </ul>
          </details>
          <details class="svx-os-row svx-os--mac" id="install-mac">
            <summary>
              <span class="svx-os-name">Mac</span>
              <span class="svx-os-hint">Early · Apple Silicon, macOS 12+</span>
              <svg class="svx-chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} /></svg>
            </summary>
            <ul>
              <li><strong>Early: not fully tested on a real Mac yet.</strong> If something breaks, <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer">tell me on GitHub</a>.</li>
              <li><strong>Not notarized by Apple yet.</strong> On first launch, open System Settings › Privacy &amp; Security and choose Open Anyway. On macOS 14 or older, right-click the app and choose Open.</li>
              <li>For M1 or newer on macOS 12 or newer. Intel Macs aren't supported.</li>
              <li>Allow Microphone and Accessibility. To record the other side of a call, Notetaker also needs Screen &amp; System Audio Recording (macOS 13 or newer).</li>
              <li class="svx-sum" data-sv-sum="mac" hidden></li>
            </ul>
          </details>
          <details class="svx-os-row svx-os--linux" id="install-linux">
            <summary>
              <span class="svx-os-name">Linux</span>
              <span class="svx-os-hint">Early · x86_64</span>
              <svg class="svx-chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} /></svg>
            </summary>
            <ul>
              <li><strong>Works on X11, Hyprland and Sway. Not on GNOME or KDE Wayland yet.</strong> On Hyprland and Sway, bind a key to <code>silent-voice --toggle</code> and install <code>wtype</code>.</li>
              <li>Take the .deb on Ubuntu and Debian, the AppImage anywhere else (run <code>chmod +x</code> on it first).</li>
              <li>An early build: if something breaks, <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer">tell me on GitHub</a>.</li>
              <li class="svx-sum" data-sv-sum="linux" hidden></li>
            </ul>
          </details>
          <details class="svx-os-row svx-os--android" id="install-android">
            <summary>
              <span class="svx-os-name">Android</span>
              <span class="svx-os-hint">Beta · Android 10+, 64-bit</span>
              <svg class="svx-chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} /></svg>
            </summary>
            <ul>
              <li><strong>A beta you install from GitHub, not Google Play.</strong> English only.</li>
              <li>Allow your browser to install apps, then turn on the "Silent Voice bubble" switch in Accessibility. Android 13 and newer first asks you to "Allow restricted settings" in the app's info page. On Xiaomi phones, also allow Autostart.</li>
              <li>Updates aren't automatic yet: check this page or the GitHub releases. If an update won't install over the old version, uninstall the old one first (that clears its history and saved words).</li>
              <li class="svx-sum" data-sv-sum="android" hidden></li>
            </ul>
          </details>
          <details class="svx-os-row svx-os--ios" id="install-ios">
            <summary>
              <span class="svx-os-name">iPhone</span>
              <span class="svx-os-hint">Not available yet</span>
              <svg class="svx-chev" viewBox="0 0 24 24" aria-hidden="true"><path d={chevron} /></svg>
            </summary>
            <ul>
              <li>There's no iPhone or iPad app yet. Send yourself the link and install it on your computer, or on an Android phone.</li>
            </ul>
          </details>
        </div>
      </section>

      <section class="svx-block" id="whats-new" aria-labelledby="svx-new-t" data-sv-notes-card>
        <h3 class="svx-h" id="svx-new-t">Recent updates</h3>
        <!-- static lines, checked against the app's git tags; the CHANGELOG.md entry for the current release replaces its line when there is one -->
        <ol class="svx-ups" data-sv-notes>
          <li data-sv-notes-v="0.2.0">
            <span class="svx-up-v">v0.2.0 <time datetime="2026-11-11">Nov 2026</time></span>
            <div class="svx-up-text"><p><strong>Notetaker</strong> for calls and meetings, and <strong>Transcribe a file</strong>. A smaller Model Store ranked for your PC, a Progress page and redesigned cloud providers.</p></div>
          </li>
          <li data-sv-notes-v="0.1.14">
            <span class="svx-up-v">v0.1.14 <time datetime="2026-10">Oct 2026</time></span>
            <div class="svx-up-text"><p>"Transcribe while you speak" on by default, Esc to cancel, Paste last (Alt+Shift+Z), and Hyprland and Sway on Linux.</p></div>
          </li>
          <li data-sv-notes-v="0.1.11">
            <span class="svx-up-v">v0.1.11 <time datetime="2026-10">Oct 2026</time></span>
            <div class="svx-up-text"><p>The first <strong>Mac and Linux</strong> builds, still early.</p></div>
          </li>
        </ol>
        <a class="svx-link" href={ANDROID_RELEASES_URL} target="_blank" rel="noopener noreferrer">All releases on GitHub <span aria-hidden="true">→</span></a>
      </section>
    </div>

    <!-- trust, in one quiet line (the version and date come from the releases call) -->
    <p class="svx-open">
      Built in the open: <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer">MIT license</a>, every line{" "}
      <a href={SOURCE_URL} target="_blank" rel="noopener noreferrer">on GitHub</a>.{" "}<span class="svx-open-rel"><span data-sv-version>v0.2.0</span> released <time data-sv-date datetime="2026-11-11">Nov 11, 2026</time>.</span>
    </p>
  </div>
</section>

<style>
  /* outer padding comes from the page (--sv-space / --sv-gutter) */
  .svx {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }
  .svx-glow {
    position: absolute;
    left: 50%;
    top: clamp(10rem, 18vw, 16rem);
    width: min(110vw, 1000px);
    aspect-ratio: 1.8;
    translate: -50% -50%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(249, 115, 22, 0.26), rgba(249, 115, 22, 0.07) 50%, transparent);
    filter: blur(30px);
    pointer-events: none;
  }
  .svx-inner { max-width: var(--sv-max); margin: 0 auto; }
  .svx-eyebrow { justify-content: center; }
  .svx-title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 7.5vw, 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .svx-line { display: block; }
  .svx-line--em { font-style: italic; color: var(--sv-orange); }
  .svx-phone { display: none; }
  :global(html[data-sv-os="android"]) .svx-line .svx-phone { display: inline; }
  :global(html[data-sv-os="android"]) .svx-line .svx-pc { display: none; }
  .svx-lead { margin: 1.25rem 0 2.25rem; color: var(--color-muted); font-size: 1.1rem; text-wrap: balance; }
  .svx-nowrap { white-space: nowrap; }
  .svx-count { white-space: nowrap; color: var(--color-text); }
  .svx-count[hidden] { display: none; }

  /* ---- Android beta, for computers: the QR code leads, the file is a quiet link ---- */
  .svx-alt { display: flex; justify-content: center; margin-top: 1.75rem; }
  :global(html:is([data-sv-os="android"], [data-sv-os="ios"], [data-sv-phone])) .svx-alt { display: none; }
  .svx-alt-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    padding: 0.6rem 1.25rem 0.6rem 0.6rem;
    border-radius: 18px;
    border: 1px solid rgba(244, 242, 237, 0.12);
    background: rgba(17, 17, 20, 0.7);
    text-align: left;
    backdrop-filter: blur(10px);
  }
  .svx-alt-qr { flex: none; width: 5.25rem; height: 5.25rem; border-radius: 10px; box-shadow: 0 0 0 1px rgba(244, 242, 237, 0.12); }
  .svx-alt-icon { display: none; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: rgba(244, 242, 237, 0.08); color: var(--color-text); flex: none; }
  .svx-alt-icon svg { width: 52%; height: 52%; fill: currentColor; }
  .svx-alt-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; line-height: 1.35; }
  .svx-alt-text p { margin: 0; }
  .svx-alt-title { font-size: 0.95rem; font-weight: 600; color: var(--color-text); }
  .svx-alt-scan { font-size: 0.85rem; color: var(--color-muted); }
  .svx-alt-file { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5rem; font-size: 0.82rem; color: var(--color-muted); }
  .svx-alt-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: rgba(244, 242, 237, 0.3);
    text-underline-offset: 3px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .svx-alt-link:hover { color: var(--sv-orange); text-decoration-color: currentColor; }
  .svx-alt-link:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 2px; border-radius: 3px; }
  .svx-alt-or { margin-right: 0.25em; }
  .svx-alt-dl { display: none; margin-right: 0.25em; }
  .svx-alt-meta { font-family: var(--font-mono); font-size: 0.75rem; }
  /* no QR where it can't be scanned (a phone without JS, a small touch screen): the file link leads */
  @media (max-width: 767px), (pointer: coarse) {
    :global(html:not([data-sv-os="windows"]):not([data-sv-os="mac"]):not([data-sv-os="linux"])) .svx-alt .svx-alt-qr,
    :global(html:not([data-sv-os="windows"]):not([data-sv-os="mac"]):not([data-sv-os="linux"])) .svx-alt .svx-alt-scan,
    :global(html:not([data-sv-os="windows"]):not([data-sv-os="mac"]):not([data-sv-os="linux"])) .svx-alt .svx-alt-or { display: none; }
    :global(html:not([data-sv-os="windows"]):not([data-sv-os="mac"]):not([data-sv-os="linux"])) .svx-alt .svx-alt-icon { display: grid; }
    :global(html:not([data-sv-os="windows"]):not([data-sv-os="mac"]):not([data-sv-os="linux"])) .svx-alt .svx-alt-dl { display: inline; }
    :global(html:not([data-sv-os="windows"]):not([data-sv-os="mac"]):not([data-sv-os="linux"])) .svx-alt .svx-alt-link { min-height: 44px; }
  }
  @media (max-width: 400px) {
    .svx-alt-card { gap: 0.75rem; padding-right: 0.9rem; }
    .svx-alt-qr { width: 4.5rem; height: 4.5rem; }
  }

  /* ---- the detail: install notes beside recent updates, in one panel ---- */
  .svx-panel {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    margin-top: clamp(3.5rem, 7vw, 5rem);
    border-radius: 22px;
    border: 1px solid var(--sv-line);
    background: rgba(17, 17, 20, 0.8);
    text-align: left;
  }
  .svx-block { padding: clamp(1.4rem, 3vw, 2rem); min-width: 0; scroll-margin-top: 6rem; }
  .svx-block + .svx-block { border-left: 1px solid var(--sv-line); }
  .svx-h { margin: 0 0 0.75rem; font-family: "Inter Tight", var(--font-sans); font-size: 1.15rem; font-weight: 700; letter-spacing: -0.015em; }

  .svx-os { display: flex; flex-direction: column; }
  .svx-os-row { border-top: 1px solid var(--sv-line); scroll-margin-top: 6rem; }
  .svx-os-row:last-child { border-bottom: 1px solid var(--sv-line); }
  .svx-os--ios { display: none; }
  :global(html[data-sv-os="ios"]) .svx-os--ios { display: block; }
  /* the visitor's own platform comes first */
  :global(html[data-sv-os="windows"]) .svx-os--windows,
  :global(html[data-sv-os="mac"]) .svx-os--mac,
  :global(html[data-sv-os="linux"]) .svx-os--linux,
  :global(html[data-sv-os="android"]) .svx-os--android,
  :global(html[data-sv-os="ios"]) .svx-os--ios { order: -1; }
  .svx-os-row summary {
    display: flex;
    align-items: center;
    gap: 0.4rem 1rem;
    min-height: 48px;
    padding: 0.35rem 0.2rem;
    cursor: pointer;
    list-style: none;
    border-radius: 8px;
  }
  .svx-os-row summary::-webkit-details-marker { display: none; }
  .svx-os-row summary:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 2px; }
  .svx-os-name { flex: none; width: 5.5rem; font-weight: 600; font-size: 0.95rem; }
  .svx-os-hint { flex: 1; min-width: 0; color: var(--color-muted); font-size: 0.88rem; }
  .svx-chev { flex: none; width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--color-muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.25s ease, stroke 0.2s ease; }
  .svx-os-row summary:hover .svx-chev { stroke: var(--color-text); }
  .svx-os-row summary:hover .svx-os-name { color: var(--sv-orange); }
  .svx-os-row[open] .svx-chev { transform: rotate(180deg); }
  .svx-os-row[open] .svx-os-name { color: var(--sv-orange); }
  .svx-os-row ul { display: grid; gap: 0.5rem; margin: 0; padding: 0.1rem 0 1.1rem calc(5.5rem + 1.2rem); list-style: none; }
  .svx-os-row li { position: relative; color: var(--color-muted); font-size: 0.92rem; line-height: 1.55; text-wrap: pretty; }
  .svx-os-row li::before { content: ""; position: absolute; left: -0.9rem; top: 0.68em; width: 4px; height: 4px; border-radius: 50%; background: rgba(244, 242, 237, 0.35); }
  .svx-os-row strong { color: var(--color-text); font-weight: 600; }
  .svx-os-row code, .svx-up-text :global(code) { font-family: var(--font-mono); font-size: 0.85em; padding: 0.05rem 0.3rem; border-radius: 4px; background: rgba(244, 242, 237, 0.08); color: var(--color-text); }
  .svx-os-row a, .svx-up-text :global(a) { color: var(--color-text); text-decoration: underline; text-decoration-color: rgba(244, 242, 237, 0.35); text-underline-offset: 3px; }
  .svx-os-row a:hover { color: var(--sv-orange); text-decoration-color: currentColor; }

  /* SHA-256 of each file, when the releases call carries a digest (filled by the release script) */
  .svx-os-row li.svx-sum { display: grid; gap: 0.25rem; }
  .svx-os-row li.svx-sum[hidden] { display: none; }
  .svx-sum :global(.svx-sum-h) { color: var(--color-text); font-weight: 600; font-size: 0.85rem; }
  .svx-sum :global(.svx-sum-row) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.6rem; }
  .svx-sum :global(.svx-sum-k) { min-width: 6.5rem; font-size: 0.85rem; }
  .svx-sum :global(code) { font-family: var(--font-mono); font-size: 0.78rem; padding: 0.1rem 0.35rem; border-radius: 4px; background: rgba(244, 242, 237, 0.08); color: var(--color-text); overflow-wrap: anywhere; }
  .svx-sum :global(.svx-sum-copy) {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(244, 242, 237, 0.16);
    background: none;
    color: var(--color-text);
    font: 500 0.78rem/1 var(--font-sans);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .svx-sum :global(.svx-sum-copy:hover) { border-color: var(--sv-orange); color: var(--sv-orange); }
  .svx-sum :global(.svx-sum-copy:focus-visible) { outline: 2px solid var(--sv-orange); outline-offset: 2px; }
  @media (pointer: coarse) { .svx-sum :global(.svx-sum-copy) { min-height: 44px; } }
  .svx-os-row li.svx-sum::before { display: none; }

  /* recent updates: one line per version */
  .svx-ups { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .svx-ups > :global(li) { display: grid; gap: 0.2rem; }
  .svx-ups :global(.svx-up-v) { font-family: var(--font-mono); font-size: 0.8rem; color: var(--sv-orange); }
  .svx-ups :global(.svx-up-v time) { margin-left: 0.4rem; color: var(--color-muted); }
  .svx-up-text :global(p), .svx-up-text :global(li) { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.55; text-wrap: pretty; }
  .svx-up-text :global(strong) { color: var(--color-text); font-weight: 600; }
  .svx-up-text :global(ul) { display: grid; gap: 0.3rem; margin: 0; padding: 0 0 0 1rem; }
  /* long CHANGELOG items are cut at two lines */
  .svx-up-text :global(ul li) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .svx-link { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; margin-top: 0.6rem; color: var(--color-text); font-size: 0.9rem; text-decoration: none; transition: color 0.2s ease; }
  .svx-link:hover { color: var(--sv-orange); }
  .svx-link:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 2px; border-radius: 3px; }

  /* ---- built in the open: one quiet line ---- */
  .svx-open { margin: 1.5rem 0 0; color: var(--color-muted); font-size: 0.88rem; line-height: 1.6; text-wrap: balance; }
  .svx-open a { display: inline-block; color: var(--color-text); text-decoration: underline; text-decoration-color: rgba(244, 242, 237, 0.3); text-underline-offset: 4px; transition: color 0.2s ease, text-decoration-color 0.2s ease; }
  .svx-open a:hover { color: var(--sv-orange); text-decoration-color: currentColor; }
  .svx-open a:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 3px; border-radius: 3px; }
  .svx-open-rel { white-space: nowrap; }
  @media (pointer: coarse) { .svx-open a { padding-block: 0.7rem; margin-block: -0.7rem; } }

  @media (max-width: 860px) {
    .svx-panel { grid-template-columns: minmax(0, 1fr); }
    .svx-block + .svx-block { border-left: 0; border-top: 1px solid var(--sv-line); }
  }
  @media (max-width: 480px) {
    .svx-os-name { width: auto; }
    .svx-os-row summary { flex-wrap: wrap; }
    .svx-os-hint { order: 3; flex-basis: 100%; margin-top: -0.35rem; font-size: 0.84rem; }
    .svx-chev { margin-left: auto; }
    .svx-os-row ul { padding-left: 0.9rem; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>(".svx")!;
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const t = gsap.from(root.querySelectorAll(".svx-line"), {
      yPercent: 40, opacity: 0, duration: 1.1, ease: "expo.out", stagger: 0.12,
      scrollTrigger: { trigger: root, start: "top 75%", once: true },
    });
    return () => t.revert();
  });

  // The install notes for the visitor's own system start open; the others
  // stay folded. A link to one of them ("Install notes" under the button)
  // opens it on the way.
  const rows = [...root.querySelectorAll<HTMLDetailsElement>(".svx-os-row")];
  const os = document.documentElement.dataset.svOs;
  rows.find((d) => d.classList.contains(`svx-os--${os}`))?.setAttribute("open", "");
  const openFor = (hash: string) => {
    const d = rows.find((r) => `#${r.id}` === hash);
    if (d) d.open = true;
  };
  document.addEventListener("click", (e) => {
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="#install-"]');
    if (a) openFor(a.getAttribute("href")!);
  });
  addEventListener("hashchange", () => openFor(location.hash));
  if (location.hash) openFor(location.hash);
</script>

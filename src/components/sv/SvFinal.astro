---
import SvDownload from "./SvDownload.astro";
import { RELEASES_URL, REPO } from "../../scripts/sv-release";
---

<section class="svx" id="download" aria-labelledby="svx-title">
  <div class="svx-glow" aria-hidden="true"></div>
  <div class="svx-inner">
    <h2 class="svx-title" id="svx-title">
      <span class="svx-line">Your voice.</span>
      <span class="svx-line svx-line--em">Your computer.</span>
    </h2>
    <p class="svx-lead">Free to download, free to keep. No sign-up.</p>
    <div class="svx-cta"><SvDownload size="xl" /></div>

    <div class="svx-cards">
      <article class="svx-card" id="whats-new" data-sv-notes-card hidden>
        <p class="sv-eyebrow">What's new in <span data-sv-version>this release</span></p>
        <div class="svx-notes" data-sv-notes></div>
        <a class="svx-more" href={`https://github.com/${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener noreferrer">Full changelog →</a>
      </article>

      <article class="svx-card">
        <p class="sv-eyebrow">Before you install</p>
        <dl class="svx-os">
          <div>
            <dt>Windows</dt>
            <dd>Run the installer. Updates show up inside the app.</dd>
          </div>
          <div>
            <dt>macOS</dt>
            <dd>The app isn't notarised by Apple yet. The first time, right-click it and choose Open. It also needs Accessibility permission for the hotkey and paste.</dd>
          </div>
          <div>
            <dt>Linux</dt>
            <dd>Works on X11. Wayland doesn't let one app type into another, so pasting at the cursor won't work there yet.</dd>
          </div>
        </dl>
        <a class="svx-more" href={RELEASES_URL} data-sv-release-link target="_blank" rel="noopener noreferrer">All files for this release →</a>
      </article>
    </div>
  </div>
</section>

<!-- floating download pill, shown between the two big buttons -->
<div class="svbar" aria-hidden="true" inert>
  <span class="svbar-logo">
    <svg viewBox="0 0 1024 1024"><rect width="1024" height="1024" rx="224" fill="#0d0f14" /><rect x="232" y="432" width="80" height="160" rx="40" fill="#f97316" /><rect x="360" y="352" width="80" height="320" rx="40" fill="#f97316" /><rect x="488" y="252" width="80" height="520" rx="40" fill="#fff" /><rect x="616" y="352" width="80" height="320" rx="40" fill="#f97316" /><rect x="744" y="432" width="80" height="160" rx="40" fill="#f97316" /></svg>
  </span>
  <span class="svbar-text"><strong>Silent Voice</strong> <span data-sv-version></span></span>
  <a class="svbar-btn" href={RELEASES_URL} data-sv-main>Download</a>
</div>

<style>
  .svx { position: relative; padding: clamp(7rem, 14vw, 12rem) 1.25rem clamp(5rem, 10vw, 8rem); overflow: hidden; isolation: isolate; text-align: center; }
  .svx-glow {
    position: absolute;
    left: 50%;
    top: 22%;
    width: min(110vw, 1100px);
    aspect-ratio: 1.6;
    translate: -50% -50%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(249, 115, 22, 0.32), rgba(249, 115, 22, 0.08) 50%, transparent);
    filter: blur(30px);
    animation: svx-breathe 6s ease-in-out infinite;
  }
  @keyframes svx-breathe { 50% { transform: scale(1.12); opacity: 0.8; } }
  .svx-inner { max-width: 70rem; margin: 0 auto; }
  .svx-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 11vw, 9.5rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .svx-line { display: block; }
  .svx-line--em { font-style: italic; color: var(--sv-orange); }
  .svx-lead { margin: 1.6rem 0 2.6rem; color: var(--color-muted); font-size: 1.15rem; }

  .svx-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1rem; align-items: start; margin-top: clamp(4rem, 8vw, 6rem); text-align: left; }
  .svx-card { padding: clamp(1.4rem, 3vw, 2rem); border-radius: 22px; border: 1px solid var(--sv-line); background: rgba(17, 17, 20, 0.8); backdrop-filter: blur(10px); }
  .svx-card[hidden] { display: none; }
  .svx-notes :global(ul) { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.8rem; }
  .svx-notes :global(li) {
    position: relative;
    padding-left: 1.2rem;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .svx-notes :global(li)::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--sv-orange); }
  .svx-notes :global(strong) { color: var(--color-text); font-weight: 600; }
  .svx-notes :global(code) { font-family: var(--font-mono); font-size: 0.85em; padding: 0.05rem 0.3rem; border-radius: 4px; background: rgba(244, 242, 237, 0.08); }

  .svx-os { margin: 1rem 0 0; display: grid; gap: 1rem; }
  .svx-os > div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; }
  .svx-os dt { font-weight: 600; font-size: 0.92rem; }
  .svx-os dd { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; }
  :global(html[data-sv-os="windows"]) .svx-os > div:nth-child(1) dt,
  :global(html[data-sv-os="mac"]) .svx-os > div:nth-child(2) dt,
  :global(html[data-sv-os="linux"]) .svx-os > div:nth-child(3) dt { color: var(--sv-orange); }

  .svx-more { display: inline-flex; align-items: center; min-height: 44px; margin-top: 0.8rem; color: var(--color-text); font-size: 0.9rem; text-decoration: none; border-bottom: 1px solid transparent; transition: color 0.2s ease; }
  .svx-more:hover { color: var(--sv-orange); }

  /* ---- floating pill ---- */
  .svbar {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.45rem 0.45rem 0.45rem 0.5rem;
    border-radius: 999px;
    background: rgba(17, 17, 20, 0.85);
    border: 1px solid rgba(244, 242, 237, 0.12);
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 40px -10px rgba(249, 115, 22, 0.35);
    backdrop-filter: blur(14px);
    transform: translate(-50%, 160%);
    transition: transform 0.6s cubic-bezier(.22, 1.2, .36, 1);
  }
  .svbar.show { transform: translate(-50%, 0); }
  .svbar-logo { width: 2.2rem; height: 2.2rem; flex: none; }
  .svbar-logo svg { width: 100%; height: 100%; display: block; }
  .svbar-text { font-size: 0.88rem; white-space: nowrap; }
  .svbar-text span { color: var(--color-muted); font-family: var(--font-mono); font-size: 0.75rem; margin-left: 0.25rem; }
  .svbar-btn {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--sv-orange);
    color: #140a02;
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .svbar-btn:hover { transform: scale(1.04); box-shadow: 0 0 30px rgba(249, 115, 22, 0.6); }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>(".svx")!;
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const t = gsap.from(root.querySelectorAll(".svx-line"), {
      yPercent: 60, opacity: 0, filter: "blur(14px)", duration: 1.4, ease: "expo.out", stagger: 0.14,
      scrollTrigger: { trigger: root, start: "top 70%", once: true },
    });
    return () => t.revert();
  });

  // The pill shows once the hero button has scrolled away, and hides again
  // while the final button is on screen, so there is never a doubled CTA.
  const bar = document.querySelector<HTMLElement>(".svbar")!;
  const heroBtn = document.querySelector(".svh .svdl-btn");
  const finalBtn = root.querySelector(".svdl-btn");
  // also out of the way while the demo keys are on screen (it would sit on them on phones)
  const demoKeys = document.querySelector(".svd-hold");
  let heroGone = false, finalSeen = false, demoOn = false;
  const sync = () => {
    const on = heroGone && !finalSeen && !demoOn;
    bar.classList.toggle("show", on);
    // hidden pill must not be reachable by keyboard or screen readers
    bar.toggleAttribute("inert", !on);
    bar.setAttribute("aria-hidden", String(!on));
  };
  if (heroBtn) new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(heroBtn);
  if (demoKeys) new IntersectionObserver(([e]) => { demoOn = e.isIntersecting; sync(); }).observe(demoKeys);
  if (finalBtn) new IntersectionObserver(([e]) => { finalSeen = e.isIntersecting || e.boundingClientRect.top < 0; sync(); }).observe(finalBtn);
</script>

---
// Notetaker, the v0.2.0 headline feature. The centrepiece is a working copy of
// the real Notetaker window that plays one scripted call: Start recording, the
// lines arrive live as "You" / "Others", Stop, the Others side is split into
// Speaker 1 / Speaker 2, then Summarize writes the Overview. The base HTML is
// the finished meeting (JS off, reduced motion). Around it: echo removal,
// mixed languages, local or cloud, after-the-call tools, platform notes and a
// compact "Transcribe a file" card. Facts: facts-app.md "Notetaker", facts-ui.md §3.

type Who = "you" | "a" | "b";
const LINES: { t: number; who: Who; text: string }[] = [
  { t: 4, who: "you", text: "Quick note, I'm recording this so I don't have to take notes. Where are we with the launch?" },
  { t: 19, who: "a", text: "The landing page is done. I'm only missing the final screenshots from the app." },
  { t: 41, who: "you", text: "I can send those tomorrow morning. Are we still aiming for the 14th?" },
  { t: 62, who: "b", text: "The 14th works for me, as long as the email goes out the day before." },
  { t: 86, who: "a", text: "Then let's keep the 14th and send the email on the 13th." },
  { t: 111, who: "you", text: "Good. I'll write the email and share a draft with you both on Friday." },
  { t: 134, who: "b", text: "I'll schedule the launch day posts and check the price page one more time." },
];
const DURATION = 151;
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const finalName = (w: Who) => (w === "you" ? "You" : w === "a" ? "Speaker 1" : "Speaker 2");

const NAV = [
  { k: "Home", d: "M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" },
  { k: "Progress", d: "M5 20v-6M12 20V8M19 20V4" },
  { k: "Transcribe", d: "M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M9 13h6M9 17h4" },
  { k: "Notetaker", d: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" },
  { k: "Model Store", d: "M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" },
  { k: "Writing styles", d: "M4 20h4L19 9l-4-4L4 16zM14 6l4 4" },
  { k: "Theme", d: "M12 3a9 9 0 1 0 0 18c1 0 1.5-.8 1.5-1.5 0-1-.8-1.3-.8-2.3 0-.8.7-1.2 1.5-1.2H17a4 4 0 0 0 4-4c0-5-4-9-9-9z" },
  { k: "Settings", d: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" },
  { k: "History", d: "M12 7v5l3 2M21 12a9 9 0 1 1-9-9 9 9 0 0 1 9 9z" },
];

// Echo picture: the mic hears your voice (orange) plus the call from your
// speakers (slate). Where only the speakers are heard, the gate mutes it;
// where you talk over them, the speakers' sound is subtracted (about 8 dB).
const BARS = 72;
const hash = (i: number, s: number) => Math.abs((Math.sin(i * 12.9898 + s * 78.233) * 43758.5453) % 1);
const inSeg = (i: number, segs: [number, number][]) => segs.some(([a, b]) => i >= a && i <= b);
const voiceSegs: [number, number][] = [[7, 21], [33, 47], [57, 66]];
const echoSegs: [number, number][] = [[0, 9], [18, 35], [44, 59], [64, 71]];
const echoBars = Array.from({ length: BARS }, (_, i) => {
  const voice = inSeg(i, voiceSegs) ? 0.32 + 0.68 * hash(i, 1) : 0;
  const echo = inSeg(i, echoSegs) ? 0.22 + 0.42 * hash(i, 2) : 0.03 + 0.04 * hash(i, 3);
  return { x: i * 10 + 2, voice, echo, gate: voice === 0 };
});
---

<section class="svn" id="notetaker" aria-labelledby="svn-title">
  <div class="svn-inner">
    <header class="svn-head">
      <div>
        <p class="sv-eyebrow">New in 0.2.0 · Notetaker</p>
        <h2 class="h2" id="svn-title">Your meetings, <em>written down.</em></h2>
      </div>
      <p class="svn-lead">
        Notetaker records your side and the other side of any call. The words show up while people talk,
        it tells the voices apart, and when you stop, it writes the summary. All on your computer,
        unless you choose a cloud provider.
      </p>
    </header>

    <!-- story chapters: each one plays the demo from that point -->
    <div class="svn-controls">
      <ol class="svn-chapters" aria-label="What the demo shows">
        <li>
          <button type="button" class="svn-ch" data-ch="1">
            <span class="svn-ch-n" aria-hidden="true">01</span>
            <span class="svn-ch-t">Both sides, live</span>
            <span class="svn-ch-d">Your mic is "You", the computer's sound is "Others". Lines appear as people talk.</span>
            <i class="svn-ch-bar" aria-hidden="true"></i>
          </button>
        </li>
        <li>
          <button type="button" class="svn-ch" data-ch="2">
            <span class="svn-ch-n" aria-hidden="true">02</span>
            <span class="svn-ch-t">Voices told apart</span>
            <span class="svn-ch-d">After you stop, "Others" becomes Speaker 1, Speaker 2. About 15 s per minute of meeting.</span>
            <i class="svn-ch-bar" aria-hidden="true"></i>
          </button>
        </li>
        <li>
          <button type="button" class="svn-ch" data-ch="3">
            <span class="svn-ch-n" aria-hidden="true">03</span>
            <span class="svn-ch-t">The summary, written</span>
            <span class="svn-ch-d">Key points, decisions and action items, from a model on your computer or your own cloud key.</span>
            <i class="svn-ch-bar" aria-hidden="true"></i>
          </button>
        </li>
      </ol>
    </div>

    <!-- ===================== the Notetaker window ===================== -->
    <div class="svn-stage">
      <div class="nt" data-phase="post" data-split="1" role="group" aria-label="Notetaker demo with a sample call" tabindex="-1">
        <div class="nt-title" aria-hidden="true">
          <span class="nt-lights"><i></i><i></i><i></i></span>
          <span class="nt-wtitle">Silent Voice</span>
          <span class="nt-winctl">
            <svg viewBox="0 0 10 10"><path d="M1 5h8" /></svg>
            <svg viewBox="0 0 10 10"><rect x="1.5" y="1.5" width="7" height="7" rx="1" /></svg>
            <svg viewBox="0 0 10 10"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7" /></svg>
          </span>
        </div>

        <div class="nt-body">
          <nav class="nt-side" aria-hidden="true">
            <div class="nt-brand">
              <svg viewBox="0 0 1024 1024" class="nt-logo">
                <rect width="1024" height="1024" rx="224" fill="#0d0f14" />
                <rect x="232" y="432" width="80" height="160" rx="40" fill="#f97316" />
                <rect x="360" y="352" width="80" height="320" rx="40" fill="#f97316" />
                <rect x="488" y="252" width="80" height="520" rx="40" fill="#ffffff" />
                <rect x="616" y="352" width="80" height="320" rx="40" fill="#f97316" />
                <rect x="744" y="432" width="80" height="160" rx="40" fill="#f97316" />
              </svg>
              <span class="nt-brand-t"><b>Silent Voice</b><small>local-first dictation</small></span>
            </div>
            <ul class="nt-nav">
              {NAV.map((n) => (
                <li class:list={["nt-nav-i", { "is-on": n.k === "Notetaker" }]}>
                  <svg viewBox="0 0 24 24"><path d={n.d} /></svg>
                  <span class="nt-nav-t">{n.k}</span>
                  {n.k === "Notetaker" && <span class="nt-nav-dot"></span>}
                </li>
              ))}
            </ul>
            <div class="nt-side-foot"><span class="nt-theme"><i></i><i class="on"></i><i></i></span><span>v0.2.0</span></div>
          </nav>

          <div class="nt-main">
            <div class="nt-head">
              <div class="nt-head-t">
                <p class="nt-h1">Notetaker</p>
                <p class="nt-sub">Record a call and get a live transcript of who said what. Audio and text stay on this PC.</p>
              </div>
              <div class="nt-actions">
                <span class="nt-gear" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" /></svg>
                </span>
                <button type="button" class="nt-start">
                  <span class="nt-start-ic" aria-hidden="true"></span>Start recording
                </button>
                <span class="nt-recpill">
                  <span class="nt-ping" aria-hidden="true"></span>
                  <span class="nt-rec-t">Recording <span class="nt-rec-time">{clock(DURATION)}</span></span>
                  <button type="button" class="nt-stop"><span class="nt-stop-l">■ Stop</span><span class="nt-stop-f">Finishing up…</span></button>
                </span>
              </div>
            </div>

            <div class="nt-cols">
              <!-- left: setup card + meeting list -->
              <div class="nt-list" aria-hidden="true">
                <div class="nt-setup">
                  <dl>
                    <div><dt>You</dt><dd>Default microphone</dd></div>
                    <div><dt>Others</dt><dd>What plays on your speakers</dd></div>
                  </dl>
                  <p class="nt-setup-hint">Best with headphones. On speakers your mic also hears the others; Silent Voice drops those repeats, but headphones keep "You" cleanest.</p>
                  <p class="nt-consent">Let people know you're recording. In many places everyone on a call has to agree to it. <b>Got it</b></p>
                </div>
                <div class="nt-search">
                  <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg>
                  Search meetings
                </div>
                <p class="nt-day">Today</p>
                <div class="nt-row nt-row--now">
                  <span class="nt-tile"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" /></svg><i></i></span>
                  <span class="nt-row-t"><b>Meeting at 3:05 PM</b><small class="nt-row-done">3:05 PM · {clock(DURATION)}</small><small class="nt-row-live">Recording now</small></span>
                </div>
                <div class="nt-row">
                  <span class="nt-tile"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" /></svg></span>
                  <span class="nt-row-t"><b>Design review</b><small>11:30 AM · 38:04</small></span>
                </div>
                <p class="nt-day">Yesterday</p>
                <div class="nt-row">
                  <span class="nt-tile"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" /></svg></span>
                  <span class="nt-row-t"><b>Weekly sync</b><small>10:02 AM · 42:17</small></span>
                </div>
                <div class="nt-row">
                  <span class="nt-tile"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" /></svg></span>
                  <span class="nt-row-t"><b>Call with the printer</b><small>4:15 PM · 12:50</small></span>
                </div>
              </div>

              <!-- right: the open meeting -->
              <div class="nt-panel">
                <p class="nt-empty">Start recording when a call begins, and stop when it ends.</p>

                <div class="nt-ph">
                  <div class="nt-ph-t">
                    <p class="nt-mtitle">Meeting at 3:05 PM</p>
                    <p class="nt-details nt-details--live">Today · 3:05 PM · Recording now</p>
                    <p class="nt-details nt-details--post">
                      <span>Today · 3:05 PM · {clock(DURATION)}</span>
                      <span class="nt-sep" aria-hidden="true">·</span>
                      <label class="nt-people-l">People besides you
                        <select class="nt-people" title="How many voices to tell apart on the Others side. Auto lets the model guess.">
                          <option value="auto" selected>Auto</option>
                          <option value="1">1</option>
                          <option value="2">2</option>
                        </select>
                      </label>
                      <span class="nt-voices" hidden> · telling voices apart…</span>
                      <span class="nt-sep" aria-hidden="true">·</span>
                      <span class="nt-again">Transcribe again</span>
                    </p>
                  </div>
                  <div class="nt-tools" aria-hidden="true">
                    <span><svg viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /></svg><em>Copy</em></span>
                    <span><svg viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg><em>Save…</em></span>
                    <span><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" /></svg><em>Delete</em></span>
                  </div>
                </div>

                <div class="nt-scroll" data-lenis-prevent>
                  <div class="nt-ov" data-state="done">
                    <p class="nt-ov-label">Overview</p>
                    <div class="nt-ov-card">
                      <div class="nt-ov-empty">
                        <p class="ov-h" data-for="live">The transcript fills in as people talk.</p>
                        <p class="ov-s" data-for="live">Summarize it when the meeting ends.</p>
                        <p class="ov-h" data-for="ready">Get the main points, decisions and action items.</p>
                        <p class="ov-s" data-for="ready">Written with the summary model from Notetaker settings.</p>
                        <p class="ov-h" data-for="busy">Writing the summary…</p>
                        <p class="ov-s" data-for="busy">A long meeting can take a few minutes, longer with a model on this PC.</p>
                      </div>
                      <div class="nt-ov-notes">
                        <div class="ov-sec">
                          <p class="ov-sh">Summary</p>
                          <p>A short check on the launch. The date stays on the 14th, with the launch email going out the day before.</p>
                        </div>
                        <div class="ov-sec">
                          <p class="ov-sh">Key points</p>
                          <ul><li>The landing page is done, it only needs the final app screenshots.</li><li>The launch email goes out one day before launch.</li></ul>
                        </div>
                        <div class="ov-sec">
                          <p class="ov-sh">Decisions</p>
                          <ul><li>Launch on the 14th, email on the 13th.</li></ul>
                        </div>
                        <div class="ov-sec">
                          <p class="ov-sh">Action items</p>
                          <ul class="ov-tasks">
                            <li><span class="ov-tag ov-tag--you">You</span>Send the app screenshots tomorrow morning.</li>
                            <li><span class="ov-tag ov-tag--you">You</span>Share the email draft on Friday.</li>
                            <li><span class="ov-tag">Others</span>Schedule the launch day posts and check the price page.</li>
                          </ul>
                        </div>
                      </div>
                      <div class="nt-ov-ctrl">
                        <button type="button" class="nt-sum">
                          <span class="nt-sum-ic" aria-hidden="true">
                            <svg class="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
                            <svg class="i-redo" viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6" /></svg>
                            <span class="i-spin"></span>
                          </span>
                          <span class="nt-sum-l" data-for="ready">Summarize</span>
                          <span class="nt-sum-l" data-for="busy">Writing</span>
                          <span class="nt-sum-l" data-for="done">Redo</span>
                        </button>
                      </div>
                    </div>
                  </div>

                  <ol class="nt-lines" aria-label="Transcript">
                    {LINES.map((l, i) => (
                      <li class="ln" data-i={i} data-who={l.who} data-t={l.t}>
                        <button type="button" class="ln-time" aria-label={`Play from ${clock(l.t)}`} title="Play from here">
                          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>{clock(l.t)}
                        </button>
                        <div class="ln-body">
                          <div class="ln-who"><span class="ln-name"><span class="nm">{finalName(l.who)}</span></span></div>
                          <p class="ln-text">{l.text}</p>
                        </div>
                      </li>
                    ))}
                    <li class="nt-listen">
                      <span></span>
                      <span class="nt-listen-b"><span class="nt-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nt-listen-t">Listening</span></span>
                    </li>
                  </ol>
                </div>

                <div class="nt-player">
                  <button type="button" class="nt-play" aria-label="Play">
                    <svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2v8l6.5-4z" /></svg>
                    <svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2h2.2v8H3zM6.8 2H9v8H6.8z" /></svg>
                  </button>
                  <span class="nt-pos">0:00</span>
                  <input class="nt-range" type="range" min="0" max={DURATION} step="1" value="0" aria-label="Seek" />
                  <span class="nt-dur">{clock(DURATION)}</span>
                  <select class="nt-rate" aria-label="Playback speed">
                    <option value="1" selected>1×</option>
                    <option value="1.25">1.25×</option>
                    <option value="1.5">1.5×</option>
                    <option value="2">2×</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="svn-under">
        <p class="svn-hint">Try it: set <b>People besides you</b> to 1, or click a time to play from there.</p>
        <button type="button" class="svn-replay">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7M4 5v5h5" /></svg>
          Replay
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-svn-live></p>
    </div>

    <!-- ===================== around the mock ===================== -->
    <div class="svn-grid">
      <article class="svn-card svn-card--echo">
        <div class="svn-card-copy">
          <h3>No headphones? The echo comes out.</h3>
          <p>
            On laptop speakers your mic also hears the call. Where it only hears the speakers, that part is muted.
            Where you talk over them, their sound is taken out of your side. On a real call that meant
            about 8 dB less echo, with your voice kept.
          </p>
        </div>
        <div class="svn-echo" data-echo="on">
          <div class="svn-echo-top">
            <p class="svn-echo-k"><i class="v"></i>Your voice <i class="e"></i>Echo from your speakers</p>
            <button type="button" class="svn-echo-tg" aria-pressed="true">
              <span class="svn-sw" aria-hidden="true"><i></i></span>Echo removal
            </button>
          </div>
          <svg class="svn-wave" viewBox="0 0 720 120" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="60" x2="720" y2="60" />
            {echoBars.map((b) => (
              <rect class="eg" x={b.x} y={60 - b.echo * 50} width="6" height={Math.max(2, b.echo * 100)} rx="3" />
            ))}
            {echoBars.map((b, i) => (
              <rect class:list={["eb", b.gate ? "eb--gate" : "eb--sub"]} x={b.x} y={60 - b.echo * 50} width="6" height={Math.max(2, b.echo * 100)} rx="3" style={`--i:${i}`} />
            ))}
            {echoBars.filter((b) => b.voice > 0).map((b) => (
              <rect class="vb" x={b.x} y={60 - b.voice * 50} width="6" height={b.voice * 100} rx="3" />
            ))}
          </svg>
          <div class="svn-echo-read">
            <span><b class="svn-db">about 8 dB less</b> echo</span>
            <span><b>voice kept</b> on a real call</span>
          </div>
        </div>
      </article>

      <article class="svn-card svn-card--lang">
        <div class="svn-card-copy">
          <h3>Two languages, one meeting.</h3>
          <p>Tell it every language people speak, for example Bangla and English. A piece that comes back in the wrong script is done again in the right language.</p>
        </div>
        <div class="svn-lang" aria-hidden="true">
          <div class="svn-lang-set">
            <span class="svn-lang-k">Language spoken</span>
            <span class="svn-lang-sel">Bangla <svg viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" /></svg></span>
            <span class="svn-lang-k">Also spoken:</span>
            <span class="svn-chip">English ×</span>
            <span class="svn-chip svn-chip--add">+ Add</span>
          </div>
          <div class="svn-mini">
            <div class="svn-mini-ln"><span class="t">12:40</span><div><b>Speaker 1</b><p lang="bn">ঠিক আছে, তাহলে লঞ্চ ১৪ তারিখেই হবে।</p></div></div>
            <div class="svn-mini-ln"><span class="t">12:46</span><div><b class="you">You</b><p>Perfect. I'll send the email draft on Friday.</p></div></div>
          </div>
        </div>
      </article>

      <article class="svn-card svn-card--where">
        <div class="svn-card-copy">
          <h3>On your computer by default.</h3>
          <p>Notetaker transcribes on your computer and works offline. If you add your own cloud provider you can use it instead, and then the audio is sent to that provider.</p>
        </div>
        <div class="svn-where">
          <div class="svn-where-opts" role="group" aria-label="Where the meeting is transcribed">
            <button type="button" class="svn-opt" aria-pressed="true" data-where="local">
              <b>On this PC · offline</b><small>Your voice model. Nothing leaves this PC.</small>
            </button>
            <button type="button" class="svn-opt" aria-pressed="false" data-where="cloud">
              <b>Cloud</b><small>Your own provider and key.</small>

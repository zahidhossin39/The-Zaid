    .nt-ov[data-state="done"] .nt-sum { height: 30px; }
    .nt-lines { gap: 4px; min-height: 5.5rem; }
    .ln-who { font-size: 11.5px; }
    .ln-text { font-size: 13.5px; line-height: 1.45; }
    .nt-player { padding: 6px 14px; }
    /* date and "Transcribe again" share the first row, the People choice the second */
    .nt-details--post .nt-sep { display: none; }
    .nt-details--post { column-gap: 12px; }
    .nt-again { order: 1; }
    .nt-people-l { order: 2; }
    .nt-voices { order: 3; }
  }
  @media (max-width: 420px) {
    .nt-rec-w, .nt-pl-long { display: none; }

  .nt-ov-ctrl { display: none; margin-top: 12px; }
  .nt-ov:is([data-state="ready"], [data-state="busy"], [data-state="done"]) .nt-ov-ctrl { display: block; }
  .nt-ov[data-state="done"] .nt-ov-ctrl { position: absolute; top: -6px; right: 0; margin: 0; }
  .nt-sum {
    display: inline-flex; align-items: center; gap: 8px;
    height: 40px; padding: 0 16px;
    border: 0; border-radius: 10px;
    background: var(--a-ac); color: var(--a-on) !important;
    font-size: 14px !important; font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.3s ease;
  }
  .nt-sum:hover { background: #ea580c; }
  .nt-ov[data-state="busy"] .nt-sum { cursor: progress; opacity: 0.85; }
  .nt-ov[data-state="done"] .nt-sum { height: 32px; padding: 0 12px; border: 1px solid var(--a-bd); background: none; color: var(--a-tx) !important; font-size: 13px !important; font-weight: 500; }
  .nt-ov[data-state="done"] .nt-sum:hover { border-color: var(--a-ac); }
  .nt-sum-ic { display: grid; width: 16px; height: 16px; }
  .nt-sum-ic > * { grid-area: 1 / 1; display: none; }
  .nt-sum-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .nt-sum-ic .i-bolt { fill: currentColor; stroke: none; }
  .i-spin { width: 14px !important; height: 14px; margin: 1px; border-radius: 50%; border: 2px solid currentColor; border-top-color: transparent; animation: nt-spin 0.8s linear infinite; }
  .nt-ov[data-state="ready"] .i-bolt, .nt-ov[data-state="busy"] .i-spin, .nt-ov[data-state="done"] .i-redo { display: block; }
  .nt-ov[data-state="busy"] .nt-ov-empty .ov-h { background: linear-gradient(90deg, var(--a-tx) 35%, var(--a-ac) 50%, var(--a-tx) 65%) 0 0 / 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: nt-scan 1.6s linear infinite; }

  /* transcript */
  .nt-lines {
    position: relative;
    flex: 1 1 auto;
    min-height: 6.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none; margin: 0; padding: 0 4px 0 0;
    display: grid; align-content: start; gap: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--a-bd) transparent;
    /* a soft edge where lines continue out of sight */
    -webkit-mask-image: linear-gradient(transparent, #000 6px, #000 calc(100% - 14px), transparent);
    mask-image: linear-gradient(transparent, #000 6px, #000 calc(100% - 14px), transparent);
  }
  .ln { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 12px; }
  .ln-time {
    position: relative;
    display: flex; align-items: center; justify-content: flex-end; gap: 4px;
    height: fit-content;
    padding: 2px 0 0; border: 0; border-radius: 4px;
    background: none;
    color: var(--a-mu) !important; font-size: 11px !important; font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .ln-time svg { width: 10px; height: 10px; fill: currentColor; flex: none; }
  /* a 24px-plus target around the small time label */
  .ln-time::before { content: ""; position: absolute; inset: -6px -4px; }
  .ln-time:hover { color: var(--a-ac) !important; }
  .ln-time:disabled { cursor: default; }
  .ln-time:disabled:hover { color: var(--a-mu) !important; }
  .ln-time:disabled svg { display: none; }
  .ln-body { max-width: 72ch; margin: 0 -8px; padding: 2px 8px 4px; border-radius: 8px; transition: background 0.35s ease, box-shadow 0.35s ease; }
  .ln.is-now .ln-time { color: var(--a-ac) !important; }
  .ln.is-now .ln-body { background: rgba(249, 115, 22, 0.1); }
  .ln-who { font-size: 12px; font-weight: 600; line-height: 1.5; color: var(--a-tx); }
  .ln[data-who="you"] .ln-who { color: var(--a-ac); }
  .ln-name { display: inline-grid; overflow: hidden; vertical-align: top; }
  .ln-name :global(.nm) { grid-area: 1 / 1; white-space: nowrap; }
  .ln-name :global(.nm-in) { animation: nt-nm-in 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.2) both, nt-nm-glow 1.4s ease-out; }
  .ln-name :global(.nm-out) { animation: nt-nm-out 0.4s cubic-bezier(0.5, 0, 0.75, 0) both; }
  .nt.is-scanning .ln:not([data-who="you"]) .ln-name :global(.nm) {
    background: linear-gradient(90deg, var(--a-tx) 30%, var(--a-ac) 50%, var(--a-tx) 70%) 0 0 / 300% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: nt-scan 1.1s linear infinite;
  }
  .nt.is-scanning .ln:not([data-who="you"]) .ln-body { box-shadow: inset 2px 0 0 rgba(249, 115, 22, 0.55); }
  .ln-text { margin-top: 1px !important; font-size: 14.5px; line-height: 1.55; color: var(--a-tx); }
  .ln.is-new { animation: nt-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .ln-text :global(.w) { animation: nt-word 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--d, 0s); }

  .nt-listen { display: none; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 12px; }
  .nt:is([data-phase="rec"], [data-phase="finishing"]) .nt-listen { display: grid; }
  .nt-listen-b { display: flex; align-items: center; gap: 7px; padding-top: 2px; font-size: 12px; color: var(--a-mu); }
  .nt-dots { display: flex; gap: 3px; }
  .nt-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--a-mu); animation: nt-pulse 1.2s ease-in-out infinite; }
  .nt-dots i:nth-child(2) { animation-delay: 0.15s; }
  .nt-dots i:nth-child(3) { animation-delay: 0.3s; }

  /* player */
  .nt-player { flex: none; display: none; align-items: center; gap: 10px; padding: 9px 22px; border-top: 1px solid var(--a-bd); background: var(--a-s1); }
  .nt[data-phase="post"] .nt-player { display: flex; }
  .nt-play { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border: 0; border-radius: 50%; background: var(--a-ac); color: var(--a-on) !important; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.3s ease; }
  .nt-play svg { width: 12px; height: 12px; fill: currentColor; }
  .nt-play .i-pause, .nt-player.is-playing .nt-play .i-play { display: none; }
  .nt-player.is-playing .nt-play .i-pause { display: block; }
  .nt-pos, .nt-dur { font-size: 11px; color: var(--a-mu); font-variant-numeric: tabular-nums; min-width: 2.2em; }
  .nt-range { flex: 1; min-width: 0; accent-color: var(--a-ac); height: 24px; margin: 0; cursor: pointer; }
  .nt-silent { display: inline-flex; align-items: center; gap: 5px; flex: none; padding: 0 8px; height: 22px; border-radius: 999px; background: var(--a-s2); color: var(--a-mu); font-size: 11px; white-space: nowrap; }
  .nt-silent svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .nt-player.is-playing .nt-silent { color: var(--a-tx); box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.45); }
  .nt-rate { height: 26px; padding: 0 6px; border: 1px solid var(--a-bd); border-radius: 6px; background: var(--a-s2); color: var(--a-tx) !important; font-size: 12px !important; cursor: pointer; }

  @keyframes nt-ping { 75%, 100% { transform: scale(2.2); opacity: 0; } }
  @keyframes nt-pulse { 50% { opacity: 0.35; } }
  @keyframes nt-spin { to { transform: rotate(360deg); } }
  @keyframes nt-scan { from { background-position: 100% 0; } to { background-position: 0 0; } }
  @keyframes nt-rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes nt-word { from { opacity: 0; filter: blur(5px); transform: translateY(4px); } }
  @keyframes nt-nm-in { from { transform: translateY(110%); opacity: 0; filter: blur(3px); } }
  @keyframes nt-nm-out { to { transform: translateY(-110%); opacity: 0; filter: blur(3px); } }
  @keyframes nt-nm-glow { 0%, 40% { text-shadow: 0 0 12px rgba(249, 115, 22, 0.9); color: #fdba74; } }

  .nt.is-redoing .ln-text { opacity: 0.4; transition: opacity 0.3s ease; }

  /* ================= echo + transcribe ================= */
  .svn-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; margin-top: clamp(2rem, 3.6vw, 2.75rem); }
  .svn-card {
    display: flex; flex-direction: column; gap: 1.1rem;
    padding: clamp(1.3rem, 2.2vw, 1.6rem);
    border: 1px solid var(--sv-line); border-radius: 22px;
    background: rgba(17, 17, 20, 0.8);
  }
  .svn-card h3 { margin: 0 0 0.45rem; font-family: "Inter Tight", var(--font-sans); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  .svn-card-copy p { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; max-width: 40rem; }

  /* echo */
  .svn-echo { margin-top: auto; padding: 0.85rem 0.95rem 0.8rem; border-radius: 16px; background: #0b0e14; border: 1px solid #262c3d; }
  .svn-echo-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 0.75rem; flex-wrap: wrap; }
  .svn-echo-state { display: flex; align-items: center; gap: 0.6rem; margin: 0; font-size: 0.88rem; color: #e6e9f0; font-weight: 500; }
  .svn-echo-seg { display: inline-flex; padding: 3px; border-radius: 999px; background: #131722; border: 1px solid #262c3d; }
  .svn-echo-b { min-height: 34px; min-width: 4.6rem; padding: 0 0.9rem; border: 0; border-radius: 999px; background: none; color: #9aa2b5; font: inherit; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: background 0.25s ease, color 0.25s ease; }
  .svn-echo-b:hover { color: #e6e9f0; }
  .svn-echo-b[aria-pressed="true"] { background: #e6e9f0; color: #0b0e14; }
  .svn-echo-b[data-echo-set="on"][aria-pressed="true"] { background: var(--sv-orange); color: #1a1200; }
  .svn-echo-b:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 2px; }
  @media (pointer: coarse) { .svn-echo-b { min-height: 44px; } }
  .svn-echo [data-when] { display: none; }
  .svn-echo[data-echo="on"] [data-when="on"], .svn-echo[data-echo="off"] [data-when="off"] { display: inline; }
  .svn-wave { display: block; width: 100%; height: 4rem; margin: 0.55rem 0 0.35rem; }
  .svn-wave line { stroke: #262c3d; stroke-width: 1; }
  .svn-wave .vb { fill: var(--sv-orange); }
  .svn-wave .eg { fill: none; stroke: #64748b; stroke-width: 1; stroke-dasharray: 2 2; opacity: 0; transition: opacity 0.6s ease 0.3s; }
  .svn-echo[data-echo="on"] .eg { opacity: 0.45; }
  .svn-wave .eb { fill: #64748b; transform-box: fill-box; transform-origin: center; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease; transition-delay: calc(var(--i) * 9ms); }
  .svn-echo[data-echo="on"] .eb--sub { transform: scaleY(0.4); opacity: 0.55; }
  .svn-echo[data-echo="on"] .eb--gate { transform: scaleY(0.04); opacity: 0.2; }
  .svn-echo-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .svn-echo-k { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; margin: 0; font-size: 0.8rem; color: #8b93a7; }
  .svn-echo-k > span { display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; }
  .svn-echo-k i { width: 9px; height: 9px; border-radius: 3px; flex: none; }
  .svn-echo-k i.v { background: var(--sv-orange); }
  .svn-echo-k i.e { background: #64748b; }
  .svn-echo-num { display: flex; align-items: center; gap: 0.6rem; margin: 0; font-size: 0.82rem; color: #8b93a7; white-space: nowrap; }
  .svn-echo-num b { color: #e6e9f0; font-weight: 600; font-size: 0.95rem; }
  .svn-echo[data-echo="on"] .svn-echo-num b { color: var(--sv-orange); }
  .svn-echo-meter { position: relative; width: 52px; height: 6px; border-radius: 999px; background: #262c3d; overflow: hidden; }
  .svn-echo-meter i { position: absolute; inset: 0; background: #64748b; transform-origin: left; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .svn-echo[data-echo="on"] .svn-echo-meter i { transform: scaleX(0.4); background: var(--sv-orange); }

  /* transcribe a file */
  .svn-card--file { background: linear-gradient(135deg, rgba(249, 115, 22, 0.07), rgba(17, 17, 20, 0.8) 50%); }
  .svn-file-k { margin: 0 0 0.55rem !important; font-family: var(--font-mono); font-size: 0.7rem !important; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sv-orange) !important; }
  .svn-file-ui { margin-top: auto; padding: 0.95rem 1.05rem 1rem; border-radius: 16px; background: #131722; border: 1px solid #262c3d; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #e6e9f0; }
  .svn-file-row { display: flex; align-items: center; gap: 0.7rem; }
  .svn-file-ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: #1b2030; color: var(--sv-orange); flex: none; }
  .svn-file-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .svn-file-n { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .svn-file-n b { font-size: 13px; font-weight: 600; }
  .svn-file-n small { font-size: 11.5px; color: #8b93a7; }
  .svn-file-done { margin-left: auto; padding: 0 0.55rem; border-radius: 999px; background: rgba(34, 197, 94, 0.12); color: #4ade80; font-size: 11.5px; line-height: 22px; }
  .svn-file-bar { display: block; height: 4px; margin: 0.75rem 0 0.8rem; border-radius: 999px; background: #262c3d; overflow: hidden; }
  .svn-file-bar i { display: block; height: 100%; background: var(--sv-orange); transform-origin: left; }
  .svn-file-lines { display: grid; gap: 0.4rem; }
  .svn-file-lines p { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 0.5rem; margin: 0; font-size: 13.5px; line-height: 1.5; }
  .svn-file-lines span { padding-top: 1px; text-align: right; font-size: 11px; color: #8b93a7; font-variant-numeric: tabular-nums; }
  .svn-file-fmt { margin: -0.3rem 0 0; font-family: var(--font-mono); font-size: 0.72rem; color: rgba(244, 242, 237, 0.55); }

  /* ================= more about Notetaker ================= */
  .svn-more { margin-top: 1rem; border: 1px solid var(--sv-line); border-radius: 22px; background: rgba(17, 17, 20, 0.8); }
  .svn-more summary {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.4rem 1.25rem;
    min-height: 64px; padding: 0.9rem 1.4rem;
    border-radius: 22px;
    cursor: pointer; list-style: none;
    transition: background 0.2s ease;
  }
  .svn-more summary::-webkit-details-marker { display: none; }
  .svn-more summary:hover { background: rgba(244, 242, 237, 0.025); }
  .svn-more summary:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 2px; }
  .svn-more-t { font-family: "Inter Tight", var(--font-sans); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; color: var(--color-text); }
  .svn-more-d { font-size: 0.86rem; color: var(--color-muted); }
  .svn-more-ch { width: 30px; height: 30px; padding: 6px; border-radius: 50%; border: 1px solid var(--sv-line); fill: none; stroke: var(--sv-orange); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.3s ease; }
  .svn-more[open] .svn-more-ch { transform: rotate(180deg); }
  .svn-more-body { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 1.75rem; padding: 0.6rem 1.4rem 1.4rem; border-top: 1px solid var(--sv-line); padding-top: 1.4rem; }
  .svn-mi h3 { margin: 0 0 0.5rem; font-family: "Inter Tight", var(--font-sans); font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--color-text); }
  .svn-mi > p { margin: 0; font-size: 0.88rem; line-height: 1.5; color: var(--color-muted); }
  .svn-mi-note { margin-top: 0.6rem !important; font-size: 0.82rem !important; }
  .svn-lang { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; margin-top: 0.8rem; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 0.78rem; color: #e6e9f0; }
  .svn-lang-sel { display: inline-flex; align-items: center; gap: 0.35rem; height: 26px; padding: 0 0.55rem; border: 1px solid #262c3d; border-radius: 7px; background: #1b2030; }
  .svn-lang-sel svg { width: 10px; height: 10px; fill: none; stroke: #8b93a7; stroke-width: 1.5; }
  .svn-chip { display: inline-flex; align-items: center; height: 24px; padding: 0 0.6rem; border-radius: 999px; background: rgba(249, 115, 22, 0.14); color: #fdba74; }
  .svn-lang-ln { flex-basis: 100%; padding: 0.55rem 0.7rem; border-radius: 10px; background: #131722; border: 1px solid #262c3d; font-size: 0.86rem; line-height: 1.5; }
  .svn-lang-ln b { display: block; font-size: 0.72rem; color: #8b93a7; font-weight: 600; }
  .svn-lang-ln [lang="bn"] { font-family: "Nirmala UI", "Bangla Sangam MN", "Kohinoor Bangla", "Noto Sans Bengali", "Hind Siliguri", sans-serif; }
  .svn-where { display: grid; gap: 0.5rem; margin-top: 0.8rem; }
  .svn-where-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .svn-opt {
    min-height: 44px; padding: 0.4rem 0.6rem;
    border: 1px solid #262c3d; border-radius: 12px;
    background: #131722; color: #e6e9f0;
    font: inherit; font-size: 0.8rem; line-height: 1.25; text-align: left; cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .svn-opt b { font-weight: 600; }
  .svn-opt:hover { border-color: #3a4258; }
  .svn-opt[aria-pressed="true"] { border-color: var(--sv-orange); background: rgba(249, 115, 22, 0.08); }
  .svn-opt:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: 2px; }
  .svn-where-out { margin: 0; padding: 0.6rem 0.75rem; border-radius: 12px; background: #0b0e14; border: 1px solid #262c3d; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 0.84rem; line-height: 1.45; color: #e6e9f0; }
  .svn-where-k { display: block; margin-bottom: 0.15rem; font-size: 0.74rem; color: #8b93a7; }
  .svn-where-out [hidden] { display: none; }
  .svn-tools { display: grid; gap: 0.55rem; margin: 0; }
  .svn-tools div { padding-left: 0.75rem; border-left: 1px solid var(--sv-line); }
  .svn-tools dt { font-size: 0.86rem; font-weight: 600; color: var(--color-text); }
  .svn-tools dd { margin: 0.1rem 0 0; font-size: 0.82rem; line-height: 1.45; color: var(--color-muted); }
  .svn-tools dd a { color: var(--color-text); text-decoration: underline; text-decoration-color: rgba(249, 115, 22, 0.6); text-underline-offset: 3px; }
  .svn-consent { align-self: start; display: flex; gap: 0.75rem; align-items: flex-start; margin: 0; padding: 0.8rem 1rem; border-radius: 14px; background: rgba(249, 115, 22, 0.06); border: 1px solid rgba(249, 115, 22, 0.2); font-size: 0.88rem; color: var(--color-muted); }
  .svn-consent b { color: var(--color-text); font-weight: 600; }
  .svn-consent svg { width: 20px; height: 20px; flex: none; margin-top: 0.05rem; fill: none; stroke: var(--sv-orange); stroke-width: 1.8; stroke-linecap: round; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* ================= responsive ================= */
  @media (max-width: 1279px) {
    .nt-body { grid-template-columns: 60px minmax(0, 1fr); }
    .nt-brand { justify-content: center; padding: 16px 0 14px; }
    .nt-brand-t, .nt-nav-t, .nt-side-foot { display: none; }
    .nt-nav { padding: 0 8px; }
    .nt-nav-i { position: relative; justify-content: center; padding: 9px 0; }
    .nt-nav-dot { position: absolute; top: 4px; right: 4px; }
    .svn-more-body { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1099px) {
    /* stacked: "Play the call" sits right above the window, so the button and
       what it plays share one view (the page scrolls the pair into place) */
    .svn-hero { grid-template-columns: minmax(0, 1fr); row-gap: 1.1rem; }
    .svn-side { display: contents; }
    .svn-lead { order: 1; max-width: 44rem; margin: 0; }
    .svn-chapters { order: 2; margin-bottom: 0.4rem; }
    .svn-play { order: 3; }
    .svn-stage { order: 4; }
    .svn-hint { order: 5; }
    .nt { max-height: calc(100svh - 156px); }
    .svn-chapters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .svn-ch { grid-template-columns: minmax(0, 1fr); }
    .svn-ch-ic { grid-row: auto; margin-bottom: 0.3rem; }
    .svn-ch-t { padding-top: 0; }
    .svn-ch-d { grid-column: 1; }
    .svn-hint { margin: 0; }
  }
  @media (max-width: 860px) {
    .svn-pair { grid-template-columns: minmax(0, 1fr); }
    .svn-more summary { grid-template-columns: minmax(0, 1fr) auto; }

  .nt-body { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: 200px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); }

  /* sidebar */
  .nt-side { display: flex; flex-direction: column; min-height: 0; overflow: hidden; background: var(--a-s1); border-right: 1px solid var(--a-bd); }

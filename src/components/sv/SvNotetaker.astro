---
// Notetaker, the v0.2.0 headline feature. The centrepiece is a working copy of
// the real Notetaker window. It starts on the finished meeting (speaker labels
// and Overview visible), which is also the JS-off and reduced-motion frame.
// "Play the call" replays it in about 10 s: Start recording, lines arrive as
// "You" / "Others", Stop, "Others" is split into Speaker 1 / Speaker 2, then
// Summarize writes the Overview. Beside it: the three steps (each one plays
// from there). Below: echo removal and Transcribe a file, then a "More about
// Notetaker" disclosure. Facts: facts-app.md "Notetaker", facts-ui.md §3.

type Who = "you" | "a" | "b";
const LINES: { t: number; who: Who; text: string }[] = [
  { t: 4, who: "you", text: "I'm recording so I don't have to take notes. How's the launch looking?" },
  { t: 17, who: "a", text: "The landing page is done. I only need the final app screenshots." },
  { t: 36, who: "you", text: "I'll send those tomorrow morning, and I'll write the launch email." },
  { t: 58, who: "b", text: "Then the 14th works for me, if the email goes out the day before." },
  { t: 79, who: "a", text: "Good, launch on the 14th and email on the 13th. I'll check the price page." },
  { t: 101, who: "b", text: "And I'll schedule the launch day posts." },
];
const DURATION = 115;
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const finalName = (w: Who) => (w === "you" ? "You" : w === "a" ? "Speaker 1" : "Speaker 2");

const NAV = [
  { k: "Home", d: "M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" },
  { k: "Progress", d: "M5 20v-6M12 20V8M19 20V4" },
  { k: "Transcribe", d: "M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M9 13h6M9 17h4" },
  { k: "Notetaker", d: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3" },
  { k: "Model Store", d: "M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" },
  { k: "Writing styles", d: "M4 20h4L19 9l-4-4L4 16zM14 6l4 4" },
  { k: "Theme", d: "M12 3a9 9 0 1 0 0 18c1 0 1.5-.8 1.5-1.5 0-1-.8-1.3-.8-2.3 0-.8.7-1.2 1.5-1.2H17a4 4 0 0 0 4-4c0-5-4-9-9-9z" },
  { k: "Settings", d: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" },
  { k: "History", d: "M12 7v5l3 2M21 12a9 9 0 1 1-9-9 9 9 0 0 1 9 9z" },
];

const STEPS = [
  { n: 1, t: "Who said what, live", d: "You and Others, line by line." },
  { n: 2, t: "Every voice told apart", d: "Others becomes Speaker 1, Speaker 2." },
  { n: 3, t: "Action items, per person", d: "One click on Summarize." },
];

// Echo picture: the mic hears your voice (orange) plus the call from your
// speakers (slate). Where only the speakers are heard, the gate mutes it;
// where you talk over them, the speakers' sound is subtracted (about 8 dB).
const BARS = 72;
const hash = (i: number, s: number) => Math.abs((Math.sin(i * 12.9898 + s * 78.233) * 43758.5453) % 1);
const inSeg = (i: number, segs: [number, number][]) => segs.some(([a, b]) => i >= a && i <= b);
const voiceSegs: [number, number][] = [[7, 21], [33, 47], [57, 66]];
const echoSegs: [number, number][] = [[0, 9], [18, 35], [44, 59], [64, 71]];
const echoBars = Array.from({ length: BARS }, (_, i) => {
  const voice = inSeg(i, voiceSegs) ? 0.32 + 0.68 * hash(i, 1) : 0;
  const echo = inSeg(i, echoSegs) ? 0.22 + 0.42 * hash(i, 2) : 0.03 + 0.04 * hash(i, 3);
  return { x: i * 10 + 2, voice, echo, gate: voice === 0 };
});
const PLAY = "M3.5 2v8l6.5-4z";
---

<section class="svn" id="notetaker" aria-labelledby="svn-title">
  <div class="svn-inner">
    <header class="svn-head">
      <p class="sv-eyebrow">New in 0.2.0 · Notetaker</p>
      <h2 class="h2" id="svn-title">Your meetings, <em>written down.</em></h2>
    </header>

    <div class="svn-hero">
      <!-- left: what it does, and the controls that play the demo -->
      <div class="svn-side">
        <p class="svn-lead">Record any call and get who said what, then the action items, without taking notes.</p>

        <button type="button" class="svn-play" hidden>
          <span class="svn-play-ic" aria-hidden="true">
            <svg class="i-p" viewBox="0 0 12 12"><path d={PLAY} /></svg>
            <svg class="i-s" viewBox="0 0 12 12"><path d="M2 2.2v7.6L7 6zM7.6 2.2h2v7.6h-2z" /></svg>
          </span>
          <span class="svn-play-l">Play the call</span>
          <span class="svn-play-d" aria-hidden="true">about 10 s</span>
        </button>

        <ol class="svn-chapters" aria-label="What the demo shows">
          {STEPS.map((s) => (
            <li>
              <button type="button" class="svn-ch" data-ch={s.n} disabled>
                <span class="svn-ch-ic" aria-hidden="true">
                  <span class="svn-ch-n">0{s.n}</span>
                  <svg viewBox="0 0 12 12"><path d={PLAY} /></svg>
                </span>
                <span class="svn-ch-t">{s.t}</span>
                <span class="svn-ch-d">{s.d}</span>
                <i class="svn-ch-bar" aria-hidden="true"></i>
              </button>
            </li>
          ))}
        </ol>

        <p class="svn-hint">Try it: set <b>People</b> to 1, or <span class="h-fine">click</span><span class="h-coarse">tap</span> a time. The demo has no sound.</p>
      </div>

      <!-- ===================== the Notetaker window ===================== -->
      <div class="svn-stage">
        <div class="nt" data-phase="post" role="group" aria-label="Notetaker demo with a sample call" tabindex="-1">
          <div class="nt-title" aria-hidden="true">
            <span class="nt-lights"><i></i><i></i><i></i></span>
            <span class="nt-wtitle">Silent Voice</span>
            <span class="nt-winctl">
              <svg viewBox="0 0 10 10"><path d="M1 5h8" /></svg>
              <svg viewBox="0 0 10 10"><rect x="1.5" y="1.5" width="7" height="7" rx="1" /></svg>
              <svg viewBox="0 0 10 10"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7" /></svg>
            </span>
          </div>

          <div class="nt-body">
            <nav class="nt-side" aria-hidden="true">
              <div class="nt-brand">
                <svg viewBox="0 0 1024 1024" class="nt-logo">
                  <rect width="1024" height="1024" rx="224" fill="#0d0f14" />
                  <rect x="232" y="432" width="80" height="160" rx="40" fill="#f97316" />
                  <rect x="360" y="352" width="80" height="320" rx="40" fill="#f97316" />
                  <rect x="488" y="252" width="80" height="520" rx="40" fill="#ffffff" />
                  <rect x="616" y="352" width="80" height="320" rx="40" fill="#f97316" />
                  <rect x="744" y="432" width="80" height="160" rx="40" fill="#f97316" />
                </svg>
                <span class="nt-brand-t"><b>Silent Voice</b><small>local-first dictation</small></span>
              </div>
              <ul class="nt-nav">
                {NAV.map((n) => (
                  <li class:list={["nt-nav-i", { "is-on": n.k === "Notetaker" }]}>
                    <svg viewBox="0 0 24 24"><path d={n.d} /></svg>
                    <span class="nt-nav-t">{n.k}</span>
                    {n.k === "Notetaker" && <span class="nt-nav-dot"></span>}
                  </li>
                ))}
              </ul>
              <div class="nt-side-foot"><span class="nt-theme"><i></i><i class="on"></i><i></i></span><span>v0.2.0</span></div>
            </nav>

            <div class="nt-main">
              <div class="nt-head">
                <div class="nt-head-t">
                  <p class="nt-h1">Notetaker</p>
                  <p class="nt-sub">Record a call and get a live transcript of who said what. Audio and text stay on this PC.</p>
                </div>
                <div class="nt-actions">
                  <span class="nt-gear" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" /></svg>
                  </span>
                  <button type="button" class="nt-start">
                    <span class="nt-start-ic" aria-hidden="true"></span>Start recording
                  </button>
                  <span class="nt-recpill">
                    <span class="nt-ping" aria-hidden="true"></span>
                    <span class="nt-rec-t"><span class="nt-rec-w">Recording </span><span class="nt-rec-time">{clock(DURATION)}</span></span>
                    <button type="button" class="nt-stop"><span class="nt-stop-l">■ Stop</span><span class="nt-stop-f">Finishing up…</span></button>
                  </span>
                </div>
              </div>

              <!-- the open meeting -->
              <div class="nt-panel">
                <p class="nt-empty">Start recording when a call begins, and stop when it ends.</p>

                <div class="nt-ph">
                  <div class="nt-ph-t">
                    <p class="nt-mtitle">Meeting at 3:05 PM</p>
                    <p class="nt-details nt-details--live">Today · 3:05 PM · Recording now</p>
                    <p class="nt-details nt-details--post">
                      <span class="nt-date">Today · 3:05 PM · {clock(DURATION)}</span>
                      <span class="nt-sep" aria-hidden="true">·</span>
                      <label class="nt-people-l"><span>People<span class="nt-pl-long"> besides you</span></span>
                        <select class="nt-people" title="How many voices to tell apart on the Others side. Auto lets the model guess.">
                          <option value="auto" selected>Auto</option>
                          <option value="1">1</option>
                          <option value="2">2</option>
                        </select>
                      </label>
                      <span class="nt-voices" hidden> · telling voices apart…</span>
                      <span class="nt-sep" aria-hidden="true">·</span>
                      <button type="button" class="nt-again" data-state="idle">
                        <span data-s="idle">Transcribe again</span>
                        <span data-s="confirm">Replace the text? Transcribe with <span class="nt-again-with">this PC</span></span>
                        <span data-s="busy">transcribing again… <u>Cancel</u></span>
                      </button>
                    </p>
                  </div>
                  <div class="nt-tools" aria-hidden="true">
                    <span><svg viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /></svg></span>
                    <span><svg viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg></span>
                    <span><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" /></svg></span>
                  </div>
                </div>

                <div class="nt-content">
                  <div class="nt-ov" data-state="done">
                    <p class="nt-ov-label">Overview</p>
                    <div class="nt-ov-card">
                      <div class="nt-ov-empty">
                        <p class="ov-h" data-for="live">The transcript fills in as people talk.</p>
                        <p class="ov-s" data-for="live">Summarize it when the meeting ends.</p>
                        <p class="ov-h" data-for="ready">Get the main points, decisions and action items.</p>
                        <p class="ov-s" data-for="ready">Written with the summary model from Notetaker settings.</p>
                        <p class="ov-h" data-for="busy">Writing the summary…</p>
                        <p class="ov-s" data-for="busy">A long meeting can take a few minutes, longer with a model on this PC.</p>
                      </div>
                      <div class="nt-ov-notes">
                        <div class="ov-sec">
                          <p class="ov-sh">Key points</p>
                          <ul><li>The landing page is done, apart from the final screenshots.</li></ul>
                        </div>
                        <div class="ov-sec">
                          <p class="ov-sh">Decisions</p>
                          <ul><li>Launch on the 14th, email on the 13th.</li></ul>
                        </div>
                        <div class="ov-sec">
                          <p class="ov-sh">Action items</p>
                          <ul class="ov-tasks">
                            <li><span class="ov-tag ov-tag--you">You</span>Send the screenshots tomorrow.</li>
                            <li><span class="ov-tag ov-tag--you">You</span>Write the launch email.</li>
                            <li><span class="ov-tag" data-who="a">Speaker 1</span>Check the price page.</li>
                            <li><span class="ov-tag" data-who="b">Speaker 2</span>Schedule the launch posts.</li>
                          </ul>
                        </div>
                      </div>
                      <div class="nt-ov-ctrl">
                        <button type="button" class="nt-sum">
                          <span class="nt-sum-ic" aria-hidden="true">
                            <svg class="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
                            <svg class="i-redo" viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6" /></svg>
                            <span class="i-spin"></span>
                          </span>
                          <span class="nt-sum-l" data-for="ready">Summarize</span>
                          <span class="nt-sum-l" data-for="busy">Writing</span>
                          <span class="nt-sum-l" data-for="done">Redo</span>
                        </button>
                      </div>
                    </div>
                  </div>

                  <ol class="nt-lines" aria-label="Transcript" data-lenis-prevent>
                    {LINES.map((l, i) => (
                      <li class="ln" data-i={i} data-who={l.who} data-t={l.t}>
                        <button type="button" class="ln-time" aria-label={`Play from ${clock(l.t)}`} title="Play from here">
                          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z" /></svg>{clock(l.t)}
                        </button>
                        <div class="ln-body">
                          <div class="ln-who"><span class="ln-name"><span class="nm">{finalName(l.who)}</span></span></div>
                          <p class="ln-text">{l.text}</p>
                        </div>
                      </li>
                    ))}
                    <li class="nt-listen">
                      <span></span>
                      <span class="nt-listen-b"><span class="nt-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nt-listen-t">Listening</span></span>
                    </li>
                  </ol>
                </div>

                <div class="nt-player">
                  <button type="button" class="nt-play" aria-label="Play">
                    <svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2v8l6.5-4z" /></svg>
                    <svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2h2.2v8H3zM6.8 2H9v8H6.8z" /></svg>
                  </button>
                  <span class="nt-pos">0:00</span>
                  <input class="nt-range" type="range" min="0" max={DURATION} step="1" value="0" aria-label="Seek" />
                  <span class="nt-dur">{clock(DURATION)}</span>
                  <span class="nt-silent" title="In the app this plays the real recording">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4zM16 9.5l5 5M21 9.5l-5 5" /></svg>Silent demo
                  </span>
                  <select class="nt-rate" aria-label="Playback speed">
                    <option value="1" selected>1×</option>
                    <option value="1.25">1.25×</option>
                    <option value="1.5">1.5×</option>
                    <option value="2">2×</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="sr-only" aria-live="polite" data-svn-live></p>
      </div>
    </div>

    <!-- ===================== the two that sell it ===================== -->
    <div class="svn-pair">
      <article class="svn-card svn-card--echo">
        <div class="svn-card-copy">
          <h3>No headphones? The echo comes out.</h3>
          <p>On laptop speakers your mic also hears the call. Notetaker takes that echo out of your side.</p>
        </div>
        <div class="svn-echo" data-echo="on">
          <div class="svn-echo-top">
            <div class="svn-echo-seg" role="group" aria-label="Your side of the call">
              <button type="button" class="svn-echo-b" data-echo-set="off" aria-pressed="false">Before</button>
              <button type="button" class="svn-echo-b" data-echo-set="on" aria-pressed="true">After</button>
            </div>
            <p class="svn-echo-state" aria-live="polite">
              <span data-when="off">Echo mixed into your side</span><span data-when="on">Echo taken out, voice kept</span>
            </p>
          </div>
          <svg class="svn-wave" viewBox="0 0 720 120" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="60" x2="720" y2="60" />
            {echoBars.map((b) => (
              <rect class="eg" x={b.x} y={60 - b.echo * 50} width="6" height={Math.max(2, b.echo * 100)} rx="3" />
            ))}
            {echoBars.map((b, i) => (
              <rect class:list={["eb", b.gate ? "eb--gate" : "eb--sub"]} x={b.x} y={60 - b.echo * 50} width="6" height={Math.max(2, b.echo * 100)} rx="3" style={`--i:${i}`} />
            ))}
            {echoBars.filter((b) => b.voice > 0).map((b) => (
              <rect class="vb" x={b.x} y={60 - b.voice * 50} width="6" height={b.voice * 100} rx="3" />
            ))}
          </svg>
          <div class="svn-echo-foot">
            <p class="svn-echo-k"><span><i class="v"></i>Your voice</span><span><i class="e"></i>Echo from your speakers</span></p>
            <p class="svn-echo-num">
              <span class="svn-echo-meter" aria-hidden="true"><i></i></span>
              <span data-when="off"><b>0 dB</b> removed</span><span data-when="on"><b>about 8 dB</b> less on a real call</span>
            </p>
          </div>
        </div>
      </article>

      <article class="svn-card svn-card--file">
        <div class="svn-card-copy">
          <p class="svn-file-k">Also new: Transcribe</p>
          <h3>Got a recording already? Drop it in.</h3>
          <p>Lectures, calls, voice memos, videos. Get a transcript with times, saved as .txt, .md or .srt. Always on your computer.</p>
        </div>
        <div class="svn-file-ui" aria-hidden="true">
          <div class="svn-file-row">
            <span class="svn-file-ic"><svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /></svg></span>
            <span class="svn-file-n"><b>interview.m4a</b><small>24:16 · on this PC</small></span>
            <span class="svn-file-done">Done</span>
          </div>
          <span class="svn-file-bar"><i></i></span>
          <div class="svn-file-lines">
            <p><span>0:00</span>Thanks for making the time. Let's start with how the shop began.</p>
          </div>
        </div>
        <p class="svn-file-fmt">mp3 · m4a · aac · mp4 · mov · wav · flac · ogg · mkv</p>
      </article>
    </div>

    <!-- ===================== the rest, one click away ===================== -->
    <details class="svn-more">
      <summary>
        <span class="svn-more-t">More about Notetaker</span>
        <span class="svn-more-d">Two languages in one call · on your computer or the cloud · what it needs · search and export · where it records the other side</span>
        <svg class="svn-more-ch" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <div class="svn-more-body">
        <section class="svn-mi">
          <h3>Two languages, one meeting</h3>
          <p>Tell it every language people speak, for example Bangla and English. A piece that comes back in the wrong script is done again in the right language. This needs a multilingual voice model, such as Whisper, or a cloud provider; the default English model hears English only.</p>
          <div class="svn-lang" aria-hidden="true">
            <span class="svn-lang-sel">Bangla <svg viewBox="0 0 12 12"><path d="M3 4.5l3 3 3-3" /></svg></span>
            <span class="svn-chip">+ English</span>
            <span class="svn-lang-ln"><b>Speaker 1</b> <span lang="bn">ঠিক আছে, তাহলে লঞ্চ ১৪ তারিখেই হবে।</span></span>
          </div>
        </section>

        <section class="svn-mi">
          <h3>On your computer by default</h3>
          <p>Notetaker transcribes on your computer and works offline. If you add your own cloud provider you can use it instead, and then the audio is sent to that provider.</p>
          <div class="svn-where">
            <div class="svn-where-opts" role="group" aria-label="Where the meeting is transcribed">
              <button type="button" class="svn-opt" aria-pressed="true" data-where="local"><b>This PC (offline)</b></button>
              <button type="button" class="svn-opt" aria-pressed="false" data-where="cloud"><b>Cloud, your own key</b></button>
            </div>
            <p class="svn-where-out" aria-live="polite">
              <span class="svn-where-k">In the app you'll see:</span>
              <span data-where-text="local">Audio and text stay on this PC.</span>
              <span data-where-text="cloud" hidden>Audio is sent to your provider to transcribe; recordings and text stay on this PC.</span>
            </p>
          </div>
        </section>

        <section class="svn-mi">
          <h3>What it needs</h3>
          <dl class="svn-tools">
            <div><dt>Telling voices apart</dt><dd>A one-time download of about 30 MB. It takes about 15 s per minute of meeting, on a typical laptop.</dd></div>
            <div><dt>Summaries</dt><dd>A summary model: a local AI model from the Model Store (about 0.8 to 4.9 GB) or your own cloud key.</dd></div>
          </dl>
        </section>

        <section class="svn-mi">
          <h3>Find it, play it back, keep it</h3>
          <dl class="svn-tools">
            <div><dt>Search</dt><dd>Across meeting names, Overviews and every word said.</dd></div>
            <div><dt>Play back at 1× to 2×</dt><dd>Click any line's time to play from there.</dd></div>
            <div><dt>Save or copy</dt><dd>Plain text, Markdown with times, or subtitles (.txt, .md, .srt).</dd></div>
            <div><dt>Transcribe again</dt><dd>Redo a meeting from its saved audio with a newer model. Cancel puts the old text back.</dd></div>
          </dl>
        </section>

        <section class="svn-mi">
          <h3>Where it records the other side</h3>
          <dl class="svn-tools">
            <div><dt>Windows</dt><dd>Records both sides.</dd></div>
            <div><dt>macOS 13 or later</dt><dd>Both sides once you allow Screen &amp; System Audio Recording. The Mac app is early and not fully tested on a real Mac yet, so <a href="https://github.com/zahidhossin39/Silent-Voice/issues" target="_blank" rel="noopener noreferrer">tell me if it works<span class="sr-only"> (opens in a new tab)</span></a>. On macOS 12, your side only.</dd></div>
            <div><dt>Linux</dt><dd>Both sides with PulseAudio or PipeWire.</dd></div>
          </dl>
          <p class="svn-mi-note">If it can't record the computer's sound, it tells you before you start and keeps your side.</p>
        </section>

        <p class="svn-consent">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.5" /></svg>
          <span><b>Let people know you're recording.</b> In many places everyone on a call has to agree to it. The app reminds you the first time.</span>
        </p>
      </div>
    </details>
  </div>
</section>

<style>

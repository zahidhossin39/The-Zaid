  .nt-ov::before { content: ""; position: absolute; inset: -8px -10px 2px; border-radius: 12px; background: radial-gradient(70% 90% at 30% 60%, rgba(249, 115, 22, 0.13), transparent 75%); box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.3); opacity: 0; pointer-events: none; transition: opacity 0.8s ease; }

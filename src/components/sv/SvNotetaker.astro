    .svn-echo-state { font-size: 0.84rem; }
  }
  /* a narrow player keeps play, position, seek and the "Silent demo" label */
  @container (max-width: 430px) {
    .nt-dur, .nt-rate { display: none; }
  }
  /* touch: every control kept in the mock gets a 44px target */
  @media (pointer: coarse) {
    .ln-time { min-width: 44px; min-height: 44px; align-items: flex-start; padding-top: 4px; }
    .nt-people { height: 44px; padding-left: 12px; padding-right: 26px; }
    .nt-again { min-height: 44px; }
    .nt-rate { height: 44px; padding: 0 10px; }
    .nt-play { width: 44px; height: 44px; }
    .nt-range { height: 44px; }
    .nt-start { height: 44px; }
    .nt-recpill { height: 44px; }
    .nt-stop { height: 34px; }
    .nt-sum, .nt-ov[data-state="done"] .nt-sum { height: 44px; }
  }
  /* JS off: the finished meeting as a still picture, with no controls that do nothing */
  :global(html:not(.js)) .svn :is(.nt-start, .nt-player, .nt-again, .nt-ov-ctrl, .svn-echo-seg, .svn-where-opts) { display: none; }
  :global(html:not(.js)) .svn .nt-people-l, :global(html:not(.js)) .svn .nt-details--post .nt-sep { display: none; }
  :global(html:not(.js)) .svn .ln-time { pointer-events: none; }
  :global(html:not(.js)) .svn .ln-time svg { display: none; }
  :global(html:not(.js)) .svn .nt-ov-notes { padding-right: 0; }
  @media (prefers-reduced-motion: reduce) {
    .nt-ping::after, .nt-nav-dot, .nt-tile i, .nt-dots i, .i-spin { animation: none !important; }
    .nt.is-scanning .ln-name :global(.nm) { animation: none !important; }
    .svn-wave :is(.eb, .eg) { transition-delay: 0s !important; }
    .svn-ch, .svn-play, .svn-more-ch { transition: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>(".svn");
  if (root) init(root);

  type Who = "you" | "a" | "b";

  function init(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];

    const nt = $(".nt");
    const panel = $(".nt-panel");
    const startBtn = $<HTMLButtonElement>(".nt-start");
    const stopBtn = $<HTMLButtonElement>(".nt-stop");
    const recTime = $(".nt-rec-time");
    const ol = $(".nt-lines");
    const listen = $(".nt-listen");
    const listenT = $(".nt-listen-t");
    const ov = $(".nt-ov");
    const sumBtn = $<HTMLButtonElement>(".nt-sum");
    const people = $<HTMLSelectElement>(".nt-people");
    const voices = $(".nt-voices");
    const againBtn = $<HTMLButtonElement>(".nt-again");
    const againWith = $(".nt-again-with");
    const player = $(".nt-player");
    const playBtn = $<HTMLButtonElement>(".nt-play");
    const pos = $(".nt-pos");
    const range = $<HTMLInputElement>(".nt-range");
    const rate = $<HTMLSelectElement>(".nt-rate");
    const chapters = $$<HTMLButtonElement>(".svn-ch");
    const playCall = $<HTMLButtonElement>(".svn-play");
    const playCallL = $(".svn-play-l");
    const live = $("[data-svn-live]");
    const tags = $$(".ov-tag[data-who]");

    const lines = $$<HTMLLIElement>(".ln", ol);
    const data = lines.map((li) => ({
      li,
      who: li.dataset.who as Who,
      t: Number(li.dataset.t),
      text: $(".ln-text", li).textContent!.trim(),
      time: $<HTMLButtonElement>(".ln-time", li),
      name: $(".ln-name", li),
    }));
    const DURATION = Number(range.max);
    const REC_SECONDS = 5.5; // the whole call "records" in about 5.5 s
    const RATE = DURATION / REC_SECONDS;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

    // `motion` only switches the decorative animation (word blur, label flips,
    // entrances). The story itself runs on real time either way, because it is
    // started by the visitor and its point is the order of events.
    let motion = false;
    let gen = 0; // bumps on every reset, so the timers of an old run do nothing
    let relabelGen = 0;
    let split = true;
    let stopReq = false;
    let clockT = 0;
    let recStart = 0;
    let storyOn = false;

    const alive = (g: number) => g === gen;
    const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const announce = (msg: string) => { live.textContent = msg; };
    const press = (el: HTMLElement) => { if (!motion) return; el.classList.add("is-press"); setTimeout(() => el.classList.remove("is-press"), 260); };
    // keep keyboard focus inside the widget when the focused control is swapped out
    const keepFocus = (from: HTMLElement, to: HTMLElement) => { if (document.activeElement === from) requestAnimationFrame(() => to.focus({ preventScroll: true })); };

    // ---- names ----
    const nameFor = (who: string) => {
      if (who === "you") return "You";
      if (!split) return "Others";
      if (people.value === "1") return "Speaker 1";
      return who === "a" ? "Speaker 1" : "Speaker 2";
    };
    const setName = (d: (typeof data)[number], name: string, animate: boolean) => {
      const cur = d.name.querySelector<HTMLElement>(".nm:not(.nm-out)");
      if (cur && cur.textContent === name) return;
      if (!animate || !cur) { d.name.innerHTML = ""; const s = document.createElement("span"); s.className = "nm"; s.textContent = name; d.name.appendChild(s); return; }
      const nn = document.createElement("span");
      nn.className = "nm nm-in";
      nn.textContent = name;
      cur.classList.add("nm-out");
      d.name.appendChild(nn);
      setTimeout(() => cur.remove(), 450);
    };
    // the Overview's action items follow the same labels as the transcript
    const applyNames = (animate: boolean) => {
      let k = 0;
      data.forEach((d) => {
        const n = nameFor(d.who);
        const cur = d.name.querySelector(".nm:not(.nm-out)");
        if (cur?.textContent === n) return;
        if (animate) setTimeout(() => setName(d, n, true), (k++) * 110);
        else setName(d, n, false);
      });
      tags.forEach((tg) => (tg.textContent = nameFor(tg.dataset.who!)));
    };

    // ---- transcript ----
    const showLine = (i: number, animate: boolean) => {
      const d = data[i];
      const p = $(".ln-text", d.li);
      d.li.classList.remove("is-new", "is-now");
      p.textContent = "";
      if (animate) {
        d.text.split(" ").forEach((w, j) => {
          const s = document.createElement("span");
          s.className = "w";
          s.style.setProperty("--d", `${j * 28}ms`);
          s.textContent = w + " ";
          p.appendChild(s);
        });
        d.li.classList.add("is-new");
      } else p.textContent = d.text;
      setName(d, nameFor(d.who), false);
      ol.insertBefore(d.li, listen);
      // live lines: keep the newest one (and "Listening") in sight
      if (animate && nt.dataset.phase === "rec") ol.scrollTo({ top: ol.scrollHeight, behavior: motion ? "smooth" : "auto" });
    };
    // scroll only the transcript box (never the page) so a line is fully in it
    const showInList = (li: HTMLElement) => {
      const top = li.offsetTop, bottom = top + li.offsetHeight;
      if (top >= ol.scrollTop && bottom <= ol.scrollTop + ol.clientHeight) return;
      ol.scrollTo({ top: Math.max(0, top - 6), behavior: motion ? "smooth" : "auto" });
    };
    const clearLines = () => data.forEach((d) => d.li.remove());
    const setLive = (on: boolean) => data.forEach((d) => (d.time.disabled = on));

    // ---- steps ----
    const setChapter = (n: number, p = 0, dur = 0.25) => {
      chapters.forEach((c, i) => {
        const k = i + 1;
        c.toggleAttribute("aria-current", false);
        if (k === n) c.setAttribute("aria-current", "step");
        c.style.setProperty("--dur", k === n ? `${dur}s` : "0.25s");
        c.style.setProperty("--p", String(k < n ? 1 : k === n ? p : 0));
      });
    };

    // ---- states (instant) ----
    const setPhase = (p: "idle" | "rec" | "finishing" | "post") => { nt.dataset.phase = p; };
    const setOv = (s: "live" | "ready" | "busy" | "done") => { ov.dataset.state = s; sumBtn.setAttribute("aria-disabled", String(s === "busy")); };
    // while the call replays, the panel keeps its finished height, so nothing on the page jumps
    const lock = () => { if (!panel.style.minHeight) panel.style.minHeight = `${panel.offsetHeight}px`; };
    const unlock = () => { panel.style.minHeight = ""; };
    const setStory = (on: boolean) => {
      storyOn = on;
      root.classList.toggle("is-playing", on);
      playCallL.textContent = on ? "Skip to the end" : "Play the call";
      if (!on) unlock();
    };

    // ---- Transcribe again (confirm, then a short redo that can be cancelled) ----
    let againT = 0, againG = 0;
    const setAgain = (s: "idle" | "confirm" | "busy") => { againBtn.dataset.state = s; };
    const againReset = () => { clearTimeout(againT); againG++; nt.classList.remove("is-redoing"); setAgain("idle"); };
    againBtn.addEventListener("click", async () => {
      const s = againBtn.dataset.state;
      if (s === "idle") {
        setAgain("confirm");
        clearTimeout(againT);
        againT = window.setTimeout(() => { if (againBtn.dataset.state === "confirm") setAgain("idle"); }, 6000);
        return;
      }
      if (s === "busy") {
        againReset();
        announce("Cancelled. The old text is back.");
        return;
      }
      clearTimeout(againT);
      const g = ++againG;
      stopPlayer(false);
      setAgain("busy");
      nt.classList.add("is-redoing");
      announce("Transcribing again from the saved audio.");
      await sleep(1800);
      if (g !== againG) return;
      nt.classList.remove("is-redoing");
      data.forEach((_, i) => showLine(i, motion));
      setAgain("idle");
      announce("Transcribed again from the saved audio.");
    });

    function reset() {
      gen++;
      relabelGen++;
      stopPlayer(true);
      againReset();
      nt.classList.remove("is-scanning");
      ov.classList.remove("is-reveal");
      voices.hidden = true;
      stopReq = false;
    }
    function stateIdle() {
      setPhase("idle");
      split = false;
      people.value = "auto";
      people.disabled = true;
      clearLines();
      setOv("live");
      recTime.textContent = "0:00";
      setChapter(1, 0);
    }
    function statePost(withSplit: boolean, summary: boolean) {
      setPhase("post");
      split = withSplit;
      people.disabled = !withSplit;
      clearLines();
      data.forEach((_, i) => showLine(i, false));
      ol.scrollTop = 0;
      applyNames(false);
      setLive(false);
      setOv(summary ? "done" : "ready");
    }
    // the finished meeting, right away (also used when the demo leaves the screen)
    function finishNow() {
      reset();
      statePost(true, true);
      setStory(false);
      setChapter(0);
    }

    // ---- the story ----
    async function story(from: 1 | 2 | 3) {
      reset();
      statePost(true, true);
      lock(); // measured on the finished frame
      const g = gen;
      setStory(true);
      if (from === 1) {
        stateIdle();
        await sleep(350); if (!alive(g)) return;
        press(startBtn);
        await sleep(200); if (!alive(g)) return;
        await record(g); if (!alive(g)) return;
      } else {
        statePost(from === 3, false);
        setChapter(from, 0);
      }
      if (from <= 2) {
        await sleep(from === 2 ? 400 : 150); if (!alive(g)) return;
        await tellApart(g); if (!alive(g)) return;
        await sleep(500); if (!alive(g)) return;
      }
      await summarize(g, true); if (!alive(g)) return;
      // the Overview took its room back: show the end of the call under it
      ol.scrollTo({ top: ol.scrollHeight, behavior: motion ? "smooth" : "auto" });
      setStory(false);
      setTimeout(() => { if (alive(g)) setChapter(0); }, 900);
    }

    async function record(g: number) {
      setPhase("rec");
      setOv("live");
      listenT.textContent = "Listening";
      split = false;
      people.disabled = true;
      clearLines();
      setLive(true);
      stopReq = false;
      announce("Recording a sample call. Lines appear as people talk.");
      recStart = performance.now();
      clockT = 0;
      // one rAF loop for the clock; it ends with the recording, and the whole
      // story is cut short (finishNow) if the demo leaves the screen or the tab
      const tick = () => {
        if (!alive(g) || nt.dataset.phase !== "rec" || stopReq) return;
        clockT = Math.min(DURATION, ((performance.now() - recStart) / 1000) * RATE);
        recTime.textContent = fmt(clockT);
        setChapter(1, clockT / DURATION, 0.1);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      const until = (t: number) => new Promise<void>((r) => {
        const check = () => (!alive(g) || stopReq || clockT >= t ? r() : setTimeout(check, 40));
        check();
      });
      for (let i = 0; i < data.length; i++) {
        await until(data[i].t); if (!alive(g)) return;
        if (stopReq) { for (; i < data.length; i++) showLine(i, false); break; }
        showLine(i, motion);
      }
      await until(DURATION); if (!alive(g)) return;
      if (!stopReq) { press(stopBtn); await sleep(200); if (!alive(g)) return; }
      stopReq = true;
      setPhase("finishing");
      listenT.textContent = "Finishing the last words…";
      setChapter(1, 1);
      await sleep(650); if (!alive(g)) return;
      setPhase("post");
      setLive(false);
      setOv("ready");
      keepFocus(stopBtn, startBtn);
    }

    async function tellApart(g: number) {
      setChapter(2, 1, 1.3);
      voices.hidden = false;
      nt.classList.add("is-scanning");
      announce("Telling the voices apart.");
      await sleep(1300); if (!alive(g)) return;
      nt.classList.remove("is-scanning");
      voices.hidden = true;
      split = true;
      applyNames(motion);
      people.disabled = false;
      announce("Voices told apart: Others is now Speaker 1 and Speaker 2.");
    }

    async function summarize(g: number, auto: boolean) {
      setChapter(3, 0);
      if (auto) { press(sumBtn); await sleep(220); if (!alive(g)) return; }
      ov.classList.remove("is-reveal");
      setOv("busy");
      setChapter(3, 1, 1.4);
      await sleep(1400); if (!alive(g)) return;
      setOv("done");
      if (motion) ov.classList.add("is-reveal");
      ov.classList.add("is-glow");
      window.setTimeout(() => ov.classList.remove("is-glow"), 2600);
      announce("Overview written: key points, decisions and action items.");
    }

    // ---- player ----
    let t = 0, playing = false, last = 0, raf = 0, current = -1;
    const markNow = () => {
      let idx = -1;
      if (t > 0 || playing) data.forEach((d, i) => { if (d.t <= t + 0.01) idx = i; });
      if (idx === current) return;
      current = idx;
      data.forEach((d, i) => d.li.classList.toggle("is-now", i === idx));
      if (idx >= 0) showInList(data[idx].li);
    };
    const drawPos = () => { pos.textContent = fmt(t); range.value = String(Math.floor(t)); };
    const loop = (now: number) => {
      if (!playing) return;
      t = Math.min(DURATION, t + ((now - last) / 1000) * Number(rate.value));
      last = now;
      drawPos();
      markNow();
      if (t >= DURATION) { stopPlayer(false); return; }
      raf = requestAnimationFrame(loop);
    };
    function startPlayer() {
      if (nt.dataset.phase !== "post" || storyOn) return;
      if (t >= DURATION) t = 0;
      playing = true;
      player.classList.add("is-playing");
      playBtn.setAttribute("aria-label", "Pause");
      last = performance.now();
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
      markNow();
    }
    function stopPlayer(rewind: boolean) {
      playing = false;
      cancelAnimationFrame(raf);
      player.classList.remove("is-playing");
      playBtn.setAttribute("aria-label", "Play");
      if (rewind) { t = 0; current = -2; drawPos(); markNow(); }
    }
    playBtn.addEventListener("click", () => (playing ? stopPlayer(false) : startPlayer()));
    range.addEventListener("input", () => { t = Number(range.value); drawPos(); markNow(); });
    data.forEach((d) => d.time.addEventListener("click", () => {
      t = d.t; drawPos(); current = -2; startPlayer(); markNow();
    }));

    // ---- play where it can be seen ----
    // Before a replay starts, the window (and, when stacked, the Play button right
    // above it) is scrolled under the nav. Smooth with motion, a jump without.
    const stacked = matchMedia("(max-width: 1099px)");
    const reduceMq = matchMedia("(prefers-reduced-motion: reduce)");
    const NAV = 64;
    let revealTok = 0;
    const reveal = () => new Promise<void>((done) => {
      const target = stacked.matches && !playCall.hidden ? playCall : nt;
      const tr = target.getBoundingClientRect();
      const nr = nt.getBoundingClientRect();
      const inView = tr.top >= NAV && nr.bottom <= innerHeight + 1;
      if (inView) return done();
      const y = Math.max(0, scrollY + tr.top - NAV - 12);
      const lenis = (window as any).lenis;
      if (reduceMq.matches || !lenis) {
        window.scrollTo({ top: y, behavior: reduceMq.matches ? "instant" : "smooth" });
        if (reduceMq.matches) return done();
        setTimeout(done, 700);
        return;
      }
      let ok = false;
      const fin = () => { if (!ok) { ok = true; done(); } };
      lenis.scrollTo(y, { duration: 0.75, force: true, onComplete: fin });
      setTimeout(fin, 1100);
    });
    async function play(from: 1 | 2 | 3) {
      const tok = ++revealTok;
      await reveal();
      if (tok !== revealTok) return;
      story(from);
    }

    // ---- visitor controls inside the window ----
    startBtn.addEventListener("click", () => {
      if (nt.dataset.phase === "rec" || nt.dataset.phase === "finishing") return;
      play(1).then(() => keepFocus(startBtn, stopBtn));
    });
    stopBtn.addEventListener("click", () => {
      if (nt.dataset.phase !== "rec") return;
      stopReq = true;
      press(stopBtn);
    });
    sumBtn.addEventListener("click", async () => {
      if (ov.dataset.state === "busy" || nt.dataset.phase !== "post") return;
      relabelGen++;
      againReset();
      const g = ++gen;
      stopPlayer(false);
      setStory(false);
      lock();
      if (!split) { split = true; applyNames(false); people.disabled = false; nt.classList.remove("is-scanning"); voices.hidden = true; }
      await summarize(g, false);
      if (alive(g)) { unlock(); setChapter(0); }
    });
    people.addEventListener("change", async () => {
      const r = ++relabelGen;
      voices.hidden = false;
      nt.classList.add("is-scanning");
      await sleep(900);
      if (r !== relabelGen) return;
      nt.classList.remove("is-scanning");
      voices.hidden = true;
      applyNames(motion);
      announce(people.value === "1" ? "Relabelled: one other person, Speaker 1." : "Relabelled: Speaker 1 and Speaker 2.");
    });

    // ---- steps + play the call ----
    chapters.forEach((c) => {
      c.disabled = false;
      c.addEventListener("click", () => { root.classList.add("was-played"); play(Number(c.dataset.ch) as 1 | 2 | 3); });
    });
    playCall.hidden = false;
    playCall.addEventListener("click", () => {
      if (storyOn) { revealTok++; finishNow(); announce("Skipped to the finished meeting."); }
      else { root.classList.add("was-played"); play(1); }
    });

    // ---- echo ----
    const echo = $(".svn-echo");
    const echoBs = $$<HTMLButtonElement>(".svn-echo-b");
    const setEcho = (on: boolean) => {
      echo.dataset.echo = on ? "on" : "off";
      echoBs.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.echoSet === "on") === on)));
    };
    let echoTimer = 0;
    let echoTouched = false;
    echoBs.forEach((b) => b.addEventListener("click", () => {
      clearTimeout(echoTimer);
      echoTouched = true;
      setEcho(b.dataset.echoSet === "on");
    }));

    // ---- local or cloud (also changes the window's subtitle and the redo prompt) ----
    const opts = $$<HTMLButtonElement>(".svn-opt");
    const sub = $(".nt-sub");
    const SUB_LOCAL = "Record a call and get a live transcript of who said what. Audio and text stay on this PC.";
    const SUB_CLOUD = "Record a call and get a live transcript of who said what. Audio is sent to your provider to transcribe; recordings and text stay on this PC.";
    opts.forEach((o) => o.addEventListener("click", () => {
      const w = o.dataset.where!;
      opts.forEach((x) => x.setAttribute("aria-pressed", String(x === o)));
      $$("[data-where-text]").forEach((s) => (s.hidden = s.dataset.whereText !== w));
      sub.textContent = w === "cloud" ? SUB_CLOUD : SUB_LOCAL;
      againWith.textContent = w === "cloud" ? "your provider" : "this PC";
    }));

    root.classList.add("is-ready");
    setChapter(0);
    setLive(false);

    // ---- off screen or hidden tab: nothing keeps running ----
    const pauseAll = () => {
      if (storyOn) finishNow();
      if (playing) stopPlayer(false);
    };
    new IntersectionObserver(([e]) => { if (!e.isIntersecting) pauseAll(); }).observe(nt);
    document.addEventListener("visibilitychange", () => { if (document.hidden) pauseAll(); });

    // ---- motion: one short "voices told apart" flip on first view, entrances ----
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      motion = true;
      // the finished meeting, but with "Others" until the window is seen
      reset();
      statePost(false, true);
      let flipped = false;
      let flipCut = false;
      // the visitor got there first: show the split labels now, no timer overrides them
      const cancelFlip = () => {
        flipped = true;
        io.disconnect();
        if (flipCut || split || storyOn || nt.dataset.phase !== "post") return;
        flipCut = true;
        nt.classList.remove("is-scanning");
        voices.hidden = true;
        split = true;
        people.disabled = false;
        applyNames(false);
      };
      nt.addEventListener("pointerdown", cancelFlip, true);
      nt.addEventListener("keydown", cancelFlip, true);
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting || flipped) return;
        flipped = true;
        io.disconnect();
        if (storyOn || split || nt.dataset.phase !== "post") return;
        const g = gen;
        await sleep(450); if (!alive(g) || storyOn || flipCut) return;
        voices.hidden = false;
        nt.classList.add("is-scanning");
        await sleep(1200); if (!alive(g) || storyOn || flipCut) return;
        nt.classList.remove("is-scanning");
        voices.hidden = true;
        split = true;
        people.disabled = false;
        applyNames(true);
      }, { threshold: 0.45 });
      io.observe(nt);

      // echo: show it with the echo first, then take it out
      setEcho(false);
      const echoIo = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        echoIo.disconnect();
        if (echoTouched) return;
        echoTimer = window.setTimeout(() => { if (!echoTouched) setEcho(true); }, 1100);
      }, { threshold: 0.6 });
      echoIo.observe(echo);

      const lift = gsap.from(nt, {
        y: 50, opacity: 0, scale: 0.98, duration: 1.1, ease: "expo.out",
        scrollTrigger: { trigger: nt, start: "top 92%", once: true },
      });
      const cards = gsap.from(root.querySelectorAll(".svn-card, .svn-more"), {
        y: 36, opacity: 0, duration: 0.9, ease: "expo.out", stagger: 0.08,
        scrollTrigger: { trigger: root.querySelector(".svn-pair"), start: "top 88%", once: true },
      });
      const bar = gsap.fromTo(root.querySelector(".svn-file-bar i"), { scaleX: 0 }, {
        scaleX: 1, duration: 1.8, ease: "power1.inOut",
        scrollTrigger: { trigger: root.querySelector(".svn-card--file"), start: "top 80%", once: true },
      });
      const fileLines = gsap.from(root.querySelectorAll(".svn-file-lines p, .svn-file-done"), {
        opacity: 0, y: 8, duration: 0.5, ease: "power2.out", stagger: 0.2, delay: 1.3,
        scrollTrigger: { trigger: root.querySelector(".svn-card--file"), start: "top 80%", once: true },
      });

      return () => {
        motion = false;
        io.disconnect();
        echoIo.disconnect();
        clearTimeout(echoTimer);
        nt.removeEventListener("pointerdown", cancelFlip, true);
        nt.removeEventListener("keydown", cancelFlip, true);
        [lift, cards, bar, fileLines].forEach((a) => a.revert());
        setEcho(true);
        finishNow();
      };
    });
  }
</script>

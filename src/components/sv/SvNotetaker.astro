  .nt-lights i:nth-child(3) { background: #28c840; }
  .nt-wtitle { font-size: 12px; color: var(--a-mu); }
  .nt-winctl { margin-left: auto; display: flex; height: 100%; }
  .nt-winctl svg { width: 48px; height: 100%; padding: 15px 19px; fill: none; stroke: var(--a-mu); stroke-width: 1; }
  :global(html[data-sv-os="mac"]) .nt-lights { display: flex; }

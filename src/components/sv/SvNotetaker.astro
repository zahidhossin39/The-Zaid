    .nt-content { padding: 14px 14px 16px; }
    .nt-ov-notes { padding-right: 0; }
    .nt-ov[data-state="done"] .nt-ov-ctrl { top: -10px; }
    .nt-player { padding: 8px 12px; gap: 8px; }
    .ln { grid-template-columns: 2.9rem minmax(0, 1fr); gap: 8px; }
    .nt-listen { grid-template-columns: 2.9rem minmax(0, 1fr); gap: 8px; }
    .ln-text { font-size: 14px; }
    .svn-chapters { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .svn-ch { grid-template-columns: 2.25rem minmax(0, 1fr); padding: 0.75rem 0.9rem 0.8rem 0.75rem; }
    .svn-ch-ic { grid-row: 1 / span 2; margin: 0; }
    .svn-ch-t { padding-top: 0.1rem; font-size: 0.95rem; }
    .svn-ch-d { grid-column: 2; font-size: 0.84rem; }
    .svn-play { justify-self: stretch; }
    .svn-more-body { grid-template-columns: minmax(0, 1fr); padding: 1.2rem 1.1rem 1.2rem; }
    .svn-more summary { padding: 0.9rem 1.1rem; }
  }
  /* compact window: phones and short laptop screens. No fake sidebar or title
     bar, tighter spacing and smaller type, so the transcript and the Overview
     fit on screen together */
  @media (max-width: 760px), (max-height: 820px) {
    .nt { font-size: 13px; }
    .nt-title { display: none; }
    .nt-body { grid-template-columns: minmax(0, 1fr); }
    .nt-side { display: none; }
    .nt-main { padding: 12px 14px 14px; }

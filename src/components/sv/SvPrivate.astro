---
// "Private by default": a short statement (its words light up on a short timed
// stagger when it enters view), the plain explanation under it, and a flow
// diagram (mic → your computer → text). The visitor can flip an example switch
// to see what changes with a cloud key: an orange path from the computer to the
// provider they picked. The switch is pure CSS (:has), so it works with JS off.
import { REPO } from "../../scripts/sv-release";

const statement = "Your voice stays on your computer.";
// words that light up orange instead of white
const HOT = new Set(["computer."]);
const words = statement.split(" ");
const facts = [
  { t: "Dictation", d: "works offline once the speech model is downloaded." },
  { t: "Notetaker", d: "keeps meeting audio and transcripts on your computer by default." },
  { t: "No account, no tracking", d: "no analytics, telemetry or crash reports." },
];
---

<section class="svp" aria-labelledby="svp-title">
  <div class="svp-inner">
    <div class="svp-copy">
      <p class="sv-eyebrow">Private by default</p>
      <h2 class="svp-statement" id="svp-title" aria-label={statement}>
        {words.map((w, i) => <span class:list={["sw", { hot: HOT.has(w) }]} style={`--i:${i}`} aria-hidden="true">{w} </span>)}
      </h2>
      <p class="svp-lead">It becomes text right there. Nothing is uploaded unless you add a cloud service with your own key.</p>
      <ul class="svp-facts">
        {facts.map((f) => (
          <li><strong>{f.t}:</strong> {f.d}</li>
        ))}
      </ul>
      <a class="svp-link" href={`https://github.com/${REPO}/blob/main/PRIVACY.md`} target="_blank" rel="noopener noreferrer">Read the privacy notes on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
    </div>

    <div class="svp-demo">
      <div class="svp-try">
        <label class="switch">
          <input type="checkbox" class="switch-in" aria-describedby="svp-path" />
          <span class="switch-track" aria-hidden="true"><span class="switch-dot"></span></span>
          <span class="switch-label">Try it: add a cloud key</span>
        </label>
        <span class="svp-ex">Example</span>
      </div>

      <div class="svp-flow">
        <div class="node node--mic">
          <span class="node-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
          </span>
          <span class="node-t">Your microphone</span>
        </div>

        <span class="wire wire--a" aria-hidden="true"></span>

        <div class="node node--pc">
          <span class="node-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
          </span>
          <span class="node-t">Your computer</span>
          <span class="node-s">The speech model runs here</span>
          <span class="node-pulse" aria-hidden="true"></span>
        </div>

        <span class="wire wire--b" aria-hidden="true"></span>

        <div class="node node--txt">
          <span class="node-ic node-ic--txt" aria-hidden="true">Aa<i></i></span>
          <span class="node-t">Text at your cursor</span>
        </div>

        <span class="wire wire--cloud" aria-hidden="true"><b></b></span>
        <p class="path-lbl" id="svp-path" aria-live="polite"><span class="lbl-off">Off: nothing is sent</span><span class="lbl-on">On: audio or text, to the provider you picked</span></p>

        <div class="node node--cloud">
          <span class="node-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.2 4.5 4.5 0 0 0 7 18Z" /></svg>
          </span>
          <span class="node-t">Cloud provider</span>
          <span class="node-s">Only with your own key</span>
        </div>
      </div>
      <p class="svp-note">With a key, cloud transcription sends audio. Writing styles and summaries send text.</p>
    </div>
  </div>
</section>

<style>
  .svp {
    position: relative;
    /* outer padding comes from the page (main.sv > section: --sv-space, --sv-gutter) */
    background:
      radial-gradient(50% 60% at 75% 100%, rgba(249, 115, 22, 0.09), transparent 70%),
      #0d0d0f;
    border-block: 1px solid var(--sv-line);
    overflow: hidden;
  }
  /* the page container: --sv-max of content inside the --sv-gutter */
  .svp-inner {
    max-width: var(--sv-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .svp-statement {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .svp-lead { margin: 1.1rem 0 0; max-width: 32rem; font-size: clamp(1rem, 1.4vw, 1.1rem); line-height: 1.6; color: var(--color-muted); text-wrap: pretty; }
  .sw.hot { color: var(--sv-orange); }
  /* base: fully lit. With JS the words start at 45% and light up on a short
     stagger once the sentence is in view (never tied to scroll position) */
  :global(.js) .svp-statement:not(.is-static) .sw { color: rgba(244, 242, 237, 0.45); transition: color 0.5s ease; transition-delay: calc(var(--i) * 90ms); }
  :global(.js) .svp-statement:not(.is-static).lit .sw { color: var(--color-text); }
  :global(.js) .svp-statement:not(.is-static).lit .sw.hot { color: var(--sv-orange); }

  .svp-facts { margin: clamp(1.4rem, 2.6vw, 1.9rem) 0 0; padding: 0; list-style: none; display: grid; gap: 0.55rem; }
  .svp-facts li { position: relative; padding-left: 1.2rem; font-size: 0.95rem; line-height: 1.5; color: var(--color-muted); }
  .svp-facts li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 7px; height: 7px; border-radius: 50%; background: var(--sv-orange); box-shadow: 0 0 10px rgba(249, 115, 22, 0.6); }
  .svp-facts strong { color: var(--color-text); font-weight: 600; }
  .svp-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 0.8rem; color: var(--color-muted); font-size: 0.9rem; text-decoration: underline; text-decoration-color: rgba(249, 115, 22, 0.6); text-underline-offset: 4px; }
  .svp-link:hover { color: var(--color-text); }

  /* ---- the example panel ---- */
  .svp-demo { padding: clamp(1.1rem, 2.2vw, 1.6rem); border-radius: 22px; border: 1px solid var(--sv-line); background: rgba(17, 17, 20, 0.8); }
  .svp-try { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding-bottom: 1rem; margin-bottom: 1.4rem; border-bottom: 1px solid var(--sv-line); }
  .svp-ex { padding: 0.2rem 0.55rem; border-radius: 6px; border: 1px solid var(--sv-line); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }

  /* switch: orange when on */
  .switch { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 44px; cursor: pointer; font-size: 0.92rem; font-weight: 500; color: var(--color-text); }
  .switch-in { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .switch-track { position: relative; flex: none; width: 2.75rem; height: 1.5rem; border-radius: 999px; background: rgba(244, 242, 237, 0.14); border: 1px solid rgba(244, 242, 237, 0.2); transition: background 0.3s ease, border-color 0.3s ease; }
  .switch-dot { position: absolute; top: 2px; left: 2px; width: calc(1.5rem - 6px); aspect-ratio: 1; border-radius: 50%; background: var(--color-text); transition: transform 0.35s cubic-bezier(.22, 1.4, .36, 1), background 0.3s ease; }
  .switch-in:checked + .switch-track { background: var(--sv-orange); border-color: var(--sv-orange); }
  .switch-in:checked + .switch-track .switch-dot { transform: translateX(1.25rem); background: #1a1200; }
  .switch-in:focus-visible + .switch-track { outline: 2px solid var(--sv-orange); outline-offset: 3px; }
  .switch:hover .switch-track { border-color: rgba(249, 115, 22, 0.7); }

  /* ---- flow ---- */
  .svp-flow {
    --on: rgba(249, 115, 22, 0.9);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.4rem minmax(0, 1.15fr) 1.4rem minmax(0, 1fr);
    grid-template-rows: auto 4.75rem auto;
    grid-template-areas:
      ". . cloud . ."
      ". . wc . ."
      "mic wa pc wb txt";
    align-items: center;
  }
  .node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 0.9rem;
    border-radius: 14px;
    border: 1px solid var(--sv-line);
    background: rgba(244, 242, 237, 0.025);
    min-width: 0;
  }
  .node--mic { grid-area: mic; }
  .node--pc { grid-area: pc; border-color: rgba(249, 115, 22, 0.55); background: rgba(249, 115, 22, 0.08); box-shadow: 0 0 60px -20px rgba(249, 115, 22, 0.5); }
  .node--txt { grid-area: txt; }
  .node--cloud { grid-area: cloud; border-style: dashed; transition: border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease; }
  /* "off" reads as dimmed, but its words stay readable (AA) */
  .node--cloud .node-ic { opacity: 0.6; transition: opacity 0.4s ease; }
  .node--cloud :is(.node-t, .node-s) { opacity: 0.86; transition: opacity 0.4s ease; }
  .svp-demo:has(.switch-in:checked) .node--cloud { border-style: solid; border-color: var(--sv-orange); background: rgba(249, 115, 22, 0.1); box-shadow: 0 0 50px -18px rgba(249, 115, 22, 0.6); }
  .svp-demo:has(.switch-in:checked) .node--cloud :is(.node-ic, .node-t, .node-s) { opacity: 1; }
  .svp-demo:has(.switch-in:checked) .node--cloud .node-ic { background: var(--sv-orange); color: #140a02; }

  .node-ic {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    margin-bottom: 0.35rem;
    border-radius: 9px;
    background: rgba(244, 242, 237, 0.06);
    color: var(--color-text);
    transition: background 0.3s ease, color 0.3s ease;
  }
  .node--pc .node-ic { background: var(--sv-orange); color: #140a02; }
  .node-ic svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .node-ic--txt { font-family: var(--font-display); font-size: 1.1rem; }
  .node-ic--txt i { display: inline-block; width: 1.5px; height: 1rem; margin-left: 2px; background: var(--sv-orange); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .node-t { font-weight: 600; font-size: 0.9rem; line-height: 1.3; }
  .node-s { font-size: 0.76rem; color: var(--color-muted); line-height: 1.35; }
  .node-pulse { position: absolute; inset: -1px; border-radius: inherit; border: 1px solid var(--sv-orange); animation: pc-pulse 2.6s ease-out infinite; pointer-events: none; }
  @keyframes pc-pulse { from { opacity: 0.8; transform: scale(1); } to { opacity: 0; transform: scale(1.08, 1.25); } }

  /* wires: flowing dots */
  .wire { position: relative; height: 2px; align-self: center; }
  .wire--a { grid-area: wa; }
  .wire--b { grid-area: wb; }
  .wire--a, .wire--b {
    background: repeating-linear-gradient(90deg, var(--on) 0 4px, transparent 4px 10px);
    background-size: 10px 2px;
    animation: flow-x 0.6s linear infinite;
  }
  @keyframes flow-x { to { background-position: 10px 0; } }
  .wire--cloud {
    grid-area: wc;
    justify-self: center;
    width: 2px;
    height: 100%;
    background: repeating-linear-gradient(180deg, rgba(244, 242, 237, 0.22) 0 4px, transparent 4px 10px);
  }
  /* the cut in the cloud line while it's off */
  .wire--cloud b {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #111114;
    border: 1px solid rgba(244, 242, 237, 0.3);
    transition: transform 0.4s cubic-bezier(.22, 1.4, .36, 1), opacity 0.3s ease;
  }
  .wire--cloud b::before,
  .wire--cloud b::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: rgba(244, 242, 237, 0.7);
    translate: -50% -50%;
    rotate: 45deg;
  }
  .wire--cloud b::after { rotate: -45deg; }
  /* on: a thick orange path flowing up to the cloud */
  .svp-demo:has(.switch-in:checked) .wire--cloud {
    width: 3px;
    background: repeating-linear-gradient(0deg, var(--sv-orange) 0 6px, transparent 6px 11px);
    background-size: 3px 11px;
    animation: flow-y 0.5s linear infinite;
  }
  .svp-demo:has(.switch-in:checked) .wire--cloud b { transform: scale(0); opacity: 0; }
  @keyframes flow-y { to { background-position: 0 -11px; } }

  /* the path's label sits to the right of the vertical line */
  .path-lbl {
    grid-area: wc;
    justify-self: start;
    align-self: center;
    margin: 0 0 0 calc(50% + 1.1rem);
    width: max-content;
    max-width: 14rem;
    padding: 0.3rem 0.6rem;
    border-radius: 8px;
    border: 1px solid var(--sv-line);
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--color-muted);
    background: #111114;
    transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }
  .svp-demo:has(.switch-in:checked) .path-lbl { color: #fdba74; border-color: rgba(249, 115, 22, 0.6); background: rgba(249, 115, 22, 0.1); }
  .path-lbl .lbl-on, .svp-demo:has(.switch-in:checked) .path-lbl .lbl-off { display: none; }
  .svp-demo:has(.switch-in:checked) .path-lbl .lbl-on { display: inline; }
  .svp-note { margin: 1.3rem 0 0; font-size: 0.8rem; line-height: 1.45; color: var(--color-muted); }

  /* loops pause while the section is off screen or the tab is hidden */
  .svp.is-off :global(*) { animation-play-state: paused !important; }

  @media (max-width: 980px) {
    /* one column on the page's left edge, kept to a readable width */
    .svp-inner { grid-template-columns: minmax(0, 1fr); }
    .svp-copy, .svp-demo { max-width: 40rem; }
  }
  @media (max-width: 560px) {
    .svp-flow {
      grid-template-columns: minmax(0, 1.1fr) 1.6rem minmax(0, 1fr);
      grid-template-rows: auto 1.75rem auto auto 1.75rem auto;
      grid-template-areas:
        "mic . ."
        "wa . ."
        "pc wc cloud"
        "wb . lbl"
        "wb . ."
        "txt . .";
    }
    .wire--a, .wire--b {
      justify-self: center;
      width: 2px;
      height: 100%;
      background: repeating-linear-gradient(180deg, var(--on) 0 4px, transparent 4px 10px);
      background-size: 2px 10px;
      animation: flow-down 0.6s linear infinite;
    }
    @keyframes flow-down { to { background-position: 0 10px; } }
    .wire--cloud { width: 100%; height: 2px; align-self: center; background: repeating-linear-gradient(90deg, rgba(244, 242, 237, 0.22) 0 4px, transparent 4px 10px); }
    .svp-demo:has(.switch-in:checked) .wire--cloud {
      width: 100%;
      height: 3px;
      background: repeating-linear-gradient(90deg, var(--sv-orange) 0 6px, transparent 6px 11px);
      background-size: 11px 3px;
      animation: flow-x2 0.5s linear infinite;
    }
    @keyframes flow-x2 { to { background-position: 11px 0; } }
    .path-lbl { grid-area: lbl; margin: 0.5rem 0 0; justify-self: stretch; align-self: start; width: auto; max-width: none; }
    .node--pc, .node--cloud { align-self: stretch; }
    .svp-try { flex-wrap: wrap; }
  }
  /* the infinite loops stop for people who ask for less motion */
  @media (prefers-reduced-motion: reduce) {
    .node-pulse, .wire, .node-ic--txt i { animation: none !important; }
    .node-pulse { opacity: 0; }
    :global(.js) .svp-statement .sw { transition: none !important; }
  }
</style>

<script>
  import { gsap } from "gsap";

  const root = document.querySelector<HTMLElement>(".svp")!;
  const statement = root.querySelector<HTMLElement>(".svp-statement")!;

  // light the sentence on a short timed stagger once it's in view. If the page
  // opens below it (a jump link, a reload), it is simply lit.
  const lightUp = () => statement.classList.add("lit");
  const io = new IntersectionObserver(([e]) => {
    if (e.isIntersecting || e.boundingClientRect.bottom < 0) { lightUp(); io.disconnect(); }
  }, { threshold: 0.35 });
  io.observe(statement);

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const nodes = gsap.from(root.querySelectorAll(".svp-demo .node, .svp-demo .wire"), {
      opacity: 0, y: 24, duration: 0.8, ease: "expo.out", stagger: 0.07,
      // hand opacity back to the stylesheet: the cloud node's look depends on the switch
      clearProps: "opacity,transform",
      scrollTrigger: { trigger: root.querySelector(".svp-flow"), start: "top 85%", once: true },
    });
    return () => nodes.revert();
  });
  mm.add("(prefers-reduced-motion: reduce)", () => {
    statement.classList.add("is-static");
    return () => statement.classList.remove("is-static");
  });

  // CSS loops pause off screen and in a hidden tab
  let onScreen = false;
  const syncOff = () => root.classList.toggle("is-off", !onScreen || document.hidden);
  root.classList.add("is-off");
  new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; syncOff(); }).observe(root);
  document.addEventListener("visibilitychange", syncOff);

  // the example switch is CSS only (:has), so it also works with JS off
</script>

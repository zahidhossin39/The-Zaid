---
// "Private by default": a statement that lights up word by word as you
// scroll, and a flow diagram (mic → your computer → text) whose cloud branch
// stays cut until the visitor flips the switch, the same as in the app.

const statement =
  "Your voice is turned into text on your own computer. Nothing is uploaded. No account, no word limit, no monthly fee.";
const words = statement.split(" ");
---

<section class="svp" aria-labelledby="svp-title">
  <div class="svp-inner">
    <p class="sv-eyebrow">Private by default</p>
    <h2 class="svp-statement" id="svp-title" aria-label={statement}>
      {words.map((w) => <span class="sw" aria-hidden="true">{w} </span>)}
    </h2>

    <div class="svp-flow" data-cloud="off">
      <div class="node node--mic">
        <span class="node-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
        </span>
        <span class="node-t">Your microphone</span>
      </div>

      <span class="wire wire--a" aria-hidden="true"></span>

      <div class="node node--pc">
        <span class="node-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
        </span>
        <span class="node-t">Your computer</span>
        <span class="node-s">The speech model runs here</span>
        <span class="node-pulse" aria-hidden="true"></span>
      </div>

      <span class="wire wire--b" aria-hidden="true"></span>

      <div class="node node--txt">
        <span class="node-ic node-ic--txt" aria-hidden="true">Aa<i></i></span>
        <span class="node-t">Text at your cursor</span>
      </div>

      <span class="wire wire--cloud" aria-hidden="true"><b></b></span>

      <div class="node node--cloud">
        <span class="node-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.2 4.5 4.5 0 0 0 7 18Z" /></svg>
        </span>
        <span class="node-t">Cloud services</span>
        <span class="node-s">OpenAI, Anthropic, OpenRouter</span>
        <label class="switch">
          <input type="checkbox" class="switch-in" />
          <span class="switch-track" aria-hidden="true"><span class="switch-dot"></span></span>
          <span class="switch-label">Off until you turn it on</span>
        </label>
      </div>
    </div>

    <ul class="svp-chips">
      <li>Works offline</li>
      <li>No account</li>
      <li>No tracking</li>
      <li>No word limit</li>
      <li>Free</li>
    </ul>
  </div>
</section>

<style>
  .svp {
    position: relative;
    padding: clamp(6rem, 12vw, 10rem) 1.25rem;
    background:
      radial-gradient(60% 50% at 50% 100%, rgba(249, 115, 22, 0.1), transparent 70%),
      #0d0d0f;
    border-block: 1px solid var(--sv-line);
    overflow: hidden;
  }
  .svp-inner { max-width: 70rem; margin: 0 auto; text-align: center; }

  .svp-statement {
    margin: 1.2rem auto 0;
    max-width: 58rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 5.2vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .sw { transition: color 0.25s ease; }
  /* base: fully lit; JS dims what the scroll hasn't reached yet */
  :global(.js) .svp-statement:not(.is-static) .sw { color: rgba(244, 242, 237, 0.16); }
  :global(.js) .svp-statement:not(.is-static) .sw.lit { color: var(--color-text); }
  :global(.js) .svp-statement:not(.is-static) .sw.lit.hot { color: var(--sv-orange); }

  /* ---- flow ---- */
  .svp-flow {
    --on: rgba(249, 115, 22, 0.9);
    display: grid;
    grid-template-columns: 1fr minmax(2rem, 0.6fr) 1.2fr minmax(2rem, 0.6fr) 1fr;
    grid-template-rows: auto 4.5rem auto;
    grid-template-areas:
      ". . cloud . ."
      ". . wc . ."
      "mic wa pc wb txt";
    align-items: center;
    margin: clamp(3.5rem, 8vw, 6rem) auto 0;
    max-width: 62rem;
    text-align: left;
  }
  .node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem;
    border-radius: 16px;
    border: 1px solid var(--sv-line);
    background: rgba(244, 242, 237, 0.025);
  }
  .node--mic { grid-area: mic; }
  .node--pc { grid-area: pc; border-color: rgba(249, 115, 22, 0.55); background: rgba(249, 115, 22, 0.08); box-shadow: 0 0 80px -20px rgba(249, 115, 22, 0.5); }
  .node--txt { grid-area: txt; }
  .node--cloud { grid-area: cloud; border-style: dashed; transition: border-color 0.4s ease, background 0.4s ease; }
  .node--cloud > :not(.switch) { opacity: 0.7; transition: opacity 0.4s ease; }
  .svp-flow[data-cloud="on"] .node--cloud > :not(.switch) { opacity: 1; }
  .svp-flow[data-cloud="on"] .node--cloud { border-style: solid; border-color: rgba(244, 242, 237, 0.35); background: rgba(244, 242, 237, 0.05); }

  .node-ic {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: 0.4rem;
    border-radius: 10px;
    background: rgba(244, 242, 237, 0.06);
    color: var(--color-text);
  }
  .node--pc .node-ic { background: var(--sv-orange); color: #140a02; }
  .node-ic svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .node-ic--txt { font-family: var(--font-display); font-size: 1.2rem; }
  .node-ic--txt i { display: inline-block; width: 1.5px; height: 1.1rem; margin-left: 2px; background: var(--sv-orange); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .node-t { font-weight: 600; font-size: 0.98rem; }
  .node-s { font-size: 0.82rem; color: var(--color-muted); line-height: 1.4; }
  .node-pulse { position: absolute; inset: -1px; border-radius: inherit; border: 1px solid var(--sv-orange); animation: pc-pulse 2.6s ease-out infinite; pointer-events: none; }
  @keyframes pc-pulse { from { opacity: 0.8; transform: scale(1); } to { opacity: 0; transform: scale(1.08, 1.25); } }

  /* wires: flowing dots */
  .wire { position: relative; height: 2px; align-self: center; }
  .wire--a { grid-area: wa; }
  .wire--b { grid-area: wb; }
  .wire--a, .wire--b {
    background: repeating-linear-gradient(90deg, var(--on) 0 4px, transparent 4px 12px);
    background-size: 12px 2px;
    animation: flow-x 0.6s linear infinite;
  }
  @keyframes flow-x { to { background-position: 12px 0; } }
  .wire--cloud {
    grid-area: wc;
    justify-self: center;
    width: 2px;
    height: 100%;
    background: repeating-linear-gradient(180deg, rgba(244, 242, 237, 0.25) 0 4px, transparent 4px 10px);
  }
  /* the cut in the cloud line */
  .wire--cloud b {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #0d0d0f;
    border: 1px solid rgba(244, 242, 237, 0.3);
    transition: transform 0.4s cubic-bezier(.22, 1.4, .36, 1), opacity 0.3s ease;
  }
  .wire--cloud b::before,
  .wire--cloud b::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: rgba(244, 242, 237, 0.7);
    translate: -50% -50%;
    rotate: 45deg;
  }
  .wire--cloud b::after { rotate: -45deg; }
  .svp-flow[data-cloud="on"] .wire--cloud {
    background: repeating-linear-gradient(0deg, rgba(244, 242, 237, 0.75) 0 4px, transparent 4px 10px);
    background-size: 2px 10px;
    animation: flow-y 0.6s linear infinite;
  }
  .svp-flow[data-cloud="on"] .wire--cloud b { transform: scale(0); opacity: 0; }
  @keyframes flow-y { to { background-position: 0 -10px; } }

  /* switch */
  .switch { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.6rem; cursor: pointer; font-size: 0.8rem; color: var(--color-muted); min-height: 32px; }
  .switch-in { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .switch-track { position: relative; flex: none; width: 2.4rem; height: 1.35rem; border-radius: 999px; background: rgba(244, 242, 237, 0.12); transition: background 0.3s ease; }
  .switch-dot { position: absolute; top: 3px; left: 3px; width: calc(1.35rem - 6px); aspect-ratio: 1; border-radius: 50%; background: var(--color-text); transition: transform 0.35s cubic-bezier(.22, 1.4, .36, 1); }
  .switch-in:checked + .switch-track { background: var(--color-text); }
  .switch-in:checked + .switch-track .switch-dot { transform: translateX(1.05rem); background: #0d0d0f; }
  .switch-in:focus-visible + .switch-track { outline: 2px solid var(--sv-orange); outline-offset: 3px; }

  .svp-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; list-style: none; padding: 0; margin: clamp(3rem, 6vw, 4.5rem) 0 0; }
  .svp-chips li {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    font-size: 0.9rem;
    color: var(--color-text);
    background: rgba(244, 242, 237, 0.02);
  }
  .svp-chips li::before { content: "✓"; color: var(--sv-orange); margin-right: 0.5rem; font-weight: 700; }

  @media (max-width: 820px) {
    .svp-flow {
      grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 0.9fr);
      grid-template-rows: auto 2.5rem auto 2.5rem auto;
      grid-template-areas:
        "mic . ."
        "wa . ."
        "pc wc cloud"
        "wb . ."
        "txt . .";
      max-width: 34rem;
    }
    .wire--a, .wire--b {
      justify-self: center;
      width: 2px;
      height: 100%;
      background: repeating-linear-gradient(180deg, var(--on) 0 4px, transparent 4px 12px);
      background-size: 2px 12px;
      animation: flow-down 0.6s linear infinite;
    }
    @keyframes flow-down { to { background-position: 0 12px; } }
    .wire--cloud { width: 100%; height: 2px; background: repeating-linear-gradient(90deg, rgba(244, 242, 237, 0.25) 0 4px, transparent 4px 10px); }
    .svp-flow[data-cloud="on"] .wire--cloud {
      background: repeating-linear-gradient(90deg, rgba(244, 242, 237, 0.75) 0 4px, transparent 4px 10px);
      background-size: 10px 2px;
      animation: flow-x 0.6s linear infinite;
    }
    .node { padding: 0.9rem 1rem; }
    .node--cloud .node-s { display: none; }
  }
  @media (max-width: 520px) {
    .svp-flow { grid-template-columns: minmax(0, 1.1fr) 1.5rem minmax(0, 1fr); }
    .node-t { font-size: 0.9rem; }
    .switch { flex-direction: column; align-items: flex-start; gap: 0.4rem; font-size: 0.74rem; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>(".svp")!;
  const statement = root.querySelector<HTMLElement>(".svp-statement")!;
  const words = [...statement.querySelectorAll<HTMLElement>(".sw")];
  // words that light up orange instead of white
  const HOT = new Set(["computer.", "uploaded."]);
  words.forEach((w) => HOT.has(w.textContent!.trim()) && w.classList.add("hot"));

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const st = ScrollTrigger.create({
      trigger: statement,
      start: "top 80%",
      end: "bottom 45%",
      onUpdate: (self) => {
        const k = Math.round(self.progress * words.length);
        words.forEach((w, i) => w.classList.toggle("lit", i < k));
      },
      onLeave: () => words.forEach((w) => w.classList.add("lit")),
    });
    const nodes = gsap.from(root.querySelectorAll(".node, .wire"), {
      opacity: 0, y: 30, scale: 0.96, duration: 0.9, ease: "expo.out", stagger: 0.08,
      // hand opacity back to the stylesheet: the cloud node's own opacity
      // depends on the switch and has a CSS transition that fights the tween
      clearProps: "opacity,transform,translate,scale",
      scrollTrigger: { trigger: root.querySelector(".svp-flow"), start: "top 80%", once: true },
    });
    return () => { st.kill(); nodes.revert(); };
  });
  mm.add("(prefers-reduced-motion: reduce)", () => {
    statement.classList.add("is-static");
    return () => statement.classList.remove("is-static");
  });

  const flow = root.querySelector<HTMLElement>(".svp-flow")!;
  const sw = root.querySelector<HTMLInputElement>(".switch-in")!;
  const label = root.querySelector<HTMLElement>(".switch-label")!;
  sw.addEventListener("change", () => {
    flow.dataset.cloud = sw.checked ? "on" : "off";
    label.textContent = sw.checked ? "On, because you chose it" : "Off until you turn it on";
  });
</script>

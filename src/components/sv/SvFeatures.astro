---
// Feature bento (v0.2.0). Every card shows its feature working instead of
// describing it. Base markup is the finished frame; scripts only add motion.
// Four full cards (any app, writing styles, your words, Model Store), one
// compact card with three smaller tools, and a slim open-source strip.
import { siGithub } from "simple-icons";
import { REPO } from "../../scripts/sv-release";

// 1. any app: one pasted line per app
const apps = [
  { id: "mail", tab: "Email", title: "Mail", meta: "To: Sam · Re: Thursday", text: "Thursday works for me. I'll send the notes before the call." },
  { id: "docs", tab: "Docs", title: "Docs", meta: "Plan for next week", text: "First, finish the new price list. Then call the three people who asked for a quote." },
  { id: "chat", tab: "Chat", title: "Chat", meta: "Are we still on for lunch?", text: "Yes, see you at one. I'll be a few minutes late." },
  { id: "code", tab: "Code", title: "cart.ts", meta: "", text: "// add up the prices and skip anything that's out of stock" },
];

// 2. writing styles: the app's own preview sample, run through all nine
// built-in styles, in the app's order (src/services/modes.ts)
const sample = "um so i think we should like push the release to friday you know cause the uh login thing is still broken";
const styles = [
  { id: "raw", label: "Raw Transcription", ai: false, text: "So I think we should like push the release to Friday, you know, cause the login thing is still broken." },
  { id: "clean", label: "Clean Up", ai: true, text: "So I think we should push the release to Friday, because the login thing is still broken." },
  { id: "flow", label: "Whisper Flow Style", ai: true, text: "I think we should push the release to Friday, because the login thing is still broken." },
  { id: "formal", label: "Formal", ai: true, text: "I recommend moving the release to Friday, as the login issue has not been resolved yet." },
  { id: "casual", label: "Casual", ai: true, text: "Let's push the release to Friday. The login thing is still broken." },
  { id: "email", label: "Email", ai: true, text: "Hi team,\nI think we should move the release to Friday, since the login issue is still broken.\nThanks" },
  { id: "summary", label: "Summary", ai: true, text: "• Push the release to Friday\n• Login is still broken" },
  { id: "translate", label: "Translate", ai: true, text: "Creo que deberíamos pasar el lanzamiento al viernes, porque el inicio de sesión sigue fallando." },
  { id: "code", label: "Code Comment", ai: true, text: "// Release moved to Friday: login is still broken." },
];
const startStyle = 1;

// read aloud
const readWords = "Select any text, press Ctrl + Alt + S, and Silent Voice reads it out loud.".split(" ");

// Model Store: real catalogue rows. The base frame is an average 8-thread
// laptop with no graphics card; the script regroups for the visitor.
const models = [
  { id: "moonshine", name: "Moonshine Base", lang: "English", by: "Useful Sensors", size: "251 MB", note: "" },
  { id: "parakeet", name: "Parakeet TDT 0.6B v2", lang: "English", by: "NVIDIA", size: "640 MB", note: "" },
  { id: "turbo", name: "Whisper large-v3-turbo", lang: "Multilingual", by: "OpenAI", size: "1.6 GB", note: "" },
  { id: "qwen", name: "Qwen3-ASR 1.7B", lang: "52 languages", by: "Qwen", size: "2.4 GB", note: "Needs a strong graphics card" },
];
const groups = [
  { id: "well", label: "Runs well on this PC", start: ["moonshine", "parakeet"] },
  { id: "slow", label: "Runs, but may be slow", start: ["turbo"] },
  { id: "heavy", label: "Too heavy for this PC", start: ["qwen"] },
];
const byId = Object.fromEntries(models.map((m) => [m.id, m]));

// your words, shortcuts and spoken formatting
type Seg = { say: string; type: string; cat?: "words" | "short" | "format" | "filler"; br?: boolean };
const segs: Seg[] = [
  { say: "um", type: "", cat: "filler" },
  { say: "quad code", type: "Claude Code", cat: "words" },
  { say: "cut the build time by", type: "cut the build time by" },
  { say: "twenty five percent", type: "25%.", cat: "format" },
  { say: "new line", type: "", cat: "format", br: true },
  { say: "the details are on", type: "The details are on" },
  { say: "google dot com", type: "google.com.", cat: "format" },
  { say: "uh", type: "", cat: "filler" },
  { say: "send questions to", type: "Send questions to" },
  { say: "my email", type: "you@example.com", cat: "short" },
];
const cats = [
  { id: "words", label: "Your words" },
  { id: "short", label: "Shortcuts" },
  { id: "format", label: "Spoken formatting" },
  { id: "filler", label: "Fillers removed" },
];

// progress: 12 weeks of example activity (seeded, so it never changes)
let seed = 7;
const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const days = Array.from({ length: 84 }, (_, i) => {
  const dow = i % 7; // 0 = Monday
  const weekend = dow >= 5;
  const ramp = 0.45 + (i / 84) * 0.75; // more use as the weeks go on
  const r = rnd();
  if (r < (weekend ? 0.55 : 0.12)) return 0;
  return Math.round((weekend ? 110 : 300) * ramp * (0.35 + rnd() * 1.6));
});
// the last nine days in a row, ending today
for (let i = 75; i < 84; i++) days[i] = Math.max(days[i], 120 + ((i * 37) % 260));
days[83] = 740;
const level = (w: number) => (w === 0 ? 0 : w < 100 ? 1 : w < 300 ? 2 : w < 700 ? 3 : 4);
const totalWords = days.reduce((a, b) => a + b, 0);
let streak = 0;
for (let i = days.length - 1; i >= 0 && days[i] > 0; i--) streak++;
const savedMin = Math.round(totalWords / 40 - totalWords / 150); // typing at 40 wpm vs speaking at ~150
const saved = savedMin % 60 ? `${Math.floor(savedMin / 60)} h ${savedMin % 60} min` : `${savedMin / 60} hours`;
const dayNames = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

const clone = `git clone https://github.com/${REPO}`;
---

<section class="svf" id="features" aria-labelledby="svf-title">
  <div class="svf-head">
    <p class="sv-eyebrow">What it does</p>
    <h2 class="h2" id="svf-title">Dictation that works in <em>every app.</em></h2>
    <p class="svf-lead">The text lands where your cursor is. The tools around it run on your computer by default.</p>
  </div>

  <div class="bento">
    <!-- 1. any app ---------------------------------------------------------->
    <article class="card card--apps">
      <div class="card-copy">
        <p class="card-tag">Dictation</p>
        <h3>If you can type there, you can talk there</h3>
        <p>Email, documents, chat, even your code editor. Pick one to see a line dictated into it.</p>
      </div>
      <div class="apps" data-apps>
        <div class="apps-bar">
          <div class="apps-tabs" role="tablist" aria-label="Example apps">
            {apps.map((a, i) => (
              <button type="button" role="tab" class="apps-tab" id={`svf-tab-${a.id}`} aria-controls={`svf-pane-${a.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{a.tab}</button>
            ))}
          </div>
          <button type="button" class="apps-pause" aria-label="Pause the demo" hidden>
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
            <span class="apps-pause-t" aria-hidden="true">Pause</span>
          </button>
        </div>
        <div class="apps-screen">
          {apps.map((a, i) => (
            <div class:list={["apps-pane", `apps-pane--${a.id}`, { on: i === 0 }]} role="tabpanel" id={`svf-pane-${a.id}`} aria-labelledby={`svf-tab-${a.id}`} tabindex="0">
              <div class="win-bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span>{a.title}</span></div>
              <div class="win-body">
                {a.id === "mail" && <p class="apps-meta">{a.meta}</p>}
                {a.id === "docs" && <p class="apps-doc">{a.meta}</p>}
                {a.id === "chat" && <p class="apps-bubble">{a.meta}</p>}
                {a.id === "code" && <p class="apps-code" aria-hidden="true"><span class="c-k">function</span> <span class="c-f">total</span>(items) {"{"}</p>}
                <p class="apps-line">
                  <span class="sr-only">{a.text}</span>
                  <span class="apps-typed" aria-hidden="true">{a.text.split(" ").map((w) => <span class="w">{w} </span>)}</span><span class="caret" aria-hidden="true"></span>
                </p>
                {a.id === "mail" && <p class="apps-quote">On Monday, Sam wrote:<br />Could we move our call to Thursday?</p>}
                {a.id === "docs" && <div class="apps-skel" aria-hidden="true"><i></i><i></i><i></i></div>}
                {a.id === "code" && <Fragment>
                  <p class="apps-code" aria-hidden="true">&nbsp;&nbsp;<span class="c-k">return</span> items</p>
                  <p class="apps-code" aria-hidden="true">&nbsp;&nbsp;&nbsp;&nbsp;.<span class="c-f">filter</span>((i) =&gt; i.inStock)</p>
                  <p class="apps-code" aria-hidden="true">&nbsp;&nbsp;&nbsp;&nbsp;.<span class="c-f">reduce</span>((s, i) =&gt; s + i.price, 0);</p>
                  <p class="apps-code" aria-hidden="true">{"}"}</p>
                </Fragment>}
              </div>
            </div>
          ))}
          <span class="apps-pill" data-state="idle" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i>
            <svg class="apps-check" viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7" /></svg>
          </span>
        </div>
      </div>
    </article>

    <!-- 2. writing styles ---------------------------------------------------->
    <article class="card card--styles">
      <div class="card-copy">
        <p class="card-tag">Writing styles</p>
        <h3>Say it once, shape it after</h3>
        <p>All nine built-in styles, each one editable, plus your own. A local AI rewrites it on your computer, or a cloud model with your own key.</p>
      </div>
      <div class="styles" data-styles>
        <div class="styles-chips" role="radiogroup" aria-label="Writing style">
          {styles.map((s, i) => (
            <button type="button" role="radio" class="style" aria-checked={i === startStyle ? "true" : "false"} tabindex={i === startStyle ? 0 : -1} data-text={s.text} data-ai={s.ai ? "1" : "0"}>
              {s.label}{i === 0 && <span class="style-def"> (default)</span>}
            </button>
          ))}
        </div>
        <div class="styles-box">
          <p class="styles-said"><span class="styles-k">You said</span>{sample.split(" ").map((w, i) => <Fragment>{i > 0 && " "}{["um", "uh"].includes(w) ? <s>{w}</s> : w}</Fragment>)}</p>
          <div class="styles-outwrap">
            <span class="styles-k"><span data-styles-badge>Local AI</span> · pasted</span>
            <p class="styles-out" aria-live="polite">{styles[startStyle].text}</p>
          </div>
        </div>
      </div>
    </article>

    <!-- 3. your words + spoken formatting ------------------------------------>
    <article class="card card--words">
      <div class="card-copy">
        <p class="card-tag">Words and Shortcuts</p>
        <h3>Gets your words right</h3>
        <p>Teach it names and jargon. Say “my email” and it types your address. Numbers and web addresses come out formatted.</p>
      </div>
      <div class="words" data-words>
        <div class="words-legend" role="group" aria-label="Highlight one kind of fix">
          {cats.map((c) => <button type="button" class:list={["wl", `c-${c.id}`]} aria-pressed="false" data-cat={c.id}><i aria-hidden="true"></i>{c.label}</button>)}
        </div>
        <div class="words-lines">
          <p class="words-said"><span class="words-k">You say</span>
            {segs.map((s, i) => <Fragment>{i > 0 && " "}<span class:list={["seg", s.cat && `c-${s.cat}`]} data-cat={s.cat}>{s.say}</span></Fragment>)}
          </p>
          <p class="words-typed"><span class="words-k">It types</span>
            {segs.filter((s) => s.br || s.type).map((s, i) =>
              s.br ? <Fragment> <span class="seg seg-br c-format" data-cat="format"><span aria-hidden="true">↵</span></span><br /></Fragment>
              : <Fragment>{i > 0 && " "}<span class:list={["seg", s.cat && `c-${s.cat}`]} data-cat={s.cat}>{s.type}</span></Fragment>,
            )}
          </p>
        </div>
      </div>
    </article>

    <!-- 4. Model Store -------------------------------------------------------->
    <article class="card card--models">
      <div class="card-copy">
        <p class="card-tag">Model Store</p>
        <h3>Picks a model that fits your computer</h3>
        <p>22 voice models, grouped by how well they run on your PC, with one picked for you.</p>
      </div>
      <div class="ms" data-ms>
        <div class="ms-pick" role="group" aria-label="Show the grouping for">
          <button type="button" class="ms-btn" aria-pressed="false" data-profile="old">Older laptop</button>
          <button type="button" class="ms-btn" aria-pressed="true" data-profile="this">This computer</button>
          <button type="button" class="ms-btn" aria-pressed="false" data-profile="gpu">PC with a graphics card</button>
        </div>
        <div class="ms-app">
          {groups.map((g) => (
            <section class="ms-group" data-group={g.id} aria-label={g.label}>
              <h4 class="ms-h">{g.label} <span class="ms-n">{g.start.length}</span></h4>
              <ul class="ms-list">
                {g.start.map((id) => {
                  const m = byId[id];
                  return (
                    <li class="ms-row" data-model={m.id}>
                      <span class="ms-logo" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 6.5v3M6.5 4v8M10 5.5v5M13.5 7v2" /></svg></span>
                      <span class="ms-name">
                        <b>{m.name} <span class="ms-lang">({m.lang})</span></b>
                        <small>{m.by}{m.note && <span class="ms-note"> · {m.note}</span>}</small>
                      </span>
                      <span class="ms-badge" hidden={m.id !== "parakeet"}>Recommended</span>
                      <span class="ms-size">{m.size}</span>
                    </li>
                  );
                })}
              </ul>
              <p class="ms-empty" hidden={g.start.length > 0}>None</p>
            </section>
          ))}
        </div>
        <p class="ms-read" data-ms-read>The app reads your processor, memory and graphics card. This preview shows a typical laptop.</p>
      </div>
    </article>

    <!-- 5. three smaller tools in one card ------------------------------------>
    <div class="card card--more">
      <!-- proofreading -->
      <article class="mini mini--proof">
        <p class="card-tag">Writing help</p>
        <h3>Catches typos where you type</h3>
        <p>Red for spelling, blue for grammar, in the apps you write in. Optional, English only, and it skips code editors.</p>
        <div class="proof-wrap">
          <p class="proof" data-proof>
            I{" "}<button type="button" class="typo" data-fix="received" aria-label="recieved: spelling mistake, fix it">recieved</button>{" "}the notes from{" "}<button type="button" class="typo typo--g" data-fix="their" aria-label="there: grammar mistake, fix it">there</button>{" "}meeting and will reply{" "}<button type="button" class="typo" data-fix="tomorrow" aria-label="tomorow: spelling mistake, fix it">tomorow</button>.
          </p>
          <div class="proof-foot">
            <span class="proof-hint">Tap a marked word to fix it.</span>
            <button type="button" class="proof-reset" hidden>Mark them again</button>
          </div>
        </div>
      </article>

      <!-- read aloud -->
      <article class="mini mini--read">
        <p class="card-tag">Read aloud</p>
        <h3>Reads text out loud</h3>
        <p>The other direction. Natural voices from Piper and Kokoro, downloaded once, running on your computer.</p>
        <div class="read" data-read>
          <p class="read-text">{readWords.map((w) => <span>{w} </span>)}</p>
          <div class="read-row">
            <button type="button" class="read-play" aria-pressed="false">
              <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
              <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z" /></svg>
              <span class="read-label">Show the example</span>
            </button>
            <span class="read-pill" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          </div>
          <p class="read-note" hidden>This uses your browser's voice. The app's voices sound more natural.</p>
        </div>
      </article>

      <!-- progress -->
      <article class="mini mini--progress">
        <p class="card-tag">Progress</p>
        <h3>Watch the minutes add up</h3>
        <p>Time saved against typing, speaking speed, streaks and your last 12 weeks, worked out on your computer.</p>
        <div class="pg" data-pg>
          <div class="pg-stats">
            <div class="pg-big"><b>{saved}</b><span>saved against typing at 40 words a minute</span></div>
            <div class="pg-small"><b>{streak} days</b><span>streak</span></div>
            <div class="pg-small"><b>142</b><span>words a minute</span></div>
          </div>
          <div class="pg-map" aria-hidden="true">
            <span class="pg-k">Last 12 weeks</span>
            <div class="pg-grid">
              {days.map((w, i) => <i class:list={[`l${level(w)}`, { today: i === days.length - 1 }]} data-w={w} data-d={dayNames[i % 7]}></i>)}
            </div>
            <div class="pg-foot">
              <span class="pg-readout" data-pg-readout>Example numbers</span>
              <span class="pg-legend">Fewer <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> More</span>
            </div>
          </div>
          <p class="sr-only">Example numbers: {saved} saved, a {streak}-day streak, 142 words a minute when speaking, and a map of the last 12 weeks with one square per day, darker on days with more words dictated.</p>
        </div>
      </article>
    </div>

    <!-- 6. open source strip --------------------------------------------------->
    <div class="card card--oss">
      <p class="oss-t">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
        <span><strong>Free and open source.</strong> MIT licensed, every line on GitHub.</span>
      </p>
      <div class="term">
        <code><span class="term-p" aria-hidden="true">$ </span>{clone}</code>
        <button type="button" class="term-copy" data-copy={clone} aria-label="Copy the git clone command">Copy</button>
      </div>
      <a class="oss-link" href={`https://github.com/${REPO}`} target="_blank" rel="noopener noreferrer">View the code<span class="sr-only"> on GitHub (opens in a new tab)</span></a>
    </div>
  </div>
</section>

<style>
  .svf {
    --app-font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --c-words: #fb923c;
    --c-short: #2dd4bf;
    --c-format: #38bdf8;
    /* page container: 76rem of content plus a 1.25rem gutter */
    max-width: calc(76rem + 2.5rem);
    margin: 0 auto;
    padding: clamp(6rem, 12vw, 10rem) 1.25rem;
  }
  .svf-head { text-align: center; margin-bottom: clamp(2rem, 4vw, 2.5rem); }
  .svf-head .h2 { margin: 0.9rem 0 0; font-size: clamp(2.3rem, 5.2vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; text-wrap: balance; }
  .svf-head em { color: var(--sv-orange); }
  .svf-lead { margin: 1rem auto 0; max-width: 44rem; color: var(--color-muted); font-size: 1.05rem; line-height: 1.55; text-wrap: balance; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .bento { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; }
  .card {
    --mx: -400px;
    --my: -400px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border-radius: 22px;
    background: rgba(17, 17, 20, 0.8);
    overflow: hidden;
  }
  /* spotlight border + glow that follows the pointer */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(380px circle at var(--mx) var(--my), rgba(249, 115, 22, 0.75), transparent 45%), var(--sv-line);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(500px circle at var(--mx) var(--my), rgba(249, 115, 22, 0.07), transparent 50%);
    pointer-events: none;
  }
  .card-tag { margin: 0 0 0.6rem !important; font-family: var(--font-mono); font-size: 0.68rem !important; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sv-orange) !important; }
  .card h3 { margin: 0 0 0.4rem; font-family: "Inter Tight", var(--font-sans); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; text-wrap: balance; }
  .card p { margin: 0; color: var(--color-muted); font-size: 0.93rem; line-height: 1.5; }
  .card-copy p:last-child { max-width: 42rem; }
  .card button { font: inherit; }

  /* layout: two rows of full cards, one compact row, one strip */
  .card--apps { grid-column: span 6; }
  .card--styles { grid-column: span 6; }
  .card--words { grid-column: span 5; }
  .card--models { grid-column: span 7; }
  .card--more { grid-column: span 12; }
  .card--oss { grid-column: span 12; }

  /* shared bits */
  .dots { display: flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: #2a2a30; }
  .chip {
    min-height: 36px;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  /* ---- 1. any app ---- */
  .apps { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; }
  .apps-bar { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
  .apps-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  :global(html:not(.js)) .apps-tabs { visibility: hidden; }
  .apps-tab, .apps-pause {
    min-height: 40px;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.85rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .apps-tab:hover, .apps-pause:hover { color: var(--color-text); border-color: rgba(244, 242, 237, 0.25); }
  .apps-tab[aria-selected="true"] { background: var(--color-text); color: #0a0a0b; border-color: var(--color-text); }
  .apps-pause { display: inline-flex; align-items: center; gap: 0.4rem; padding-inline: 0.8rem; }
  .apps-pause[hidden] { display: none; }
  .apps-pause svg { width: 0.85rem; height: 0.85rem; fill: currentColor; }
  .apps-pause .i-play, .apps-pause[data-state="paused"] .i-pause { display: none; }
  .apps-pause[data-state="paused"] .i-play { display: block; }

  .apps-screen {
    position: relative;
    flex: 1;
    min-height: 14rem;
    border-radius: 14px;
    background: #0b0e14;
    border: 1px solid #262c3d;
    overflow: hidden;
    font-family: var(--app-font);
  }
  .apps-pane {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(.22, 1, .36, 1), visibility 0s linear 0.4s;
  }
  .apps-pane.on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .apps-pane:focus-visible { outline: 2px solid var(--sv-orange); outline-offset: -2px; border-radius: 14px; }
  .win-bar { display: flex; align-items: center; gap: 0.8rem; padding: 0.55rem 0.9rem; border-bottom: 1px solid #1b2030; background: #131722; font-size: 0.75rem; color: #8b93a7; }
  .win-body { padding: 1.1rem 1.3rem 3.4rem; }
  .apps-meta { font-size: 0.8rem !important; color: #8b93a7 !important; padding-bottom: 0.7rem; margin-bottom: 0.9rem !important; border-bottom: 1px solid #1b2030; }
  .apps-doc { font-size: 1.3rem !important; font-weight: 600; color: #e6e9f0 !important; margin-bottom: 0.7rem !important; letter-spacing: -0.01em; }
  .apps-line { color: #e6e9f0 !important; font-size: 1rem !important; line-height: 1.55 !important; min-height: 1.6em; }
  .apps-typed .w { display: inline-block; white-space: pre; }
  .caret { display: inline-block; width: 2px; height: 1.1em; margin-left: 1px; vertical-align: -0.18em; background: var(--sv-orange); }
  .apps-bubble { display: inline-block; padding: 0.5rem 0.9rem; border-radius: 14px 14px 14px 4px; background: #1b2030; color: #e6e9f0 !important; font-size: 0.92rem !important; margin-bottom: 0.8rem !important; }
  .apps-pane--chat .apps-line { margin-left: auto; width: fit-content; max-width: 85%; padding: 0.5rem 0.9rem; border-radius: 14px 14px 4px 14px; background: var(--sv-orange); color: #1a1200 !important; font-size: 0.92rem !important; }
  .apps-pane--chat .win-body { display: flex; flex-direction: column; align-items: flex-start; }
  .apps-pane--chat .apps-line { align-self: flex-end; }
  .apps-pane--chat .caret { background: #1a1200; }
  .apps-code, .apps-pane--code .apps-line { font-family: var(--font-mono); font-size: 0.85rem !important; }
  .apps-code { color: #e6e9f0 !important; }
  .apps-pane--code .apps-line { color: #8b93a7 !important; padding-left: 1.5rem; margin: 0.3rem 0 !important; }
  .apps-quote { margin-top: 1.1rem !important; padding-left: 0.8rem; border-left: 2px solid #262c3d; font-size: 0.85rem !important; color: #8b93a7 !important; line-height: 1.5 !important; }
  .apps-skel { display: grid; gap: 0.55rem; margin-top: 1.1rem; }
  .apps-skel i { display: block; height: 8px; border-radius: 4px; background: #1b2030; }
  .apps-skel i:nth-child(1) { width: 92%; }
  .apps-skel i:nth-child(2) { width: 78%; }
  .apps-skel i:nth-child(3) { width: 55%; }
  .apps-code { line-height: 1.7 !important; white-space: nowrap; }
  .c-k { color: #c084fc; }
  .c-f { color: #fdba74; }

  /* the real recording pill, scaled up: idle line, bars, processing, check */
  .apps-pill {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    translate: -50% 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 76px;
    height: 28px;
    border-radius: 999px;
    background: #0e1116;
    border: 1px solid #262c3d;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }
  .apps-pill i { width: 3px; height: 3px; border-radius: 2px; background: #8b93a7; transition: height 0.3s ease-out, width 0.3s ease-out, opacity 0.3s ease, background 0.3s ease; }
  .apps-pill[data-state="idle"] i { opacity: 0; }
  .apps-pill[data-state="idle"] i:nth-child(3) { opacity: 1; width: 26px; height: 2px; }
  .apps-pill[data-state="rec"] i { background: var(--sv-orange); }
  .apps-pill[data-state="rec"] i:nth-child(1) { height: 8px; }
  .apps-pill[data-state="rec"] i:nth-child(2) { height: 13px; }
  .apps-pill[data-state="rec"] i:nth-child(3) { height: 17px; }
  .apps-pill[data-state="rec"] i:nth-child(4) { height: 12px; }
  .apps-pill[data-state="rec"] i:nth-child(5) { height: 7px; }
  .apps-pill[data-state="proc"] i { height: 9px; }
  .apps-pill[data-state="done"] i { opacity: 0; height: 2px; }
  .apps-check { position: absolute; width: 18px; height: 18px; fill: none; stroke: #22c55e; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transform: scale(0.6); transition: opacity 0.2s ease, transform 0.3s cubic-bezier(.22, 1.4, .36, 1); }
  .apps-pill[data-state="done"] .apps-check { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .apps-pill[data-state="rec"] i { animation: sv-pulse 0.9s ease-in-out infinite alternate; }
    .apps-pill[data-state="proc"] i { animation: sv-pulse 1.6s ease-in-out infinite alternate; }
    .apps-pill i:nth-child(2) { animation-delay: -0.1s !important; }
    .apps-pill i:nth-child(3) { animation-delay: -0.2s !important; }
    .apps-pill i:nth-child(4) { animation-delay: -0.3s !important; }
    .apps-pill i:nth-child(5) { animation-delay: -0.4s !important; }
    .caret { animation: blink 1s steps(1) infinite; }
  }
  @keyframes sv-pulse { from { transform: scaleY(0.4); } to { transform: scaleY(1); } }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---- 2. writing styles ---- */
  .styles { display: flex; flex-direction: column; gap: 0.9rem; flex: 1; }
  .styles-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .style {
    min-height: 36px;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .style:hover { color: var(--color-text); border-color: rgba(249, 115, 22, 0.5); }
  .style[aria-checked="true"] { background: var(--sv-orange); border-color: var(--sv-orange); color: #1a1200; font-weight: 600; }
  .style-def { opacity: 0.75; font-weight: 400; }
  .styles-box { flex: 1; display: flex; flex-direction: column; border-radius: 14px; background: #0a0a0b; border: 1px solid rgba(244, 242, 237, 0.07); overflow: hidden; }
  .styles-k { display: block; margin-bottom: 0.35rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
  .styles-said { padding: 0.8rem 1rem; border-bottom: 1px dashed rgba(244, 242, 237, 0.1); font-family: var(--font-mono); font-size: 0.78rem !important; line-height: 1.55 !important; }
  .styles-said s { color: rgba(244, 242, 237, 0.4); text-decoration-color: rgba(249, 115, 22, 0.8); }
  .styles-outwrap { flex: 1; padding: 0.8rem 1rem 1rem; min-height: 6.5rem; }
  .styles-out { color: var(--color-text) !important; font-family: var(--font-display); font-size: 1.3rem !important; line-height: 1.3 !important; white-space: pre-line; }
  .styles-out.raw { font-family: var(--font-sans); font-size: 0.98rem !important; line-height: 1.55 !important; color: rgba(244, 242, 237, 0.82) !important; }

  /* ---- 3. words ---- */
  .words { display: flex; flex-direction: column; gap: 0.9rem; flex: 1; }
  .words-lines { flex: 1; display: flex; flex-direction: column; border-radius: 14px; background: #0a0a0b; border: 1px solid rgba(244, 242, 237, 0.07); }
  .words-k { display: block; margin-bottom: 0.35rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
  .words-said { padding: 0.8rem 1rem; border-bottom: 1px dashed rgba(244, 242, 237, 0.1); font-family: var(--font-mono); font-size: 0.78rem !important; line-height: 1.7 !important; color: rgba(244, 242, 237, 0.62) !important; }
  .words-said .seg[data-cat] { color: var(--c); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--c) 55%, transparent); text-underline-offset: 3px; }
  .words-said .c-filler { --c: rgba(244, 242, 237, 0.5); text-decoration: line-through !important; }
  .words-typed { padding: 0.8rem 1rem 0.95rem; font-family: var(--app-font); font-size: 0.96rem !important; line-height: 1.75 !important; color: var(--color-text) !important; }
  .words-typed .seg[data-cat] { color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); border-radius: 5px; padding: 0.05rem 0.25rem; }
  .words-typed .seg-br { background: none !important; padding: 0 !important; opacity: 0.7; font-size: 0.85em; }
  .c-words { --c: var(--c-words); }
  .c-short { --c: var(--c-short); }
  .c-format { --c: var(--c-format); }
  .c-filler { --c: rgba(244, 242, 237, 0.55); }
  .seg { transition: opacity 0.3s ease, filter 0.3s ease; }
  .words[data-focus] .seg { opacity: 0.28; }
  .words[data-focus="words"] .seg.c-words,
  .words[data-focus="short"] .seg.c-short,
  .words[data-focus="format"] .seg.c-format,
  .words[data-focus="filler"] .seg.c-filler { opacity: 1; }
  .words-legend { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .wl {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.78rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .wl i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .wl.c-filler i { background: transparent; border: 1.5px solid var(--c); }
  .wl:hover { color: var(--color-text); border-color: color-mix(in srgb, var(--c) 60%, transparent); }
  .wl[aria-pressed="true"] { color: var(--color-text); border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }

  /* ---- 4. Model Store ---- */
  .ms { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; }
  .ms-pick { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ms-name b, .ms-name small { min-width: 0; }
  .ms-btn {
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .ms-btn:hover { color: var(--color-text); border-color: rgba(244, 242, 237, 0.25); }
  .ms-btn[aria-pressed="true"] { background: var(--color-text); color: #0a0a0b; border-color: var(--color-text); }
  .ms-app { display: grid; gap: 0.2rem; padding: 0.8rem; border-radius: 14px; background: #0b0e14; border: 1px solid #262c3d; font-family: var(--app-font); color: #e6e9f0; }
  .ms-group + .ms-group { margin-top: 0.35rem; }
  .ms-h { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.35rem; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.02em; color: #8b93a7; }
  .ms-group[data-group="well"] .ms-h { color: #4ade80; }
  .ms-group[data-group="slow"] .ms-h { color: #facc15; }
  .ms-group[data-group="heavy"] .ms-h { color: #f87171; }
  .ms-n { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 0.3rem; border-radius: 999px; background: #1b2030; color: #8b93a7; font-size: 0.68rem; font-variant-numeric: tabular-nums; }
  .ms-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .ms-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 0.75rem; padding: 0.35rem 0.75rem; border-radius: 12px; background: #131722; border: 1px solid #262c3d; }
  .ms-group[data-group="heavy"] .ms-row { opacity: 0.6; }
  .ms-logo { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 8px; background: #1b2030; }
  .ms-logo svg { width: 15px; height: 15px; fill: none; stroke: #8b93a7; stroke-width: 1.8; stroke-linecap: round; }
  .ms-group[data-group="well"] .ms-logo svg { stroke: var(--sv-orange); }
  .ms-name { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
  .ms-name b { flex: 0 1 auto; font-size: 0.82rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ms-lang { font-weight: 400; color: #8b93a7; }
  .ms-name small { flex: 0 1000 auto; font-size: 0.72rem; color: #8b93a7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ms-note { color: #fbbf24; }
  .ms-badge { padding: 0.15rem 0.45rem; border-radius: 5px; background: rgba(249, 115, 22, 0.15); color: #fb923c; font-size: 0.66rem; font-weight: 600; }
  .ms-badge[hidden] { display: none; }
  .ms-size { font-size: 0.78rem; font-variant-numeric: tabular-nums; color: #e6e9f0; min-width: 3.6rem; text-align: right; }
  .ms-empty { margin: 0 !important; padding: 0.4rem 0.75rem; border-radius: 12px; border: 1px dashed #262c3d; font-size: 0.75rem !important; color: #8b93a7 !important; }
  .ms-empty[hidden] { display: none; }
  .ms-read { font-size: 0.8rem !important; }

  /* ---- 5. the compact card: three smaller tools side by side ---- */
  .card--more { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; padding: 0; }
  .mini { display: flex; flex-direction: column; padding: clamp(1.2rem, 2vw, 1.6rem); min-width: 0; }
  .mini + .mini { border-left: 1px solid var(--sv-line); }
  .mini h3 { font-size: 1.08rem; }
  .mini > p:not(.card-tag) { font-size: 0.86rem; }
  .mini > :last-child { margin-top: auto; padding-top: 1rem; }

  /* proofreading */
  .proof-wrap { display: flex; flex-direction: column; gap: 0.5rem; }
  .proof { font-family: var(--font-display); font-size: clamp(1.3rem, 1.8vw, 1.5rem) !important; line-height: 1.5 !important; color: var(--color-text) !important; }
  .typo {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    font: inherit !important;
    color: inherit;
    cursor: pointer;
    text-decoration: underline wavy #ef4444;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    transition: color 0.3s ease, text-decoration-color 0.4s ease;
  }
  /* a bigger hit area than the word itself */
  .typo::after { content: ""; position: absolute; inset: -0.45rem -0.2rem; }
  .typo--g { text-decoration-color: #3b82f6; }
  .typo:hover { color: #fecaca; }
  .typo--g:hover { color: #bfdbfe; }
  .typo.fixed { text-decoration-color: transparent; color: var(--sv-orange); cursor: default; }
  .proof-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; min-height: 40px; }
  .proof-hint { font-size: 0.8rem; color: var(--color-muted); }
  .proof-reset { min-height: 40px; padding: 0 0.9rem; border-radius: 999px; border: 1px solid var(--sv-line); background: transparent; color: var(--color-text); font-size: 0.78rem !important; cursor: pointer; white-space: nowrap; }
  .proof-reset:hover { border-color: var(--sv-orange); }
  .proof-reset[hidden] { display: none; }

  /* read aloud */
  .read { display: flex; flex-direction: column; gap: 0.8rem; }
  .read-text { font-family: var(--font-display); font-size: clamp(1.3rem, 1.8vw, 1.5rem) !important; line-height: 1.45 !important; color: rgba(244, 242, 237, 0.92) !important; }
  /* the sentence starts out selected, the way you'd select it to hear it */
  .read:not(.playing) .read-text span { background: rgba(56, 189, 248, 0.16); border-radius: 0; box-decoration-break: clone; }
  .read-text span { border-radius: 4px; transition: color 0.2s ease, background 0.2s ease; }
  .read.playing .read-text span { color: rgba(244, 242, 237, 0.35); }
  .read.playing .read-text span.said { color: var(--color-text); }
  .read.playing .read-text span.now { color: #04131c; background: #38bdf8; box-shadow: 0 0 0 2px #38bdf8; }
  .read-row { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; }
  .read-play {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0 1.1rem 0 0.9rem;
    border-radius: 999px;
    border: 0;
    background: var(--sv-orange);
    color: #1a1200;
    font-weight: 600;
    font-size: 0.86rem !important;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .read-play:hover { background: #fb923c; }
  .read-play svg { width: 1rem; height: 1rem; fill: currentColor; }
  .read-play .i-pause, .read-play[aria-pressed="true"] .i-play { display: none; }
  .read-play[aria-pressed="true"] .i-pause { display: block; }
  /* the read-aloud pill turns sky blue in the app */
  .read-pill { display: flex; align-items: center; justify-content: center; gap: 3px; width: 64px; height: 26px; border-radius: 999px; background: #0e1116; border: 1px solid #262c3d; }
  .read-pill i { width: 3px; height: 5px; border-radius: 2px; background: #38bdf8; opacity: 0.45; transition: opacity 0.3s ease; }
  .read-pill i:nth-child(2), .read-pill i:nth-child(4) { height: 9px; }
  .read-pill i:nth-child(3) { height: 13px; }
  .read.playing .read-pill i { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .read.playing .read-pill i { animation: sv-pulse 0.7s ease-in-out infinite alternate; }
    .read.playing .read-pill i:nth-child(2) { animation-delay: -0.15s; }
    .read.playing .read-pill i:nth-child(3) { animation-delay: -0.3s; }
    .read.playing .read-pill i:nth-child(4) { animation-delay: -0.45s; }
    .read.playing .read-pill i:nth-child(5) { animation-delay: -0.6s; }
  }
  .read-note { font-size: 0.74rem !important; }

  /* progress */
  .pg { display: grid; grid-template-columns: minmax(6.5rem, auto) minmax(0, 1fr); gap: 1rem; align-items: stretch; }
  .pg-stats { display: flex; flex-direction: column; justify-content: space-between; gap: 0.7rem; padding-block: 0.2rem; }
  .pg-stats b { display: block; font-family: "Inter Tight", var(--font-sans); font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pg-stats span { display: block; font-size: 0.72rem; color: var(--color-muted); line-height: 1.3; }
  .pg-big b { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.7rem, 2.3vw, 2rem); line-height: 1; color: var(--sv-orange); letter-spacing: -0.02em; }
  .pg-big span { max-width: 7.5rem; margin-top: 0.3rem; }
  .pg-map { padding: 0.8rem 0.9rem 0.7rem; border-radius: 14px; background: #0b0e14; border: 1px solid #262c3d; font-family: var(--app-font); }
  .pg-k { display: block; margin-bottom: 0.5rem; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; color: #8b93a7; }
  .pg-grid { display: grid; grid-template-rows: repeat(7, 1fr); grid-auto-flow: column; gap: 3px; max-width: 14rem; }
  .pg-grid i { aspect-ratio: 1; border-radius: 2px; }
  .l0 { background: rgba(38, 44, 61, 0.6); }
  .l1 { background: rgba(249, 115, 22, 0.25); }
  .l2 { background: rgba(249, 115, 22, 0.45); }
  .l3 { background: rgba(249, 115, 22, 0.7); }
  .l4 { background: #f97316; }
  .pg-grid i.today { box-shadow: 0 0 0 1.5px #0b0e14, 0 0 0 3px rgba(249, 115, 22, 0.9); }
  .pg-grid i:hover { outline: 1.5px solid #e6e9f0; outline-offset: 1px; }
  .pg-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.3rem 0.6rem; margin-top: 0.6rem; font-size: 0.66rem; color: #8b93a7; }
  .pg-readout { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pg-legend { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
  .pg-legend i { width: 9px; height: 9px; border-radius: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .pg-grid i.today { animation: today 2.4s ease-in-out infinite; }
  }
  @keyframes today { 50% { box-shadow: 0 0 0 1.5px #0b0e14, 0 0 0 5px rgba(249, 115, 22, 0.35); } }

  /* ---- 6. open-source strip ---- */
  .card--oss { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; padding-block: 0.9rem; }
  .oss-t { display: flex; align-items: center; gap: 0.75rem; flex: 1 1 18rem; color: var(--color-muted) !important; font-size: 0.93rem !important; }
  .oss-t strong { color: var(--color-text); font-weight: 600; }
  .oss-t svg { flex: none; width: 1.3rem; height: 1.3rem; fill: var(--color-text); }
  .term { display: flex; align-items: center; gap: 0.6rem; flex: 0 1 auto; min-width: 0; padding: 0.25rem 0.3rem 0.25rem 0.9rem; border-radius: 12px; background: #0a0a0b; border: 1px solid rgba(244, 242, 237, 0.08); }
  .term code { min-width: 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text); overflow-wrap: anywhere; }
  .term-p { color: var(--sv-orange); }
  .term-copy { flex: none; min-height: 36px; padding: 0 0.85rem; border-radius: 8px; border: 1px solid var(--sv-line); background: rgba(244, 242, 237, 0.04); color: var(--color-text); font-size: 0.8rem !important; cursor: pointer; }
  .term-copy:hover { border-color: var(--sv-orange); }
  .term-copy.ok { color: #4ade80; border-color: #4ade80; }
  .oss-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(244, 242, 237, 0.25);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .oss-link:hover { background: var(--color-text); color: #0a0a0b; }

  /* touch: every control is at least 44px tall */
  @media (pointer: coarse) {
    .apps-tab, .apps-pause, .style, .wl, .ms-btn, .proof-reset, .term-copy { min-height: 44px; }
    .apps-pause { min-width: 44px; }
  }

  /* loops pause while the section is off screen or the tab is hidden */
  .svf.is-off :global(*) { animation-play-state: paused !important; }

  @media (max-width: 1100px) {
    .ms-name { flex-direction: column; align-items: stretch; gap: 0; }
    .term { order: 3; flex: 1 1 100%; justify-content: space-between; }
  }
  @media (max-width: 1000px) {
    .card--apps, .card--styles { grid-column: span 12; }
    .card--words, .card--models { grid-column: span 6; }
    .apps-screen { min-height: 13rem; }
  }
  @media (max-width: 860px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .card { grid-column: auto !important; }
    .card--more { grid-template-columns: minmax(0, 1fr); }
    .mini + .mini { border-left: 0; border-top: 1px solid var(--sv-line); }
    .mini > :last-child { margin-top: 0; }
  }
  @media (max-width: 680px) {
    .apps-screen { min-height: 15rem; }
    .apps-pause-t { display: none; }
    .apps-pause { padding-inline: 0; width: 44px; justify-content: center; }
    .apps-tab { padding-inline: 0.75rem; }
    .ms-row { grid-template-columns: auto minmax(0, 1fr) auto; }
    .ms-badge { display: none; }
    .ms-name { flex-direction: column; align-items: stretch; gap: 0; }
    .ms-name b, .ms-name small { white-space: normal; }
    .card--oss { flex-direction: column; align-items: stretch; padding-block: 1.2rem; }
    .oss-t { flex: none; }
    .oss-link { align-self: flex-start; }
  }
  @media (max-width: 420px) {
    .apps-tab { padding-inline: 0.6rem; font-size: 0.8rem !important; }
    .ms-logo { display: none; }
    .ms-row { grid-template-columns: minmax(0, 1fr) auto; }
    .term code { font-size: 0.74rem; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { Flip } from "gsap/Flip";
  gsap.registerPlugin(ScrollTrigger, Flip);

  const root = document.querySelector<HTMLElement>(".svf")!;
  const motion = matchMedia("(prefers-reduced-motion: no-preference)");
  const fine = matchMedia("(hover: hover)").matches;

  // run `on` while `el` is on screen, `off` when it leaves
  const whileVisible = (el: Element, on: () => void, off: () => void, threshold = 0.3) =>
    new IntersectionObserver(([e]) => (e.isIntersecting ? on() : off()), { threshold }).observe(el);

  // CSS loops (pill, caret, today's square) pause off screen and in a hidden tab
  let sectionOn = false;
  const syncOff = () => root.classList.toggle("is-off", !sectionOn || document.hidden);
  root.classList.add("is-off");
  whileVisible(root, () => { sectionOn = true; syncOff(); }, () => { sectionOn = false; syncOff(); }, 0);
  document.addEventListener("visibilitychange", syncOff);

  // ---- card entrance + spotlight -----------------------------------------
  const cards = [...root.querySelectorAll<HTMLElement>(".card")];
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const t = gsap.from(cards, {
      y: 40, opacity: 0, duration: 0.9, ease: "expo.out", stagger: 0.06,
      scrollTrigger: { trigger: root.querySelector(".bento"), start: "top 85%", once: true },
    });
    return () => t.revert();
  });
  if (fine) {
    root.addEventListener("pointermove", (e) => {
      cards.forEach((c) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty("--mx", `${e.clientX - r.left}px`);
        c.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }

  // ---- 1. any app: hold, speak, the pill works, the line is pasted --------
  {
    const box = root.querySelector<HTMLElement>("[data-apps]")!;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panes = [...box.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const pill = box.querySelector<HTMLElement>(".apps-pill")!;
    const pauseBtn = box.querySelector<HTMLButtonElement>(".apps-pause")!;
    const pauseT = pauseBtn.querySelector<HTMLElement>(".apps-pause-t")!;
    let cur = 0, timers: number[] = [], auto = motion.matches, visible = false;
    let tween: gsap.core.Tween | null = null;

    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const words = (i: number) => [...panes[i].querySelectorAll<HTMLElement>(".apps-typed .w")];
    // stop everything and leave the current pane finished
    const settle = () => {
      timers.forEach(clearTimeout); timers = [];
      tween?.kill(); tween = null;
      panes.forEach((_, i) => gsap.set(words(i), { clearProps: "opacity,transform,filter" }));
      pill.dataset.state = "idle";
    };
    const syncPause = () => {
      pauseBtn.dataset.state = auto ? "playing" : "paused";
      pauseBtn.setAttribute("aria-label", auto ? "Pause the demo" : "Play the demo");
      pauseT.textContent = auto ? "Pause" : "Play";
    };
    const run = () => {
      settle();
      if (!motion.matches || document.hidden) return;
      const w = words(cur);
      gsap.set(w, { opacity: 0 });
      later(() => (pill.dataset.state = "rec"), 250);
      later(() => (pill.dataset.state = "proc"), 1700);
      later(() => {
        pill.dataset.state = "done";
        // pasted in one go, like the app does
        tween = gsap.fromTo(w, { opacity: 0, y: 6, filter: "blur(4px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.45, ease: "expo.out", stagger: 0.02 });
      }, 2400);
      later(() => (pill.dataset.state = "idle"), 3100);
      later(() => { if (auto && visible) select((cur + 1) % panes.length); }, 5600);
    };
    const select = (i: number, focus = false) => {
      cur = i;
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panes.forEach((p, k) => p.classList.toggle("on", k === i));
      if (focus) tabs[i].focus();
      run();
    };
    const stopAuto = () => { auto = false; syncPause(); };

    tabs.forEach((t, i) => t.addEventListener("click", () => { stopAuto(); select(i); }));
    box.querySelector(".apps-tabs")!.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      const n = tabs.length;
      const to = k === "ArrowRight" ? (cur + 1) % n : k === "ArrowLeft" ? (cur + n - 1) % n : k === "Home" ? 0 : k === "End" ? n - 1 : -1;
      if (to < 0) return;
      e.preventDefault();
      stopAuto();
      select(to, true);
    });
    pauseBtn.addEventListener("click", () => {
      auto = !auto;
      syncPause();
      if (auto) select((cur + 1) % panes.length); else settle();
    });

    const applyMotion = () => {
      pauseBtn.hidden = !motion.matches;
      auto = motion.matches;
      syncPause();
      if (!motion.matches) settle();
      else if (visible) run();
    };
    motion.addEventListener("change", applyMotion);
    applyMotion();
    whileVisible(box, () => { visible = true; if (auto) run(); }, () => { visible = false; settle(); });
    // a hidden tab stops the loop; coming back picks it up again
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) settle();
      else if (visible && auto) run();
    });
  }

  // ---- 2. writing styles: a radio group that morphs the output ------------
  {
    const box = root.querySelector<HTMLElement>("[data-styles]")!;
    const chips = [...box.querySelectorAll<HTMLButtonElement>(".style")];
    const out = box.querySelector<HTMLElement>(".styles-out")!;
    const badge = box.querySelector<HTMLElement>("[data-styles-badge]")!;
    const select = (c: HTMLButtonElement, focus = false) => {
      chips.forEach((x) => { const on = x === c; x.setAttribute("aria-checked", String(on)); x.tabIndex = on ? 0 : -1; });
      if (focus) c.focus();
      const swap = () => {
        out.textContent = c.dataset.text!;
        out.classList.toggle("raw", c.dataset.ai === "0");
        badge.textContent = c.dataset.ai === "0" ? "No AI" : "Local AI";
      };
      if (!motion.matches) return swap();
      gsap.timeline()
        .to(out, { opacity: 0, filter: "blur(8px)", y: -6, duration: 0.2, ease: "power2.in", onComplete: swap })
        .to(out, { opacity: 1, filter: "blur(0px)", y: 0, duration: 0.5, ease: "expo.out", clearProps: "filter,transform" });
    };
    chips.forEach((c) => c.addEventListener("click", () => select(c)));
    box.querySelector(".styles-chips")!.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp"].includes(k)) return;
      e.preventDefault();
      const i = chips.findIndex((c) => c.getAttribute("aria-checked") === "true");
      select(chips[(i + (k === "ArrowRight" || k === "ArrowDown" ? 1 : chips.length - 1)) % chips.length], true);
    });
  }

  // ---- 3. your words: highlight one kind of fix; replay on first view -------
  {
    const box = root.querySelector<HTMLElement>("[data-words]")!;
    const chips = [...box.querySelectorAll<HTMLButtonElement>(".wl")];
    chips.forEach((c) =>
      c.addEventListener("click", () => {
        const on = c.getAttribute("aria-pressed") !== "true";
        chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c && on)));
        if (on) box.dataset.focus = c.dataset.cat; else delete box.dataset.focus;
      }),
    );
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      const said = [...box.querySelectorAll<HTMLElement>(".words-said .seg")];
      const typed = [...box.querySelectorAll<HTMLElement>(".words-typed .seg")];
      const tl = gsap.timeline({ scrollTrigger: { trigger: box, start: "top 80%", once: true } });
      tl.fromTo(said, { opacity: 0.15 }, { opacity: 1, duration: 0.25, stagger: 0.16, ease: "none", clearProps: "opacity" })
        .fromTo(typed, { opacity: 0, y: 5, filter: "blur(5px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.5, stagger: 0.12, ease: "expo.out", clearProps: "all" }, 0.5);
      return () => tl.revert();
    });
  }

  // ---- 4. Model Store: regroup the models for a kind of computer ------------
  {
    const box = root.querySelector<HTMLElement>("[data-ms]")!;
    const btns = [...box.querySelectorAll<HTMLButtonElement>(".ms-btn")];
    const rows = Object.fromEntries([...box.querySelectorAll<HTMLElement>(".ms-row")].map((r) => [r.dataset.model!, r]));
    const groups = Object.fromEntries([...box.querySelectorAll<HTMLElement>(".ms-group")].map((g) => [g.dataset.group!, g]));
    const read = box.querySelector<HTMLElement>("[data-ms-read]")!;
    type P = { cores: number; mem: number; gpu: boolean };
    const nav = navigator as Navigator & { deviceMemory?: number };
    const here: P = { cores: navigator.hardwareConcurrency || 4, mem: nav.deviceMemory || 8, gpu: false };
    const profiles: Record<string, P> = { old: { cores: 2, mem: 4, gpu: false }, this: here, gpu: { cores: 16, mem: 32, gpu: true } };
    // a rough version of the app's own rules
    const fit = (id: string, p: P) => {
      if (id === "moonshine") return "well";
      if (id === "parakeet") return p.cores >= 4 ? "well" : "slow";
      if (id === "turbo") return p.gpu ? "well" : p.cores >= 4 && p.mem >= 4 ? "slow" : "heavy";
      return p.gpu ? "well" : "heavy"; // Qwen3-ASR wants a strong graphics card
    };
    const order = ["moonshine", "parakeet", "turbo", "qwen"];
    const apply = (key: string, animate: boolean) => {
      const p = profiles[key];
      btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.profile === key)));
      const state = animate ? Flip.getState(Object.values(rows)) : null;
      const count: Record<string, number> = { well: 0, slow: 0, heavy: 0 };
      order.forEach((id) => {
        const g = fit(id, p);
        count[g]++;
        groups[g].querySelector("ul")!.appendChild(rows[id]);
      });
      Object.entries(groups).forEach(([g, el]) => {
        el.querySelector(".ms-n")!.textContent = String(count[g]);
        el.querySelector<HTMLElement>(".ms-empty")!.hidden = count[g] > 0;
      });
      // the app recommends Parakeet v2 on a 4+ core machine without a big graphics card
      rows.parakeet.querySelector<HTMLElement>(".ms-badge")!.hidden = !(p.cores >= 4 && !p.gpu);
      if (key === "this") {
        const mem = nav.deviceMemory ? (nav.deviceMemory >= 8 ? "8 GB or more of memory" : `about ${nav.deviceMemory} GB of memory`) : "memory it won't say";
        read.textContent = `Your browser reports ${navigator.hardwareConcurrency || "an unknown number of"} threads and ${mem}. It can't see your graphics card, so this is a rough guess. Nothing is sent.`;
      } else {
        read.textContent = key === "old" ? "An older laptop: 2 cores, 4 GB of memory, no graphics card." : "A desktop with a strong graphics card. The app turns on the graphics card by itself when it has 4 GB or more of its own memory.";
      }
      if (state) Flip.from(state, { duration: 0.6, ease: "power3.inOut", absolute: false, nested: true, simple: true });
    };
    btns.forEach((b) => b.addEventListener("click", () => apply(b.dataset.profile!, motion.matches)));
    apply("this", false);
  }

  // ---- 5a. proofreading: tap a marked word to fix it -------------------------
  {
    const wrap = root.querySelector<HTMLElement>(".proof-wrap")!;
    const typos = [...wrap.querySelectorAll<HTMLButtonElement>(".typo")];
    const reset = wrap.querySelector<HTMLButtonElement>(".proof-reset")!;
    const hint = wrap.querySelector<HTMLElement>(".proof-hint")!;
    const orig = typos.map((b) => ({ text: b.textContent!, label: b.getAttribute("aria-label")! }));
    const fix = (b: HTMLButtonElement) => {
      if (b.classList.contains("fixed")) return;
      b.textContent = b.dataset.fix!;
      b.classList.add("fixed");
      b.setAttribute("aria-label", `${b.dataset.fix}, fixed`);
      if (motion.matches) gsap.fromTo(b, { scale: 1.25 }, { scale: 1, duration: 0.6, ease: "elastic.out(1, 0.4)" });
      if (typos.every((t) => t.classList.contains("fixed"))) {
        hint.textContent = "All fixed.";
        reset.hidden = false;
      }
    };
    typos.forEach((b) => b.addEventListener("click", () => fix(b)));
    reset.addEventListener("click", () => {
      typos.forEach((b, i) => { b.textContent = orig[i].text; b.classList.remove("fixed"); b.setAttribute("aria-label", orig[i].label); });
      hint.textContent = "Tap a marked word to fix it.";
      reset.hidden = true;
      typos[0].focus();
    });
  }

  // ---- 5b. read aloud: the browser's own voice if it has one -----------------
  {
    const box = root.querySelector<HTMLElement>("[data-read]")!;
    const play = box.querySelector<HTMLButtonElement>(".read-play")!;
    const label = box.querySelector<HTMLElement>(".read-label")!;
    const note = box.querySelector<HTMLElement>(".read-note")!;
    const spans = [...box.querySelectorAll<HTMLElement>(".read-text span")];
    const synth = "speechSynthesis" in window && "SpeechSynthesisUtterance" in window ? window.speechSynthesis : null;
    const text = spans.map((s) => s.textContent).join("");
    // character offset where each word starts, to follow the voice's boundary events
    const starts: number[] = [];
    spans.reduce((pos, s) => { starts.push(pos); return pos + s.textContent!.length; }, 0);
    const idle = synth ? "Hear the example" : "Show the example";
    label.textContent = idle;
    note.hidden = !synth;

    let timer = 0, fallback = 0, playing = false, idx = -1;
    const mark = (i: number) => { idx = i; spans.forEach((s, k) => { s.classList.toggle("said", k < i); s.classList.toggle("now", k === i); }); };
    const stop = () => {
      playing = false;
      clearInterval(timer); clearTimeout(fallback); timer = fallback = 0;
      synth?.cancel();
      box.classList.remove("playing");
      play.setAttribute("aria-pressed", "false");
      label.textContent = idle;
      spans.forEach((s) => s.classList.remove("said", "now"));
    };
    // timed highlight, used with no voice or when the voice sends no word events
    const tick = (ms: number) => {
      clearInterval(timer);
      timer = window.setInterval(() => {
        if (idx + 1 >= spans.length) { clearInterval(timer); timer = 0; if (!synth || !speechSynthesis.speaking) setTimeout(() => playing && stop(), 600); return; }
        mark(idx + 1);
      }, ms);
    };
    play.addEventListener("click", () => {
      if (playing) return stop();
      playing = true;
      box.classList.add("playing");
      play.setAttribute("aria-pressed", "true");
      label.textContent = "Stop";
      mark(0);
      if (!synth) return tick(motion.matches ? 300 : 450);
      const u = new SpeechSynthesisUtterance(text);
      u.lang = "en-US";
      u.rate = 1;
      let gotBoundary = false;
      u.onboundary = (e) => {
        if (e.name && e.name !== "word") return;
        gotBoundary = true;
        clearInterval(timer);
        let i = starts.findIndex((s) => s > e.charIndex) - 1;
        if (i < 0) i = e.charIndex >= starts[starts.length - 1] ? spans.length - 1 : 0;
        mark(i);
      };
      u.onend = () => { if (playing) { mark(spans.length); setTimeout(() => playing && stop(), 700); } };
      u.onerror = () => { if (playing && !gotBoundary) tick(380); };
      fallback = window.setTimeout(() => { if (playing && !gotBoundary) tick(380); }, 700);
      synth.cancel();
      synth.speak(u);
    });
    // stop talking when the card leaves the screen or the tab is hidden
    whileVisible(box, () => {}, () => playing && stop(), 0);
    document.addEventListener("visibilitychange", () => document.hidden && playing && stop());
  }

  // ---- 5c. progress: the 12 weeks fill in, hover a day to read it ------------
  {
    const box = root.querySelector<HTMLElement>("[data-pg]")!;
    const cells = [...box.querySelectorAll<HTMLElement>(".pg-grid i")];
    const readout = box.querySelector<HTMLElement>("[data-pg-readout]")!;
    const base = readout.textContent!;
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      const t = gsap.from(cells, {
        scale: 0, opacity: 0, duration: 0.5, ease: "back.out(2)",
        stagger: { each: 0.01, from: "start" },
        scrollTrigger: { trigger: box, start: "top 85%", once: true },
      });
      return () => t.revert();
    });
    box.querySelector(".pg-grid")!.addEventListener("pointerover", (e) => {
      const c = e.target as HTMLElement;
      if (c.tagName !== "I") return;
      const w = Number(c.dataset.w);
      readout.textContent = `${c.dataset.d}${c.classList.contains("today") ? " (today)" : ""} · ${w ? `${w.toLocaleString("en-US")} words` : "no dictation"}`;
    });
    box.querySelector(".pg-grid")!.addEventListener("pointerleave", () => (readout.textContent = base));
  }

  // ---- 6. copy the clone command --------------------------------------------
  root.querySelector<HTMLButtonElement>(".term-copy")?.addEventListener("click", async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(b.dataset.copy!);
      b.textContent = "Copied";
      b.classList.add("ok");
    } catch {
      b.textContent = "Select it";
    }
    setTimeout(() => { b.textContent = "Copy"; b.classList.remove("ok"); }, 1800);
  });
</script>

---
// Feature bento. Every card shows its feature working instead of describing it.
import { siGithub } from "simple-icons";
import { REPO } from "../../scripts/sv-release";

const apps = ["Email", "Docs", "Chat", "Code"];
const modes = [
  { id: "raw", label: "As spoken", text: "um so can we move the call to thursday i think that works better for me" },
  { id: "clean", label: "Clean up", text: "Can we move the call to Thursday? I think that works better for me." },
  { id: "email", label: "Email", text: "Hi Sam, would it be possible to move our call to Thursday? That would work better for me. Thanks." },
  { id: "formal", label: "Formal", text: "Would you be open to moving our call to Thursday? It would suit my schedule better." },
];
const readWords = "Select any text, press Ctrl + Alt + S, and Silent Voice reads it out loud with a natural voice.".split(" ");
const clone = `git clone https://github.com/${REPO}`;
---

<section class="svf" id="features" aria-labelledby="svf-title">
  <div class="svf-head">
    <p class="sv-eyebrow">What it does</p>
    <h2 class="h2" id="svf-title">Talk instead of type. <em>Everywhere.</em></h2>
  </div>

  <div class="bento">
    <!-- 1. any app -->
    <article class="card card--apps">
      <div class="card-copy">
        <h3>Works in any app</h3>
        <p>Email, documents, chat, even your code editor. If you can type there, you can talk there.</p>
      </div>
      <div class="apps" data-apps>
        <div class="apps-tabs" role="tablist" aria-label="Example apps">
          {apps.map((a, i) => (
            <button type="button" role="tab" class="apps-tab" aria-selected={i === 0 ? "true" : "false"} data-i={i}>{a}</button>
          ))}
        </div>
        <div class="apps-screen" aria-hidden="true">
          <div class="apps-pane" data-kind="Email">
            <p class="apps-meta">To: Sam · Re: Thursday</p>
            <p class="apps-line" data-text="Thursday works for me. I'll send the notes before the call."></p>
          </div>
          <div class="apps-pane" data-kind="Docs">
            <p class="apps-meta apps-meta--doc">Plan for next week</p>
            <p class="apps-line" data-text="First, finish the new price list. Then call the three people who asked for a quote."></p>
          </div>
          <div class="apps-pane" data-kind="Chat">
            <p class="apps-bubble">Are we still on for lunch?</p>
            <p class="apps-line apps-line--me" data-text="Yes, see you at one. I'll be a few minutes late."></p>
          </div>
          <div class="apps-pane apps-pane--code" data-kind="Code">
            <p class="apps-code"><span class="c-k">function</span> <span class="c-f">total</span>(items) {"{"}</p>
            <p class="apps-line apps-line--code" data-text="// add up the prices and skip anything that's out of stock"></p>
            <p class="apps-code">{"}"}</p>
          </div>
          <span class="apps-pill"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
      </div>
    </article>

    <!-- 2. modes -->
    <article class="card card--modes">
      <div class="card-copy">
        <h3>Say it once, shape it after</h3>
        <p>Pick a mode and a local AI tidies what you said. Tap one.</p>
      </div>
      <div class="modes" data-modes>
        <div class="modes-chips" role="radiogroup" aria-label="Writing mode">
          {modes.map((m, i) => (
            <button type="button" role="radio" class="mode" aria-checked={i === 1 ? "true" : "false"} data-text={m.text}>{m.label}</button>
          ))}
        </div>
        <p class="modes-out" aria-live="polite">{modes[1].text}</p>
      </div>
    </article>

    <!-- 3. proofreading -->
    <article class="card card--proof">
      <div class="card-copy">
        <h3>Catches typos as you type</h3>
        <p>Spelling and grammar marks show up in any app. Tap a marked word to fix it.</p>
      </div>
      <p class="proof" data-proof>
        I{" "}<button type="button" class="typo" data-fix="received">recieved</button>{" "}your message and{" "}
        <button type="button" class="typo" data-fix="will">wil</button>{" "}reply{" "}
        <button type="button" class="typo" data-fix="tomorrow">tomorow</button>{" "}morning.
      </p>
    </article>

    <!-- 4. read aloud -->
    <article class="card card--read">
      <div class="card-copy">
        <h3>Reads text out loud</h3>
        <p>The other direction. Natural voices that also run on your computer.</p>
      </div>
      <div class="read" data-read>
        <button type="button" class="read-play" aria-label="Play the example" aria-pressed="false">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        </button>
        <p class="read-text">{readWords.map((w) => <span>{w} </span>)}</p>
      </div>
    </article>

    <!-- 5. your hardware -->
    <article class="card card--hw">
      <div class="card-copy">
        <h3>Fits your computer</h3>
        <p>It checks your hardware and suggests a speech model that runs well on it.</p>
      </div>
      <dl class="hw" data-hw>
        <div><dt>Processor</dt><dd data-hw-cpu>Checking</dd><span class="hw-bar"><i data-hw-cpu-bar></i></span></div>
        <div><dt>Memory</dt><dd data-hw-mem>Checking</dd><span class="hw-bar"><i data-hw-mem-bar></i></span></div>
        <p class="hw-note">Read from this browser, the way the app reads your PC. Nothing is sent.</p>
      </dl>
    </article>

    <!-- 6. open source -->
    <article class="card card--oss">
      <div class="oss-copy">
        <h3>Free and open source</h3>
        <p>MIT licensed. Every line is on GitHub to read, check and build yourself. No trial, no paid tier, no catch.</p>
        <a class="oss-link" href={`https://github.com/${REPO}`} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
          View the code
        </a>
      </div>
      <div class="term">
        <div class="term-bar"><span class="dots"><i></i><i></i><i></i></span><span>Terminal</span></div>
        <div class="term-body">
          <code><span class="term-p">$</span> {clone}</code>
          <button type="button" class="term-copy" data-copy={clone}>Copy</button>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .svf { padding: clamp(6rem, 12vw, 10rem) 1.25rem; max-width: 78rem; margin: 0 auto; }
  .svf-head { text-align: center; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .svf-head .h2 { margin-top: 0.9rem; font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1.02; }
  .svf-head em { color: var(--sv-orange); }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
    --mx: -400px;
    --my: -400px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border-radius: 22px;
    background: #111114;
    overflow: hidden;
  }
  /* spotlight border + glow that follows the pointer */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background:
      radial-gradient(380px circle at var(--mx) var(--my), rgba(249, 115, 22, 0.75), transparent 45%),
      var(--sv-line);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(500px circle at var(--mx) var(--my), rgba(249, 115, 22, 0.08), transparent 50%);
  }
  .card h3 { margin: 0 0 0.45rem; font-family: "Inter Tight", var(--font-sans); font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; }
  .card p { margin: 0; color: var(--color-muted); font-size: 0.96rem; line-height: 1.55; }

  .card--apps { grid-column: span 4; }
  .card--modes { grid-column: span 2; }
  .card--proof, .card--read, .card--hw { grid-column: span 2; }
  .card--oss { grid-column: span 6; flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; }

  /* ---- apps ---- */
  .apps { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; }
  .apps-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .apps-tab {
    min-height: 36px;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .apps-tab:hover { color: var(--color-text); }
  .apps-tab[aria-selected="true"] { background: var(--color-text); color: #0a0a0b; border-color: var(--color-text); }
  .apps-screen {
    position: relative;
    flex: 1;
    min-height: 12rem;
    border-radius: 14px;
    background: #0a0a0b;
    border: 1px solid rgba(244, 242, 237, 0.07);
    overflow: hidden;
  }
  .apps-pane {
    position: absolute;
    inset: 0;
    padding: 1.3rem 1.4rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(.22, 1, .36, 1);
  }
  .apps-pane.on { opacity: 1; transform: none; }
  .apps-meta { font-size: 0.8rem !important; padding-bottom: 0.7rem; margin-bottom: 0.9rem !important; border-bottom: 1px solid rgba(244, 242, 237, 0.07); }
  .apps-meta--doc { font-family: var(--font-display); font-size: 1.5rem !important; color: var(--color-text) !important; border: 0; padding: 0; }
  .apps-line { color: var(--color-text) !important; font-size: 1.05rem !important; min-height: 1.6em; }
  .apps-line::after { content: ""; display: inline-block; width: 2px; height: 1.1em; margin-left: 2px; vertical-align: -0.15em; background: var(--sv-orange); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .apps-bubble { display: inline-block; padding: 0.5rem 0.9rem; border-radius: 14px 14px 14px 4px; background: #1f1f24; color: var(--color-text) !important; font-size: 0.92rem !important; margin-bottom: 0.8rem !important; }
  .apps-line--me { margin-left: auto !important; width: fit-content; max-width: 85%; padding: 0.5rem 0.9rem; border-radius: 14px 14px 4px 14px; background: var(--sv-orange); color: #140a02 !important; font-size: 0.92rem !important; }
  .apps-line--me::after { background: #140a02; }
  .apps-pane--code { font-family: var(--font-mono); }
  .apps-code { font-family: var(--font-mono); font-size: 0.85rem !important; color: var(--color-text) !important; }
  .apps-line--code { font-family: var(--font-mono); font-size: 0.85rem !important; color: #8b8a85 !important; padding-left: 1.5rem; margin: 0.3rem 0 !important; }
  .c-k { color: #c084fc; }
  .c-f { color: #fdba74; }
  .apps-pill {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 3px;
    height: 30px;
    padding: 0 0.8rem;
    border-radius: 999px;
    background: rgba(249, 115, 22, 0.14);
    border: 1px solid rgba(249, 115, 22, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .apps-screen.talking .apps-pill { opacity: 1; }
  .apps-pill i { width: 3px; height: 6px; border-radius: 2px; background: var(--sv-orange); animation: eq 0.7s ease-in-out infinite alternate; }
  .apps-pill i:nth-child(2) { animation-delay: -0.2s; }
  .apps-pill i:nth-child(3) { animation-delay: -0.5s; background: #fff; }
  .apps-pill i:nth-child(4) { animation-delay: -0.1s; }
  .apps-pill i:nth-child(5) { animation-delay: -0.35s; }
  @keyframes eq { to { height: 18px; } }

  /* ---- modes ---- */
  .modes { display: flex; flex-direction: column; gap: 1rem; flex: 1; }
  .modes-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .mode {
    min-height: 36px;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .mode:hover { color: var(--color-text); border-color: rgba(249, 115, 22, 0.5); }
  .mode[aria-checked="true"] { background: var(--sv-orange); border-color: var(--sv-orange); color: #140a02; font-weight: 600; }
  .modes-out {
    flex: 1;
    min-height: 8.5rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: #0a0a0b;
    border: 1px solid rgba(244, 242, 237, 0.07);
    color: var(--color-text) !important;
    font-family: var(--font-display);
    font-size: 1.3rem !important;
    line-height: 1.35 !important;
  }
  .modes-out.raw { font-family: var(--font-mono); font-size: 0.92rem !important; line-height: 1.6 !important; color: var(--color-muted) !important; }

  /* ---- proofreading ---- */
  .proof { font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 1.9rem) !important; line-height: 1.45 !important; color: var(--color-text) !important; }
  .typo {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline wavy #ef4444;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    transition: color 0.3s ease, text-decoration-color 0.4s ease;
  }
  .typo:hover { color: #fca5a5; }
  .typo::after {
    content: attr(data-fix);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    translate: -50% 4px;
    padding: 0.2rem 0.6rem;
    border-radius: 8px;
    background: var(--color-text);
    color: #0a0a0b;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, translate 0.2s ease;
  }
  .typo:hover::after, .typo:focus-visible::after { opacity: 1; translate: -50% 0; }
  .typo.fixed { text-decoration-color: transparent; color: var(--sv-orange); cursor: default; }
  .typo.fixed::after { display: none; }

  /* ---- read aloud ---- */
  .read { display: flex; gap: 1rem; align-items: flex-start; }
  .read-play {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 0;
    background: var(--sv-orange);
    color: #140a02;
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .read-play:hover { transform: scale(1.06); }
  .read-play svg { width: 1.2rem; height: 1.2rem; fill: currentColor; }
  .read-play .i-pause, .read-play[aria-pressed="true"] .i-play { display: none; }
  .read-play[aria-pressed="true"] .i-pause { display: block; }
  .read-text { font-size: 1.05rem !important; line-height: 1.6 !important; color: rgba(244, 242, 237, 0.45) !important; }
  .read-text span { transition: color 0.2s ease, background 0.2s ease; border-radius: 4px; }
  .read-text span.said { color: var(--color-text); }
  .read-text span.now { color: #140a02; background: var(--sv-orange); box-shadow: 0 0 0 2px var(--sv-orange); }

  /* ---- hardware ---- */
  .hw { margin: 0; display: grid; gap: 1rem; }
  .hw > div { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1rem; align-items: baseline; }
  .hw dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
  .hw dd { margin: 0; text-align: right; font-weight: 600; font-size: 0.95rem; }
  .hw-bar { grid-column: 1 / -1; height: 6px; border-radius: 999px; background: rgba(244, 242, 237, 0.08); overflow: hidden; }
  .hw-bar i { display: block; height: 100%; width: var(--w, 0%); border-radius: inherit; background: linear-gradient(90deg, #c2410c, var(--sv-orange), #fdba74); transition: width 1.4s cubic-bezier(.22, 1, .36, 1); }
  .hw-note { font-size: 0.78rem !important; }

  /* ---- open source ---- */
  .oss-copy { max-width: 30rem; }
  .oss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.2rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(244, 242, 237, 0.25);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .oss-link:hover { background: var(--color-text); color: #0a0a0b; }
  .oss-link svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  .term { flex: 1; max-width: 34rem; border-radius: 14px; background: #0a0a0b; border: 1px solid rgba(244, 242, 237, 0.08); overflow: hidden; }
  .term-bar { display: flex; align-items: center; gap: 0.8rem; padding: 0.6rem 0.9rem; border-bottom: 1px solid rgba(244, 242, 237, 0.06); font-size: 0.75rem; color: var(--color-muted); }
  .dots { display: flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: #2a2a30; }
  .term-body { display: flex; align-items: center; gap: 1rem; padding: 1rem 0.9rem 1rem 1.1rem; }
  .term-body code { flex: 1; font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-text); overflow-wrap: anywhere; }
  .term-p { color: var(--sv-orange); }
  .term-copy {
    flex: none;
    min-height: 34px;
    padding: 0 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--sv-line);
    background: rgba(244, 242, 237, 0.04);
    color: var(--color-text);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .term-copy:hover { border-color: var(--sv-orange); }
  .term-copy.ok { color: #4ade80; border-color: #4ade80; }

  @media (max-width: 1000px) {
    .card--apps, .card--modes { grid-column: span 6; }
    .card--proof, .card--read { grid-column: span 3; }
    .card--hw { grid-column: span 6; }
  }
  @media (max-width: 680px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .card--apps, .card--modes, .card--proof, .card--read, .card--hw, .card--oss { grid-column: auto; }
    .card--oss { flex-direction: column; align-items: stretch; }
    .apps-screen { min-height: 13.5rem; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>(".svf")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(hover: hover)").matches;

  // run `fn` while `el` is on screen, stop it when it leaves
  const whileVisible = (el: Element, on: () => void, off: () => void) =>
    new IntersectionObserver(([e]) => (e.isIntersecting ? on() : off()), { threshold: 0.25 }).observe(el);

  // ---- card entrance + spotlight -----------------------------------------
  const cards = [...root.querySelectorAll<HTMLElement>(".card")];
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const t = gsap.from(cards, {
      y: 60, opacity: 0, rotateX: -8, transformPerspective: 1000, duration: 1.1, ease: "expo.out", stagger: 0.08,
      scrollTrigger: { trigger: root.querySelector(".bento"), start: "top 82%", once: true },
    });
    return () => t.revert();
  });
  if (fine) {
    root.addEventListener("pointermove", (e) => {
      cards.forEach((c) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty("--mx", `${e.clientX - r.left}px`);
        c.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }

  // ---- 1. any app: types a line into each app in turn ---------------------
  {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(".apps-tab")];
    const panes = [...root.querySelectorAll<HTMLElement>(".apps-pane")];
    const screen = root.querySelector<HTMLElement>(".apps-screen")!;
    let cur = 0, timer = 0, typing = 0, running = false;

    const show = (i: number, auto: boolean) => {
      clearTimeout(timer); clearInterval(typing);
      cur = i;
      tabs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
      panes.forEach((p, k) => p.classList.toggle("on", k === i));
      const line = panes[i].querySelector<HTMLElement>(".apps-line")!;
      const text = line.dataset.text!;
      if (still) { line.textContent = text; return; }
      line.textContent = "";
      screen.classList.add("talking");
      timer = window.setTimeout(() => {
        screen.classList.remove("talking");
        const words = text.split(" ");
        let k = 0;
        typing = window.setInterval(() => {
          line.textContent = words.slice(0, ++k).join(" ");
          if (k >= words.length) {
            clearInterval(typing);
            if (auto && running) timer = window.setTimeout(() => show((cur + 1) % panes.length, true), 2200);
          }
        }, 55);
      }, 1100);
    };
    tabs.forEach((t, i) => t.addEventListener("click", () => { running = false; show(i, false); }));
    show(0, false);
    if (still) panes.forEach((p) => (p.querySelector<HTMLElement>(".apps-line")!.textContent = p.querySelector<HTMLElement>(".apps-line")!.dataset.text!));
    else whileVisible(screen, () => { if (!running) { running = true; show(cur, true); } }, () => { running = false; });
  }

  // ---- 2. modes: morph the text --------------------------------------------
  {
    const chips = [...root.querySelectorAll<HTMLButtonElement>(".mode")];
    const out = root.querySelector<HTMLElement>(".modes-out")!;
    const select = (c: HTMLButtonElement) => {
      chips.forEach((x) => x.setAttribute("aria-checked", String(x === c)));
      const swap = () => { out.textContent = c.dataset.text!; out.classList.toggle("raw", c === chips[0]); };
      if (still) return swap();
      gsap.timeline()
        .to(out, { opacity: 0, filter: "blur(8px)", y: -6, duration: 0.22, ease: "power2.in", onComplete: swap })
        .to(out, { opacity: 1, filter: "blur(0px)", y: 0, duration: 0.5, ease: "expo.out" });
    };
    chips.forEach((c) => c.addEventListener("click", () => select(c)));
    // arrow keys move through the radio group
    root.querySelector(".modes-chips")!.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp"].includes(k)) return;
      e.preventDefault();
      const i = chips.findIndex((c) => c.getAttribute("aria-checked") === "true");
      const n = chips[(i + (k === "ArrowRight" || k === "ArrowDown" ? 1 : chips.length - 1)) % chips.length];
      select(n); n.focus();
    });
  }

  // ---- 3. proofreading -------------------------------------------------------
  root.querySelectorAll<HTMLButtonElement>(".typo").forEach((b) =>
    b.addEventListener("click", () => {
      if (b.classList.contains("fixed")) return;
      b.textContent = b.dataset.fix!;
      b.classList.add("fixed");
      b.setAttribute("aria-label", `${b.dataset.fix}, fixed`);
      if (!still) gsap.fromTo(b, { scale: 1.25 }, { scale: 1, duration: 0.6, ease: "elastic.out(1, 0.4)" });
    }),
  );

  // ---- 4. read aloud: karaoke highlight ------------------------------------
  {
    const play = root.querySelector<HTMLButtonElement>(".read-play")!;
    const spans = [...root.querySelectorAll<HTMLElement>(".read-text span")];
    let i = 0, timer = 0;
    const stop = () => { clearInterval(timer); timer = 0; play.setAttribute("aria-pressed", "false"); };
    const tick = () => {
      spans.forEach((s, k) => { s.classList.toggle("said", k < i); s.classList.toggle("now", k === i); });
      i++;
      if (i > spans.length) { stop(); i = 0; setTimeout(() => spans.forEach((s) => s.classList.remove("said", "now")), 1200); }
    };
    play.addEventListener("click", () => {
      if (timer) return stop();
      play.setAttribute("aria-pressed", "true");
      tick();
      timer = window.setInterval(tick, still ? 120 : 260);
    });
  }

  // ---- 5. hardware: this browser's cores and memory --------------------------
  {
    const cores = navigator.hardwareConcurrency || 0;
    const mem = (navigator as Navigator & { deviceMemory?: number }).deviceMemory;
    const cpu = root.querySelector<HTMLElement>("[data-hw-cpu]")!;
    const memEl = root.querySelector<HTMLElement>("[data-hw-mem]")!;
    const cpuBar = root.querySelector<HTMLElement>("[data-hw-cpu-bar]")!;
    const memBar = root.querySelector<HTMLElement>("[data-hw-mem-bar]")!;
    const fill = () => {
      cpu.textContent = cores ? `${cores} threads` : "Not shared";
      // browsers round memory and cap it at 8 GB
      memEl.textContent = mem ? (mem >= 8 ? "8 GB or more" : `About ${mem} GB`) : "Not shared by this browser";
      cpuBar.style.setProperty("--w", `${Math.min(100, (cores / 16) * 100) || 8}%`);
      memBar.style.setProperty("--w", `${mem ? Math.min(100, (mem / 8) * 100) : 8}%`);
    };
    new IntersectionObserver(([e], io) => { if (e.isIntersecting) { io.disconnect(); setTimeout(fill, still ? 0 : 300); } }, { threshold: 0.4 })
      .observe(root.querySelector(".hw")!);
  }

  // ---- 6. copy the clone command --------------------------------------------
  root.querySelector<HTMLButtonElement>(".term-copy")?.addEventListener("click", async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(b.dataset.copy!);
      b.textContent = "Copied";
      b.classList.add("ok");
    } catch {
      b.textContent = "Select it above";
    }
    setTimeout(() => { b.textContent = "Copy"; b.classList.remove("ok"); }, 1800);
  });
</script>

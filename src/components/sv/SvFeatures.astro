---
// Features (v0.2.0). Three cards that show their feature working (writing
// styles, your words, the Model Store), then a plain "Also in the box" list
// with one line per tool and no widgets. Base markup is the finished frame;
// scripts only add motion and the controls.

// writing styles: the app's own preview sample, run through six of the nine
// built-in styles, in the app's order (src/services/modes.ts)
const sample = "um so i think we should like push the release to friday you know cause the uh login thing is still broken";
const styles = [
  { id: "raw", label: "Raw Transcription", ai: false, text: "So I think we should like push the release to Friday, you know, cause the login thing is still broken." },
  { id: "clean", label: "Clean Up", ai: true, text: "So I think we should push the release to Friday, because the login thing is still broken." },
  { id: "formal", label: "Formal", ai: true, text: "I recommend moving the release to Friday, as the login issue has not been resolved yet." },
  { id: "casual", label: "Casual", ai: true, text: "Let's push the release to Friday. The login thing is still broken." },
  { id: "email", label: "Email", ai: true, text: "Hi team,\nI think we should move the release to Friday, since the login issue is still broken.\nThanks" },
  { id: "translate", label: "Translate (Spanish)", ai: true, text: "Creo que deberíamos pasar el lanzamiento al viernes, porque el inicio de sesión sigue fallando." },
];
const startStyle = 1;

// Model Store: real catalogue rows (src/services/catalog.ts). The base frame is
// an 8-thread laptop with no graphics card; the script regroups for a profile.
const models = [
  { id: "tiny", name: "Tiny", lang: "English", by: "OpenAI", size: "75 MB", note: "" },
  { id: "parakeet", name: "Parakeet TDT 0.6B v2", lang: "English", by: "NVIDIA", size: "640 MB", note: "" },
  { id: "distil", name: "Distil Large v3.5", lang: "English", by: "Hugging Face", size: "756 MB", note: "" },
  { id: "turbo", name: "Large v3 Turbo", lang: "Multilingual", by: "OpenAI", size: "1.6 GB", note: "" },
  { id: "qwen", name: "Qwen3-ASR 1.7B", lang: "52 languages", by: "Qwen", size: "2.4 GB", note: "Needs a strong graphics card" },
];
const groups = [
  { id: "well", label: "Runs well", start: ["tiny", "parakeet"] },
  { id: "slow", label: "Runs, but may be slow", start: ["distil", "turbo"] },
  { id: "heavy", label: "Too heavy", start: ["qwen"] },
];
const byId = Object.fromEntries(models.map((m) => [m.id, m]));

// your words, shortcuts and spoken formatting
type Seg = { say: string; type: string; cat?: "words" | "short" | "format" | "filler"; br?: boolean };
const segs: Seg[] = [
  { say: "um", type: "", cat: "filler" },
  { say: "quad code", type: "Claude Code", cat: "words" },
  { say: "cut the build time by", type: "cut the build time by" },
  { say: "twenty five percent", type: "25%.", cat: "format" },
  { say: "new line", type: "", cat: "format", br: true },
  { say: "the details are on", type: "The details are on" },
  { say: "google dot com", type: "google.com.", cat: "format" },
  { say: "uh", type: "", cat: "filler" },
  { say: "send questions to", type: "Send questions to" },
  { say: "my email", type: "you@example.com", cat: "short" },
];
const cats = [
  { id: "words", label: "Your words" },
  { id: "short", label: "Shortcuts" },
  { id: "format", label: "Formatting" },
  { id: "filler", label: "Fillers dropped" },
];

// also in the box: one line each, no widgets
const box = [
  { t: "Works in any app", d: "Email, docs, chat, code: if you can type there, you can talk there.", i: "M3.5 5.5h17v13h-17zM3.5 9h17M12 11.5v4.5M10.5 11.5h3M10.5 16h3" },
  { t: "Catches typos where you type", d: "Optional spelling and grammar underlines in your other apps. English only.", i: "M5 7h14M5 11h9M4 17c1.4-1.6 2.8-1.6 4.2 0s2.8 1.6 4.2 0 2.8-1.6 4.2 0 2.8 1.6 3.4 0.6" },
  { t: "Reads text out loud", d: "Select text and press Ctrl + Alt + S. Natural voices that run on your computer.", i: "M4 9.5h3.5L12 5.5v13l-4.5-4H4zM15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" },
  { t: "Watch the minutes add up", d: "Time saved against typing, speaking speed and streaks, worked out on your computer.", i: "M5 20v-6M12 20V8M19 20V4" },
  { t: "History, with the audio", d: "Search, edit and replay what you said. Fixing a word teaches it.", i: "M12 7.5V12l3 2M21 12a9 9 0 1 1-9-9 9 9 0 0 1 9 9z" },
  { t: "Your own cloud key, if you want", d: "OpenAI, Anthropic, Gemini, Groq and more. Off until you add one.", i: "M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.2 4.5 4.5 0 0 0 7 18Z" },
];
---

<section class="svf" id="features" aria-labelledby="svf-title">
  <div class="svf-head">
    <div class="svf-head-t">
      <p class="sv-eyebrow">What it does</p>
      <h2 class="h2" id="svf-title">The tools around <em>the words.</em></h2>
    </div>
    <p class="svf-lead">Reshape what you said, teach it your words, and get a model that fits your computer. All on your computer by default.</p>
  </div>

  <div class="bento">
    <!-- 1. writing styles ---------------------------------------------------->
    <article class="card card--styles">
      <div class="card-copy">
        <h3>Say it once, shape it after</h3>
        <p>A local AI rewrites it for the job, or a cloud model with your key.</p>
      </div>
      <div class="styles" data-styles>
        <div class="styles-chips" role="radiogroup" aria-label="Writing style">
          {styles.map((s, i) => (
            <button type="button" role="radio" class="style" aria-checked={i === startStyle ? "true" : "false"} tabindex={i === startStyle ? 0 : -1} data-text={s.text} data-ai={s.ai ? "1" : "0"}>
              {s.label}{i === 0 && <span class="style-def"> (default)</span>}
            </button>
          ))}
          <span class="styles-more">plus 3 more, and your own</span>
        </div>
        <div class="styles-box">
          <p class="styles-said"><span class="styles-k">You said</span>{sample.split(" ").map((w, i) => <Fragment>{i > 0 && " "}{["um", "uh"].includes(w) ? <s>{w}</s> : w}</Fragment>)}</p>
          <div class="styles-outwrap">
            <span class="styles-k"><span data-styles-name>{styles[startStyle].label}</span> · <span data-styles-badge>Local AI</span></span>
            <p class="styles-out" aria-live="polite">{styles[startStyle].text}</p>
          </div>
        </div>
      </div>
    </article>

    <!-- 2. your words + spoken formatting ------------------------------------>
    <article class="card card--words">
      <div class="card-copy">
        <h3>Gets your words right</h3>
        <p>Teach it names and jargon. Say “my email” and it types your address.</p>
      </div>
      <div class="words" data-words>
        <div class="words-legend" role="group" aria-label="Highlight one kind of fix">
          {cats.map((c) => <button type="button" class:list={["wl", `c-${c.id}`]} aria-pressed="false" data-cat={c.id}><i aria-hidden="true"></i>{c.label}</button>)}
        </div>
        <div class="words-lines">
          <p class="words-said"><span class="words-k">You say</span>
            {segs.map((s, i) => <Fragment>{i > 0 && " "}<span class:list={["seg", s.cat && `c-${s.cat}`]} data-cat={s.cat}>{s.say}</span></Fragment>)}
          </p>
          <p class="words-typed"><span class="words-k">It types</span>
            {segs.filter((s) => s.br || s.type).map((s, i) =>
              s.br ? <Fragment> <span class="seg seg-br c-format" data-cat="format"><span aria-hidden="true">↵</span></span><br /></Fragment>
              : <Fragment>{i > 0 && " "}<span class:list={["seg", s.cat && `c-${s.cat}`]} data-cat={s.cat}>{s.type}</span></Fragment>,
            )}
          </p>
        </div>
      </div>
    </article>

    <!-- 3. Model Store -------------------------------------------------------->
    <article class="card card--models">
      <div class="card-copy">
        <h3>Picks a model that fits your computer</h3>
        <p>22 voice models, grouped by how well they run, with one picked for you.</p>
      </div>
      <div class="ms" data-ms>
        <div class="ms-pick" role="group" aria-label="Show the grouping for">
          <button type="button" class="ms-btn" aria-pressed="false" data-profile="old">Older laptop</button>
          <button type="button" class="ms-btn" aria-pressed="true" data-profile="this"><span data-ms-this>Typical laptop</span></button>
          <button type="button" class="ms-btn" aria-pressed="false" data-profile="gpu">Gaming PC</button>
        </div>
        <div class="ms-app">
          {groups.map((g) => (
            <section class="ms-group" data-group={g.id} aria-label={g.label}>
              <h4 class="ms-h">{g.label} <span class="ms-n">{g.start.length}</span></h4>
              <ul class="ms-list">
                {g.start.map((id) => {
                  const m = byId[id];
                  return (
                    <li class="ms-row" data-model={m.id}>
                      <span class="ms-logo" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 6.5v3M6.5 4v8M10 5.5v5M13.5 7v2" /></svg></span>
                      <span class="ms-name">
                        <b>{m.name}</b>
                        <small>{m.lang}{m.note ? <span class="ms-note"> · {m.note}</span> : ` · ${m.by}`}</small>
                      </span>
                      <span class="ms-size">{m.size}</span>
                      <span class="ms-badge" hidden={m.id !== "parakeet"}>Recommended</span>
                    </li>
                  );
                })}
              </ul>
              <p class="ms-empty" hidden={g.start.length > 0}>None</p>
            </section>
          ))}
        </div>
        <p class="ms-read" data-ms-read>The app reads your processor, memory and graphics card. This shows a typical laptop with no graphics card.</p>
      </div>
    </article>

    <!-- also in the box: a plain list --------------------------------------->
    <div class="card card--box">
      <h3 class="box-h">Also in the box</h3>
      <ul class="box">
        {box.map((b) => (
          <li>
            <span class="box-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={b.i} /></svg></span>
            <span class="box-t"><b>{b.t}</b>{b.d}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .svf {
    --app-font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --c-words: #fb923c;
    --c-short: #2dd4bf;
    --c-format: #38bdf8;
    /* the page container: --sv-max of content inside the --sv-gutter */
    max-width: calc(var(--sv-max) + 2 * var(--sv-gutter));
    margin: 0 auto;
    /* padding comes from the page (--sv-space / --sv-gutter) */
  }
  /* heading left, lead beside it on wide screens: same left edge as every section */
  .svf-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); align-items: end; gap: 1rem 3rem; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .svf-head .h2 { margin: 0.9rem 0 0; font-size: clamp(2.3rem, 5.2vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; text-wrap: balance; }
  .svf-head em { color: var(--sv-orange); }
  .svf-lead { margin: 0; max-width: 40rem; color: var(--color-muted); font-size: 1.05rem; line-height: 1.55; text-wrap: pretty; }

  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .card {
    --mx: -400px;
    --my: -400px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.2rem, 2vw, 1.45rem);
    border-radius: 22px;
    background: rgba(17, 17, 20, 0.8);
    overflow: hidden;
  }
  /* spotlight border + glow that follows the pointer */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(380px circle at var(--mx) var(--my), rgba(249, 115, 22, 0.75), transparent 45%), var(--sv-line);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(500px circle at var(--mx) var(--my), rgba(249, 115, 22, 0.07), transparent 50%);
    pointer-events: none;
  }
  .card h3 { margin: 0 0 0.4rem; font-family: "Inter Tight", var(--font-sans); font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; text-wrap: balance; }
  .card p { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; }
  .card button { font: inherit; }
  /* the copy block is the same height in every card, so the demos share a top line */
  .card-copy { min-height: 4.6rem; }
  .card--box { grid-column: 1 / -1; }

  :global(html:not(.js)) .svf :is(.styles-chips, .words-legend, .ms-pick) { display: none; }

  /* ---- writing styles ---- */
  .styles { display: flex; flex-direction: column; gap: 0.9rem; flex: 1; }
  .styles-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .style {
    min-height: 36px;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .style:hover { color: var(--color-text); border-color: rgba(249, 115, 22, 0.5); }
  .style[aria-checked="true"] { background: var(--sv-orange); border-color: var(--sv-orange); color: #1a1200; font-weight: 600; }
  .style-def { opacity: 0.8; font-weight: 400; }
  .styles-more { display: inline-flex; align-items: center; min-height: 36px; padding: 0 0.3rem; font-size: 0.8rem; color: var(--color-muted); }
  .styles-box { flex: 1; display: flex; flex-direction: column; border-radius: 14px; background: #0a0a0b; border: 1px solid rgba(244, 242, 237, 0.07); overflow: hidden; }
  .styles-k { display: block; margin-bottom: 0.3rem; font-family: var(--font-sans); font-size: 0.75rem; color: var(--color-muted); }
  .styles-said { padding: 0.8rem 1rem; border-bottom: 1px dashed rgba(244, 242, 237, 0.1); font-family: var(--font-mono); font-size: 0.78rem !important; line-height: 1.55 !important; }
  .styles-said s { color: rgba(244, 242, 237, 0.5); text-decoration-color: rgba(249, 115, 22, 0.8); }
  .styles-outwrap { flex: 1; padding: 0.8rem 1rem 1rem; min-height: 7.5rem; }
  .styles-out { color: var(--color-text) !important; font-family: var(--app-font); font-size: 1rem !important; line-height: 1.55 !important; white-space: pre-line; }
  .styles-out.raw { color: rgba(244, 242, 237, 0.82) !important; }

  /* ---- words ---- */
  .words { display: flex; flex-direction: column; gap: 0.9rem; flex: 1; }
  .words-lines { flex: 1; display: flex; flex-direction: column; border-radius: 14px; background: #0a0a0b; border: 1px solid rgba(244, 242, 237, 0.07); }
  .words-k { display: block; margin-bottom: 0.3rem; font-family: var(--font-sans); font-size: 0.75rem; color: var(--color-muted); }
  .words-said { padding: 0.8rem 1rem; border-bottom: 1px dashed rgba(244, 242, 237, 0.1); font-family: var(--font-mono); font-size: 0.78rem !important; line-height: 1.7 !important; color: rgba(244, 242, 237, 0.66) !important; }
  .words-said .seg[data-cat] { color: var(--c); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--c) 55%, transparent); text-underline-offset: 3px; }
  .words-said .c-filler { --c: rgba(244, 242, 237, 0.55); text-decoration: line-through !important; }
  .words-typed { padding: 0.8rem 1rem 0.95rem; font-family: var(--app-font); font-size: 0.96rem !important; line-height: 1.75 !important; color: var(--color-text) !important; }
  .words-typed .seg[data-cat] { color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); border-radius: 5px; padding: 0.05rem 0.25rem; }
  .words-typed .seg-br { background: none !important; padding: 0 !important; opacity: 0.7; font-size: 0.85em; }
  .c-words { --c: var(--c-words); }
  .c-short { --c: var(--c-short); }
  .c-format { --c: var(--c-format); }
  .c-filler { --c: rgba(244, 242, 237, 0.6); }
  .seg { transition: opacity 0.3s ease, filter 0.3s ease; }
  .words[data-focus] .seg { opacity: 0.28; }
  .words[data-focus="words"] .seg.c-words,
  .words[data-focus="short"] .seg.c-short,
  .words[data-focus="format"] .seg.c-format,
  .words[data-focus="filler"] .seg.c-filler { opacity: 1; }
  .words-legend { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .wl {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.78rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .wl i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .wl.c-filler i { background: transparent; border: 1.5px solid var(--c); }
  .wl:hover { color: var(--color-text); border-color: color-mix(in srgb, var(--c) 60%, transparent); }
  .wl[aria-pressed="true"] { color: var(--color-text); border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }

  /* ---- Model Store ---- */
  .ms { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; }
  .ms-pick { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ms-btn {
    min-height: 36px;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--sv-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .ms-btn:hover { color: var(--color-text); border-color: rgba(244, 242, 237, 0.25); }
  .ms-btn[aria-pressed="true"] { background: var(--color-text); color: #0a0a0b; border-color: var(--color-text); }
  .ms-app { display: grid; gap: 0.2rem; padding: 0.65rem 0.7rem; border-radius: 14px; background: #0b0e14; border: 1px solid #262c3d; font-family: var(--app-font); color: #e6e9f0; }
  .ms-group + .ms-group { margin-top: 0.35rem; }
  .ms-h { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.3rem; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.02em; color: #9aa2b5; }
  .ms-group[data-group="well"] .ms-h { color: #4ade80; }
  .ms-group[data-group="slow"] .ms-h { color: #facc15; }
  .ms-group[data-group="heavy"] .ms-h { color: #f87171; }
  .ms-n { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 0.3rem; border-radius: 999px; background: #1b2030; color: #9aa2b5; font-size: 0.68rem; font-variant-numeric: tabular-nums; }
  .ms-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  /* name and size on the first row; the Recommended badge (when shown) under the size */
  .ms-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-rows: auto auto; align-items: center; column-gap: 0.6rem; padding: 0.3rem 0.65rem; border-radius: 12px; background: #131722; border: 1px solid #262c3d; }
  .ms-logo { grid-row: 1 / span 2; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 8px; background: #1b2030; }
  .ms-logo svg { width: 15px; height: 15px; fill: none; stroke: #8b93a7; stroke-width: 1.8; stroke-linecap: round; }
  .ms-group[data-group="well"] .ms-logo svg { stroke: var(--sv-orange); }
  .ms-group[data-group="heavy"] .ms-logo { background: transparent; box-shadow: inset 0 0 0 1px #262c3d; }
  .ms-name { grid-row: 1 / span 2; display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .ms-name b { font-size: 0.8rem; font-weight: 600; }
  .ms-name small { font-size: 0.72rem; color: #9aa2b5; }
  .ms-note { color: #fbbf24; }
  .ms-size { font-size: 0.76rem; font-variant-numeric: tabular-nums; color: #e6e9f0; text-align: right; white-space: nowrap; }
  .ms-badge { justify-self: end; margin-top: 0.15rem; padding: 0.1rem 0.4rem; border-radius: 5px; background: rgba(249, 115, 22, 0.16); color: #fb923c; font-size: 0.66rem; font-weight: 600; white-space: nowrap; }
  .ms-badge[hidden] { display: none; }
  .ms-empty { margin: 0 !important; padding: 0.35rem 0.7rem; border-radius: 12px; border: 1px dashed #262c3d; font-size: 0.75rem !important; color: #9aa2b5 !important; }
  .ms-empty[hidden] { display: none; }
  .ms-read { font-size: 0.8rem !important; }

  /* ---- also in the box ---- */
  .box-h { margin: 0 !important; font-size: 1rem !important; }
  .box { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem 1.75rem; }
  .box li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.8rem; align-items: start; }
  .box-ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: rgba(249, 115, 22, 0.1); box-shadow: inset 0 0 0 1px rgba(249, 115, 22, 0.22); }
  .box-ic svg { width: 17px; height: 17px; fill: none; stroke: var(--sv-orange); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .box-t { font-size: 0.86rem; line-height: 1.45; color: var(--color-muted); }
  .box-t b { display: block; margin-bottom: 0.1rem; font-size: 0.92rem; font-weight: 600; color: var(--color-text); }

  /* touch: every control is at least 44px tall */
  @media (pointer: coarse) {
    .style, .wl, .ms-btn { min-height: 44px; }
  }

  @media (max-width: 1100px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card--models { grid-column: 1 / -1; }
    .box { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1000px) {
    .svf-head { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .card-copy { min-height: 0; }
    .box { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; }
  }
  @media (max-width: 420px) {
    .ms-logo { display: none; }
    .ms-row { grid-template-columns: minmax(0, 1fr) auto; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { Flip } from "gsap/Flip";
  gsap.registerPlugin(ScrollTrigger, Flip);

  const root = document.querySelector<HTMLElement>(".svf")!;
  const motion = matchMedia("(prefers-reduced-motion: no-preference)");
  const fine = matchMedia("(hover: hover)").matches;

  // ---- card entrance + spotlight -----------------------------------------
  const cards = [...root.querySelectorAll<HTMLElement>(".card")];
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const t = gsap.from(cards, {
      y: 40, opacity: 0, duration: 0.9, ease: "expo.out", stagger: 0.06,
      scrollTrigger: { trigger: root.querySelector(".bento"), start: "top 85%", once: true },
    });
    return () => t.revert();
  });
  if (fine) {
    root.addEventListener("pointermove", (e) => {
      cards.forEach((c) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty("--mx", `${e.clientX - r.left}px`);
        c.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }

  // ---- 1. writing styles: a radio group that morphs the output ------------
  {
    const box = root.querySelector<HTMLElement>("[data-styles]")!;
    const chips = [...box.querySelectorAll<HTMLButtonElement>(".style")];
    const out = box.querySelector<HTMLElement>(".styles-out")!;
    const badge = box.querySelector<HTMLElement>("[data-styles-badge]")!;
    const name = box.querySelector<HTMLElement>("[data-styles-name]")!;
    const select = (c: HTMLButtonElement, focus = false) => {
      chips.forEach((x) => { const on = x === c; x.setAttribute("aria-checked", String(on)); x.tabIndex = on ? 0 : -1; });
      if (focus) c.focus();
      const swap = () => {
        out.textContent = c.dataset.text!;
        out.classList.toggle("raw", c.dataset.ai === "0");
        badge.textContent = c.dataset.ai === "0" ? "No AI" : "Local AI";
        name.textContent = c.firstChild?.textContent?.trim() || "";
      };
      if (!motion.matches) return swap();
      gsap.timeline()
        .to(out, { opacity: 0, filter: "blur(8px)", y: -6, duration: 0.2, ease: "power2.in", onComplete: swap })
        .to(out, { opacity: 1, filter: "blur(0px)", y: 0, duration: 0.5, ease: "expo.out", clearProps: "filter,transform" });
    };
    chips.forEach((c) => c.addEventListener("click", () => select(c)));
    box.querySelector(".styles-chips")!.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp"].includes(k)) return;
      e.preventDefault();
      const i = chips.findIndex((c) => c.getAttribute("aria-checked") === "true");
      select(chips[(i + (k === "ArrowRight" || k === "ArrowDown" ? 1 : chips.length - 1)) % chips.length], true);
    });
  }

  // ---- 2. your words: highlight one kind of fix; replay on first view -------
  {
    const box = root.querySelector<HTMLElement>("[data-words]")!;
    const chips = [...box.querySelectorAll<HTMLButtonElement>(".wl")];
    chips.forEach((c) =>
      c.addEventListener("click", () => {
        const on = c.getAttribute("aria-pressed") !== "true";
        chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c && on)));
        if (on) box.dataset.focus = c.dataset.cat; else delete box.dataset.focus;
      }),
    );
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      const said = [...box.querySelectorAll<HTMLElement>(".words-said .seg")];
      const typed = [...box.querySelectorAll<HTMLElement>(".words-typed .seg")];
      const tl = gsap.timeline({ scrollTrigger: { trigger: box, start: "top 80%", once: true } });
      tl.fromTo(said, { opacity: 0.15 }, { opacity: 1, duration: 0.25, stagger: 0.16, ease: "none", clearProps: "opacity" })
        .fromTo(typed, { opacity: 0, y: 5, filter: "blur(5px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.5, stagger: 0.12, ease: "expo.out", clearProps: "all" }, 0.5);
      return () => tl.revert();
    });
  }

  // ---- 3. Model Store: regroup the models for a kind of computer ------------
  {
    const box = root.querySelector<HTMLElement>("[data-ms]")!;
    const btns = [...box.querySelectorAll<HTMLButtonElement>(".ms-btn")];
    const rows = Object.fromEntries([...box.querySelectorAll<HTMLElement>(".ms-row")].map((r) => [r.dataset.model!, r]));
    const groups = Object.fromEntries([...box.querySelectorAll<HTMLElement>(".ms-group")].map((g) => [g.dataset.group!, g]));
    const read = box.querySelector<HTMLElement>("[data-ms-read]")!;
    type P = { cores: number; mem: number; gpu: boolean };
    const nav = navigator as Navigator & { deviceMemory?: number; userAgentData?: { mobile?: boolean } };
    // A phone or tablet can't run the desktop app, so its own numbers say
    // nothing useful: show a plain example computer instead, and say so.
    const ua = navigator.userAgent;
    const phone = /Android|iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) || !!nav.userAgentData?.mobile;
    if (!phone) box.querySelector("[data-ms-this]")!.textContent = "This computer";
    else box.querySelector("[data-ms-this]")!.textContent = "Example computer";
    // a browser never sees the graphics card, so "this computer" assumes none
    const here: P = phone ? { cores: 8, mem: 16, gpu: false } : { cores: navigator.hardwareConcurrency || 4, mem: nav.deviceMemory || 8, gpu: false };
    const profiles: Record<string, P> = { old: { cores: 2, mem: 4, gpu: false }, this: here, gpu: { cores: 16, mem: 32, gpu: true } };
    // a rough version of the app's own rules (Model Store fit, onboarding pick)
    const fit = (id: string, p: P) => {
      if (id === "tiny") return "well";
      if (id === "parakeet") return p.cores >= 4 ? "well" : "slow";
      if (id === "distil") return p.gpu ? "well" : p.cores >= 4 ? "slow" : "heavy";
      if (id === "turbo") return p.gpu ? "well" : p.cores >= 4 && p.mem >= 4 ? "slow" : "heavy";
      return p.gpu ? "well" : "heavy"; // Qwen3-ASR wants a strong graphics card
    };
    // the app's pick: Distil Large v3.5 with a 4 GB graphics card, Parakeet v2 on 4+ cores, else Tiny
    const pick = (p: P) => (p.gpu ? "distil" : p.cores >= 4 ? "parakeet" : "tiny");
    const order = ["tiny", "parakeet", "distil", "turbo", "qwen"];
    const apply = (key: string, animate: boolean) => {
      const p = profiles[key];
      btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.profile === key)));
      const state = animate ? Flip.getState(Object.values(rows)) : null;
      const count: Record<string, number> = { well: 0, slow: 0, heavy: 0 };
      const rec = pick(p);
      order.forEach((id) => {
        const g = fit(id, p);
        count[g]++;
        groups[g].querySelector("ul")!.appendChild(rows[id]);
        rows[id].querySelector<HTMLElement>(".ms-badge")!.hidden = id !== rec;
      });
      Object.entries(groups).forEach(([g, el]) => {
        el.querySelector(".ms-n")!.textContent = String(count[g]);
        el.querySelector<HTMLElement>(".ms-empty")!.hidden = count[g] > 0;
      });
      if (key === "this" && phone) {
        read.textContent = "A phone can't run the desktop app, so this shows an example computer: 8 threads, 16 GB of memory, no graphics card.";
      } else if (key === "this") {
        const mem = nav.deviceMemory ? (nav.deviceMemory >= 8 ? "8 GB or more of memory" : `about ${nav.deviceMemory} GB of memory`) : "memory it won't say";
        read.textContent = `A guess from your browser: ${navigator.hardwareConcurrency || "an unknown number of"} threads, ${mem}. It can't see the graphics card, so this assumes none. The app checks properly.`;
      } else {
        read.textContent = key === "old" ? "An older laptop: 2 cores, 4 GB of memory, no graphics card." : "A desktop whose graphics card has 4 GB or more of its own memory. The app turns the card on by itself.";
      }
      if (state) Flip.from(state, { duration: 0.6, ease: "power3.inOut", absolute: false, nested: true, simple: true });
    };
    btns.forEach((b) => b.addEventListener("click", () => apply(b.dataset.profile!, motion.matches)));
    apply("this", false);
  }
</script>

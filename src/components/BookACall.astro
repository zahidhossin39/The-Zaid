---
const EMAIL = "hello.zaidhossain@gmail.com";
const CAL_LINK = "zaid-hossain/20min";
// <wbr> lets the address wrap at the @ on 320px phones instead of mid-word
const [EMAIL_USER, EMAIL_DOMAIN] = EMAIL.split("@");
import HoursBar from "./HoursBar.astro";
---
<section id="book" class="relative overflow-hidden border-t border-border">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-64 left-1/2 h-[28rem] w-[44rem] -translate-x-1/2 rounded-full bg-accent opacity-[0.09] blur-[130px]"
  >
  </div>

  <div class="relative mx-auto max-w-[80rem] px-6 py-20 text-center md:px-8 md:py-32">
    <p class="eyebrow reveal">Book a call</p>
    <h2 class="h2 reveal mx-auto mt-5 max-w-[20ch]" data-delay="80">
      Tell me where your time goes.
    </h2>
    <p class="lead mx-auto mt-5 max-w-[42ch]">
      Twenty minutes, no pitch. You tell me what takes up your week, and I'll
      tell you honestly whether I can fix it.
    </p>

    <div class="mt-10"><HoursBar variant="book" /></div>

    <div class="reveal mx-auto mt-10 max-w-[76rem]" data-delay="240">
      <div id="cal-embed" class="relative min-h-[34rem] w-full" data-cal-link={CAL_LINK}>
        <!-- Sits behind the embed; removed once Cal says the calendar is ready. -->
        <p class="cal-ph absolute inset-x-0 top-0 z-0 p-10 text-muted">
          Loading the calendar… or email <a class="text-accent underline underline-offset-4" href={`mailto:${EMAIL}`}>{EMAIL_USER}@<wbr />{EMAIL_DOMAIN}</a>
        </p>
        <noscript>
          <p class="p-10 text-muted">
            Booking needs JavaScript. Email <a class="text-accent" href={`mailto:${EMAIL}`}>{EMAIL_USER}@<wbr />{EMAIL_DOMAIN}</a> instead.
          </p>
        </noscript>
      </div>
    </div>

    <p class="mt-8 text-muted">
      Rather write it down? <a class="text-accent underline underline-offset-4 transition hover:text-accent-hover" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </p>
  </div>
</section>

<style is:global>
  #cal-embed > :not(.cal-ph) { position: relative; z-index: 1; }
  html:not(.js) .cal-ph { display: none; }
</style>

<script>
  // Cal.com inline embed, loaded lazily: ~100KB of third-party JS at the very
  // bottom of the page. It loads when the section gets near, or earlier when
  // someone reaches for a "Book a call" link ([data-cal-intent]).
  const w = window as any;
  const target = document.getElementById("cal-embed");
  if (target) {
    const intents = ["pointerenter", "focus", "pointerdown"];
    const onIntent = (e: Event) => {
      if ((e.target as Element | null)?.closest?.("[data-cal-intent]")) w.loadCal();
    };
    const io = new IntersectionObserver(
      (entries) => { if (entries.some((e) => e.isIntersecting)) w.loadCal(); },
      { rootMargin: "300px" }
    );
    let done = false;

    w.loadCal = () => {
      if (done) return;
      done = true;
      io.disconnect();
      // capture phase so non-bubbling pointerenter/focus reach the document
      intents.forEach((t) => document.removeEventListener(t, onIntent, true));

      (function (C: any, A: string, L: string) {
        let p = function (a: any, ar: any) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal, ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api: any = function () { p(api, arguments); };
            api.q = api.q || [];
            cal.ns[ar[1]] = cal.ns[ar[1]] || api;
            p(cal.ns[ar[1]], ar);
            p(cal, ["initNamespace", ar[1]]);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      w.Cal("init", { origin: "https://app.cal.com" });
      w.Cal("inline", {
        elementOrSelector: "#cal-embed",
        calLink: target.dataset.calLink,
        config: { theme: "dark", layout: "month_view", useSlotsViewOnSmallScreen: "true" },
      });
      w.Cal("ui", {
        theme: "dark",
        cssVarsPerTheme: { dark: { "cal-brand": "#F4F2ED", "cal-bg": "transparent", "cal-bg-muted": "transparent", "cal-border-booker": "transparent", "cal-border-booker-width": "0px" } },
        hideEventTypeDetails: false,
      });
      const fail = () => {
        const ph = target.querySelector(".cal-ph");
        const mail = ph?.querySelector("a");
        if (ph && mail) ph.replaceChildren("Couldn't load the calendar. Email ", mail, " instead.");
      };
      const failTimer = setTimeout(fail, 15000); // linkReady never came (blocked, offline)
      w.Cal("on", {
        action: "linkReady",
        callback: () => { clearTimeout(failTimer); target.querySelector(".cal-ph")?.remove(); },
      });
      w.Cal("on", { action: "linkFailed", callback: () => { clearTimeout(failTimer); fail(); } });
    };

    intents.forEach((t) => document.addEventListener(t, onIntent, true));
    io.observe(target);
  }
</script>

---
import ProjectCard from "./ProjectCard.astro";
import projects from "../data/projects.json";
---
<section id="proof" class="mx-auto max-w-[64rem] px-6 py-20 md:px-8 md:py-32">
  <div class="grid gap-12 md:grid-cols-[5fr_7fr] md:gap-14">
    <!-- sticky framing column: keeps context during the longest section -->
    <div class="md:sticky md:top-24 md:self-start">
      <p class="eyebrow reveal">Examples</p>
      <h2 class="h2 reveal mt-5" data-delay="80">What that looks like in practice.</h2>
      <p class="lead mt-5">
        Two demo builds. One brings customers in, the other handles the work
        they create. Your real project gets the same care.
      </p>
      <p class="reveal mt-8 hidden font-mono md:block text-sm text-muted" data-delay="240">
        <span id="proof-counter" class="text-accent">01</span> / {String(projects.length).padStart(2, "0")}
      </p>
    </div>

    <div class="space-y-10">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </div>
</section>

<script>
  // 1. YouTube facade: swap the thumbnail for a real iframe on click.
  document.querySelectorAll<HTMLButtonElement>(".yt-play").forEach((btn) => {
    btn.addEventListener("click", () => {
      const wrap = btn.closest<HTMLElement>("[data-yt]");
      const id = wrap?.dataset.yt;
      if (!wrap || !id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = "Project walkthrough";
      iframe.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full";
      wrap.replaceChildren(iframe);
    });
  });

  // 2. Counter in the sticky column, tracking which card is in view.
  const counter = document.getElementById("proof-counter");
  const cards = [...document.querySelectorAll("#proof article")];
  if (counter && cards.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const i = cards.indexOf(e.target);
          if (i >= 0) counter.textContent = String(i + 1).padStart(2, "0");
        }
      },
      { rootMargin: "-35% 0px -35% 0px" }
    );
    cards.forEach((c) => io.observe(c));
  }
</script>

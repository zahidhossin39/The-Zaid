---
interface Props {
  dotSize?: number;
  gap?: number;
  baseColor?: string;
  activeColor?: string;
  proximity?: number;
  speedTrigger?: number;
  shockRadius?: number;
  shockStrength?: number;
  maxSpeed?: number;
  resistance?: number;
  returnDuration?: number;
  class?: string;
}

const {
  dotSize = 4,
  gap = 26,
  baseColor = "#dcd9d1",
  activeColor = "#111111",
  proximity = 130,
  speedTrigger = 100,
  shockRadius = 250,
  shockStrength = 5,
  maxSpeed = 5000,
  resistance = 750,
  returnDuration = 1.5,
  class: className = "",
} = Astro.props;
---

<div class:list={["dotgrid-wrapper", className]}>
  <canvas
    class="dotgrid-canvas"
    data-dotsize={dotSize}
    data-gap={gap}
    data-basecolor={baseColor}
    data-activecolor={activeColor}
    data-proximity={proximity}
    data-speedtrigger={speedTrigger}
    data-shockradius={shockRadius}
    data-shockstrength={shockStrength}
    data-maxspeed={maxSpeed}
    data-resistance={resistance}
    data-returnduration={returnDuration}
  ></canvas>
</div>

<style>
  .dotgrid-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .dotgrid-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { InertiaPlugin } from "gsap/InertiaPlugin";

  gsap.registerPlugin(InertiaPlugin);

  const throttle = <T extends (...args: any[]) => void>(func: T, limit: number) => {
    let lastCall = 0;
    return function (this: any, ...args: Parameters<T>) {
      const now = performance.now();
      if (now - lastCall >= limit) {
        lastCall = now;
        func.apply(this, args);
      }
    };
  };

  interface Dot {
    cx: number;
    cy: number;
    xOffset: number;
    yOffset: number;
    _inertiaApplied: boolean;
  }

  function hexToRgb(hex: string) {
    const m = hex.match(/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i);
    if (!m) return { r: 0, g: 0, b: 0 };
    return {
      r: parseInt(m[1], 16),
      g: parseInt(m[2], 16),
      b: parseInt(m[3], 16)
    };
  }

  function initDotGrid(canvas: HTMLCanvasElement) {
    const wrap = canvas.parentElement;
    if (!wrap) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const dotSize = parseFloat(canvas.dataset.dotsize || "4");
    const gap = parseFloat(canvas.dataset.gap || "26");
    const baseColor = canvas.dataset.basecolor || "#dcd9d1";
    const activeColor = canvas.dataset.activecolor || "#111111";
    const proximity = parseFloat(canvas.dataset.proximity || "130");
    const speedTrigger = parseFloat(canvas.dataset.speedtrigger || "100");
    const shockRadius = parseFloat(canvas.dataset.shockradius || "250");
    const shockStrength = parseFloat(canvas.dataset.shockstrength || "5");
    const maxSpeed = parseFloat(canvas.dataset.maxspeed || "5000");
    const resistance = parseFloat(canvas.dataset.resistance || "750");
    const returnDuration = parseFloat(canvas.dataset.returnduration || "1.5");

    const baseRgb = hexToRgb(baseColor);
    const activeRgb = hexToRgb(activeColor);

    let circlePath: Path2D | null = null;
    if (typeof window !== "undefined" && window.Path2D) {
      circlePath = new Path2D();
      circlePath.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
    }

    let dots: Dot[] = [];

    const buildGrid = () => {
      const { width, height } = wrap.getBoundingClientRect();
      if (width === 0 || height === 0) return;
      const dpr = window.devicePixelRatio || 1;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);

      const cell = dotSize + gap;
      const cols = Math.floor((width + gap) / cell);
      const rows = Math.floor((height + gap) / cell);

      const gridW = cell * cols - gap;
      const gridH = cell * rows - gap;

      const extraX = width - gridW;
      const extraY = height - gridH;

      const startX = extraX / 2 + dotSize / 2;
      const startY = extraY / 2 + dotSize / 2;

      dots.forEach((dot) => gsap.killTweensOf(dot));

      const newDots: Dot[] = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const cx = startX + x * cell;
          const cy = startY + y * cell;
          newDots.push({ cx, cy, xOffset: 0, yOffset: 0, _inertiaApplied: false });
        }
      }
      dots = newDots;
    };

    const drawStatic = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = baseColor;
      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        ctx.save();
        ctx.translate(dot.cx, dot.cy);
        if (circlePath) {
          ctx.fill(circlePath);
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }
    };

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion) {
      buildGrid();
      drawStatic();
      return;
    }

    buildGrid();

    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(() => {
        buildGrid();
      });
      ro.observe(wrap);
    } else {
      window.addEventListener("resize", buildGrid);
    }

    const pointer = {
      x: -10000,
      y: -10000,
      vx: 0,
      vy: 0,
      speed: 0,
      lastTime: 0,
      lastX: 0,
      lastY: 0
    };

    const proxSq = proximity * proximity;

    const draw = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const px = pointer.x;
      const py = pointer.y;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const ox = dot.cx + dot.xOffset;
        const oy = dot.cy + dot.yOffset;
        const dx = dot.cx - px;
        const dy = dot.cy - py;
        const dsq = dx * dx + dy * dy;

        let style = baseColor;
        if (dsq <= proxSq) {
          const dist = Math.sqrt(dsq);
          const t = 1 - dist / proximity;
          const r = Math.round(baseRgb.r + (activeRgb.r - baseRgb.r) * t);
          const g = Math.round(baseRgb.g + (activeRgb.g - baseRgb.g) * t);
          const b = Math.round(baseRgb.b + (activeRgb.b - baseRgb.b) * t);
          style = `rgb(${r},${g},${b})`;
        }

        ctx.save();
        ctx.translate(ox, oy);
        ctx.fillStyle = style;
        if (circlePath) {
          ctx.fill(circlePath);
        } else {
          ctx.beginPath();
          ctx.arc(0, 0, dotSize / 2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);

    const onMove = (e: MouseEvent) => {
      const now = performance.now();
      const pr = pointer;
      const dt = pr.lastTime ? now - pr.lastTime : 16;
      const dx = e.clientX - pr.lastX;
      const dy = e.clientY - pr.lastY;
      let vx = (dx / dt) * 1000;
      let vy = (dy / dt) * 1000;
      let speed = Math.hypot(vx, vy);
      if (speed > maxSpeed) {
        const scale = maxSpeed / speed;
        vx *= scale;
        vy *= scale;
        speed = maxSpeed;
      }
      pr.lastTime = now;
      pr.lastX = e.clientX;
      pr.lastY = e.clientY;
      pr.vx = vx;
      pr.vy = vy;
      pr.speed = speed;

      const rect = canvas.getBoundingClientRect();
      pr.x = e.clientX - rect.left;
      pr.y = e.clientY - rect.top;

      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dist = Math.hypot(dot.cx - pr.x, dot.cy - pr.y);
        if (speed > speedTrigger && dist < proximity && !dot._inertiaApplied) {
          dot._inertiaApplied = true;
          gsap.killTweensOf(dot);
          const pushX = dot.cx - pr.x + vx * 0.005;
          const pushY = dot.cy - pr.y + vy * 0.005;
          gsap.to(dot, {
            inertia: { xOffset: pushX, yOffset: pushY, resistance },
            onComplete: () => {
              gsap.to(dot, {
                xOffset: 0,
                yOffset: 0,
                duration: returnDuration,
                ease: "elastic.out(1,0.75)"
              });
              dot._inertiaApplied = false;
            }
          });
        }
      }
    };

    const onClick = (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      const cx = e.clientX - rect.left;
      const cy = e.clientY - rect.top;
      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        const dist = Math.hypot(dot.cx - cx, dot.cy - cy);
        if (dist < shockRadius && !dot._inertiaApplied) {
          dot._inertiaApplied = true;
          gsap.killTweensOf(dot);
          const falloff = Math.max(0, 1 - dist / shockRadius);
          const pushX = (dot.cx - cx) * shockStrength * falloff;
          const pushY = (dot.cy - cy) * shockStrength * falloff;
          gsap.to(dot, {
            inertia: { xOffset: pushX, yOffset: pushY, resistance },
            onComplete: () => {
              gsap.to(dot, {
                xOffset: 0,
                yOffset: 0,
                duration: returnDuration,
                ease: "elastic.out(1,0.75)"
              });
              dot._inertiaApplied = false;
            }
          });
        }
      }
    };

    const throttledMove = throttle(onMove, 50);
    window.addEventListener("mousemove", throttledMove, { passive: true });
    window.addEventListener("click", onClick);
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.dotgrid-canvas").forEach((canvas) => {
    initDotGrid(canvas);
  });
</script>

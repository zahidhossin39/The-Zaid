---
const EMAIL = "hello.zaidhossain@gmail.com";
const CAL_URL = "https://cal.com/zaid-hossain/20min";
const year = new Date().getFullYear();

// variant="app" (the app page): no service pitch or site links, only the
// app line, the social links and the name.
interface Props { variant?: "site" | "app" }
const { variant = "site" } = Astro.props;
const app = variant === "app";

// in-page anchors on the home page, links back to it from anywhere else
const home = Astro.url.pathname === "/";
const at = (hash: string) => (home ? hash : `/${hash}`);
const pages = [
  ["Work", at("#proof")],
  ["How I work", at("#process")],
  ["About", at("#about")],
  ["FAQ", at("#faq")],
  ["Book a call", at("#book")],
];

// Icons: 24px grid, drawn as fills so they sit at one visual weight.
const socials = [
  {
    label: "GitHub",
    handle: "zahidhossin39",
    href: "https://github.com/zahidhossin39",
    d: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z",
  },
  {
    label: "X",
    handle: "@ZaidHossain_",
    href: "https://x.com/ZaidHossain_",
    d: "M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z",
  },
  {
    label: "LinkedIn",
    handle: "zaid-hossain",
    href: "https://www.linkedin.com/in/zaid-hossain",
    d: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z",
  },
];
---

<footer class="ft">
  <div class="ft-inner">
    {app ? (
    <div class="ft-top ft-top--app">
      <div class="ft-pitch">
        <p class="ft-line">Silent Voice.<br /><em>Free, and yours to keep.</em></p>
        <p class="ft-app-note">Open source under the MIT license. Built and kept up by me, in my own time.</p>
      </div>
      <div class="ft-col">
        <h2 class="ft-h">Elsewhere</h2>
        <ul>
          {socials.map((s) => (
            <li>
              <a class="ft-social" href={s.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} /></svg>
                <span>{s.label}</span>
                <span class="ft-handle">{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    ) : (
    <div class="ft-top">
      <div class="ft-pitch">
        <p class="ft-line">More customers.<br /><em>Not more hours.</em></p>
        <div class="ft-actions">
          <a class="ft-btn" href={CAL_URL} target="_blank" rel="noopener noreferrer">
            Book a free 20-min call
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </a>
          <a class="ft-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </div>

      <nav class="ft-col" aria-label="Footer">
        <h2 class="ft-h">Site</h2>
        <ul>
          {pages.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <div class="ft-col">
        <h2 class="ft-h">Elsewhere</h2>
        <ul>
          {socials.map((s) => (
            <li>
              <a class="ft-social" href={s.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} /></svg>
                <span>{s.label}</span>
                <span class="ft-handle">{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    )}

    <div class="ft-mark-wrap" aria-hidden="true">
      <p class="ft-mark">Zaid Hossain</p>
      <canvas class="ft-ascii"></canvas>
    </div>

    <div class="ft-base">
      <p>© {year} Zaid Hossain.{!app && " Websites and automations for small businesses."}</p>
      <a href="#" class="ft-top-link">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    overflow: hidden;
  }
  .ft-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 2rem;
  }
  .ft-top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 3rem;
  }

  .ft-top--app { grid-template-columns: minmax(0, 2fr) minmax(0, 1.2fr); }
  .ft-app-note { margin: 1.5rem 0 0; max-width: 26rem; color: var(--color-muted); }

  .ft-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ft-line em { color: var(--color-muted); }

  .ft-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .ft-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 500;
    transition: background 0.2s ease;
  }
  .ft-btn:hover { background: var(--color-accent-hover); }
  .ft-btn svg {
    width: 16px; height: 16px;
    fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ft-btn:hover svg { transform: translate(2px, -2px); }
  .ft-mail {
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
    transition: color 0.2s ease, border-color 0.2s ease;
    overflow-wrap: anywhere;
  }
  .ft-mail:hover { color: var(--color-text); border-color: var(--color-text); }

  .ft-h {
    margin: 0 0 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .ft-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .ft-col a { color: var(--color-text); transition: color 0.2s ease; }
  .ft-col a:hover { color: var(--color-muted); }

  .ft-social { display: flex; align-items: center; gap: 0.75rem; }
  .ft-social svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }
  .ft-handle { margin-left: auto; font-size: 0.875rem; color: var(--color-muted); }

  /* oversized signature: bleeds to the edges, reads as the page's sign-off */
  .ft-mark {
    margin: 5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 15.5vw, 14rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    text-align: center;
    color: var(--color-surface);
    -webkit-text-stroke: 1px var(--color-border);
    user-select: none;
  }

  /* hover: the name dissolves into glowing ASCII (canvas drawn over the text) */
  .ft-mark-wrap { position: relative; margin-top: 5rem; }
  .ft-mark-wrap .ft-mark { margin: 0; }
  .ft-ascii { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ft-mark-wrap.live .ft-mark { visibility: hidden; } /* canvas draws the name itself */

  .ft-base {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .ft-base p { margin: 0; }
  .ft-top-link { color: var(--color-muted); transition: color 0.2s ease; }
  .ft-top-link:hover { color: var(--color-text); }

  @media (max-width: 900px) {
    .ft-top { grid-template-columns: 1fr 1fr; }
    .ft-pitch { grid-column: 1 / -1; }
    .ft-top--app { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .ft-inner { padding-top: 4rem; }
    .ft-top { grid-template-columns: 1fr; gap: 2.5rem; }
    .ft-mark-wrap { margin-top: 3.5rem; }
  }
</style>

<script>
  import { whenNear } from "../scripts/near";
  // ASCII hover: the name is drawn on a canvas split into small cells. Entering it
  // starts a ring that spreads from the entry point; each cell the ring reaches
  // scrambles, then settles into a glowing digit (brightest around the cursor).
  // Leaving pulls the ring back to where it started. Mouse only, off for reduced motion.
  const wrap = document.querySelector<HTMLElement>(".ft-mark-wrap");
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // phones/tablets (no hover) and reduced motion: shown as ASCII from the start, no animation
  const fixed = !fine || still;
  if (wrap) whenNear(wrap, () => {
    const text = wrap.querySelector<HTMLElement>(".ft-mark")!;
    const cv = wrap.querySelector("canvas")!;
    const ctx = cv.getContext("2d")!;
    const CHARS = "0101010123456789";
    const FEATHER = 90; // px: width of the ring's soft edge
    type Cell = { x: number; y: number; m: number; ch: string; t: number; show: boolean };
    let cells: Cell[] = [], w = 0, h = 0, dpr = 1, cs = 10, maxR = 1;
    let font = "", fill = "", stroke = "", ink = "", ls = "0px", baseY = 0;
    let pad = 0, r = 0, over = false, ox = 0, oy = 0, mx = -1e4, my = -1e4, raf = 0;
    const rnd = () => CHARS[(Math.random() * CHARS.length) | 0];

    const drawName = (c: CanvasRenderingContext2D) => {
      c.font = font; c.textAlign = "center"; c.textBaseline = "alphabetic";
      (c as any).letterSpacing = ls;
      c.fillStyle = fill; c.fillText(text.textContent!, w / 2, baseY);
      c.lineWidth = 1; c.strokeStyle = stroke; c.strokeText(text.textContent!, w / 2, baseY);
    };

    const layout = () => {
      const b = wrap.getBoundingClientRect();
      if (b.width < 1 || b.height < 1) return;
      const st = getComputedStyle(text);
      const root = getComputedStyle(document.documentElement);
      // line-height is 0.8, so the letters overflow the box: bleed the canvas by
      // half the font size top and bottom so nothing is clipped
      pad = Math.ceil(parseFloat(st.fontSize) * 0.5);
      // size from the text itself, never from the canvas, so resizing can't feed back
      const th = text.offsetHeight;
      cv.style.top = -pad + "px"; cv.style.height = th + 2 * pad + "px"; cv.style.bottom = "auto";
      dpr = devicePixelRatio || 1; w = b.width; h = th + 2 * pad;
      cv.width = w * dpr; cv.height = h * dpr;
      font = `${st.fontStyle} ${st.fontWeight} ${st.fontSize} ${st.fontFamily}`;
      ls = st.letterSpacing === "normal" ? "0px" : st.letterSpacing;
      fill = st.color; stroke = root.getPropertyValue("--color-border").trim() || fill;
      ink = root.getPropertyValue("--color-text").trim() || "#F4F2ED";
      // baseline straight from the DOM: the text's content box top + the font ascent
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = font;
      const range = document.createRange();
      range.selectNodeContents(text);
      const tr = range.getBoundingClientRect();
      baseY = tr.top - (b.top - pad) + ctx.measureText(text.textContent!).fontBoundingBoxAscent;
      // finer cells on touch screens, where the name is small and always ASCII
      cs = fixed ? Math.max(4, Math.round(parseFloat(st.fontSize) / 16)) : Math.max(7, Math.round(parseFloat(st.fontSize) / 20));
      // sample the glyph coverage per cell
      const off = document.createElement("canvas");
      off.width = Math.ceil(w); off.height = Math.ceil(h);
      const o = off.getContext("2d", { willReadFrequently: true })!;
      const fillSave = fill; fill = "#fff"; drawName(o); fill = fillSave;
      const data = o.getImageData(0, 0, off.width, off.height).data;
      cells = [];
      for (let y = 0; y + cs <= off.height; y += cs)
        for (let x = 0; x + cs <= off.width; x += cs) {
          let a = 0, n = 0;
          for (let yy = y; yy < y + cs; yy += 2) for (let xx = x; xx < x + cs; xx += 2) { a += data[(yy * off.width + xx) * 4 + 3]; n++; }
          // any touched cell gets erased (no leftover letter edges); only solid ones get a digit
          if (a / n > 4) cells.push({ x, y, m: 0, ch: rnd(), t: 0, show: a / n > 90 });
        }
      maxR = Math.hypot(w, h) + FEATHER;
      if (fixed) cells.forEach((c) => (c.m = 1));
      wrap.classList.add("live");
      draw();
    };

    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = "source-over";
      drawName(ctx);
      // punch the name out where cells have turned, then draw their characters
      ctx.globalCompositeOperation = "destination-out";
      for (const c of cells) if (c.m > 0.01) { ctx.fillStyle = `rgba(0,0,0,${c.m})`; ctx.fillRect(c.x, c.y, cs, cs); }
      ctx.globalCompositeOperation = "source-over";
      ctx.font = `600 ${cs * 1.15}px ui-monospace, "SFMono-Regular", Menlo, monospace`;
      (ctx as any).letterSpacing = "0px";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillStyle = ink; ctx.shadowColor = ink;
      for (const c of cells) {
        if (c.m <= 0.01 || !c.show) continue;
        const near = Math.max(0, 1 - Math.hypot(c.x - mx, c.y - my) / 160);
        ctx.globalAlpha = c.m * (fixed ? 0.7 : 0.38 + 0.62 * near);
        ctx.shadowBlur = near > 0.2 ? 10 * near : 0;
        ctx.fillText(c.ch, c.x + cs / 2, c.y + cs / 2 + 0.5);
      }
      ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    };

    let last = 0;
    const tick = (now: number) => {
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now;
      // ring radius eases out toward its target: reacts instantly, lands softly
      const target = over ? maxR : 0;
      r += (target - r) * (1 - Math.exp(-dt * (over ? 3.2 : 4.5)));
      let busy = Math.abs(target - r) > 1;
      for (const c of cells) {
        const d = Math.hypot(c.x + cs / 2 - ox, c.y + cs / 2 - oy);
        const goal = Math.min(1, Math.max(0, (r - d) / FEATHER));
        c.m += (goal - c.m) * Math.min(1, dt * 14);
        if (Math.abs(goal - c.m) > 0.003) busy = true;
        // scramble while turning, then flicker gently near the cursor
        c.t -= dt;
        const near = Math.hypot(c.x - mx, c.y - my) < 160;
        if (c.t <= 0 && c.m > 0.01 && (c.m < 0.97 || near)) { c.ch = rnd(); c.t = c.m < 0.97 ? 0.05 : 0.12 + Math.random() * 0.3; }
      }
      draw();
      if (busy || over) raf = requestAnimationFrame(tick);
      else { raf = 0; last = 0; }
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    if (!fixed) {
    const local = (e: PointerEvent) => { const b = wrap.getBoundingClientRect(); return [e.clientX - b.left, e.clientY - b.top + pad]; };
    wrap.addEventListener("pointerenter", (e) => {
      [mx, my] = local(e);
      if (r < 1) { ox = mx; oy = my; } // start a new ring from the entry point
      over = true; kick();
    });
    wrap.addEventListener("pointermove", (e) => { [mx, my] = local(e); });
    wrap.addEventListener("pointerleave", () => { over = false; mx = my = -1e4; kick(); });
    }

    document.fonts.ready.then(layout);
    let lastW = 0;
    new ResizeObserver(() => {
      const nw = wrap.clientWidth;
      if (nw !== lastW && (cells.length || w)) { lastW = nw; layout(); }
    }).observe(wrap);
  });
</script>
